@article{ WOS:000226555300004,
Author = {Flinders, M},
Title = {Majoritarian democracy in Britain: New labour and the constitution},
Journal = {WEST EUROPEAN POLITICS},
Year = {2005},
Volume = {28},
Number = {1},
Pages = {61-93},
Month = {JAN},
Abstract = {In May 1997 the British electorate voted a Labour government into office
   after 18 years of Conservative administration. This government has
   subsequently enacted a large number of constitutional reforms. However,
   a debate exists in relation to the degree to which, taken together,
   these reforms amount to a fundamental shift in the nature of British
   democracy. This article utilises Arend Lijphart's work off patterns of
   democracy in order to provide a conceptual lens through which New
   Labour's constitutional reforms can be analysed in terms of representing
   either a minor or major shift from a traditionally majoritarian to more
   consensus-orientated system. The article concludes that, although
   significant, the actual degree of reform in Britain is. less radical
   than is commonly assumed: although New Labour is committed to
   far-reaching constitutional reform in principle it has been far less
   committed in practice.},
