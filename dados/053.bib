@article{ WOS:000222578200004,
Author = {Martin, PS},
Title = {Inside the black box of negative campaign effects: Three reasons why
   negative campaigns mobilize},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2004},
Volume = {25},
Number = {4},
Pages = {545-562},
Month = {AUG},
Note = {2nd Minnesota Symposium on Political Psychology, Univ Michigan, Dept
   Polit Sci, Ann Arbor, MI, NOV 07-09, 2002},
Abstract = {The debate over the effect of negative campaigns on vote turnout has not
   been settled. At present, studies demonstrating a mobilization effect
   seem to have the upper hand. However, neither side has offered a
   compelling theory of the causal mechanisms that connect negative
   campaigns and voter turnout. This paper identifies three mechanisms of
   voter motivation-republican duty, candidate threat, and perceived
   closeness of the election-and tests the influence of negative ads on
   each. The findings suggest that each works to plausibly translate
   exposure to negative advertisement into increased participation.},
