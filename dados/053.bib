@article{ WOS:000226545000009,
Author = {Claassen, RL},
Title = {Political opinion and distinctiveness: The case of Hispanic ethnicity},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2004},
Volume = {57},
Number = {4},
Pages = {609-620},
Month = {DEC},
Note = {61st Annual Meeting of the Midwest-Political-Science-Association,
   CHICAGO, IL, APR 03-06, 2003},
Organization = {Midwest Polit Sci Assoc},
Abstract = {Despite a proliferation of research treating Hispanics as a homogeneous
   political group, important questions regarding the nature and structure
   of Hispanic public opinion remain unanswered. Are Hispanic
   self-identifiers similar enough in their political preferences to be
   analyzed as a political group? As a group. are Hispanic preferences
   distinctive enough to be distinguished empirically from other racial and
   ethnic constituencies? Using National Election Studies data I evaluate
   intra-group similarity and inter-group differences. I find evidence of
   strikingly similar intra-uroup opinion, and I find Hispanic preferences
   are distinctive relative to Anglos and blacks, even after controlling
   for socioeconomic status (SES). Moreover. SES variables impact hispanic
   opinion and Anglo opinion differently By exploring the statistical
   imeraction between Hispanic ethnicity and the SES variables I am able to
   illustrate ways in which Hispanics' shared experienice differ from those
   of Anglos and lead to distinctive political views.},
