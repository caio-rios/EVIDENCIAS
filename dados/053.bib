@article{ WOS:000224098500007,
Author = {Hanley, S},
Title = {A nation of sceptics? The Czech EU accession referendum of 13-14 June
   2003},
Journal = {WEST EUROPEAN POLITICS},
Year = {2004},
Volume = {27},
Number = {4},
Pages = {691-715},
Month = {SEP},
Abstract = {The Czech Republic's 13-14 June 2003 referendum on accession to the
   European Union was the seventh of nine held in candidate states due to
   join the EU on 1 May 2004. Despite the presence of two strong
   Eurosceptic parties and the perceived Euroscepticism of Czech public
   opinion, the pro-accession camp scored a convincing victory. This
   account analyses the historical, political and institutional context of
   the referendum and the campaign. It concludes that despite high elite
   contention over the EU and the overwhelming resources advantage of the
   `Yes' camp, Czech voters were minimally influenced by the campaign.
   Rather, they took their cue from longstanding positive linkages of
   `Europe' with democracy, market reform and Czech identity.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
