@article{ WOS:000226545000008,
Author = {Beltran, C},
Title = {Patrolling borders:: Hybrids, hierarchies and the challenge of
   Mestizaje},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2004},
Volume = {57},
Number = {4},
Pages = {595-607},
