@article{ WOS:000223700800001,
Author = {Craiutu, A and Jennings, J},
Title = {The third democracy: Tocqueville's views of America after 1840},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2004},
Volume = {98},
Number = {3},
Pages = {391-404},
Month = {AUG},
Note = {Annual Meeting of the American-Political-Science-Association,
   Philadelphia, PA, AUG 27-SEP 01, 2003},
Organization = {Amer Polit Sci Assoc},
Abstract = {Tocqueville's Democracy in America offered the image of an accomplished
   and successful democratic regime. Although Tocqueville never wrote a
   third volume, he continued to be interested in American political events
   and exchanged a number of important letters with his American friends
   after 1840. Did Tocqueville change his views on America outlined in the
   two volumes published in 1835 and 1840? If so, did the evolution of his
   views of America affect his theory of democracy? The paper answers these
   questions by examining Tocqueville's unduly neglected correspondence
   with his American friends. It seeks to reconstruct what Volume Three of
   Democracy in America might have looked like if it had ever been written.
   In these letters, Tocqueville addressed important topics such as the
   instability of the market and the immaturity of American democracy,
   issues that did not loom large in the two published volumes. The paper
   shows that in the last years of his life Tocqueville became very
   disenchanted with American political life and reassessed some of his
   previous views of American democracy.},
