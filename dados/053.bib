@article{ WOS:000226728500009,
Author = {Pereira, C and Power, TJ and Rennó, L},
Title = {Under what conditions do presidents resort to decree power? Theory and
   evidence from the Brazilian case},
Journal = {JOURNAL OF POLITICS},
Year = {2005},
Volume = {67},
Number = {1},
Pages = {178-200},
Month = {FEB},
Abstract = {The emerging literature on executive decree authority has generated
   important insights, but it has tended to select on the dependent
   variable (decrees), rather than view decrees as one of several possible
   ways that presidents can initiate policies. This article examines the
   conditions under which presidents resort to extraordinary rather than
   ordinary means of legislative initiative. Unilateral action theory
   claims that presidents will resort to decrees in unfavorable political
   environments, while delegation theory claims that decrees will flourish
   when the president is more politically secure. A study of four Brazilian
   presidents between 1988 and 1998 yields inconsistent support for both
   theories. Presidential popularity is only weakly related to the use of
   decree authority, but executive-legislative relations-especially
   coalition management via multiparty cabinets-is a more reliable
   predictor. Neither unilateral action theory nor delegation theory can
   fully account for the wide variation in the legislative strategies of
   presidents.},
