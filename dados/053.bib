@article{ WOS:000226539200003,
Author = {Mason, AC},
Title = {Constructing authority alternatives on the periphery: Vignettes from
   Colombia},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2005},
Volume = {26},
Number = {1},
Pages = {37-54},
Month = {JAN},
Note = {ISA Annual Conference, Montreal, CANADA, MAR 10-14, 2004},
Organization = {ISA},
Abstract = {Current processes of globalization are transforming the world's social
   and political geography by facilitating new socio-spatial configurations
   that are discontinuous with state territories and incompatible with the
   notion of exclusive authority. This article examines the emergence of
   alternative sociopolitical relationships in Colombia as a result of
   global changes, and considers how this development has affected the more
   elusive aspects of statehood, such as authority and legitimacy. While
   alternative orders can undermine what are often already precarious
   structures of domestic governance and authority, as the Colombian
   experience attests, new spheres of authority may in fact enhance state
   performance and legitimacy.},
