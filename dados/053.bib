@article{ WOS:000234343500007,
Author = {Patterson, TE},
Title = {Of polls, mountains - US journalists and their use of election surveys},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2005},
Volume = {69},
Number = {5, SI},
Pages = {716-724},
Abstract = {Polls are a prominent feature of U.S. election news coverage. Although
   polls are used to explain voter opinion, they are employed mostly to
   fuel horse-race coverage and to craft images consistent with the
   candidates' positions in the race. Moreover, U.S. journalists sometimes
   misinterpret polls by slighting the possibility that changes in
   candidate preference are the result of survey error rather than real
   change. On balance, U.S. journalists' dependence on polls adversely
   affects the quality of American election coverage.},
