@article{ WOS:000226642400001,
Author = {De Vries, MS},
Title = {Changing policy views at the local level: The effect of age, generations
   and policy-periods in five European countries},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2005},
Volume = {44},
Number = {1},
Pages = {1-15},
Month = {JAN},
Abstract = {This article addresses the question of how far turnover among those who
   make policy is relevant for understanding changing policy views. Does
   age or generation determine changing attitudes about policy making, or
   does the period in which new policy makers get dominant positions
   determine changes in attitudes? The research is based on a survey
   conducted in 1989, and repeated in 1996 and 2000, among local
   politicians and senior administrators in Sweden, the Netherlands,
   Russia, Lithuania and Belarus. The conclusion is that period-effects
   account for a large portion of attitude change among local policy
   makers. This can be explained by their perceptions of the urgency of
   policy problems with which their municipalities are confronted.},
