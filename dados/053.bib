@article{ WOS:000226823800014,
Author = {O'Leary, B and Grofman, B and Elklit, J},
Title = {Divisor methods for sequential portfolio allocation in multi-party
   executive bodies: Evidence from Northern Ireland and Denmark},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2005},
Volume = {49},
Number = {1},
Pages = {198-211},
Month = {JAN},
Abstract = {Some proportional representation (PR) rules can also be used to specify
   the sequence in which each party in a parliament or each member in a
   multiparty governing coalition is given its choice about (unique)
   desired resources, e.g., ``indivisible goods{''} such as cabinet
   ministries or executive positions, thus providing an algorithmic method
   for determining `fair{''} allocations. Divisor rule sequencing using the
   d'Hondt method was recently used to determine the ten cabinet positions
   in the Northern Ireland Executive Committee created under the 1998
   Belfast ({''}Good Friday{''}) Agreement; and such sequential allocation
   procedures have been used in some Danish municipal governments, and for
   determination of committee chairs in the European parliament. Here we
   examine in some detail the procedures used in Northern Ireland and
   Denmark, with a focus on special features such as the option in Denmark
   to form post-election alliances.},
