Year = {2004},
Volume = {57},
Number = {4},
Pages = {585-594},
Month = {DEC},
Abstract = {In this article I explore the distance traveled by Jurgen Habermas from
   the pessimism, expressed about the prospects for democracy in
   contemporary society in his earl), work, The Structural Transformation
   of the public Sphere: An Inquiry into a Category of Bourgeois Society,
   to the optimistic resuscitation of democracy in a most recent work,
   between Facts and Norms: Contributions to a Discourse Theory of Law and
   Democracy. I also discuss what I consider to be an inadequate treatment
   in the later work of the threat to democracy posed by the influence of
   the modern mass media allied with unchecked corporate power.},
