@article{ WOS:000224552200004,
Author = {Walgrave, S and De Swert, K},
Title = {The making of the (issues of the) Vlaams Blok},
Journal = {POLITICAL COMMUNICATION},
Year = {2004},
Volume = {21},
Number = {4},
Pages = {479-500},
Month = {OCT-DEC},
Note = {30th ECPR Joint Workshop Sessions, Turin, ITALY, MAR 22-27, 2002},
Organization = {ECPR},
Abstract = {In Flanders, the Dutch-speaking part of Belgium, one of the strongest
   extreme right parties of Europe thrives: the Vlaams Blok ( the Flemish
   Bloc). The basic question of this article is straightforward: Do the
   Flemish media contribute to the success of the Vlaams Blok by
   emphasizing the themes of the party? The theoretical argument is
   twofold: agenda setting by the media and issue ownership by parties. The
   issues the Vlaams Blok owns are determined using two sources: its
   electoral manifestoes and its electorate's motivations to vote for the
   party. This leads to four issues: Flemish nationalism, immigrant topics,
   antipolitics issues, and crime-related themes. Using a vast media data
   set covering three newspapers and two TV stations and stretching over 10
   years ( 1991 - 2000), we examine to what extent these issues were
   covered. The analysis shows that especially immigrant topics and crime
   receive extensive and growing media attention, and time series analysis
   shows that this rise parallels the electoral growth of the Vlaams Blok.
   The media could be considered co-responsible for the Vlaams Blok's
   upsurge.},
