@article{ WOS:000227566700013,
Author = {Grossback, LJ and Peterson, DAM and Stimson, JA},
Title = {Comparing competing theories on the causes of mandate perceptions},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2005},
Volume = {49},
Number = {2},
Pages = {406-419},
Month = {APR},
Note = {60th Annual Meeting of the
   Midwest-Political-Science-Association/American-Political-Science-Associa
   tion, CHICAGO, IL, APR 25-28, 2002},
Organization = {Midwest Polit Sci Assoc; Amer Polit Sci Assoc},
Abstract = {The discussion of presidential mandates is as certain as a presidential
   election itself. Journalists inevitably discuss whether the
   president-elect has a popular mandate. Because they see elections as too
   complex to allow the public to send a unitary signal, political
   scientists are more skeptical of mandates. Mandates, however, have
   received new attention by scholars asking whether perceptions of mandate
   arise and lead representatives to act as if voters sent a policy
   directive. Two explanations have emerged to account for why elected
   officials might react to such perceptions. One focuses on the
   president's strategic decision to declare a mandate, the second on how
   members of Congress read signals of changing preferences in the
   electorate from their own election results. We test these competing
   views to see which more accurately explains how members of Congress act
   in support of a perceived mandate. The results indicate that members
   respond more to messages about changing preferences than to the
   president's mandate declaration.},
