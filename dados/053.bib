@article{ WOS:000224731900003,
Author = {Steger, WR and Dowdle, AJ and Adkins, RE},
Title = {The New Hampshire effect in presidential nominations},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2004},
Volume = {57},
Number = {3},
Pages = {375-390},
Month = {SEP},
Abstract = {In order to demonstrate challenges to conventional wisdom (Aldrich
   1980a, b; Bartels 1985 1988; Orren and Polsby 1987), this article
   develops several forecasting models of the presidential primary vote to
   compare to a baseline model of the aggregate primary vote (APV) that
   uses pre-primary and New Hampshire primary data. The models indicate
   that candidates' Gallup poll position and cash reserves are significant
   positive predictors of a candidates' primary vote share, though there
   are differences between forecasting models of the primary vote in
   Democratic and Republican nomination campaigns. Parallel models
   incorporating results of the New Hampshire primary improve the
   predictive power of the baseline model, indicating that the bellwether
   primary has a ``correcting{''} effect on the relative standings of some
   candidates seeking a presidential nomination. This effect is
   substantially greater for Democrats than for Republicans.},
