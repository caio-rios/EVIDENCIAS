@article{ WOS:000226555300002,
Author = {Sartori, G},
Title = {Party types, organisation and functions},
Journal = {WEST EUROPEAN POLITICS},
Year = {2005},
Volume = {28},
Number = {1},
Pages = {5-32},
Month = {JAN},
Abstract = {This paper deals with the classification and functions of political
   parties. It argues that the central concept involved in classifying
   parties is that of the organisational network, which goes beyond the
   party itself to include the space that the party occupies. Historical
   types and sequences of party, organisation and organisational
   development are then explored, as is the central concept of the `mass
   party'. Finally, while many different functions can be ascribed to
   parties, the functions which are central to the notion of party, and
   which are essentially, irreplaceable, are those of participation,
   electioneering and expression.},
