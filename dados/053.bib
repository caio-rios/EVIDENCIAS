ISSN = {0304-4130},
EISSN = {1475-6765},
Keywords-Plus = {PRESIDENTIAL ELECTIONS; ANTI-PARTYISM; SUPPORT; BEHAVIOR; GOVERNMENT;
   CYNICISM; PARTIES; BRITAIN; TURNOUT; ISSUES},
