@article{ WOS:000224360200003,
Author = {Bélanger, É},
Title = {Antipartyism and third-party vote choice - A comparison of Canada,
   Britain, and Australia},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2004},
Volume = {37},
Number = {9},
Pages = {1054-1078},
Month = {NOV},
Note = {Annual Joint Sessions of the Workshop of the
   European-Consortium-for-Political-Research, Univ Edinburgh, Edinburgh,
   SCOTLAND, MAR 28-APR 02, 2003},
Organization = {European Consortium Polit Res},
Abstract = {The effect of antiparty sentiment on voting behaviour is examined
   comparatively using recent individual-level electoral survey data from
   Canada, Britain, and Australia. The author distinguishes two dimensions
   of antipartyism: the rejection of traditional major-party alternatives
   (specific antiparty sentiment) and of political parties per se
   (generalized antiparty sentiment). He argues that disaffected voters in
   these countries are attracted to third or minor parties and support them
   to voice antiparty sentiments. The results show that in general, third
   parties benefit from specific antiparty sentiment at the mass level. The
   rejection of party politics per se, in contrast, brings citizens to
   abstain, unless some third parties-antiparty parties such as the Reform
   Party in Canada and One Nation in Australia-electorally mobilize
   generalized antiparty feelings. The results also indicate that
   compulsory voting in Australia affects disaffected voters' behaviour; in
   particular, those who reject all party alternatives would be more likely
   to abstain if they had the choice.},
Publisher = {SAGE PUBLICATIONS INC},
