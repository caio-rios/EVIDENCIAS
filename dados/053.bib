@article{ WOS:000222888000004,
Author = {Goodin, RE},
Title = {Representing diversity},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2004},
Volume = {34},
Number = {3},
Pages = {453-468},
Month = {JUL},
Note = {Workshop on Political Representation, Edinburgh, SCOTLAND, 2003},
Abstract = {`Mirror representation' or a `politics of presence' presupposes
   relatively modest levels of diversity among those being represented. If
   the groups to be represented are too numerous, internally too
   heterogeneous or too cross-cutting, too many representatives will be
   required for the assembly to remain a deliberative one where `presence'
   can have the effects its advocates desire. In those circumstances, what
   is being represented ought be conceptualized as the `sheer fact of
   diversity' rather than `all the particularities of the diversity among
   us'. The appropriate response to that is legislative reticence.},
Publisher = {CAMBRIDGE UNIV PRESS},
