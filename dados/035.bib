@article{ WOS:000348889400002,
Author = {Martin, Diana},
Title = {From spaces of exception to `campscapes': Palestinian refugee camps and
   informal settlements in Beirut},
Journal = {POLITICAL GEOGRAPHY},
Year = {2015},
Volume = {44},
Pages = {9-18},
Month = {JAN},
Abstract = {The recent literature on the refugee condition and spaces has heavily
   drawn on Agamben's reflection on `bare life' and the `camp'. As refugees
   are cast out the normal juridical order, their lives are confined to
   refugee camps, biopolitical spaces that allow for the separation of the
   alien from the nation. But is the camp the only spatial device that
   separates qualified and expendable lives? What happens when the space of
   the camp overlaps with the space of the city? Taking the Palestinian
   refugee camp of Shatila in Beirut as a case, this study problematises
   the utilisation of legal prisms and clear-cut distinctions for the
   understanding of the production of bare life and spaces of exception.
   Isolated at the time of its establishment, Shatila is today part of the
   so-called `misery belt'. Physical continuities are also reflected by the
   distribution of the population as both Palestinians and
   non-Palestinians, including Lebanese, live in Shatila and the
   surrounding informal settlements. As physical and symbolic boundaries
   separating the refugee and the citizen blur, I argue that the exception
   is not only produced through law and its suspension. While legal
   exceptions place the Palestinians outside the juridical order, other
   exclusions run along sectarian and socio-economic lines cutting through
   the Lebanese body. As Shatila and the infomal settlements are entangled,
   a new spatial model of analysis defined as the `campscape' is proposed.
   Once the exception leaks out of the space of the camp, the campscape
   becomes the threshold where the refugee, the citizen and other outcasts
   meet. (C) 2014 Elsevier Ltd. All rights reserved.},
Publisher = {ELSEVIER SCI LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Martin, D (Corresponding Author), Univ Stellenbosch, Dept Psychol, Wilcocks Bldg,Ryneveld St, ZA-7600 Stellenbosch, South Africa.
   Univ Stellenbosch, Dept Psychol, ZA-7600 Stellenbosch, South Africa.},
DOI = {10.1016/j.polgeo.2014.08.001},
ISSN = {0962-6298},
EISSN = {1873-5096},
Keywords = {Space of exception; Refugee camp; Informal settlements; Palestinian
   refugees; Lebanon},
Keywords-Plus = {INDISTINCTION; ZONES},
Research-Areas = {Geography; Government \& Law},
Web-of-Science-Categories  = {Geography; Political Science},
Author-Email = {dianamartin.int@gmail.com},
Affiliations = {Stellenbosch University},
Funding-Acknowledgement = {Department of Geography of Durham University},
Funding-Text = {I would like to thank all the Palestinians and Lebanese who took part to
   this research and opened the doors of their homes and lives to me. I
   will never forget their unconditional welcome and strength. This paper
   was first presented at the Association of American Geographers
   conference of 2010 in the session `Spatialising Camps'. I am indebted to
   the following for their constructive feedback: Louise Amoore, David
   Campbell, Klaus Dodds, James Duminy, Stuart Elden, Sara Fregonese,
   Christopher Harker, Michele Lancione, Rushil Ranchod, James Sidaway, the
   anonymous reviewers and the Associate Editor of the journal Philip
   Steinberg. My gratitude goes to the International Boundaries Research
   Unit and the Department of Geography of Durham University for funding my
   doctoral research, the Centre for African Studies of the University of
   Cape Town and the Depai {[}Anent of Psychology of Stellenbosch
   University for hosting me during the completion of the paper.},
Cited-References = {Ababsa M., 2012, URBANITE MARGES MIGR, P87.
   Abbas Mahmoud., 1997, J REFUG STUD, V10, P378.
