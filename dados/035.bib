@article{ WOS:000346181700006,
Author = {Ortmann, Stephan},
Title = {Political Change and Civil Society Coalitions in Singapore},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2015},
Volume = {50},
Number = {1},
Pages = {119-139},
Month = {JAN},
Abstract = {In the past few years, a number of civil society coalitions have emerged
   in the illiberal city-state of Singapore. They are the unintended result
   of a controlled process of liberalization which was initiated by the
   government in the 1990s in response to growing demands for
   participation. In particular, the internet has contributed to a more
   assertive, independent and better organized civil society, which can be
   seen as a significant step in the process of political change in the
   city-state.},
