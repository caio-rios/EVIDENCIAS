EISSN = {1468-2508},
Keywords-Plus = {HOUSE; EQUILIBRIUM; PARTY},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Affiliations = {State University System of Florida; University of Florida},
Funding-Acknowledgement = {Woodrow Wilson International Center},
Funding-Text = {My appreciation to the Woodrow Wilson International Center for Scholars
   for a residential fellowship that aided the development of this work, to
   the journal editors and reviewers for their helpful comments and
   guidance, and to Nicole Brinn for preparing the figures. My deep
   appreciation as well to Anthony Downs and his extraordinary book. It
   keeps on giving and giving, even after six decades, so that my challenge
   to his convergence thesis builds in essential ways on his discussion of
   revolutionary cycles and regime change.},
