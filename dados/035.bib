@article{ WOS:000353959100004,
Author = {Ferguson, Neil and Burgess, Mark and Hollywood, Ian},
Title = {Leaving Violence Behind: Disengaging from Politically Motivated Violence
   in Northern Ireland},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2015},
