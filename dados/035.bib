@article{ WOS:000344804000017,
Author = {Wallace, Sophia J.},
Title = {Representing Latinos: Examining Descriptive and Substantive
   Representation in Congress},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2014},
Volume = {67},
Number = {4},
Pages = {917-929},
Month = {DEC},
Abstract = {Using an original data set of roll call votes and bill co-sponsorships
   across three high salience issues (immigration, labor, and education)
   and one low salience issue (social security), this article analyzes the
   111th Congress to assess representation of Latinos. Partisanship is the
   key determinant in member behavior on voting, not the member's race or
   ethnicity or constituent demographics. For bill co-sponsorships, Latino
   members are only more active on high salience issue areas compared with
   non-Latino members. Increases in Latino population do not influence
   behavior. The results also indicate that African American and Democratic
   legislators offer Latinos considerable amounts of substantive
   representation.},
Publisher = {SAGE PUBLICATIONS INC},
