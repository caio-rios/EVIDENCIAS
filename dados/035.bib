@article{ WOS:000353478400001,
Author = {Strach, Patricia and Zuber, Katherine and Fowler, Erika Franklin and
   Ridout, Travis N. and Searles, Kathleen},
Title = {In a Different Voice? Explaining the Use of Men and Women as Voice-Over
   Announcers in Political Advertising},
Journal = {POLITICAL COMMUNICATION},
Year = {2015},
Volume = {32},
Number = {2},
Pages = {183-205},
Month = {APR 3},
Abstract = {We draw on a comprehensive database of American political advertising
   and television audience profile data to investigate the ways in which
   gender influences choices about the use of voice-overs in political
   advertising. Our findings suggest that although men voice the vast
   majority of political ads, campaigns do strategically choose the sex of
   the voice-over announcer and that it systematically varies with
   candidate characteristics, ad tone, and, to a lesser extent, issues.
   Moreover, using survey data, we show that the choice of voice-over
   influences the perceived credibility of the ad.},
