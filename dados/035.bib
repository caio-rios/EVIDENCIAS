@article{ WOS:000350310800003,
Author = {Horwitz, S. Nechama and Nir, Lilach},
Title = {How politics-news parallelism invigorates partisanship strength},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2015},
Volume = {36},
Number = {2},
Pages = {153-167},
Month = {MAR},
Abstract = {Although past research has found that news exposure correlates with
   strong partisanship, insights are based on single-country studies. Other
   studies have shown that cross-national variations in news systems
   correlate with turnout, but have not explored partisanship. The current
   study fills this gap by testing the strength of the relationship between
   news exposure and partisanship cross-nationally. We argue that the
   greater the political parallelism in news systems, the stronger the
   correlation between news exposure and partisanship and the smaller the
   gaps in partisanship between those most and least educated. Multivariate
   analyses of the cross-national European Social Survey find empirical
   support for both hypotheses.},
