@article{ WOS:000757661800001,
Author = {Behl, Natasha},
Title = {India's Farmers' Protest: An Inclusive Vision of Indian Democracy},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2022},
Volume = {116},
Number = {3},
Pages = {1141-1146},
Month = {AUG},
Abstract = {India, the world's largest democracy, has been experiencing a democratic
   decline. Since coming to power in 2014 and winning reelection in 2019,
   Prime Minister Narendra Modi and the Bharatiya Janata Party have become
   increasingly illiberal and authoritarian. The rule of law has
   deteriorated, rights and liberties have been curtailed, and scholars and
   the media have been silenced. If electoral constraint, constitutional
   design, judicial independence, and a free press haven't slowed India's
   march toward illiberalism, what can? In November 2020, India's farmers
   began a highly organized protest against the government. In this
   research note, I ask, how has this protest protected Indian democracy
   from further degradation, and has it radically altered India's political
   future? I argue that the farmers' protest provides an alternative vision
   of democracy, one rooted in radical egalitarianism. Protesting farmers
   have actualized the spirit of dissent enshrined in the Indian
   constitution by holding the current government accountable to it.},
