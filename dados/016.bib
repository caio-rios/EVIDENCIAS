@article{ WOS:000746738800001,
Author = {Tsatsanis, Emmanouil and Borghetto, Enrico and Freire, Andre and Ramon
   Montero, Jose},
Title = {Generational and Ideological Gaps in Democratic Support: Seeds of
   Deconsolidation in Post-Crisis Southern Europe?},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2021},
Volume = {26},
Number = {2, SI},
Pages = {209-237},
Month = {APR 3},
Abstract = {This article explores trends in overall levels of democratic support in
   Portugal, Spain, Italy, and Greece. Additionally, the article examines
   the extent to which the experience of the steep economic downturn in
   Southern Europe had specific effects on democratic support across
   different generations and ideological groups by examining survey data
   that span three decades. The evidence is mixed concerning the resilience
   of democratic values in the four South European countries, ranging from
   stability in Portugal to noticeable decline in Italy. Members of the
   `millennial' generation appear to be more susceptible to the period
   effect of the crisis, whereas left-wing and centrist citizens are more
   likely to select democracy as the best form of government compared to
   right-wing citizens.},
