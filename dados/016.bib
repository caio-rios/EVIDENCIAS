@article{ WOS:000752882400001,
Author = {del Rio, Adrian},
Title = {Strategic Uncertainty and Elite Defections in Electoral Autocracies: A
   Cross-National Analysis},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2022},
Volume = {55},
Number = {13},
Pages = {2250-2282},
Month = {NOV},
Abstract = {Defections within the ruling elite often endanger authoritarian rule,
   emboldening opposition groups and paving the way for regime breakdown.
   Yet, the consequences of elite defections are better understood than
   their causes. Why do some authoritarian regimes experience more
   defections to the opposition than others? This paper develops a theory
   of the origins of elite defection and tests it using a novel dataset
   based on the political careers of 15,013 legislative deputies and
   ministers in 12 electoral autocracies. The theory predicts that regime
   elites defect when there are greater opportunities to capitalize on the
   discontent of other regime elites and voters. Regimes with weak party
   mechanisms that are also supported by many factions experience more
   defections. Finally, defections increase during economic downturns and
   when the government's control of mass media declines, which helps
