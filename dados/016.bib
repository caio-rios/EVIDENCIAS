@article{ WOS:000753684400001,
Author = {Kayran, Elif Naz and Nadler, Anna-Lena},
Title = {Non-citizen voting rights and political participation of citizens:
   evidence from Switzerland},
Journal = {EUROPEAN POLITICAL SCIENCE REVIEW},
Year = {2022},
Volume = {14},
Number = {2},
Pages = {206-225},
Month = {MAY},
Abstract = {Can non-citizen enfranchisement policies reduce the turnout gap between
   citizens with an immigration background and native citizen voters? While
   increasingly common in practice, there are only a handful of studies on
   the political consequences of non-citizen enfranchisement on voter
   mobilisation. Here, we examine the impact of non-citizen voting (NCV)
   rights on the political participation of citizens with and without an
   immigration background. Focusing on Switzerland, we use high-quality
   household panel data (SHP) from 1999 to 2014, leveraging both
   longitudinal and municipal level variation of enfranchisement laws when
   identifying their effect on turnout. We show that NCV rights boost
   political participation overall, and it particularly enhances turnout
   among citizens with an immigration background. Our analysis adds to
   existing theoretical explanations and empirical debates on
   representation and political participation in diverse democratic
   societies with large immigrant populations.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Kayran, EN (Corresponding Author), Leiden Univ, Fac Governance \& Global Affairs, Leiden, Netherlands.
   Kayran, Elif Naz, Leiden Univ, Fac Governance \& Global Affairs, Leiden, Netherlands.
   Nadler, Anna-Lena, Univ Geneva, Dept Polit Sci \& Int Relat, Geneva, Switzerland.},
DOI = {10.1017/S1755773922000029},
