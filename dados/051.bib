@article{ WOS:000241990300004,
Author = {Thrall, A. Trevor},
Title = {The myth of the outside strategy: Mass media news coverage of interest
   groups},
Journal = {POLITICAL COMMUNICATION},
Year = {2006},
Volume = {23},
Number = {4},
Pages = {407-420},
Month = {OCT-DEC},
Abstract = {The ability of interest groups to make their views heard is a central
   tenet of pluralist views of American politics. Despite consensus about
   the importance of news coverage to interest groups pursuing ``outside
   strategies,{''} however, little work has examined the ability of
   ordinary groups to make news. I argue that the best predictor of an
   interest group's ability to use the mass media as a political tool is
   the level of organizational resources ( money, members, staff, etc.) it
   enjoys. Through an investigation of the quantity and quality of news
   coverage received by a sample of 244 interest groups, I show that uneven
   distribution of resources leads to heavy concentration of news on the
