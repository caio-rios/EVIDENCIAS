@article{ WOS:000240619600005,
Author = {Best, Samuel J. and Krueger, Brian S. and Ladewig, Jeffrey},
Title = {The polls - Trends - Privacy in the information age},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2006},
Volume = {70},
Number = {3},
Pages = {375-401},
Month = {FAL},
Abstract = {In recent years, surveillance has become an increasingly salient
   political issue in the United States. In this article we present data on
   public opinion about privacy invasions and surveillance techniques since
   1990. Generally speaking, the polls show that concern about threats to
   personal privacy has been growing in recent years. Although the public
   was temporarily willing to expand the government's investigative powers
   in the aftermath of the September 11, 2001, terrorist attacks, support
   for most forms of surveillance has declined.},
