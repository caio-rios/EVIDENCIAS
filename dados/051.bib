@article{ WOS:000239998300003,
Author = {Schatz, Edward},
Title = {Access by accident: Legitimacy claims and democracy promotion in
   authoritarian Central Asia},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2006},
Volume = {27},
Number = {3},
Pages = {263-284},
Month = {JUL},
Abstract = {The adjective ``authoritarian{''} to describe political regimes obscures
   much variety. What makes some regimes ``soft{''} authoritarian and
   others ``hard?{''} This article suggests that the involvement of
   democracy advocates helps to drive variation in Central Asia's
   authoritarian regimes. The role that these advocates play in the region,
   in turn, may be traced in part to unintended consequences. Specifically,
   elites made early choices about how to frame the legitimacy of the
   state, which, in turn, set the parameters for their maneuver in
   subsequent political transformations.},
