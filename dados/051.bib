@article{ WOS:000238756500005,
Author = {Ellis, Elisabeth},
Title = {Citizenship and property rights: A new look at social contract theory},
Journal = {JOURNAL OF POLITICS},
Year = {2006},
Volume = {68},
Number = {3},
Pages = {544-555},
Month = {AUG},
Abstract = {Social contract thought has always contained multiple and mutually
   conflicting lines of argument; the minimalist contractarianism so
   influential today represents the weaker of two main constellations of
   claims. I make the case for a Kantian contract theory that emphasizes
   the bedrock principle of consent of the governed instead of the mere
   heuristic device of the exit from the state of nature. Such a shift in
   emphasis resolves two classic difficulties: traditional contract
   theory's ahistorical presumption of a pre-political settlement, and its
   impossibly high demands on citizens seeking to practice self-rule.
   Kant's solutions to these problems of property rights and citizenship
   are found in his political works, rather than the ethical works through
   which Kant's political theory is usually interpreted.},
