@article{ WOS:000237783700009,
Author = {Wilson, Rick K. and Stevenson, Randolph and Potts, Geoffrey},
Title = {Brain activity in the play of dominant strategy and mixed strategy games},
Journal = {POLITICAL PSYCHOLOGY},
