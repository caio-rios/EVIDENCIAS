@article{ WOS:000241973500001,
Author = {Zorn, Christopher},
Title = {Comparing GEE and robust standard errors for conditionally dependent
   data},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2006},
Volume = {59},
Number = {3},
Pages = {329-341},
Month = {SEP},
Abstract = {In recent years political scientists have become increasingly sensitive
   to questions of conditional dependence in their data. I outline and
   compare two general, widely-used approaches for addressing such
   dependence-robust variance estimators and generalized estimating
   equations (GEEs)-using data on votes in Supreme Court search and seizure
   decisions between 1963 and 1981. The results make clear that choices
   about the unit on which data are grouped, i.e., clustered, are typically
   of far greater significance than are decisions about which type
   estimator is used.},
