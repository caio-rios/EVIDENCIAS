@article{ WOS:000236607200007,
Author = {Lin, K and Carroll, E},
Title = {State institutions, political power and social policy choices:
   Reconstructing the origins of Nordic models of social policy},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2006},
Volume = {45},
Number = {2},
Pages = {345-367},
Month = {MAR},
Abstract = {The origins of the Nordic social policy model(s) need to be viewed
   broadly and historically from its late nineteenth-century initiation to
   the immediate postwar period (1940s to the early 1960s), when a social
   democratic model began to consolidate. In reference to the alternate
   social policy traditions of British poor relief and German occupational
   insurance, this article analyzes the sociopolitical contexts that
   finally prevented Scandinavian states from developing similarly, instead
   enabling development of universalistic social policy. The historical
   narratives are arranged with respect to four analytical aspects: policy
   development; the configuration of state institutions; the strength of
   liberal, conservative and leftist power blocs; and intra-Nordic
   divergence in all these respects. Such an approach integrates
   state-centred and power-resources-focused analyses of Nordic welfare.},
