@article{ WOS:000236326700007,
Author = {Prakash, A and Potoski, M},
Title = {Racing to the bottom? Trade, environmental governance, and ISO 14001},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2006},
Volume = {50},
Number = {2},
Pages = {350-364},
Month = {APR},
Abstract = {Globalization critics argue that international trade spurs a race to the
   bottom among national environmental standards. ISO 14001 is the most
   widely adopted voluntary environmental regulation which encourages firms
   to take environmental action beyond what domestic government regulations
   require. Drawing on a panel study of 108 countries over seven years, we
   investigate conditions under which trade linkages can encourage ISO
   14001 adoption, thereby countering environmental races to the bottom. We
   find that trade linkages encourage ISO 14001 adoption if countries'
   major export markets have adopted this voluntary regulation.},
