@article{ WOS:000237117300005,
Author = {Pérez-Liñán, A and Ames, B and Seligson, MA},
Title = {Strategy, careers, and judicial decisions: Lessons from the Bolivian
   courts},
Journal = {JOURNAL OF POLITICS},
Year = {2006},
Volume = {68},
Number = {2},
Pages = {284-295},
Month = {MAY},
Note = {25th International Congress of the Latin-American-Studies-Association,
   Las Vegas, NV, OCT 07-09, 2004},
Organization = {Latin Amer Studies Assoc},
Abstract = {Using survey data from Bolivian trial courts, we explore the
   relationship between judicial decisions, career goals, and hierarchical
   pressures in continental legal systems. Based on a principal-agent
   approach, we hypothesize that inferior court judges are more likely to
   defer to superior courts when they share their interpretation of the
   law, when they anticipate reversals, and when they fear political
   manipulation of judicial careers. In turn, superior judges are likely to
   exercise informal pressures over inferior court judges who deviate from
   the former's legal views and do not anticipate their preferences. The
   conclusions emphasize the utility of survey research for the study of
   strategic compliance in judicial institutions.},
