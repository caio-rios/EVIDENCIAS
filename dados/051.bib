@article{ WOS:000238655800004,
Author = {Shamir, Michal and Sagiv-Schifter, Tammy},
Title = {Conflict, identity, and tolerance: Israel in the Al-Aqsa Intifada},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2006},
Volume = {27},
Number = {4},
Pages = {569-595},
Month = {AUG},
Abstract = {This paper explores the impact of the Al-Aqsa Intifada on tolerance
   orientations of the Israeli Jewish public. We rely upon five surveys
   carried out between January 2000 and June 2002 to study in a real-life
   setting the amount and nature of change in political tolerance due to
   the conflict and the mechanisms behind it. Building on theory and
   research on intergroup relations in social psychology and political
   tolerance in political science, we focus upon threat and ingroup
   identification as the two primary factors in the social psychological
   processes resulting from conflict and leading to intolerance. We set the
   trends and explore mediation and interaction processes in the impact of
   this round of conflict on political tolerance.},
