@article{ WOS:000239998300004,
Author = {Choup, Anne Marie},
Title = {Calculated risks: Why civic leaders (re)turn to politics},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2006},
Volume = {27},
Number = {3},
Pages = {285-300},
Month = {JUL},
Note = {97th Annual Meeting of the American-Political-Science-Association, SAN
   FRANCISCO, CA, AUG 29-SEP 02, 2001},
Organization = {Amer Polit Sci Assoc},
Abstract = {Existing conceptualizations of civil society often emphasize its
   distinction from political institutions and individuals. This article
   argues for a systematic review of the relationships between civic and
   political leaders in Latin America, since many civic leaders turn (or
   return) to political activities in order to carry out local work better.
   There exist a variety of nuanced relationships between the civil and the
   political realms. Examples from chil-political relationships in the
   Dominican Republic in 1999 illustrate this variety of alliances between
   civic leaders and political parties and demonstrate that they are not
   necessarily harmful to the democratic order.},
