@article{ WOS:000240583600010,
Author = {Witko, Christopher},
Title = {PACs, issue context, and congressional decisionmaking},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2006},
Volume = {59},
Number = {2},
Pages = {283-295},
Month = {JUN},
Abstract = {Scholars have claimed that PAC influence on congressional behavior is
   more likely on certain types of issues. After considering both roll-call
   voting and committee participation, I argue that the conditions making
   PAC influence on voting most likely make influence on participation
   least likely, and vice versa. The analysis of 20 legislative proposals
   indicates that PACs are able to influence voting on
   non-ideological/non-visible issues, but are more likely to influence
   participation on ideological/visible issues. Unlike previous studies,
   these findings demonstrate that PACs can influence behavior across
   different contexts, but that the route to influence differs depending on
   the type of issue being considered.},
