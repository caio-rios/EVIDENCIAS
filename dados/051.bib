@article{ WOS:000238655800005,
Author = {Baird, Vanessa A. and Gangl, Amy},
Title = {Shattering the myth of legality: The impact of the media's framing of
   Supreme Court procedures on perceptions of fairness},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2006},
Volume = {27},
Number = {4},
Pages = {597-614},
Month = {AUG},
Abstract = {The tendency of the media to depict the Supreme Court as inherently
   apolitical, some scholars argue, is part of the reason that many believe
   in the ``myth of legality{''} in which the Court is perceived to operate
   above the ideological skirmishes of everyday politics. Our experimental
   analyses show that citizens react more negatively to press reports of a
   politically motivated Court than they do to coverage portraying a Court
   that strictly follows legal guidelines. Interestingly, our results also
   suggest that it is not so much the perceived absence of political
   wrangling among justices but rather it is the presence of legal
   guidelines driving the outcome that is the source of the perception of
   fairness.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Baird, VA (Corresponding Author), Univ Colorado, Dept Polit Sci, CB 333, Boulder, CO 80309 USA.
   Univ Colorado, Dept Polit Sci, Boulder, CO 80309 USA.
   Union Coll, Dept Polit Sci, Schenectady, NY 12308 USA.},
