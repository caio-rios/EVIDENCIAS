@article{ WOS:000234198200010,
Author = {Yackee, JW and Yackee, SW},
Title = {A bias towards business? Assessing interest group influence on the US
   bureaucracy},
Journal = {JOURNAL OF POLITICS},
Year = {2006},
Volume = {68},
Number = {1},
Pages = {128-139},
Month = {FEB},
Note = {Annual Meeting of the Midwest-Political-Science-Association, Chicago,
   IL, APR, 2004},
Organization = {Midwest Polit Sci Assoc},
Abstract = {We test the proposition that the federal bureaucracy exhibits a ``bias
   toward business{''} during notice and comment rulemaking. We analyze
   over 30 bureaucratic rules and almost 1,700 comments over the period of
   1994 to 2001. We find that business commenters, but not nonbusiness
   commenters, hold important influence over the content of final rules. We
   also demonstrate that as the proportion of business commenters
   increases, so too does the influence of business interests. These
   findings contrast with previous empirical studies and generally suggest
   that notice and comment procedures have not succeeded in
   ``democratizing{''} the agency policymaking process to the extent
   sometimes suggested in the normative rulemaking literature.},
