@article{ WOS:000236326700015,
Author = {Savchak, EC and Hansford, TG and Songer, DR and Manning, KL and Carp, RA},
Title = {Taking it to the next level: The elevation of district court judges to
   the US Courts of Appeals},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2006},
Volume = {50},
Number = {2},
Pages = {478-493},
Month = {APR},
Note = {62nd Annual Meeting of the Midwest-Political-Science-Association,
   Chicago, IL, APR, 2004},
Organization = {Midwest Polit Sci Assoc},
Abstract = {We address an important aspect of judicial careers: the elevation of
   judges from the U.S. District Courts to the Courts of Appeals. We argue
   that the likelihood of a judge being elevated is a function of
   informational cues and signals regarding the nature of the judge and the
   judge's compatibility with presidential preferences. We also expect
   norms involving the intersection between geography and Senate politics
   to affect a judge's elevation chances. Using data on district court
   judges appointed between 1946 and 1995, we find that the likelihood of a
   judge being elevated is a function of the judge's ideological
   compatibility with the president, the judge's previous ABA rating, and
   Senate norms involving state ``ownership{''} of appeals court seats.
   Blunt indicators of policy preferences trump direct signals when
   presidents decide whom to elevate, leaving judges little control over
   their career prospects and thus less incentive to slant their decisions
   in the direction of the president's preferences.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
