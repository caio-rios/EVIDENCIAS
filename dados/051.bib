@article{ WOS:000237434400002,
Author = {Wernli, Boris},
Title = {Homo- and heterogamy in political attitudes and behaviour in Switzerland},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2006},
Volume = {12},
Number = {1},
Pages = {33-72},
Month = {SPR},
Abstract = {The article explores the political behaviour of heterosexual couples who
   were interviewed during the first wave of the Swiss Household Panel
   (www.swisspanel.ch) project. It is commonly admitted that political
   behaviour is influenced by a great variety of interpersonal exchanges,
   in particular those amongst persons living together within the same
   household. Despite this most electoral studies consider individuals
   isolated from their family contexts. By taking into account the
   characteristics of both partners in a couple, political behaviour can be
   analyzed and understood in a more meaningful way. In particular, the
   results show that political behaviour tends to be similar for both
   partners in a couple, although both still enjoy a large degree of
   autonomy left. Men influence the political behaviour of their female
   partner more strongly than females influence men. Moreover,
   socio-demographic variables make only a minor contribution to the
   explanation of such political behaviour.},
