@article{ WOS:000289633500001,
Author = {Leyenaar, Monique and Hazan, Reuven Y.},
Title = {Reconceptualising Electoral Reform},
Journal = {WEST EUROPEAN POLITICS},
Year = {2011},
Volume = {34},
Number = {3, SI},
Pages = {437-455},
Abstract = {This article delineates the three waves of development in the study of
   electoral reform: the systematic description and consequences of
   electoral systems; the analysis of major reform and its political
   consequences; and a more comprehensive approach to the study of
   electoral reform. It seeks to achieve two goals. The first is to shift
   attention away from the political consequences of electoral change and
   toward what takes place before the passage of reform. Beyond delineating
   what electoral reform is, the authors ask: Why does it occur? Who
   initiates the electoral reform? When, and where, does it succeed or fail
   to pass the necessary obstacles? How should we study it? They therefore
   want to analyse the determinants of electoral reform. Their second goal
   is to elaborate an agenda for future research in electoral change, and
   they do so by discussing both the reconceptualisation and the
   methodology of electoral reform research.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Leyenaar, M (Corresponding Author), Radboud Univ Nijmegen, Inst Management Res, NL-6525 ED Nijmegen, Netherlands.
   Leyenaar, Monique, Radboud Univ Nijmegen, Inst Management Res, NL-6525 ED Nijmegen, Netherlands.
   Hazan, Reuven Y., Hebrew Univ Jerusalem, Dept Polit Sci, IL-91905 Jerusalem, Israel.},
DOI = {10.1080/01402382.2011.555974},
Article-Number = {PII 936230520},
ISSN = {0140-2382},
