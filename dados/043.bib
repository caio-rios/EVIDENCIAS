Pages = {45-60},
Month = {JAN},
Abstract = {The standard model of democratic accountability emphasizes
   accountability to the appropriate agents. This model has proven
   difficult to adapt to the challenges posed by global governance. This
   article critiques the Westphalian assumptions underlying the standard
   model and develops an alternative model of accountability to democratic
   norms rather than to specific agents.},
