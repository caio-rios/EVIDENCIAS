@article{ WOS:000290964300003,
Author = {Chu, Lan T.},
Title = {Unfinished business: the Catholic Church, communism, and democratization},
Journal = {DEMOCRATIZATION},
Year = {2011},
Volume = {18},
Number = {3},
Pages = {631-654},
Abstract = {Although history has shown us that the church plays a role in the
   political liberalization of non-democratic countries, the nature of the
   church's role and how it participates in politics has yet to be fully
   revealed. By revisiting the Polish Church's historic role in the
   collapse of communism, I argue that we have overestimated the church's
   effect on political liberalization in that case, which has led us to
   neglect or be prematurely disappointed in its role in the remaining
   communist countries such as in Cuba. Drawing from the Polish case, I
   conclude that the church's moral, self-limiting, and transnational
   character needs to be recognized and incorporated into a general theory
   of democratization. It is this aspect of the church that has helped it
   to remain active within remaining communist societies, and provide the
   moral support that is an integral part of political liberalization
   processes.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
