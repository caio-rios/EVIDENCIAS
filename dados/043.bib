Volume = {34},
Number = {3, SI},
Pages = {551-567},
Abstract = {Citizens can be involved directly in the electoral reform process. In
   some jurisdictions, constitutional requirements or political necessity
   requires a referendum. There are also instances in which a proposal
   originates through such means as a popular initiative or reference to a
   citizens' assembly. When a vote occurs, additional barriers to success
   are created. This article examines particularly the referendum which
   took place in the Canadian province of Ontario on a reform proposal that
   had been recommended by acitizens' assembly. The analysis examines the
   campaign and discusses some of the factors that ultimately led to the
   defeat of the proposal.},
