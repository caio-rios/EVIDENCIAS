@article{ WOS:000570660900001,
Author = {Castro, Paula},
Title = {National interests and coalition positions on climate change: A
   text-based analysis},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2021},
Volume = {42},
Number = {1, SI},
Pages = {95-113},
Month = {JAN},
Abstract = {Coalitions play a central role in the international negotiations under
   the United Nations Framework Convention on Climate Change. By getting
   together, countries join resources in defending their interests and
   positions. But building coalitions may come at a cost. Coalition
   positions are a result of compromise between their members, and thus the
   increase in bargaining power may come at a price if the preferences of
   their members are heterogeneous. Relying on automatic text analysis of
   written position papers submitted to the negotiations, I analyze the
   extent to which coalitions represent the preferences of their members
   and discuss whether this contributes to disproportionate policy
   responses at the international level. I focus on a recently formed
   coalition: the Like-Minded Developing Countries, a large and
   heterogeneous group that brings together emerging, oil-dependent and
   poor developing countries.},
Publisher = {SAGE PUBLICATIONS LTD},
