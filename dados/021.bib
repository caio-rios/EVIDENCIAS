   Correa, Patricia, Aston Univ, Birmingham, W Midlands, England.},
DOI = {10.1017/S1755773920000119},
Article-Number = {PII S1755773920000119},
ISSN = {1755-7739},
EISSN = {1755-7747},
Keywords = {civil society; membership organizations; mortality anxiety;
   organizational viability; European Democracies},
Keywords-Plus = {PARTY ORGANIZATION; POLITICAL-PARTIES; SURVIVAL; INTERESTS;
   REPRESENTATION; MEMBERSHIP; RESOURCES; DEMOCRACY; ACCESS; VOICE},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {n.bolleyer@ex.ac.uk},
Affiliations = {University of Exeter; Aston University},
