   Ladd, Jonathan M., Georgetown Univ, McCourt Sch Publ Policy, Washington, DC 20057 USA.
   Ladd, Jonathan M., Georgetown Univ, Dept Govt, Washington, DC 20057 USA.},
DOI = {10.1017/S0007123418000285},
