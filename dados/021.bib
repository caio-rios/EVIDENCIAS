@article{ WOS:000579503000001,
Author = {Wiedenbrueg, Anahi},
Title = {Responsibility For Financial Crises},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2021},
Volume = {65},
Number = {2},
Pages = {460-472},
Month = {APR},
Abstract = {How is the unjust global order reproduced, and how are we to think about
   individual responsibility therefor? Social and global justice scholars
   have devoted much thought to these two interrelated questions. In this
   article I argue that to capture the multifaceted responsibility picture
   for the reproduction of the unjust global order, an integrated
   responsibility model is needed, which builds on, integrates and revises
   existing responsibility theories. To do so, I analyze one set of complex
   social processes through which the unjust global order is reproduced,
   namely financial crises. The integrated responsibility model defended
   offers three heuristic categories to think through the full
   responsibility picture for the reproduction of the unjust global order
   via financial crises: the structural-agential level, structural
   processes proper, and the structural-systemic level.},
