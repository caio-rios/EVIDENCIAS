@article{ WOS:000584343000031,
Author = {Kuipers, Nicholas},
Title = {The Effect of Electing Female Candidates on Attitudes toward Intimate
   Partner Violence},
Journal = {JOURNAL OF POLITICS},
Year = {2020},
Volume = {82},
Number = {4},
Pages = {1590-1595},
Month = {OCT 1},
Abstract = {What can be done to encourage people to condemn intimate partner
   violence? Looking at Indonesia, I combine electoral data with a
   large-scale health survey and find that the narrow victory of a female
   candidate-as opposed to a male candidate-in local council elections
   leads to a decrease in the share of female constituents who agree that a
   husband is justified in assaulting his wife. I observe similar results
   for male constituents, although some estimates are not statistically
   significant. These results improve our understanding of the role of
   descriptive representation as a cause, rather than simply a consequence,
   of changing attitudes.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
