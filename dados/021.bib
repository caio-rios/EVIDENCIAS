@article{ WOS:000553658900016,
Author = {Tomz, Michael and Weeks, Jessica L. P.},
Title = {Public Opinion and Foreign Electoral Intervention},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2020},
Volume = {114},
Number = {3},
Pages = {856-873},
Month = {AUG},
Abstract = {Foreign electoral intervention is an increasingly important tool for
   influencing politics in other countries, yet we know little about when
   citizens would tolerate or condemn foreign efforts to sway elections. In
   this article, we use experiments to study American public reactions to
   revelations of foreign electoral intervention. We find that even modest
   forms of intervention polarize the public along partisan lines.
   Americans are more likely to condemn foreign involvement, lose faith in
   democracy, and seek retaliation when a foreign power sides with the
   opposition, than when a foreign power aids their own party. At the same
   time, Americans reject military responses to electoral attacks on the
   United States, even when their own political party is targeted. Our
   findings suggest that electoral interference can divide and weaken an
   adversary without provoking the level of public demand for retaliation
   typically triggered by conventional military attacks.},
