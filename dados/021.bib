@article{ WOS:000553658900006,
Author = {Ainsley, Caitlin and Carrubba, Clifford J. and Crisp, Brian F. and
   Demirkaya, Betul and Gabel, Matthew J. and Hadzic, Dino},
Title = {Roll-Call Vote Selection: Implications for the Study of Legislative
   Politics},
