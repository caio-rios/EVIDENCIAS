@article{ WOS:000173595400001,
Author = {Claibourn, MP and Martin, PS},
Title = {Trusting and joining? An empirical test of the reciprocal nature of
   social capital},
Journal = {POLITICAL BEHAVIOR},
Year = {2000},
Volume = {22},
Number = {4},
Pages = {267-291},
Month = {DEC},
Abstract = {This article tests a key hypothesis of the social capital literature:
   voluntary memberships and generalized trust reproduce one another. Panel
   data from the Michigan Socialization Studies from 1965 to 1982 are used
   to test the contemporaneous and lagged effects of interpersonal trust on
   joining groups and the contemporaneous and lagged effects of joining
   groups on interpersonal trust. We find no evidence supporting the
   hypothesis that interpersonal trust encourages group memberships and
   only limited evidence suggesting that belonging to groups makes
   individuals more trusting.},
