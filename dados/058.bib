@article{ WOS:000089917800001,
Author = {Pierre, J and Svåsand, L and Widfeldt, A},
Title = {State subsidies to political parties:: Confronting rhetoric with reality},
Journal = {WEST EUROPEAN POLITICS},
Year = {2000},
Volume = {23},
Number = {3},
Pages = {1-24},
Month = {JUL},
Abstract = {This article investigates the political impact of the introduction of
   state subsidies to political parties. The arguments for and against
   subsidising political parries are outlined Different models of party
   subsidies, and their regulatory frameworks, are discussed. We find
   little evidence of a cross-national impact of the introduction of party
   subsidies. The subsidies cannot explain the decline in party membership.
   Nor is there evidence to suggest that the subsidies were introduced as a
   response to membership decline. There is no support for the allegation
   that party subsidies lead to the petrification of party systems. The
   subsidies have not meant that other income sources have lost their
   significance for political parties.},
