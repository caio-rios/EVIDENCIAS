@article{ WOS:000167735800004,
Author = {McLaren, LM},
Title = {Immigration and the new politics of inclusion and exclusion in the
   European Union: The effect of elites and the EU on individual-level
   opinions regarding European and non-European immigrants},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2001},
Volume = {39},
Number = {1},
Pages = {81-108},
Month = {JAN},
Note = {Joint Workshops of the ECPR, MANNHEIM, GERMANY, MAR 26-31, 1999},
Organization = {ECPR},
Abstract = {Within European politics, a distinction is currently being made at the
   elite level between internal and external immigration, with individuals
   from EU countries being given special rights and privileges when they
   migrate within the EU. This paper addresses the question of whether
   individual EU citizens also view the two types of immigrants differently
   and what structures their beliefs regarding these two sources of
   migration. The findings indicate that (a) the vast majority of EU
   citizens view internal and external migration as identical and (b) elite
   cues and debates regarding immigration within each of the countries are
   helping individuals form their opinions regarding the two different
   types of immigration. These findings and their implications are
   discussed in the body of the paper.},
Publisher = {KLUWER ACADEMIC PUBL},
