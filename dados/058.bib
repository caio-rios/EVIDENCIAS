@article{ WOS:000167970000007,
Author = {Hopkin, J},
Title = {A `southern model' of electoral mobilisation? Clientelism and electoral
   politics in Spain},
Journal = {WEST EUROPEAN POLITICS},
Year = {2001},
Volume = {24},
Number = {1},
Pages = {115-136},
Month = {JAN},
Abstract = {It is often argued that clientelism is a key feature of electoral
   mobilisation in southern European? democracies. This article examines
   the evidence for clientelism in the Spanish case, assessing the
   recruitment, redistributive strategies and electoral performance of
   governing parties in the 1977-96 period. It finds little evidence of
   extensive clientelistic mobilisation; instead, political parties' use of
   state resources is largely consistent with? their programmatic and
   ideological positions. `Old' clientelism from the pre-democratic era
   mostly did not survive the change of regime, whilst `new' clientelism
   based or? the expansion of state employment contributed to the Socialist
   Party's organisational consolidation, bur was not a significant feature
   e of its strategy of electoral mobilisation.},
