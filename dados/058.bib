@article{ WOS:000165813100006,
Author = {Rogers, JR},
Title = {Information and judicial review: A signaling game of
   legislative-judicial interaction},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2001},
Volume = {45},
Number = {1},
Pages = {84-99},
Month = {JAN},
Abstract = {This article develops a simple signaling game in which a Legislature and
   a Court interact seeking their own policy goals. The Legislature faces
   two sources of certainty when legislating. First, it knows only
   probabilistically whether the Court's preferences preferences
   convergence or diverge from its own on the proposed law. Second, its
   knows only probabilistically the true state of the world and, hence,
   does not know with certainty whether the law will reasonably achieve its
   intended outcome if enacted. For institutional and sequential reasons,
   the Court has more information regarding the actual of an enacted law
   than the Legislature did when initially considering it. As a result, the
   Court's exercise of the judicial veto may (but not necessarily will) be
   informationally productive. The possibility of informative judicial
   review affects the quantity of legislation enacted by Legislature
   relative to legislation that would be enacted in the absence of judicial
   review. Further, an informational component to judicial review alters
   the incentive that the Court has to act strategically relative to
   incentives for strategic behavior in purely distributive models of
   legislative-judicial interaction. Finally, because of the possibility of
   informative judicial review, the model accounts endogenously for the
   creation and maintenance of an independent judiciary by a Legislature
   that solely values achieving its preferred policy outcomes.},
