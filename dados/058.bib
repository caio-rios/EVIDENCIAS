@article{ WOS:000165813100001,
Author = {Boix, C},
Title = {Democracy, development, and the public sector},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2001},
Volume = {45},
Number = {1},
Pages = {1-17},
Month = {JAN},
Abstract = {This article develops a mode; that describes the growth of the public
   sector as a joint result of the process of economic development and the
   political institutions in place. the model is tested using panel dat for
   about sixty five developing and developed nations for the period
   1950-90. Economic modernization leads to the growth of the public sector
   through two mechanisms: first , the state intervenes to provide certain
   collective goods such as regulatory agencies anf infrastructure; second,
   industrialization and an ageing population translate into higher demands
   for transfers in the form of unemployment benefits, health insurance,
   and pensions. Still, the impact of economic development is strongly
   conditional on the political regime in place as well as on the level of
   electoral participation. Whereas in a democratic regime, were
   politicians respond to voters' demands, the public sector grows parallel
   to the structural changes associated with economic development, in
   authoritarian countries the size of the public sector remains small.},
