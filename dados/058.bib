Year = {2000},
Volume = {21},
Number = {3},
Pages = {559-571},
Month = {SEP},
Abstract = {This paper considers Bill Clinton's operational code as reflected in
   prepared speeches and spontaneous remarks. Differences between the two
   types of verbal material, their respective differences over time, and
   their respective variation after key intervening political events were
   subjected to analysis of variance as well as descriptive analyses. The
   results suggest that measurements based on spontaneous comments are
   preferable, particularly in providing sensitive measures of personal
   predispositions.},
