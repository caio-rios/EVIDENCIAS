Year = {2000},
Volume = {23},
Number = {3},
Pages = {139-152},
Month = {JUL},
Abstract = {Doubt has been cast recently on the explanatory significance of the
   Dutch variant of consociationalism, or verzuiling. Here it is argued
   that the problems arise in the main from confusions in terminology: and
   that verzuiling as a concept still has much to offer Links are
   identified with emancipation, tolerance and national identity. The Dutch
   case is compared with Belgium, and put in a EU perspective. A
   distinction is drawn between consociation, pillarisation and corporatism
   the specifically Dutch combination of these came to dominate public life
   in the Netherlands for much of the early twentieth century.},
