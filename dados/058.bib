@article{ WOS:000089917800003,
Author = {Richards, D and Smith, MJ},
Title = {The public service ethos and the role of the British Civil Service},
Journal = {WEST EUROPEAN POLITICS},
Year = {2000},
Volume = {23},
Number = {3},
Pages = {45-66},
Month = {JUL},
Abstract = {The last Conservative administration invested much time and effort in
   reforming the structure and organisation of the Civil Service. Yet it
   left untouched the core principles which underpinned Whitehall, often
   referred to as the public service ethos. In this article, we argue that
   this ethos has been defended by both conservative and liberal opinion as
   something fundamentally good. Yet, in reality the public service ethos
   is a power/knowledge sq stern which legitimises the rule of a particular
   elite by presenting public service as a worthy occupation and, thereby:
   authorising a system of power which is relatively closed and secretive.
   This accounts for why it has been in the interests of both the last
   Conservative administration and the present Labour government to ensure
   the ethos remains intact.},
Publisher = {FRANK CASS CO LTD},
