@article{ WOS:000166706500004,
Author = {Derouen, K and Heo, U},
Title = {Defense contracting and domestic politics},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2000},
Volume = {53},
Number = {4},
Pages = {753-769},
Month = {DEC},
Note = {Annual Conference of the American-Political-Science-Association, BOSTON,
   MASSACHUSETTS, AUG 30-SEP 06, 1998},
Organization = {Amer Polit Sci Assoc},
Abstract = {Scholars have investigated the relationship between defense spending and
   domestic political constraints. Because of a two-year time lag, however,
   it is difficult to make a theoretical link between the aggregate defense
   budget and domestic politics. We focus on defense contract awards
   because of their rapid turn-around. We advance the referendum model to
   account for variations in the timing of defense contracts within
   administrations. The referendum model posits that government policies
   are reflective of approval ratings and that the President uses defense
   contracts to counter sagging approval and/or a weak economy This is a
   subtle but important alternative to political business cycle (PSC)
   models which constrain political manipulation of the defense budget to
   the electoral cycle. An empirical model is tested using pooled
   time-series analysis which allows us to assess variation within
   administrations. The analysis reveals that presidential approval, war,
   presidential reelection, and unemployment are determinants of defense
   contracting.},
Publisher = {UNIV UTAH},
Address = {WESTERN POLITICAL QUARTERLY, SALT LAKE CITY, UT 84112 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Derouen, K (Corresponding Author), SW Texas State Univ, San Marcos, TX 78666 USA.
   SW Texas State Univ, San Marcos, TX 78666 USA.
   Univ Wisconsin, Milwaukee, WI 53201 USA.},
DOI = {10.2307/449259},
ISSN = {1065-9129},
Keywords-Plus = {UNITED-STATES; PRESIDENTIAL POPULARITY; ELECTORAL CYCLES;
   PUBLIC-OPINION; MACROECONOMIC POLICY; US USES; ECONOMY; FORCE;
