@article{ WOS:000165065400002,
Author = {Skjeie, H and Siim, B},
Title = {Scandinavian feminist debates on citizenship},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2000},
Volume = {21},
Number = {4},
Pages = {345-360},
Month = {OCT},
Abstract = {The Scandinavian notion of citizenship is based upon a strong
   participatory tradition. A broad notion of democracy includes not only
   formal political institutions but also the activities of social
   movements and voluntary associations in civil society. In social
   democratic citizenship, tension thus persists between traditions of
   governance where consensus-building is mediated through centralized
   corporate negotiations between major economic organizations, and an
   egalitarian, participatory tradition based on movement activism.},
