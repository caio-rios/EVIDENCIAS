@article{ WOS:000088566400008,
Author = {Hagopian, F},
Title = {Political development, revisited},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2000},
Volume = {33},
Number = {6-7},
Pages = {880-911},
Month = {AUG-SEP},
Abstract = {This article reviews four decades of scholarship on political
   development. It contends that the theoretical ambitions of the early
   political development literature to frame the comparative inquiry of
   politics and political change in less developed countries were
   undermined by intellectual challenges to the paradigms of modernization
   and structural functionalism and that the literature's teleological
   dimension was contradicted by real-world events. Nonetheless, in
   subsequent decades, the field made gnat advances in the study of
   political institutions, democratic stability and breakdown, stale
   structures, civil society, and the uneven character of political
   development itself. The article argues that amid manifold evidence of
   plural forms of political development and decay; at the century's end,
   the field should avoid relapses into neomodernization theory and instead
   focus on such issues as state reform, democratic governance, political
   representation and accountability, and the organization of civil
   societies. Such an expansive and fluid research agenda will enable the
   held of political development to generate important theoretical advances
   in comparative politics.},
