@article{ WOS:000088566400005,
Author = {Pierson, P},
Title = {Three worlds of welfare state research},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2000},
Volume = {33},
Number = {6-7},
Pages = {791-821},
Month = {AUG-SEP},
Abstract = {This article reviews three important clusters of recent research on the
   comparative politics of the welfare state. The three clusters focus on
   political economy, gender and social policy, and the investigation of
   long-term developmental processes. The article argues that in each area
   there has been significant progress and that there are increasing
   opportunities for intellectual exchange across these clusters. Research
   in this important empirical subfield of comparative politics has been
   pluralistic and eclectic, both methodologically and theoretically.
   Overall, this stance has yielded substantial benefits.},
