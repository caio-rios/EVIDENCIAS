@article{ WOS:000167237400001,
Author = {Sigelman, L},
Title = {The presentation of self in presidential life: Onstage and backstage
   with Johnson and Nixon},
Journal = {POLITICAL COMMUNICATION},
Year = {2001},
Volume = {18},
Number = {1},
Pages = {1-22},
Month = {JAN-MAR},
Abstract = {This is a dual case study of the strategic use of presidential rhetoric,
   drawing on sociological and social-psychological treatments of
   self-presentation and impression management. Comparison of the
   ``onstage{''} and ``backstage{''} language of Lyndon Johnson and Richard
   Nixon provides an unprecedented opportunity to analyze presidential
   impression management strategies. The primary question posed here is the
   extent to which the tendency to engage in impression management is
   observable in the two presidents' major public appearances. The
   secondary questions are whether the two presidents pursued different
   self-presentation strategies, projecting positive but distinctive
   personas, or converged toward a common presidential profile and the
   extent to which their distinctive personalities came through in their
   private conversations. On the three dimensions examined here, the
   onstage Johnson and Nixon projected more ``presidential{''} personas
   than their backstage counterparts. Backstage, their personas differed
   considerably. Onstage, they appeared very similar.},
