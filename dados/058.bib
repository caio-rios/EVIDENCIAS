@article{ WOS:000088234000003,
Author = {Marks, G and Wilson, CJ},
Title = {The past in the present: A cleavage theory of party response to European
   integration},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2000},
Volume = {30},
Number = {3},
Pages = {433-459},
Month = {JUL},
Abstract = {This article explains the positions taken by national political parties
   on the issue of European integration over the period 1984-96. Based on
   the theory of party systems developed by Lipset and Rokkan, we develop a
   cleavage account of party response to new political issues. We
   hypothesize that European integration is assimilated into pre-existing
   ideologies of party leaders, activists and constituencies that reflect
   long-standing commitments on fundamental domestic issues.},
