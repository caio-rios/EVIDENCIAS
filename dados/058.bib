@article{ WOS:000166933700005,
Author = {Jelin, E},
Title = {Cultural movements and social actors in the new regional scenarios: The
   case of Mercosur},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2001},
Volume = {22},
Number = {1},
Pages = {85-98},
Month = {JAN},
Abstract = {This article focuses on societal and cultural transformations that take
   plate in the context of the process of regional integration in the case
   of Mercosur, and asks how these policies affect societal actors and
   movements as the policies of economic integration are advanced by
   governments and powerful economic actors front above. Rather than
   assuming a linear process of societal integration, the article explores
   how the Mercosur process is becoming a new framework for societal
   activities, implying a multiplication of international exchanges and
   contacts. Its analysis of the experience of border areas and of social
   movements suggests that the ongoing societal processes do not
   necessarily imply cooperation and integration. Often, new conflicts
   emerge, and the results may lead to strengthening, rather than to
   weakening, nationalisms.},
