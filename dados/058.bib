@article{ WOS:000088809500010,
Author = {Licari, MJ and Meier, KJ},
Title = {Regulation and signaling: When a tax is not just a tax},
Journal = {JOURNAL OF POLITICS},
Year = {2000},
Volume = {62},
Number = {3},
Pages = {875-885},
Month = {AUG},
Abstract = {Excise taxes are popular as regulatory policy. This popularity stems in
   part from their simple disincentive mechanism: higher prices mean less
   consumption of the regulated item. The size of the disincentive,
   however, may not be the whole story since governments rarely regulate
   without sending signals about why the regulation is necessary. This
   paper integrates signaling into a model designed to test the
   effectiveness of regulatory policies. By focusing on how signaling can
   he used in conjunction with more traditional policy analysis models, we
   offer a more complete understanding of regulation.},
