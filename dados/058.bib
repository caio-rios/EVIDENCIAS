Volume = {20},
Number = {1},
Pages = {1-12},
Month = {JAN},
Abstract = {The politics of the discipline of geography contains an unacceptable
   measure of hate, reflected in the antagonisms that I have experienced,
   and in the more serious attacks endured by others. Hate is situated most
