@article{ WOS:000168404800006,
Author = {Semetko, HA and de Vreese, CH and Peter, J},
Title = {Europeanised politics - Europeanised media? European integration and
   political communication},
Journal = {WEST EUROPEAN POLITICS},
Year = {2000},
Volume = {23},
Number = {4},
Pages = {121+},
Month = {OCT},
Abstract = {A comprehensive framework for analysis of the impact of European
   integration on political communication needs to take account of
   developments in four areas: media and political systems, media and
   political organisations, media content and potential effects, and media
   audiences and audience characteristics. In this study, the focus is,
   first, on changes in media systems, and, second, on media organisations
   and journalists' role orientations. Third, what is known about news
   concerning `Europe' is summarised and the impact of `Europeanisation' on
   news content discussed. The authors identify the conceptual, theoretical
   and empirical challenges facing students and scholars of political
   communication in understanding the impact of European integration in
   member states. It is argued that it is important to consider both the
   historical, institutional and media system contexts and patterns in news
   content. The discussion concludes by proposing new avenues for research
   on the link between media coverage of politics and potential effects on
   audiences.},
