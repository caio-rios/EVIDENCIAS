@article{ WOS:000166901900001,
Author = {Neustadt, RE},
Title = {The weakening White House},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2001},
Volume = {31},
Number = {1},
Pages = {1-11},
Month = {JAN},
Note = {Conference on Modeling Politics, WASHIINGTON UNIV, ST LOUIS, MISSOURI,
   1998},
Abstract = {The US presidency has been progressively weakened over the past three
   decades - to the point where it is probably weaker today than at almost
   any time in the preceding century. The formal powers of the office have
   been trimmed. Congress, in the absence of Cold War and domestic
   emergency, has reasserted itself on all scores. The modern revolution in
   communications has diminished the President's ability to convey his
   message to his people. Not least, the White House is grossly
   overstaffed. As a result of these developments, the presidency more
   resembles Franklin D. Roosevelt's second term, in its worst months, than
   either his first term or his third, and is weaker than were those of any
   of his Cold War successors.},
Publisher = {CAMBRIDGE UNIV PRESS},
