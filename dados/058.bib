@article{ WOS:000089917800005,
Author = {Nakano, K},
Title = {The role of ideology and elite networks in the decentralisation reforms
   in 1980s France},
Journal = {WEST EUROPEAN POLITICS},
Year = {2000},
Volume = {23},
Number = {3},
Pages = {97-114},
Month = {JUL},
Note = {Meeting of the
   Northeast-Political-Science-Association/International-Studies-Associatio
   n, BOSTON, MASSACHUSETTS, NOV 12-14, 1998},
Organization = {NE Polit Sci Assoc; Int Studies Assoc},
Abstract = {France saw historic decentralisation reforms under the leadership of
   Mitterrand and Defferre, his first Minister of the Interior in the
   1980s. This article highlights the role played by ideology and elite
   networks in the reform process. Ideological renewal determined the broad
   direction of policy change towards decentralisation, and placed the
   decentralist cause at the heart of the legislative programme of the
   incoming Socialist government. Yet it was the networks that linked the
   political, administrative and local elites, more than ideology, that
   shaped and constrained the details of the actual reform outcomes.},
