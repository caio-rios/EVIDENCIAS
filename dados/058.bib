@article{ WOS:000167970000005,
Author = {Baxandall, P},
Title = {When is unemployment politically important? Explaining differences in
   political salience across European countries},
Journal = {WEST EUROPEAN POLITICS},
Year = {2001},
Volume = {24},
Number = {1},
Pages = {75-98},
Month = {JAN},
Abstract = {This article explores alternative hypotheses for variation in the
   political salience of unemployment. The differences between the
   political opinions of employed and unemployed people are used as a proxy
   for the qualitative importance of unemployment. Unemployment is not
   found to be more politically salient when government support of the
   unemployed is more generous or when jobless spells are shorter: Far more
   important is the character of employment. Unemployment is more
   politically salient in countries where employment guarantees a basic
   livelihood. The darn also suggest that unemployment has greater salience
   in countries where the unemployment are more likely to use stare
   employment exchanges in searching for work. Two conclusions al-e
   suggested. First, public toleration of high unemployment in recent
   decades may be partly the result of the rise of atypical work
   arrangements. Second, while it is debatable whether social-democratic
   protections of employment standards increase unemployment rates, such
   efforts may inadvertently increase the political costs of high
   unemployment.},
