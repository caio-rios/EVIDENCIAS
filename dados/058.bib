@article{ WOS:000087697000012,
Author = {Molinari, MC},
Title = {Military capabilities and escalation: A correction to Bueno de Mesquita,
   Morrow, and Zorick},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2000},
Volume = {94},
Number = {2},
Pages = {425-427},
Month = {JUN},
Abstract = {Bueno de Mesquita, Morrow, and Zorick analyte the evolution of crises as
   a two-sided incomplete information game in order to illuminate the
   relationship between observable military capabilities and the escalation
   of a dispute to armed conflict. I show that an error in the derivation
   of the equilibria invalidates their conclusions, and I offer a few
   suggestions on how to model the evolution of crises as incomplete
   information games.},
