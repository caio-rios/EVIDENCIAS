@article{ WOS:000089650700001,
Author = {Duch, RM and Palmer, HD and Anderson, CJ},
Title = {Heterogeneity in perceptions of national economic conditions},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2000},
Volume = {44},
Number = {4},
Pages = {635-652},
Month = {OCT},
Abstract = {Empirical findings concerning economic voting differ according to the
   level of analysis employed. A widely accepted explanation for the
   inconsistency between macro- and micro-level evidence of economic voting
   is the high degree of random variation that plagues survey data.
   According to this explanation, aggregation purges individual-level
   ``noise{''} from mass opinions on policy issues and outcomes. Building
   on the research of Bartels (1996), we debate the validity of this
   explanation by demonstrating that public evaluations by demonstrating
   that public evaluations of the national economy vary systematically with
   information, media exposure, political attitudes, personal experiences
   and demographic characteristics. Furthermore, we show that these sources
   of subjective heterogeneity produce systematic biases when national
   economic evaluations are aggregted. This findings challenge a widely
   accepted notion that because ``error{''} in individual-level measures
   (or expressions) of preferences is random, the aggregation of these
   individual measures ensures that they correctly represent the collective
   preference.},
