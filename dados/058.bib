@article{ WOS:000089272000003,
Author = {Hart, RA},
Title = {Democracy and the successful use of economic sanctions},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2000},
Volume = {53},
Number = {2},
Pages = {267-284},
Month = {JUN},
Abstract = {Most analysts argue that economic sanctions are a relatively poor policy
   tool. In this article I build on a theoretical framework which has the
   leaders of states being primarily interested in retaining office
   domestically. Because of this, leaders of some stales (i.e.,
   democracies) can effectively tie their hands internationally by using
   aggressive foreign policy actions. I argue that democracies should be,
   on average, more successful when using economic sanctions because of the
   signaling properties of sanctions. This hypothesis is tested using
   ordered probit analysis of 81 bilateral sanctions episodes from 1914 to
   1989. The hypothesis is confirmed even when controlling for the known
   correlates of sanctions success and other potentially confounding
   factors (relative power, f. ex.). This finding suggests that we can
   expand our theoretical expectations on the links between domestic
   politics and international relations.},
