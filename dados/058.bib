@article{ WOS:000167970000004,
Author = {Josselin, D},
Title = {Trade unions for EMU: Sectoral preferences and political opportunities},
Journal = {WEST EUROPEAN POLITICS},
Year = {2001},
Volume = {24},
Number = {1},
Pages = {55-74},
Month = {JAN},
Abstract = {Surveys conducted on the political economy of Europe's Economics and
   Monetary Union have seldom considered the response of domestic interest
   groups, notably trade unions. This article contrasts and explains the
   positions on EMU adopted by major British, French and German trade
   unions, in the process reassessing the so-called interest by the
   intervention of ideological and institutional factors. On a substantive
   level, unions turned out to be broadly supportive of what many had
   labelled a `monetarist' project. If, as it is often argued, social and
   political cohesion is needed for monetary union to endure, this
   represents an important development.},
