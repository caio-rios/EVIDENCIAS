@article{ WOS:001104382700001,
Author = {Vandenberghe, Maxime},
Title = {Pacification through decentralization: An explanatory analysis of
   ethno-territorial cabinet conflict in Belgium (1979-2006)},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2023},
Volume = {29},
Number = {4},
Pages = {443-464},
Month = {DEC},
Abstract = {The impact of decentralization on ethno-territorial conflict is widely
   debated, but empirical analyses of ethno-territorial party politics are
   scarce. This paper uses novel data on conflicts in power-sharing
   cabinets to explore the relation between decentralization and
   ethno-territorial conflicts in the case of Belgium (1979-2006). These
   data are analysed with the help of poisson and logistic regressions,
   which confirm the negative association between decentralization and
   conflict. In addition to institutions, the analyses also examine the
   relevance of issue saliency, regionalist parties' strength, regionalist
   cabinet participation, and the proximity of elections. The results
   contradict the paradox of federalism and add to contemporary debates on
   ethno-territorial politics, conflict management, and power-sharing.
   L'impact de la decentralisation sur les conflits ethno-territoriaux est
   largement debattu, mais les analyses empiriques du jeu politique en
   matiere ethno-territoriale sont rares. Cet article utilise des donnees
   originales sur les conflits dans les gouvernements de coalition pour
   explorer la relation entre la decentralisation et les conflits
   ethno-territoriaux dans le cas de la Belgique (1979-2006). Ces donnees
   sont analysees a l'aide de regressions de Poisson et de regressions
   logistiques, qui confirment l'association negative entre la
   decentralisation et les conflits. Outre les institutions, les analyses
   examinent egalement la pertinence de l'importance des enjeux, de la
   force des partis regionalistes, de la participation des regionalistes
   dans les cabinets et de la proximite des elections. Les resultats
   contredisent le paradoxe du federalisme et alimentent les debats
   contemporains sur les politiques ethno-territoriales, la gestion des
   conflits et le partage du pouvoir.
   Die Auswirkungen der Dezentralisierung auf ethno-territoriale Konflikte
   sind weithin umstritten, aber empirische Analysen ethno-territorialer
   Parteipolitik sind rar. Dieser Beitrag verwendet neue Daten zu
   Konflikten in Koalitionsregierungen, um den Zusammenhang zwischen
   Dezentralisierung und ethno-territorialen Konflikten im Fall von Belgien
   (1979-2006) zu untersuchen. Diese Daten werden mit Hilfe von Poisson-
   und logistischen Regressionen analysiert, die den negativen Zusammenhang
   zwischen Dezentralisierung und Konflikten bestatigen. Neben den
   Institutionen wird auch die Relevanz der Themensensibilitat, der Starke
   der regionalistischen Parteien, ihrer Kabinettsbeteiligung und der Nahe
   von Wahlen untersucht. Die Ergebnisse widerlegen das Paradoxon des
   Foderalismus und tragen zu den aktuellen Debatten uber
   ethno-territoriale Politik, Konfliktmanagement und Machtteilung bei.
   Sebbene l'impatto del decentramento sui conflitti etno-territoriali sia
   ampiamente dibattuto, le analisi empiriche sui partiti etno-territoriali
   sono ancora scarse. Utilizzando dati inediti sui conflitti negli
   esecutivi di power sharing, il presente articolo esplora la relazione
   fra decentramento e conflitti etno-territoriali nel caso del Belgio
   (1979-2006). L'analisi dei dati si basa su modelli di regressione
   logistica e di Poisson, che confermano la correlazione negativa fra
   decentramento e conflitto. Oltre alle istituzioni, le analisi
   considerano anche il ruolo della issue saliency, la forza dei partiti
   regionalisti, la loro partecipazione al governo, e la vicinanza alla
   data delle elezioni. I risultati contraddicono il paradosso del
   federalismo e contribuiscono agli attuali dibattiti sulla politica
   etno-territoriale, sulla gestione dei conflitti e sul power sharing.},
