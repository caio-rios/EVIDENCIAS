   Emmenegger, Patrick; Thoma, Andreina, Univ St Gallen, Dept Polit Sci, St Gallen, Switzerland.
   Walter, Andre, Univ Zurich, Dept Polit Sci, Zurich, Switzerland.},
DOI = {10.1017/S0007123423000297},
