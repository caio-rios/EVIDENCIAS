Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Maier, F (Corresponding Author), Univ Stuttgart, Inst Social Sci, Stuttgart, Germany.
   Maier, Franziska; Baechtiger, Andre, Univ Stuttgart, Inst Social Sci, Stuttgart, Germany.},
DOI = {10.1111/1475-6765.12629},
