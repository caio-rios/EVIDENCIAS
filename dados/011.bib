@article{ WOS:001095147000001,
Author = {Yu, Branda Yee-Man and Lam, Calvin and Chan, Christian S.},
Title = {All we need is love? Irreconcilable political incongruence in families
   after the 2019 social unrest in Hong Kong},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2024},
Volume = {45},
Number = {3},
Pages = {643-665},
Month = {JUN},
Abstract = {Political disagreement with family members can have a deleterious impact
   on familial relationships, but the long-term consequences are
   understudied. This study examined the relational outcomes of familial
   political incongruence two years after the 2019 social unrest in Hong
   Kong and the extent to which frequency and types of family contact
   explain their association. This two-wave questionnaire study augmented
   with a 14-day daily record of family contact recruited (1) young adults
   and (2) parents with children aged 18-30 (N = 559). Nearly half of the
   respondents reported significant political incongruence with their
   parents/children. We observed consistent findings in both adult children
   and parents. Greater parent-child political differences were associated
   with reduced likelihood of having positive family communication and
   family functioning. Increased political differences with family members
   were associated with greater odds of family dysfunctionality. Moreover,
   expression of love and care mediated the effect of political differences
   with family members on changes in family functioning. This study
   demonstrates familial political incongruence exerts an influence on
   families two years after the unrest. Parent-child political differences
   are associated with a decline in the quality of family communication and
   family environment. We discuss how parent-child political incongruence
   drives a family to worsened well-being through dysfunctional family
   dynamics.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Chan, CS (Corresponding Author), Univ Hong Kong, Dept Psychol, Hong Kong, Peoples R China.
   Yu, Branda Yee-Man; Lam, Calvin; Chan, Christian S., Univ Hong Kong, Dept Psychol, Hong Kong, Peoples R China.
   Chan, Christian S., Int Christian Univ, Dept Psychol \& Linguist, Tokyo, Japan.},
DOI = {10.1111/pops.12941},
EarlyAccessDate = {NOV 2023},
ISSN = {0162-895X},
EISSN = {1467-9221},
Keywords = {affective polarization; family well-being; parent-child relationship;
   political incongruence},
Keywords-Plus = {CHINESE; RESPONSIBILITY; CONSEQUENCES; PARTISANSHIP; ADOLESCENTS;
