@article{ WOS:000251250500005,
Author = {Spirova, Maria},
Title = {Bulgaria},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2007},
Volume = {46},
Number = {7-8},
Pages = {901-908},
Month = {DEC},
Abstract = {Bulgarian political life in 2006 was dominated by two major events: the
   scheduled entry of Bulgaria into the European Union (EU) on 1 January
   2007 and the presidential elections of October 2006. The EU accession,
   however, was by far the more important one as the specifics of the
   Bulgarian entry remained unclear almost until the very end of the year.
   The regular reports of the EU Commission on the readiness of Bulgaria to
   join as scheduled were the major sources of anxiety for the Stanishev
   Government. However, in the context of an oversized majority in
   parliament, a fragmented opposition and an overarching goal of EU entry,
   the Government managed to remain intact and experienced no politically
   motivated reshuffles: the only change came as a result of the
   appointment of one minister as European Commissioner in December 2006.},
