@article{ WOS:000257857400004,
Author = {Brusattin, Lorenzo},
Title = {Late anti-communism as a shortcut: The success of Forza Italia in the
   1994 Italian election},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2007},
Volume = {12},
Number = {4},
Pages = {481-499},
Month = {DEC},
Abstract = {The article undertakes an analysis of Forza Italia's success in the 1994
   Italian election. While drawing from the insights of political
   psychology, it puts forward an explanatory hypothesis based both on the
   historical legacy of the strong polarization of the Italian electorate
   and on the use of anti-communism as a cognitive shortcut by relatively
   uninformed voters. The hypothesis, which is supported by the data,
   offers new insight into the consequences of the lack of sophistication
   in the electorate, and lends substance to some scepticism about the
   remedial effect of heuristic reasoning on poor political knowledge.},
