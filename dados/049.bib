Volume = {26},
Number = {7},
Pages = {804-823},
Month = {SEP},
Abstract = {In this spatial statistical analysis, Hungary, though a small country in
   size (smaller than most states in the USA), is shown as having
   significant spatial clustering. On the basis of this spatial clustering,
   it is demonstrated that a political party, FIDESZ that had previously
   been associated with a different political bloc has been able, in a
   relatively short period of time of the 1990s in the post-Communist
   period, to occupy the vacant space on the `right' and to integrate with
   the voters of the right-wing bloc. (C) 2007 Elsevier Ltd. All rights
