@article{ WOS:000249923300010,
Author = {Konisky, David M.},
Title = {Regulatory competition and environmental enforcement: Is there a race to
   the bottom?},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2007},
Volume = {51},
Number = {4},
Pages = {853-872},
Month = {OCT},
Note = {63rd Annual Meeting of the Midwest-Political-Science-Association,
   Chicago, IL, APR 07-10, 2005},
Organization = {Midwest Polit Sci Assoc},
Abstract = {This article examines several of the key hypotheses suggested by the
   race to the bottom theory in environmental regulation. The research
   studies annual state-level enforcement of federal air, water, and
   hazardous waste pollution control regulation, covering the period from
   1985 to 2000. Specifically, the study estimates a series of strategic
   interaction models to examine whether a state's environmental regulatory
   behavior is influenced by the regulatory behavior of the states with
   which it competes for economic investment. While there is clear evidence
   of strategic interaction in state environmental regulatory behavior,
   states do not respond in the asymmetric manner suggested by the race to
   the bottom theory.},
