@article{ WOS:000257857200005,
Author = {Lago, Ignacio and Montero, Jose Ramon and Torcal, Mariano},
Title = {The 2006 regional election in Catalonia: Exit, voice, and electoral
   market failures},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2007},
Volume = {12},
Number = {2},
Pages = {221-235},
Month = {JUN},
Abstract = {This paper analyses the results of the 2006 autonomous election in
   Catalonia and their implications for Spanish politics. In accordance
   with the analytical framework provided by Hirschman (Exit, Voice, and
   Loyalty, Harvard University Press, 1970), and using individual and
   aggregated data, we show that demands shared by a significant number of
   voters were unsatisfied in this election, provoking an electoral market
   failure and a consequential rise of exit (or abstention) and voice (or
   blank and null votes and voting for new parties). All these behaviours
   are symptoms of both an increasing level of political discontent and a
   lack of political integration due to a divergence between issues salient
   to Catalans and the dominant focus of party platforms and agendas.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
