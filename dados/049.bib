@article{ WOS:000246521300005,
Author = {Mockabee, Stephen T.},
Title = {A question of authority: Religion and cultural conflict in the 2004
   election},
Journal = {POLITICAL BEHAVIOR},
Year = {2007},
Volume = {29},
Number = {2},
Pages = {221-248},
Month = {JUN},
Note = {Conference on the Wartime Election of 2004, Ohio State Univ, Columbus,
   OH, JAN 12-15, 2006},
Abstract = {In this study I adopt a view of cultural conflict that extends beyond
   the usual set of controversial ``moral{''} issues like abortion and gay
   rights to include symbolic issues related to patriotism and group
   affect. Using a set of survey items asking about respondents'
   preferences in child-rearing, I create a measure of individuals'
   orientations toward authority that proves to be a potent predictor of
   attitudes on cultural issues, affect toward social groups, party
   identification, and vote choice. This authority effect persists even in
   the presence of extensive multivariate controls for demographic and
   religious variables. I find that both authority measures and religion
   measures shape political attitudes, suggesting the need for a
   multi-faceted approach to understanding cultural conflict.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
