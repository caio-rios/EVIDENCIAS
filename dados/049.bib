@article{ WOS:000250481600003,
Author = {Jamal, Amaney},
Title = {When is social trust a desirable outcome?: Examining levels of trust in
   the Arab world},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2007},
Volume = {40},
Number = {11},
Pages = {1328-1349},
Month = {NOV},
Abstract = {Levels of both political and social trust tend to play a crucial role in
   democracies. Yet we have little understanding of the ways in which trust
   operates in nondemocratic societies. This article finds that levels of
   political confidence are linked to generalized trust in both democratic
   and nondemocratic states. In democracies, then, levels of generalized
   trust may reinforce existing democratic institutions. In nondemocracies,
   however, generalized trust may be linked to support for authoritarian
   patterns of rule. This article argues that although generalized trust
   serves democracy in democratic settings, it is not linked to democratic
   forms of political and social engagement in the less democratic states
   of the Arab world.},
