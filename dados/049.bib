@article{ WOS:000260412300007,
Author = {Pace, Roderick},
Title = {Malta's 2008 Election: A Vote for Continuity and Change},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2008},
Volume = {13},
Number = {3},
Pages = {377-390},
Abstract = {The 2008 Malta election confirmed the Nationalist Party in power for a
   third consecutive term, but with a much reduced majority. It also
   instigated a change of leadership in the opposition Malta Labour Party
   and the subsequent election of a new leader from amongst the ranks of
   its MEPs. Unlike national elections in most other EU member states, EU
   membership featured very strongly in this election but in a peculiarly
   different way than it did in previous ones. Voter participation at
   92.5\% was below the 2003 rate of 95.96\% and 1.32\% less than the
   1966-2008 average.},
