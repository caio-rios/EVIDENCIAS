   Univ Lille 2, F-59800 Lille, France.
   Stanford Univ, Stanford, CA 94305 USA.},
DOI = {10.1080/01402380701617449},
ISSN = {0140-2382},
Keywords-Plus = {FRANKLIN THESIS},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {laurence.morel@eui.eu},
Affiliations = {Universite de Lille; Stanford University},
