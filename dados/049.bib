@article{ WOS:000257857200003,
Author = {Pasotti, Eleonora},
Title = {Institutional overshooting in Italian urban politics},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2007},
Volume = {12},
Number = {2},
Pages = {183-201},
Month = {JUN},
Abstract = {The introduction of direct mayoral elections in Italy altered the
   balance of power between political parties and their local candidates.
   Previously powerless mayors suddenly began to challenge the centre.
   However, they ultimately overestimated the extent of their newfound
   autonomy. The paper presents macro- and micro-level analysis of the
   `mayors' movement' that emerged, tracing the effects of the
   `institutional overshooting' and the readjustment to party power. Both
   aggregate accounts and individual career paths show a resulting
   equilibrium, in which personalism has increased, but in less radical
   ways than believed in the period after the reform.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
