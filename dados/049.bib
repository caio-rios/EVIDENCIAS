@article{ WOS:000247608300009,
Author = {Brooks, Sarah M.},
Title = {When does diffusion matter? Explaining the spread of structural pension
   reforms across nations},
Journal = {JOURNAL OF POLITICS},
Year = {2007},
Volume = {69},
Number = {3},
Pages = {701-715},
Month = {AUG},
Note = {157th Annual Meeting of the American-Psychiatric-Association, New York,
   NY, MAY 01-06, 2004},
Organization = {Amer Psychiat Assoc},
Abstract = {When and where is cross-national diffusion an important determinant of
   policy innovation? I posit that the characteristics of a policy
   innovation-whether it imposes high or low ``sunk{''} costs on
   adopters-and country attributes such as wealth, mediate the importance
   of diffusion in domestic policy choices. Competing risks analysis of two
   structural pension reform models in 71 developing and industrialized
   countries supports these hypotheses. Peer diffusion weighs heavily in
   the adoption of the costly ``funded{''} defined-contribution pension
   reform model, and does so principally among middle-income nations, while
   the less-costly ``notional{''} defined-contribution pension reform is
   not governed by diffusion.},
