@article{ WOS:000249229200004,
Author = {Elguen, Oezlem and Tillman, Erik R.},
Title = {Exposure to European Union policies and support for membership in the
   candidate countries},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2007},
Volume = {60},
Number = {3},
Pages = {391-400},
Month = {SEP},
Abstract = {This article examines the relative merits of competing explanations of
   public support for European Union membership in thirteen Central and
   Eastern European candidate countries. While noneconomic
   factors-attitudes toward domestic politics and feelings of social
   identity-have a consistently strong effect, the impact of human capital
   is contingent on exposure to the distributive consequences of European
   integration. The results of an ordered logit analysis of Candidate
   Country Eurobarometer data are consistent with these predictions. These
   results suggest a revision of theories of EU support to account for the
   role of exposure to the consequences of integration in shaping
   utilitarian judgments.},
