@article{ WOS:000248598200001,
Author = {Allern, Elin Haugsgjerd and Aylott, Nicholas and Christiansen, Flemming
   Juul},
Title = {Social Democrats and trade unions in Scandinavia: The decline and
   persistence of institutional relationships},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2007},
Volume = {46},
Number = {5},
Pages = {607-635},
Month = {AUG},
Abstract = {This article examines the institutional arrangements between Social
   Democratic parties and trade unions in Denmark, Norway and Sweden.
   First, the authors show how these relations have weakened at a varying
   pace. Party-union ties are now quite distant in Denmark, but remain
   relatively close in Norway and, especially, Sweden. Second, the authors
   explore this variation using a simple model of political exchange. The
   finding is that the intensity of the relationship is correlated with the
   resources that each side can derive from the other, which in turn
   reflects national differences. Yet it is also clear that the degree of
   change is related to the formative phase of the institutional
   arrangement itself: the weaker the ties were from the beginning, the
   more easily they unravel in response to environmental changes.},
Publisher = {WILEY},
