@article{ WOS:000259148000015,
Author = {Monroe, Nathan W. and Robinson, Gregory},
Title = {Do restrictive rules produce nonmedian outcomes? A theory with evidence
   from the 101st-108th Congresses},
Journal = {JOURNAL OF POLITICS},
Year = {2008},
Volume = {70},
Number = {1},
Pages = {217-231},
Month = {JAN},
Note = {Annual Meeting of the American-Political-Science-Association,
   Philadelphia, PA, AUG 31-SEP 03, 2006},
Organization = {Amer Polit Sci Assoc},
Abstract = {A fundamental tenet of partisan theories of legislative organization is
   that the majority party is able to generate outcomes that deviate in
   their preferred direction from the chamber median. While these biased
   outcomes may be achieved through arm twisting on final passage votes,
   there is a more efficient means for achieving this bias: restrictive
   rules. While scholars have recognized this tactic as an important
   leadership tool in the House, its effectiveness has been often assumed
   but never empirically tested. We develop a theoretical model that
   demonstrates how the majority party can use restrictive rules to offer
   successful ``take-it-or-leave-it'' proposals to the floor median. More
   significantly, we test this model using DW-NOMINATE's estimated cut
   points of final passage roll calls in the House from the 101(st) to
   108(th) Congress. Our results support the prediction of our model and
   suggest that majority party leaders achieve biased policy outcomes
   through the use of restrictive rules.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
