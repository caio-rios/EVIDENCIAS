@article{ WOS:000257857200002,
Author = {Izcara Palacios, Simon Pedro},
Title = {Welfare benefits and social exclusion in southern Spain},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2007},
Volume = {12},
Number = {2},
Pages = {165-182},
Month = {JUN},
Abstract = {In much of rural Spain, historically inequitable land ownership patterns
   and more recent processes of economic restructuring have led to the
   impoverishment of many rural communities. As a result, social welfare
   policies have been designed to sustain the livelihoods of the most
   vulnerable social groups. Public expenditure has shown some success in
   combating most visible forms of poverty and deprivation. Rural areas
   have seen a significant rise in unemployment over the past two decades
   without associated mass poverty, welfare assistance being the basis of
   agricultural workers' household subsistence. However, government
   payments have also generated other pervasive impacts in rural areas.
   Welfare assistance, far from guaranteeing the social and economic
   integration of the most disadvantaged, has caused an increase in social
   exclusion.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
