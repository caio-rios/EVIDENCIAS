@article{ WOS:000207505800006,
Author = {Sineau, Mariette},
Title = {The French Gender-parity Law and the Parties' Strategies to Circumvent
   It, 2002-07},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2008},
Volume = {14},
Number = {4},
Pages = {741-765},
Abstract = {This article examines the French gender-parity law introduced in 2000
   and the way it was applied by the parties in the 2002 and 2007
   legislative elections. In the light of these two ``cases{''} the study
   tries to assess the impact of this complex law which hardly corresponded
   with the French single-seat constituency system. The analysis seeks to
   identify some of the factors that limited the law's impact and prevented
   the parties from making use of the quota system to improve women's
   representation and, beyond that, to diversify and democratise
   parliamentary recruitment. Finally, the political and sociological
   profile of the female deputies of the ``Generation Parity{''} is
   outlined, focusing on the skills that allowed them to blend in the
   patterns of professional politics.},
