@article{ WOS:000251205300010,
Author = {Daley, Dorothy M. and Haider-Markel, Donald P. and Whitford, Andrew B.},
Title = {Checks, balances, and the cost of regulation},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2007},
Volume = {60},
Number = {4},
Pages = {696-706},
Month = {DEC},
Abstract = {This article examines the relationship between political veto points,
   credible commitments, and regulatory compliance costs. Its central
   purpose is to assess whether different types of political veto points
   credibly constrain regulatory change and thus lower compliance costs.
   The authors conceptualize veto points broadly, including legislative
   oversight, gubernatorial powers, and direct democracy. We analyze
   state-level environmental compliance costs from 1988 to 1994 as a
   function of the structure of state political institutions and state
   political and economic characteristics. The results suggest that a key
   veto point, the authority for legislators to review bureaucratic
   behavior, consistently reduces compliance costs.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
