@article{ WOS:000249229200013,
Author = {Weissert, Carol S. and Halperin, Karen},
Title = {The paradox of term limit support -: To know them is NOT to love
   them},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2007},
Volume = {60},
Number = {3},
Pages = {516-530},
Month = {SEP},
Abstract = {The public has evidenced continuing support for state legislative term
   limits, while those who most closely observe the impacts of term limits
   often support their repeal or extension. This article examines this
   paradox of term limit support among two groups of knowledgeable
   observers-party chairs and lobbyists in Florida. The findings support
   the idea that to know term limits is NOT to love them. They also suggest
   that among these political elites, support for the repeal of term limits
   is not a matter of self-interest, but rather reflects a concern about
   the institutional viability of an important state representative body.},
