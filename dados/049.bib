@article{ WOS:000246338300005,
Author = {Haklai, Oded},
Title = {Religious-nationalist mobilization and state penetration - Lessons from
   Jewish settlers' activism in Israel and the West Bank},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2007},
Volume = {40},
Number = {6},
Pages = {713-739},
Month = {JUN},
Note = {Annual Meeting of the Association-for-Israel-Studies, Banff, CANADA,
   2006},
Organization = {Assoc Israel Studies; Res Grp Natl, Ethnic \& Multcultural Citizenship;
   Queen Univ, Dept Polit Studies},
Abstract = {When will public agencies act in violation of the rules set by the state
   in a strong state? This article demonstrates that when an organized
   religious-nationalist force manages to penetrate the state apparatus, it
   can cause the state to lose some enforcement capacity vis-h-vis the
   penetrating force. The activists, in turn, can use the infiltrated arms
   of the state to realize their preferences, even if the pursuant
   practices contradict state laws. These conclusions are based on research
   conducted on Jewish settlements constructed unlawfully in the West Bank.
   The establishment of these settlements necessitated some collaboration
   from state agencies. Settler activism that included penetration into
   important arms of the bureaucracy is identified as an important
   facilitator of unauthorized settlements. The lessons drawn from the case
   are generalizable and can apply to other types of societal mobilization.},
