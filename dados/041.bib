@article{ WOS:000302237000004,
Author = {Claibourn, Michele P.},
Title = {Hearing Campaign Appeals: The Accountability Implications of
   Presidential Campaign Tone},
Journal = {POLITICAL COMMUNICATION},
Year = {2012},
Volume = {29},
Number = {1},
Pages = {64-85},
Abstract = {Citizen understanding of candidate priorities is highly consequential
   for both elections and postelection accountability and is especially key
   to the office of the presidency. I examine the impact of campaign
   advertising tone on citizen understanding of candidate agendas in the
   context of the 2000 presidential election. Merging data on political ads
   from the Wisconsin Advertising Project with individual survey data, I
   test whether citizens are more likely to accurately hear a positive
   campaign theme. The analysis provides empirical support for this benefit
   of positivity.},
