@article{ WOS:000295730700004,
Author = {Aguilar, Paloma and Balcells, Laia and Cebolla-Boado, Hector},
Title = {Determinants of Attitudes Toward Transitional Justice: An Empirical
   Analysis of the Spanish Case},
Journal = {COMPARATIVE POLITICAL STUDIES},
