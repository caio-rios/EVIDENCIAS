@article{ WOS:000298039900004,
Author = {Cranmer, Mirjam and Petit, Raphael and Sager, Fritz},
Title = {The Argumentative Logic of Tobacco Regulation in Early Modern Bern: A
   Historical Policy Analysis},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2011},
Volume = {17},
Number = {4},
Pages = {432-446},
Month = {DEC},
Abstract = {Analyzing dynamic social phenomena is a major challenge for research.
   This article conducts a feasibility test of a social scientific tool we
   developed based on Dunn (2004). We apply this tool to a corpus of
   historical documents on tobacco policy in the city of Bern generated
   between 1659 and 1723. A longitudinal analysis across time periods of
   argument structure and form shows shifts in the perceived problems,
   causes, and policy measures considered with respect to tobacco, as well
   as their legitimation. The implication is that our method is a viable
