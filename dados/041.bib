@article{ WOS:000301461900001,
Author = {Schiemann, John W.},
Title = {Interrogational Torture: Or How Good Guys Get Bad Information with Ugly
   Methods},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2012},
Volume = {65},
Number = {1},
Pages = {3-19},
Month = {MAR},
Abstract = {Debate about the sources of intelligence leading to bin Laden's location
   has revived the question as to whether interrogational torture is
   effective. Answering this question is a necessary-if not
   sufficient-condition for any justification of interrogational torture.
   Given the impossibility of approaching the question empirically, I
   address it theoretically, asking whether the use of torture to extract
   information satisfies reasonable expectations about reliability of
   information as well as normative constraints on the frequency and
   intensity of torture. I find that although information from
   interrogational torture is unreliable, it is likely to be used
   frequently and harshly.},
