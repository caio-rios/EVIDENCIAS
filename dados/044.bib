@article{ WOS:000278354400002,
Author = {Baker, Dana Lee},
Title = {An Elephant's Eye View of the Mouse: American Impressions of Canadian
   Governance},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2010},
Volume = {31},
Number = {2},
Pages = {129-139},
Month = {MAR},
Abstract = {Canada and the United States share a border with one of the longest
   peaceful existencies in the world. Yet relationships between the two
   countries, while seemingly routine, often lack transparency and mutual
   comprehension. Of particular concern in Canada is a growing impression
   that public discourse in the United States considers Canadian governance
   to be flawed. This article employs the cases of terrorism and SARS to
   examine discourse regarding Canadian public administration in the United
   States press. The results of this analysis not only demonstrate elements
   of the American understanding of Canada but also speak to the role of
   peer nations in domestic policy discourse.},
