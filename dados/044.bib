@article{ WOS:000275004100003,
Author = {Ha, Shang E.},
Title = {The Consequences of Multiracial Contexts on Public Attitudes toward
   Immigration},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2010},
Volume = {63},
Number = {1},
Pages = {29-42},
Month = {MAR},
Abstract = {This study examines how racial contexts relate to Americans' opinion
   toward immigration. Survey data analysis reveals that racial
   surroundings correspond to public attitudes differently, depending on
   race and geographic unit. For non-Hispanic white Americans, proximity to
   Asians correlates with positive attitudes toward immigrants, whereas
   those living with Hispanics are more likely to harbor negative
   stereotypes. Conversely, African Americans living with Asians are more
   likely to be prejudiced against immigrants. Furthermore, the positive
   effects of racial contexts are more salient in the neighborhoods than in
   larger areas. These findings suggest the significance of racial
   integration in alleviating interethnic tension.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Ha, SE (Corresponding Author), Yale Univ, New Haven, CT 06520 USA.
   Yale Univ, New Haven, CT 06520 USA.},
DOI = {10.1177/1065912908325255},
