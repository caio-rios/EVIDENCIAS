Pages = {423-430},
Month = {SEP},
Abstract = {Recent field experiments have demonstrated the powerful effect of social
   pressure messages on voter turnout. This research note considers the
   question of whether these interventions' effects persist over a series
   of subsequent elections. Tracking more than one million voters from six
   experimental studies, we find strong and statistically significant
   enduring effects one and sometimes two years after the initial
   communication.},
