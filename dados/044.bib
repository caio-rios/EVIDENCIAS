@article{ WOS:000276727900013,
Author = {Schwindt-Bayer, Leslie A.},
Title = {Comparison and Integration: A Path toward a Comparative Politics of
   Gender},
Journal = {PERSPECTIVES ON POLITICS},
Year = {2010},
Volume = {8},
Number = {1},
Pages = {177-182},
Month = {MAR},
Note = {Conference on Toward a Comparative Politics of Gender, Case Western
   Reserve Univ, Cleveland, OH, OCT 25-27, 2007},
Abstract = {Moving from a ``gender and comparative politics{''} to a ``comparative
   politics of gender{''} is a challenging proposition. In this essay, I
   offer two mechanisms for doing this-emphasizing the comparative nature
   of gender politics research and encouraging greater integration of
   gender research into the subfield of comparative politics. I illustrate
   how current research generally uses a ``gender and comparative
   politics{''} approach that is insufficient for advancing the field and
   then describe how scholars can work to emphasize greater comparison and
   integration in the literature. This will help to move the gender and
   politics literature toward a comparative politics of gender.},
