@article{ WOS:000278111600017,
Author = {Skaaning, Svend-Erik},
Title = {Measuring the Rule of Law},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2010},
Volume = {63},
Number = {2},
Pages = {449-460},
Month = {JUN},
Note = {Workshop on the Numbers We Use, the World We See held at the Joint
   Sessions of Workshops of the European-Consortium-of-Political-Research,
   Rennes, FRANCE, APR 11-16, 2008},
Organization = {European Consortium Polit Res},
Abstract = {This article offers a comparative review of seven rule of law measures.
   It demonstrates that the measures differ in both form and
   appropriateness and that the differences have consequences for the
   empirical results. The shortcomings are, among others, restrictions in
   scope and availability of disaggregate data, insufficient codebooks, and
   unjustified aggregation procedures. In most cases, the task of
   conceptualization is not grounded in theory, and key principles of the
   rule of law are left out while more inappropriate elements are included.
   These findings suggest that more precaution is required in the
   construction and employment of rule of law measures.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
