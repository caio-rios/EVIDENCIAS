@article{ WOS:001242018700001,
Author = {Wolf, Anne},
Title = {How Erroneous Beliefs Trigger Authoritarian Collapse: The Case of
   Tunisia, January 14, 2011},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2025},
Volume = {58},
Number = {4},
Pages = {816-846},
Month = {MAR},
Abstract = {Why was the longtime Tunisian ruler Zine el-Abidine Ben Ali ousted on
   January 14, 2011? Prevailing theories focus on popular mobilization,
   grievances, and the role of the army to explain the collapse of the
   authoritarian regime. I evaluate these arguments in light of new
   empirical evidence, which shows that they are insufficient to explain
   Ben Ali's ousting. Analyzing key decisional moments and counterfactual
   scenarios, I propose that the regime collapsed because of a set of
   erroneous beliefs, which flourished amid the contingent revolutionary
   context. Erroneous beliefs are endogenous to highly contingent
   revolutionary periods and a potential contingency themselves in that
   they can change collective outcomes. This study shows how the
   microanalysis of events can furnish new insights into highly impactful
   events in history-the collapse of the Ben Ali regime gave rise to the
   wider Arab Uprisings-and topics of key concern to scholars of
   contentious politics, authoritarianism, and democratization.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Wolf, A (Corresponding Author), All Souls Coll, Oxford OX1 2JD, England.
   Wolf, Anne, Univ Oxford, All Souls Coll, Oxford, England.
   Wolf, Anne, All Souls Coll, Oxford OX1 2JD, England.},
DOI = {10.1177/00104140241252101},
EarlyAccessDate = {JUN 2024},
ISSN = {0010-4140},
EISSN = {1552-3829},
Keywords = {Tunisia; Regime collapse; Arab uprising; contingency; democratization;
   erroneous beliefs; belief-formation; revolution; process-tracing},
Keywords-Plus = {REGIME CHANGE; ARAB; REVOLUTIONS; COUNTERFACTUALS; PSYCHOLOGY; UPRISINGS},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {anne-margret.wolf@all-souls.ox.ac.uk},
Affiliations = {University of Oxford; University of Oxford},
ORCID-Numbers = {Wolf, Anne/0000-0003-4060-4004},
Funding-Acknowledgement = {All Souls College, University of Oxford},
Funding-Text = {I am tremendously grateful for the support from All Souls College,
   University of Oxford, for this research. I would also like to thank the
   three anonymous reviewers for their fantastic comments and suggestions.
   Previous versions of the article benefited from the feedback of Stathis
   Kalyvas, Ivan Ermakoff, Charles Kurzman, Raphael Lefevre, Kurt Weyland,
   and George Lawson. I presented earlier versions of this article at a
