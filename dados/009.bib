@article{ WOS:001229089600001,
Author = {Zilinsky, Jan and Theocharis, Yannis and Pradel, Franziska and Tulin,
   Marina and de Vreese, Claes and Aalberg, Toril and Cardenal, Ana Sofia
   and Corbu, Nicoleta and Esser, Frank and Gehle, Luisa and Halagiera,
   Denis and Hameleers, Michael and Hopmann, David Nicolas and
   Koc-Michalska, Karolina and Matthes, Jorg and Schemer, Christian and
   Stetka, Vaclav and Stromback, Jesper and Terren, Ludovic and Splendore,
   Sergio and Stanyer, James and Stepinska, Agnieszka and Van Aelst, Peter
   and Zoizner, Alon},
Title = {Justifying an Invasion: When Is Disinformation Successful?},
Journal = {POLITICAL COMMUNICATION},
Year = {2024},
Volume = {41},
Number = {6},
Pages = {965-986},
Month = {NOV 1},
Abstract = {Conventional wisdom suggests that social media, especially when used by
   authoritarian powers with nefarious aims, leaves citizens of democratic
   countries vulnerable to psychological influence campaigns. But such
   concerns overlook predispositions among recipients of false claims to
   reject (or to endorse) conspiratorial narratives. Analyzing responses
   from a survey fielded in 19 countries, we find that it is a preexisting
   conspiracy outlook at the individual level, more so than media diets,
   which consistently predicts rating Russia's pretenses for the invasion
   as more accurate. In all countries, individuals who view the world in
   general with a conspiratorial mindset are more likely to believe
   war-related disinformation. Receiving news via YouTube, Facebook, or
   TikTok is also associated with greater belief in Russian narratives
   justifying the invasion in several countries, but these relationships
   are weaker compared to those observed for conspiracy thinking. Without
   downplaying a potential positive role for media interventions, the
   findings highlight the importance of a deeper understanding of the
   underlying causes of conspiratorial thinking.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
Type = {Article},
Language = {English},
Affiliation = {Zilinsky, J (Corresponding Author), TUM Sch Social Sci \& Technol, Dept Governance, Richard Wagner Str 1, D-80333 Munich, Germany.
   Zilinsky, Jan; Theocharis, Yannis; Pradel, Franziska, TUM Sch Social Sci \& Technol, Dept Governance, Richard Wagner Str 1, D-80333 Munich, Germany.
   Tulin, Marina, Univ Amsterdam, Fac Social \& Behav Sci, Amsterdam, Netherlands.
   de Vreese, Claes; Hameleers, Michael, Univ Amsterdam, Polit Commun, Amsterdam, Netherlands.
   Van Aelst, Peter, Univ Antwerp, Dept Polit Sci, Antwerp, Belgium.
   Hopmann, David Nicolas, Univ So Denmark, Polit Sci \& Publ Management, Odense, Denmark.
   Corbu, Nicoleta, Fac Commun \& Publ Relat, Scoala Nationala Studii Politice Si Adm, Bucharest, Romania.
