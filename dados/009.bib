@article{ WOS:001206695600001,
Author = {Opitz, Christian},
Title = {Democratic innovations beyond the deliberative paradigm: a
   re-conceptualization based on Luhmann's systems theory},
Journal = {DEMOCRATIZATION},
Year = {2024},
Volume = {31},
Number = {8},
Pages = {1695-1718},
Month = {NOV 16},
Abstract = {The current research on deliberative-participatory democratic
   innovations conducted by state administration agencies exhibits
   empirical eclecticism and is dominated by a deliberative paradigm.
   However, this paradigm tends to conflate normative prescription with
   analytical description. In contrast, this article proposes a
   comprehensive re-conceptualization of such innovations, drawing from
   Niklas Luhmann's systems theory. It outlines the specific problem these
   innovations address (function), how they operate in tackling this
   problem (functioning) and the problems they inevitably raise
   (dysfunctions). In addition, my re-conceptualization retains the
   possibility to critically compare these (and other) experiments
   regarding their capability to address emerging challenges within the
   modern democratic political system.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Opitz, C (Corresponding Author), Univ Fed Armed Forces Hamburg, Helmut Schmidt Univ, Hamburg, Germany.
   Opitz, Christian, Univ Fed Armed Forces Hamburg, Helmut Schmidt Univ, Hamburg, Germany.},
DOI = {10.1080/13510347.2024.2340636},
EarlyAccessDate = {APR 2024},
ISSN = {1351-0347},
