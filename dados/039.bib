@article{ WOS:000315609100003,
Author = {Lim, Elvin T.},
Title = {The Anti-Federalist Strand in Progressive Politics and Political Thought},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2013},
Volume = {66},
Number = {1},
Pages = {32-45},
Month = {MAR},
Abstract = {In this article, the author argues that the Progressives can be as much
   characterized as the antistatists of the nineteenth century as the
   statists of the twentieth century because their overriding goal was the
   destruction of the party state and not, directly, the creation of the
   bureaucratic state. They found in Anti-Federalist political thought a
   general antistatist template that they used to articulate their specific
   objection to the nineteenth-century party state. This template comprised
   a mutual commitment to simple government, the common good as a
   preinstitutional reality, democracy, direct and responsive government,
   fear of elite rule, civic education, and cultural homogeneity.},
