@article{ WOS:000318389400004,
Author = {Peytchev, Andy and Neely, Benjamin},
Title = {RDD TELEPHONE SURVEYS TOWARD A SINGLE-FRAME CELL-PHONE DESIGN},
Journal = {PUBLIC OPINION QUARTERLY},
