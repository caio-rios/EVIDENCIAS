@article{ WOS:000312657500006,
Author = {Cao, Xun and Greenhill, Brian and Prakash, Aseem},
Title = {Where Is the Tipping Point? Bilateral Trade and the Diffusion of Human
   Rights},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2013},
Volume = {43},
Number = {1},
Pages = {133-156},
Month = {JAN},
Abstract = {Drawing on a panel of 136 countries over the period 1982-2004, we study
   a tipping point version of Vogel's `California Effect' in the context of
   the diffusion of human rights practices. Because human rights practices
   are often deeply embedded in a society's customs and political
   institutions, we expect that a high level of pressure from the importing
   countries is needed to bring about changes in an exporting country's
   human rights records. We find strong empirical support for this
   threshold effect; provided that the average level of respect for human
   rights in importing countries is sufficiently high, trading
   relationships can operate as transmission belts for the diffusion of
   human rights practices from importing to exporting countries.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
Type = {Article},
Language = {English},
Affiliation = {Cao, X (Corresponding Author), Penn State Univ, Dept Polit Sci, University Pk, PA 16802 USA.
   Cao, Xun, Penn State Univ, Dept Polit Sci, University Pk, PA 16802 USA.
   Greenhill, Brian, Dartmouth Coll, Dept Govt, Hanover, NH 03755 USA.
