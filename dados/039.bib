@article{ WOS:000331761400015,
Author = {Boix, Carles and Svolik, Milan W.},
Title = {The Foundations of Limited Authoritarian Government: Institutions,
   Commitment, and Power-Sharing in Dictatorships},
Journal = {JOURNAL OF POLITICS},
Year = {2013},
Volume = {75},
Number = {2},
Pages = {300-316},
Month = {APR},
Abstract = {Why do some dictatorships establish institutions that may constrain
   their leaders? We argue that institutions promote the survival of
   dictatorships by facilitating authoritarian power-sharing. Specifically,
   institutions such as parties, legislatures, and advisory councils
   alleviate commitment and monitoring problems between the dictator and
   his allies caused by the secrecy in authoritarian governance. However,
   because authoritarian power-sharing succeeds only when it is backed by a
   credible threat of a rebellion by the dictator's allies, institutions
   will be ineffective or break down when an imbalance of power within the
   ruling coalition undermines this threat's credibility. Our arguments
   clarify the complex interaction between collective action, commitment,
   and monitoring problems in authoritarian governance. We use both
   historical and large-N data to assess new empirical predictions about
   the relationship between political institutions, leader survival, and
   the concentration of power in dictatorships.},
Publisher = {UNIV CHICAGO PRESS},
