@article{ WOS:000325761200003,
Author = {Hogstrom, John},
Title = {Does the Choice of Democracy Measure Matter? Comparisons between the Two
   Leading Democracy Indices, Freedom House and Polity IV},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2013},
Volume = {48},
Number = {2},
Pages = {201-221},
Month = {APR},
Abstract = {This article investigates whether two different measures of democracy
   generate the same empirical results. The Freedom House and Polity IV
   measures are used as the dependent variables. The result shows that
   statistical significance and explanatory power for different independent
   variables differ greatly, depending on which democracy index is used as
   the dependent variable. The results also indicate that Freedom House and
   Polity IV rate many countries' levels of democracy differently. It is
   worrying and problematic for comparative studies of democracy that
   empirical results differ so much according to which measure of democracy
   is used.},
