@article{ WOS:000325760800006,
Author = {Burchard, Stephanie},
Title = {You Have to Know Where to Look in Order to Find It: Competitiveness in
   Botswana's Dominant Party System},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2013},
Volume = {48},
Number = {1},
Pages = {101+},
Month = {JAN},
Abstract = {Dominant party systems are defined by a lack of party alternation at the
   national level; however, dominant party systems do not inherently
   preclude electoral competition at the macro level, the micro level, or
   both. Nonetheless, little systematic work has documented the
   competitiveness of elections under a dominant party system. This article
   describes the nature of competition under one of sub-Saharan Africa's
   most enduring dominant party systems, Botswana. By examining electoral
   outcomes at the constituency level, this article demonstrates that
   elections in Botswana produce significant levels of competition,
   especially when compared to other sub-Saharan countries. Furthermore,
   electoral competitiveness appears unrelated to the party system at
   large: namely, competitiveness is no less or greater under dominant
   party systems than under multiparty systems.},
Publisher = {CAMBRIDGE UNIV PRESS},
