@article{ WOS:000310541300008,
Author = {Vonnahme, Greg},
Title = {Registration Deadlines and Turnout in Context},
Journal = {POLITICAL BEHAVIOR},
Year = {2012},
Volume = {34},
Number = {4},
Pages = {765-779},
Month = {DEC},
Abstract = {This paper analyzes the effect of registration deadlines on voter
   turnout. The theoretical explanation considers how registration
   deadlines affect turnout when individuals influence the participation of
   others. The theoretical model leads to a novel empirical hypothesis,
   that deadlines can have both a direct and indirect effect on turnout
   through a behavioral contagion process. The paper reports empirical
   findings that confirm the theoretical expectations. These results have
   important implications for future research on registration deadlines and
   Election Day registration as the effects of these reforms depend on the
   specific social context in which they are adopted.},
