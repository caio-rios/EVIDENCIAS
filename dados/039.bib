@article{ WOS:000325761200004,
Author = {Gumuscu, Sebnem},
Title = {The Emerging Predominant Party System in Turkey},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2013},
Volume = {48},
Number = {2},
Pages = {223-244},
Month = {APR},
Abstract = {In the Turkish national elections of 12 June 2011 the ruling Adalet ve
   Kalkinma Partisi (AKP, Justice and Development Party) registered an
   exceptional success in Turkish democracy. For the first time, an
   incumbent party had managed to increase its votes for three elections in
   a row and established its predominance. This article argues that the
   AKP, like the Christian Democrats in Italy, Liberal Democrats in Japan
   or Social Democrats in Sweden, has established a cycle of dominance that
   includes initial mobilization, expansion of core support through
   material benefits, delegitimization of the opposition and selective use
   of ideological rigidity and flexibility. It is through this cycle that
   the AKP consolidated its position as a right-wing party, unifying
   centre-right and Islamic constituencies and thereby accomplishing what
   the other right-wing parties in Turkey had failed to do in the past.},
