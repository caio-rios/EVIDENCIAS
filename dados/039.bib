@article{ WOS:000316220900002,
Author = {Dellepiane-Avellaneda, Sebastian},
Title = {Gordon Unbound: The Heresthetic of Central Bank Independence in Britain},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2013},
Volume = {43},
Number = {2},
Pages = {263-293},
Month = {APR},
Abstract = {This article combines theory and narrative to shed new light on the
   politics surrounding the making of central bank independence in
   contemporary Britain. Its central argument is that Gordon Brown's
   rewriting of the British monetary constitution in May 1997 constituted
   political manipulation in a Rikerian sense. The government removed a
   contentious issue from party politics in order to signal competence and
   enforce internal discipline. Building on Elster's constraint theory, the
   paper argues that Brown adopted a pre-commitment strategy aimed at
   binding others. The heresthetic move had dual consequences, both
   constraining and enabling. The institutionalization of discipline
   enabled New Labour to achieve economic and political goals. By
   revisiting the political rationality of precommitment, this article
   questions the dominant credibility story underlying the choice of
   economic institutions.},
