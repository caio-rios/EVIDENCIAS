@article{ WOS:000315224600002,
Author = {Costello, Rory and Thomassen, Jacques and Rosema, Martin},
Title = {European Parliament Elections and Political Representation: Policy
   Congruence between Voters and Parties},
Journal = {WEST EUROPEAN POLITICS},
Year = {2012},
Volume = {35},
Number = {6, SI},
Pages = {1226-1248},
Month = {NOV 1},
Abstract = {It is often said that European Parliament elections fail as an
   instrument to express the will of the European people. However, while
   the elections are not contested at the European level and are often
   dominated by national issues, this does not necessarily imply that they
   fail to connect policy views of voters and representatives. This article
   examines policy congruence between voters and candidates, utilising the
   candidate and voter surveys of the European Election Study 2009. First,
   it demonstrates that policy preferences of candidates and voters are
   constrained by three separate policy dimensions. Second, it shows that
   the quality of representation is high in terms of left/right, the main
   dimension of conflict in European politics, but lower on the cultural
   and European integration dimensions. Finally, it establishes that in
   some cases the aggregation of national parties in political groups in
   the European Parliament poses problems for effective political
   representation.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
