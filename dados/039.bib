Year = {2013},
Volume = {34},
Number = {1},
Pages = {21-38},
Month = {JAN},
Abstract = {This article explores the implications of the World Trade Organization's
   Agreement on Agriculture for the right to food in the global South. In a
   context in which a worldwide backlash has developed against the World
   Trade Organization (WTO), the politics of the Doha Round negotiations
   are analyzed from a food rights perspective. It is argued that since
   2004 attention in the WTO has shifted from overarching human rights
   concerns toward a focus on technical detail constraining developing
   countries from acting to respect, protect, and fulfill the right to
   food.},
