   Campaigns},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2012},
Volume = {76},
Number = {4},
Pages = {783-814},
Month = {WIN},
Abstract = {The degree of psychological engagement in political campaigns is a key
   factor influencing participation in U.S. elections. Unfortunately, no
   resources exist that offer comparable over time survey measures of
   campaign engagement in the electorate. Results from a diverse array of
   U.S. public opinion surveys administered from 1952 through 2010 are used
   to explore trends about interest in elections, attention to campaigns,
   and enthusiasm for the candidates. Trends are examined both over the
   course of a single campaign and across election cycles.},
