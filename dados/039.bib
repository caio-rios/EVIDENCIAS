@article{ WOS:000315609100006,
Author = {Burden, Barry C. and Neiheisel, Jacob R.},
Title = {Election Administration and the Pure Effect of Voter Registration on
   Turnout},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2013},
Volume = {66},
Number = {1},
Pages = {77-90},
Month = {MAR},
Abstract = {Voter registration is thought to have a substantial negative effect on
   American voter turnout. The authors clarify this understanding in two
   ways. First, using a natural experiment in Wisconsin, they estimate the
   pure effect of registration, stripped of aspects such as the closing
   date. Registration lowers turnout by about 2 percentage points. Second,
   the authors argue that administrative capacities of local election
   officials are important moderators of how much registration affects
   turnout. Municipalities with less capacity are associated with bigger
   decreases in turnout. Researchers and policy makers should consider
   administrative capacity as a component in the equal application of
   voting laws.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Burden, BC (Corresponding Author), Univ Wisconsin, Dept Polit Sci, 1050 Bascom Mall,110 North Hall, Madison, WI 53706 USA.
   Burden, Barry C.; Neiheisel, Jacob R., Univ Wisconsin, Madison, WI 53706 USA.},
DOI = {10.1177/1065912911430671},
ISSN = {1065-9129},
Keywords = {voter registration; election law; voter turnout; natural experiment},
Keywords-Plus = {UNITED-STATES; LAWS},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {bcburden@wisc.edu},
