@article{ WOS:000314847200005,
Author = {Federico, Christopher M. and Hunt, Corrie V.},
Title = {Political Information, Political Involvement, and Reliance on Ideology
   in Political Evaluation},
Journal = {POLITICAL BEHAVIOR},
Year = {2013},
Volume = {35},
Number = {1},
Pages = {89-112},
Month = {MAR},
Abstract = {Many studies have focused on the relationship between political
   information and the use of ideology. Here, we argue that two
   ``evaluative motivations{''}aEuro{''}general investment of the self in
   politics and extremity of partisanship-serve as moderators of this
   relationship. Specifically, we use data from two recent national surveys
   to test whether the possession of information is more strongly
   associated with a tendency to approach politics in an ideological
   fashion among individuals high in both types of evaluative motivation.
   Results supported this hypothesis, revealing that information was more
   strongly associated with ideological constraint and with a tendency to
   give polarized evaluations of conservatives and liberals among those who
   highly invest the self in politics and those with more extreme
   partisanship. As such, this study suggests that information and
   involvement interact to shape the use of ideology.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Federico, CM (Corresponding Author), Univ Minnesota, Dept Psychol, 75 E River Rd, Minneapolis, MN 55455 USA.
   Federico, Christopher M., Univ Minnesota, Dept Psychol, Minneapolis, MN 55455 USA.
   Federico, Christopher M., Univ Minnesota, Dept Polit Sci, Minneapolis, MN 55455 USA.
   Hunt, Corrie V., Hart Res Associates, Washington, DC 20009 USA.},
DOI = {10.1007/s11109-011-9184-7},
ISSN = {0190-9320},
EISSN = {1573-6687},
Keywords = {Ideology; Political expertise; Political involvement},
Keywords-Plus = {NEED; IDENTIFICATION; POLARIZATION; MOTIVATION; CONSTRAINT; EXPERTISE;
   THINKING; IMPACT; POLICY; PARTY},
