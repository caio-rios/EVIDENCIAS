@article{ WOS:000264022200003,
Author = {Anthonsen, Mette and Lindvall, Johannes},
Title = {Party Competition and the Resilience of Corporatism},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2009},
Volume = {44},
Number = {2},
Pages = {167-187},
Month = {APR},
Abstract = {This article argues that after the Golden Age of capitalism, corporatist
   methods of policy-making have come to depend on specific modes of party
   competition. In contrast to previous studies of corporatism, which have
   argued that corporatism depends on strong social democratic parties,
   this article suggests that the competition between well-defined
   left-wing and right-wing `blocs' has become detrimental to corporatism.
   In countries with mixed governments or traditions of power-sharing, on
   the other hand, corporatism thrives. These conclusions are based on a
   comparison of four traditionally corporatist countries - Denmark, the
   Netherlands, Sweden and Switzerland - from the early 1970s to the late
   1990s.},
Publisher = {WILEY-BLACKWELL PUBLISHING, INC},
