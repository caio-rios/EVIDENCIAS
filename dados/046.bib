@article{ WOS:000263796600016,
Author = {Whitford, Andrew B. and Wong, Karen},
Title = {Political and Social Foundations for Environmental Sustainability},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2009},
Volume = {62},
Number = {1},
Pages = {190-204},
Month = {MAR},
Abstract = {This article quantitatively investigates several possible foundations
   for environmental sustainability, as measured across countries with
   varying geography, development patterns, social customs, and political
   arrangements. Two central hypotheses about the roles of democracy and
   federalism, as well as other hypotheses about economic development,
   religion, and demographics, are tested. The study provides moderate
   evidence that sustainability levels depend on democratization, but
   little evidence that it depends on the presence of federalism. In
   addition, it is found that the effects of environmental interests,
   development paths, and religious orientations vary across different
   measures of sustainability.},
