@article{ WOS:000264112200007,
Author = {Blais, Andre and Loewen, Peter John},
Title = {The French Electoral System and its Effects},
Journal = {WEST EUROPEAN POLITICS},
Year = {2009},
Volume = {32},
Number = {2},
Pages = {345-359},
Abstract = {The most original feature of the French Fifth Republic is the use of a
   two-round system for both presidential and legislative elections. This
   article considers the effects of this electoral system and its
   development in the first 50 years of the Republic. It distinguishes
   between two types of effects: mechanical and psychological. It reviews
   the theoretical arguments for each and the available evidence. The
   authors first specify a series of vote-seat curves that characterise the
   mechanical effect, paying particular attention to the mediating effects
   of coalitions. They then examine the psychological effect through a
   series of tests on coalition formation. The article concludes by noting
   that much remains to be learned about the electoral system and its
   effects in the French Fifth Republic.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
