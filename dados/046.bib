@article{ WOS:000265959000005,
Author = {Piana, Daniela},
Title = {The Power Knocks at the Courts' Back Door Two Waves of Postcommunist
   Judicial Reforms},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2009},
Volume = {42},
Number = {6},
Pages = {816-840},
Month = {JUN},
Abstract = {In the postcommunist countries' candidate to the European membership,
   the EU and the Council of Europe exercised a heavy pressure on domestic
   elite to promote the adoption of institutional guarantees of judicial
   independence and judicial capacity. Relying on a wide set of interviews
   with the key actors of the European and domestic institutions, this
   article will discuss the logic of action of the judicial reforms adopted
   in Poland, Czech Republic, and Hungary in two policy subfields: the
   governance of the judicial branch and the governance of the court. The
   empirical evidence confirms that the processes of reform have been
   deeply influenced by the national actors who had been empowered during
   the democratic transition. They have been able to fully exploit the
   resources provided by the EU.},
