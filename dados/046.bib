@article{ WOS:000268517900020,
Author = {Zucco, Jr., Cesar},
Title = {Ideology or What? Legislative Behavior in Multiparty Presidential
   Settings},
Journal = {JOURNAL OF POLITICS},
Year = {2009},
Volume = {71},
Number = {3},
Pages = {1076-1092},
Month = {JUL},
Abstract = {In this paper I show that voting patterns of Brazilian legislators
   depart from their ideology in ways that suggest that the president plays
   an important role in influencing their behavior. Moreover, statistical
   analysis indicates that this influence is channeled through the
   distribution of pork and nominations to cabinet positions. Ideology not
   only fails to fully explain the patterns of legislative behavior
   observed since the return to democracy, but there is evidence that
   ideological behavior has declined over time.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
Affiliation = {Zucco, C (Corresponding Author), Inst Univ Pesquisas Rio Janeiro, BR-22260100 Rio De Janeiro, Brazil.
   Inst Univ Pesquisas Rio Janeiro, BR-22260100 Rio De Janeiro, Brazil.},
DOI = {10.1017/S0022381609090896},
ISSN = {0022-3816},
