@article{ WOS:000267439800002,
Author = {Aiyede, Emmanuel Remi},
Title = {The Political Economy of Fiscal Federalism and the Dilemma of
   Constructing a Developmental State in Nigeria},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2009},
Volume = {30},
Number = {3},
Pages = {249-269},
Month = {JUN},
Abstract = {The relationship between federalism and development needs to be
   investigated in the context of values of governance and state-society
   relations, especially citizenship. This helps to uplift the discourse on
   the African state by situating it within the historiography and
   political economy of federalism. This article explores the institutional
   and political foundations of the fundamentally distributive orientation
   of Nigeria's fiscal federal system: the values that underlie governance
   and the character of state-society relations expressed in the
   demarcation of fiscal federalism from citizenship privileges and duties.
   It argues that a fragmented citizenship sustains predatory rule, which
   undermines the developmental content of federalism.},
