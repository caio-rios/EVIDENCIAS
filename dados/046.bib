@article{ WOS:000265583200010,
Author = {Binderkrantz, Anne Skorkjaer},
Title = {Membership Recruitment and Internal Democracy in Interest Groups: Do
   Group-Membership Relations Vary Between Group Types?},
Journal = {WEST EUROPEAN POLITICS},
Year = {2009},
Volume = {32},
Number = {3},
Pages = {657-678},
Abstract = {The article tests the argument that group-membership relations vary
   between public interest groups and other types of groups. While public
   interest groups draw their members from diffuse constituencies
   supporting the causes of the groups, sectional groups exhibit a closer
   correspondence between the interests advanced and the members recruited.
   According to the literature, differences can therefore be expected both
   in the patterns of membership recruitment and in the degree of
   membership influence in groups. The analysis draws on a survey of all
   national interest groups in Denmark. It demonstrates that public
   interest groups differ from other groups in their patterns of membership
   recruitment. However, it finds no tendency for public interest groups to
   be either less or more democratic than the average group.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
