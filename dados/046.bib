@article{ WOS:000267314800005,
Author = {Wittman, Donald},
Title = {Bargaining in the Shadow of War: When Is a Peaceful Resolution Most
   Likely?},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2009},
Volume = {53},
Number = {3},
Pages = {588-602},
Month = {JUL},
Abstract = {This article derives the optimal bargaining strategies of the
   belligerents when each side has private but incomplete information about
   the expected outcome of a war, should it take place. I show that the
   aggressor's demand curve can be below the defender's offer curve, that
   wars are possible even when both sides are jointly pessimistic, and that
   the relative cost of a war can radically alter the types of disputes
   that end in war. A simple diagram provides the intuition for most of the
   major propositions.},
