@article{ WOS:000267712700002,
Author = {Lau, Richard R. and Heldman, Caroline},
Title = {Self-Interest, Symbolic Attitudes, and Support for Public Policy: A
   Multilevel Analysis},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2009},
Volume = {30},
Number = {4},
Pages = {513-537},
Month = {AUG},
Abstract = {This paper examines the role of self-interest and symbolic attitudes as
   predictors of support for two domestic policy issues-guaranteed jobs and
   incomes and national health insurance-in the American National Election
   Survey (ANES) between 1972 and 2004. As was the case in 1976 when Sears,
   Lau, Tyler, and Allen (1980) first explored this topic, symbolic
   attitudes continue to be much more important predictors of policy
   attitudes than various indicators of self-interest over the 30 years we
   analyze. We explore this finding further to determine whether any
   individual/internal and external/contextual variables affect the
   magnitude of self-interest effects on policy support. Five possible
   internal moderators of self-interest effects are examined: (1) political
   knowledge, (2) issue publics, (3) political values, (4) social
   identifications, and (5) emotions, but none are found to boost the
   magnitude of the self-interest effect. However, we do find some evidence
   that contextual variables representing the social/information
   environment moderate the impact of self-interest on public opinion.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
