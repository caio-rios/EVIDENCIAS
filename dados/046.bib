@article{ WOS:000266021100011,
Author = {Barth, Jay and Overby, L. Marvin and Huffmon, Scott H.},
Title = {Community Context, Personal Contact, and Support for an Anti-Gay Rights
   Referendum},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2009},
Volume = {62},
Number = {2},
Pages = {355-365},
Month = {JUN},
Note = {65th Annual Meeting of the Midwest-Political-Science-Association,
   Chicago, IL, APR 12-15, 2007},
Organization = {Midwest Polit Sci Assoc},
Abstract = {Using data from an unusual survey, we gauge factors influencing support
   for a state anti-gay rights referendum. After controlling for other
   powerful predictors of attitudes, we find personal contact (especially
   relevant and voluntary contact) has an important impact on public
   support, although community context does not. These findings support an
   integrated notion of interactions with ``out{''} groups, grounded in
   social categorization theory, that sees community context and
   interpersonal contact as concentric circles, moving from abstract,
   detached forms of contact to more pronounced, personal forms. However,
   even among those with substantial interpersonal contact, support for the
   referendum was still widespread.},
Publisher = {SAGE PUBLICATIONS INC},
