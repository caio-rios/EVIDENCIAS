@article{ WOS:000276727700009,
Author = {Scott, Catherine V.},
Title = {Imagining Terror in an Era of Globalization: US Foreign Policy and the
   Construction of Terrorism after 9/11},
Journal = {PERSPECTIVES ON POLITICS},
Year = {2009},
Volume = {7},
Number = {3},
Pages = {579-590},
Month = {SEP},
Abstract = {Many analyses of U. S. foreign policy after September 11 have rested
   upon readings of the U. S. as a traditional imperialist power. In so
   doing, the constructions of Al Qaeda as a decentralized corporation and
   a virtual network are often ignored. Corporate and network constructions
   place less stress on conventional threats to the nation-state and
   instead portray terrorism in distinctively post-Fordist terms. This in
   turn helps explain the short-lived and partial patriotic responses to
   the terrorist attacks, as well as the contradictory place of race in
   portrayals of the threat facing the U.S. Together these discourses point
   to new ways of thinking about U. S. nationalism and terrorism in the
   twenty-first century.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
Type = {Article},
Language = {English},
Affiliation = {Scott, CV (Corresponding Author), Agnes Scott Coll, Decatur, GA 30030 USA.
   Agnes Scott Coll, Decatur, GA 30030 USA.},
DOI = {10.1017/S1537592709990879},
ISSN = {1537-5927},
EISSN = {1541-0986},
Keywords-Plus = {NATIONALISM},
