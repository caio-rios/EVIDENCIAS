@article{ WOS:000265617400009,
Author = {Maloy, J. S.},
Title = {Two Concepts of Trust},
Journal = {JOURNAL OF POLITICS},
Year = {2009},
Volume = {71},
Number = {2},
Pages = {492-505},
Month = {APR},
Abstract = {Debates around political trust, notwithstanding ostensible
   disagreements, have converged on a conceptualization that is more
   psychological and economic than political. By contrast, classic debates
   in the history of political thought featured an agency-centered approach
   revolving around two concepts of trust, the discretionary and the
   accountable. Exploring the dynamic tension between discretion and
   accountability and restoring the latter to its historic significance for
   democratic theory would remedy some defects of the recent literature on
   trust. In particular, some rational-choice studies, though bearing
   important criticisms of alternative accounts of trust, have settled on
   vague and potentially self-defeating prescriptions for psychologically
   distrusting and institutionally disempowering government.},
Publisher = {UNIV CHICAGO PRESS},
