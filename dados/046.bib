@article{ WOS:000267570700008,
Author = {Azzopardi, Rose Marie},
Title = {Malta's Open Economy: Weathering the Recessional Storm?},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2009},
Volume = {14},
Number = {1},
Pages = {103-120},
Abstract = {The 2008 global financial and economic crises have already led to a
   recessional storm. This article evaluates the exogenous shocks faced by
   Malta, a small and open economy which is highly dependent on external
   trade and investment. It provides an initial analysis of a situation
   that will continue to develop in the coming months. So far, the
   international crises appear to have had a limited effect on the
   financial sector. However, the impact on trade in merchandise goods,
   tourism and foreign direct investment is expected to be more extensive,
   with some visible signs already evident. Supportive public policy
   decisions are needed to manage the economy in these precarious
   circumstances.},
