@article{ WOS:000262040600002,
Author = {Hooghe, Marc and Reeskens, Tim and Stolle, Dietlind and Trappers, Ann},
Title = {Ethnic Diversity and Generalized Trust in Europe A Cross-National
   Multilevel Study},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2009},
Volume = {42},
Number = {2},
Pages = {198-223},
Month = {FEB},
Abstract = {While most current research documents a negative relation between ethnic
   diversity and generalized trust, it has to be acknowledged that these
   results often originate from one-country analyses in North America. In
   this article, attitudinal measurements from the European Social Survey
   are combined with Organization for Economic Co-Operation and Development
   data on migration patterns, thus examining the relationship between
   diversity and trust in a comparative manner across 20 European
   countries. More fine-grained measurements of diversity ( including type
   and rise of diversity over time and legal status of immigrants) are
   included in a multilevel model. At the individual level, most of the
   familiar relations were confirmed. At the country level, hardly any
   indicators for migration or diversity proved to be strongly and
   consistently related to generalized trust. Results suggest that the
   pessimistic conclusions about the negative effects of ethnic diversity
   on generalized trust cannot be confirmed at the aggregate level across
   European countries.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
