@article{ WOS:000266021100016,
Author = {Rocha, Rene R. and Espino, Rodolfo},
Title = {Racial Threat, Residential Segregation, and the Policy Attitudes of
   Anglos},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2009},
Volume = {62},
Number = {2},
Pages = {415-426},
Month = {JUN},
Abstract = {The impact of racial context on the political behavior of Anglos has
   been a focus of social science research for well over half a century. We
   suggest that a shortcoming of earlier work has been the failure to
   account for the levels of segregation within a community. Relying on
   data from the Latino National Political Survey, our findings show that
   Anglo attitudes toward English-language and immigration policies are
   significantly related to changes in the size of the Latino population
   conditional on levels of segregation. We also find that Latinos elicit
   different reactions from Anglos based on their fluency in English and
   nativity.},
