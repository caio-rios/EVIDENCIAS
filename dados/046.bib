@article{ WOS:000264320900002,
Author = {Reuter, Ora John and Remington, Thomas F.},
Title = {Dominant Party Regimes and the Commitment Problem The Case of United
   Russia},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2009},
Volume = {42},
Number = {4},
Pages = {501-526},
Month = {APR},
Abstract = {This article analyzes the formation of a stable dominant party in an
   authoritarian regime as a commitment problem between two sides: the
   ruler and other elites. After defining a dominant party regime and
   outlining the costs and benefits that such a regime entails for each
   side, the authors examine the efforts made in Russia to establish United
   Russia as a dominant party and argue that the Kremlin and regional
   elites have overcome their commitment problem through mutual investment
   in the United Russia party. In contrast to previous party-of-power
   projects, United Russia represents an equilibrium arrangement between
   the federal center and other political and economic elite actors.},
Publisher = {SAGE PUBLICATIONS INC},
