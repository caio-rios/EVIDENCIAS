@article{ WOS:000265617400018,
Author = {Stark, Andrew},
Title = {The Consensus School, Its Critics, and Welfare Policy: A Study of
   American Political Discourse},
Journal = {JOURNAL OF POLITICS},
Year = {2009},
Volume = {71},
Number = {2},
Pages = {627-643},
Month = {APR},
Abstract = {In the debate between the ``consensus{''} school of American politics
   and its various critics, all participants have shown themselves capable
   of shedding light on different historical periods or particular
   political conflicts; and, of course, given the complexity of public
   discourse, many American political controversies lend themselves to
   elucidation by more than one of them. This paper's purpose is to suggest
   yet a further way of interpreting American political discourse, one that
   carries the capacity to illuminate a kind of discursive structure in
   American politics that goes undiscerned by both the consensus school and
   its critics. The paper illustrates this alternative approach by using it
   to interpret discourse leading up to and following the 1996 welfare
   reforms. It concludes by suggesting that since welfare debate lends
   itself well to this interpretation, the question of whether other
   American political debates might also do so is a worthwhile project for
   further research.},
