@article{ WOS:000266010900007,
Author = {Boudreau, Cheryl},
Title = {Making Citizens Smart: When do Institutions Improve Unsophisticated
   Citizens' Decisions?},
Journal = {POLITICAL BEHAVIOR},
Year = {2009},
Volume = {31},
Number = {2},
Pages = {287-306},
Month = {JUN},
Abstract = {Many scholars lament citizens' lack of political sophistication, while
   others emphasize that information shortcuts can substitute for
   sophistication and help citizens with their political choices. In this
   paper, I use experiments to assess whether and under what conditions
   institutions can substitute for sophistication and enable even
   unsophisticated citizens to make informed decisions. The results of my
   experiments demonstrate that institutions, such as a penalty for lying
   or a threat of verification, can help both sophisticated and
   unsophisticated citizens to make more informed decisions. Further, my
   results suggest that institutions may, under certain conditions, level
   the playing field between sophisticated and unsophisticated citizens.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
