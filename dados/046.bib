@article{ WOS:000266021100005,
Author = {Warwick, Paul V.},
Title = {Relative Extremism and Relative Moderation Strategic Party Positioning
   in Democratic Systems},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2009},
Volume = {62},
Number = {2},
Pages = {276-288},
Month = {JUN},
Abstract = {This article investigates the ways in which parties stake out left-right
   positions that deviate from the mean positions of their supporters.
   Previous research has shown that parties tend to adopt positions that
   are more extreme than those of their supporters, but there are at least
   two arguments that also imply the presence of relative moderation-a
   tendency for moderate parties to be more moderate than their supporters.
   Using surveys covering 34 countries compiled by the Comparative Study of
   Electoral Systems, this investigation shows that parties in coalitional
   systems display both phenomena.},
