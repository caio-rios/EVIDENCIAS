@article{ WOS:000276724300008,
Author = {Bogaards, Matthijs},
Title = {How to classify hybrid regimes? Defective democracy and electoral
   authoritarianism},
Journal = {DEMOCRATIZATION},
Year = {2009},
Volume = {16},
Number = {2},
Pages = {399-423},
Abstract = {The `third wave' of democratization has resulted in the proliferation of
   regimes that are neither fully democratic nor classic authoritarian. To
   capture the nature of these hybrid regimes, the democratization
   literature has come up with a wide variety of adjectives as descriptors
   of different forms of democracy and authoritarianism. This article
   reviews two of the most systematic recent approaches, centring on the
   concepts of `defective democracy' and `electoral authoritarianism'. An
   important limitation of both approaches is that each covers only one
   side of the spectrum. Where they meet in the middle, confusion arises.
   As a remedy, the article suggests to embed the concepts of defective
   democracy and electoral authoritarianism in a `double-root strategy'
   that maps the full range of contemporary regimes from both sides of the
   political spectrum.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
