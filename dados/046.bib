@article{ WOS:000267678200009,
Author = {Ikeda, Ken'ichi and Richey, Sean},
Title = {The Impact of Diversity in Informal Social Networks on Tolerance in
   Japan},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2009},
Volume = {39},
Number = {3},
Pages = {655-668},
Month = {JUL},
Abstract = {Scholars often incorrectly categorize informal social networks its
   homogeneous and dismiss their potential for exposing members to diverse
   opinions. Recent research in the United States. however. shows that
   diversity in informal social networks exists and has a Positive
   influence On political tolerance. Whether exposure to a politically
   heterogeneous network also increases tolerance in socially homogeneous
   Japan is tested here. To do this, two new Japanese national sample
   Surveys that utilize name-generator methodology were created and
   administered to a sample of respondents. its well as a new measure of
   network political diversity in a multi-party system. Also. in additional
   type of tolerance, moral tolerance, was tested. The Conclusion is that
   diversity in informal social networks has it positive influence on
   political and moral tolerance in Japan.},
