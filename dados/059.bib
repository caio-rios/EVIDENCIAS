@article{ WOS:000086334000002,
Author = {Grofman, B and Koetzle, W and McDonald, MP and Brunell, TL},
Title = {A new look at split-ticket outcome for house and president: The
   comparative midpoints model},
Journal = {JOURNAL OF POLITICS},
Year = {2000},
Volume = {62},
Number = {1},
Pages = {34-50},
Month = {FEB},
Note = {Annual Meeting of the Public-Choice-Society, SAN FRANCISCO, CALIFORNIA,
   MAR 21-23, 1997},
Organization = {Public Choice Soc},
Abstract = {We argue that conservative districts that go Democratic for the House
   should be likely to choose a Republican for president, while liberal
   districts represented by a Republican should be likely to opt for a
   Democrat for president. We test these and related predictions about
   split-ticket voting with election data from the eight presidential
   elections between 1964 and 1992. We show that ideological differences in
   the estimated location of the district's median voter explains a
   substantial component of the systematic variation in patterns of split
   outcomes in this period across districts, but that other factors (e.g.,
   an especially popular incumbent or a particularly poor challenger, the
   magnitude of presidential election victory, region-specific realignment
   effects) also play a role.},
