@article{ WOS:000085394800005,
Author = {Bennett, SE and Flickinger, RS and Rhine, SL},
Title = {Political talk over here, over there, over time},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2000},
Volume = {30},
Number = {1},
Pages = {99-119},
Month = {JAN},
Note = {Annual Meeting of the International-Society-of-Political-Psychology,
   VANCOUVER, CANADA, JUL, 1996},
Organization = {Int Soc Polit Psychol},
Abstract = {Data from Great Britain acid the United States from the late 1950s to
   the early 1990s show relatively little change in the frequency with
   which citizens engage in political discussions, with whom they are
   likely to speak, and the variables that shape their propensity to engage
   in political talk. In addition, analyses of the data show that
   discussing politics enhances citizens' knowledge of public affairs, even
   net of other variables known to affect political knowledge. Students of
   political behaviour and those interested in strengthening democracy need
   to treat political discussions as an important form of political
