@article{ WOS:000086334000007,
Author = {Steinberger, PJ},
Title = {The impossibility of a ``political{''} conception},
Journal = {JOURNAL OF POLITICS},
Year = {2000},
Volume = {62},
Number = {1},
Pages = {147-165},
Month = {FEB},
Abstract = {Justice as fairness is understood to be freestanding in that it is to be
   presented apart from any specific comprehensive doctrine. It is, in
   other words, ``political, not metaphysical.{''} The idea of a such a
   political conception, however, raises a number of very serious problems
   with respect to justification and rationality. Ultimately, to ask if
   political philosophy should be done without metaphysics is to overlook
   the sense in which any political claim unavoidably reflects serious and
   controversial commitments of a moral and metaphysical nature.},
