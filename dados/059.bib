@article{ WOS:000089917600006,
Author = {Kittel, BA},
Title = {Deaustrification? The policy-area-specific evolution of Austrian social
   partnership},
Journal = {WEST EUROPEAN POLITICS},
Year = {2000},
Volume = {23},
Number = {1},
Pages = {108-129},
Month = {JAN},
Note = {48th Annual Conference of the Political-Studies-Association, KEELE UNIV,
   KEELE, ENGLAND, APR 07-09, 1998},
Organization = {Polit Studies Assoc},
Abstract = {Recently the functioning of Austrian Social Partnership has been
   increasing called into question. The strains on the system, often traced
   to the internationalisation of the economy and the related shift to
   neoliberally inspired policies, might make Austria prone to
   disorganising pressures. However, case studies in fields of social and
   economic policy-making crucial for international competitiveness
   (working time, vocational training, industrial policy) suggest that many
   elements of interest intermediation, concentration, and conflict
   resolution have remained constant over the last 30 years, entailing both
   elements of concentration and of conflict as well as different trends
   across policy areas.},
