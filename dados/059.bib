@article{ WOS:000085430700003,
Author = {Lane, JE and Mæland, R},
Title = {Constitutional analysis:: The power index approach},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2000},
Volume = {37},
Number = {1},
Pages = {31-56},
Month = {JAN},
Abstract = {A power index approach to the EU institutions gives a new perspective
   upon the EU institutions and their future reform. Using a standard power
   measure, the Banzhaf index, we show that in a group of states as the EU
   council, the voting power of a member state is equal to twice the
   individual power to block multiplied by the group's collective power to
   change. Political power of the member states is calculated under
   alternative constitutional rules for the EU, where cooperative game
   theory allows the derivation of power equivalences. We suggest that
   simple majority should be used more often in the EU council.},
