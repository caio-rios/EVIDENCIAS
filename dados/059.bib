@article{ WOS:000084820700001,
Author = {Schiemann, JW},
Title = {Meeting halfway between Rochester and Frankfurt: Generative salience,
   focal points, and strategic interaction},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2000},
Volume = {44},
Number = {1},
Pages = {1-16},
Month = {JAN},
Abstract = {Rational choice theory and the critical theory of Jurgen Habermas
   exclude ant social categories from their analyses of strategic
   interaction. Successful strategic action in many contexts, however,
   depends upon the irreducibly intersubjective categories of the
   lifeworld. I defend this claim by analyzing the use of focal points to
   multiple equilibria problem in coordination games, both the generation
   of the salience behind focal points as well as the strategic rationality
   of using them. The goal of this reconstruction is to demonstrate the
   compatibility of what ars to be mutually hostile research traditions,
   validating the intuition that together they provide a understanding of
   politics than either school can on its own.},
