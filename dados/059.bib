@article{ WOS:000088111800003,
Author = {Burgess, D and Haney, B and Snyder, M and Sullivan, JL and Transue, JE},
Title = {Rocking the vote - Using personalized messages to motivate voting among
   young adults},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2000},
Volume = {64},
Number = {1},
Pages = {29-52},
Month = {SPR},
Abstract = {We examined a nationwide effort to encourage young adults to vote in the
   1996 U.S. presidential election. During the year before the election,
   individuals were given the chance to sign and self-address one of two
   kinds of postcards pledging to vote; these cards were mailed back to the
   individuals within 2 weeks prior to the election. It is important to
   note that some individuals completed pledge cards that prompted them to
   provide their own reason for voting by completing the sentence, ``I will
   vote because,{''} whereas other individuals completed pledge cards that
   did not contain this sentence prompt. We conducted a large-scale survey
   of individuals who filled out pledge cards and determined that receiving
   a pledge card with the sentence prompt had a positive influence on
   voting. Moreover, this effect was found above and beyond demographic and
   psychological predictors of voting. Implications of these findings are
   discussed.},
