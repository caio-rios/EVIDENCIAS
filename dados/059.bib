@article{ WOS:000089917600007,
Author = {Beirich, H and Woods, D},
Title = {Globalisation, workers and the northern league},
Journal = {WEST EUROPEAN POLITICS},
Year = {2000},
Volume = {23},
Number = {1},
Pages = {130-143},
Month = {JAN},
Abstract = {This article seeks to explain why the Northern League's main basis of
   support now comes primarily from Northern workers and artisans. To
   explain the nature of the League's support, we hypothesise that a fear
   of globalisation has led workers in the north to vote for the party that
   has put the greatest emphasis on the protection of local identities. We
   analyse survey data to document the affect globalisation has on the
   voting patterns of Northern workers. From our data, we construct a
   regression model to identify the issues and socioeconomic factors that
   predict support for the Northern League. In addition to the regression
   model, we also present cross-tabulated data revealing that Northern
   League supporters tend to be extremely provincial, yet they are
   convinced that global forces are threatening their quality of life.},
