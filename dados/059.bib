@article{ WOS:000086334000008,
Author = {Smith, TW},
Title = {The audience of the Nicomachean Ethics},
Journal = {JOURNAL OF POLITICS},
Year = {2000},
Volume = {62},
Number = {1},
Pages = {166-186},
Month = {FEB},
Abstract = {The question, ``Who is the audience of the Nicomachean Ethics?{''} is
   crucial for understanding Aristotle's political philosophy. Leo Strauss
   and Aristide Tessitore have both argued that it consisted in part of
   gentlemen who uncritically accepted the worth of moral virtue as the
   starting point and horizon of the inquiry. By contrast, I argue that
   Aristotle seeks a common starting point with his audience in a
   commitment to noble action. Aristotle connects the love of noble action
   with the pursuit of honor. Yet, while this pursuit led some of his
   students to value moral virtue, it led others to value mastery. I
   explain the audience's equivocal understanding of virtue by tracing it
   back to the psychic motivations of the pursuit of honor in ancient
   Greece. This account helps us better understand Aristotle's overall
   pedagogical strategy in the Ethics.},
