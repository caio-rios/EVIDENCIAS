@article{ WOS:000085152800004,
Author = {Cirincione, C and Darling, TA and O'Rourke, TG},
Title = {Assessing South Carolina's 1990s congressional districting},
Journal = {POLITICAL GEOGRAPHY},
Year = {2000},
Volume = {19},
Number = {2},
Pages = {189-211},
Month = {FEB},
Abstract = {In this study, the authors employ a computer-intensive method to assess
   the factual basis for a race-as-predominant-factor claim against South
   Carolina's congressional districting plan. They use four algorithms that
   weight traditional districting criteria (equal population, the
   preservation of county integrity, and district area compactness) to
   generate 10,000 alternative plans containing a total of 60,000
   congressional districts. Based upon the analysis of these plans, the
   authors conclude that: (1) race is a factor in the design of South
   Carolina's congressional districts; (2) race predominates over the
   preservation of county lines; and (3) race may predominate over district
   compactness. (C) 2000 Published by Elsevier Science Ltd. All rights
   reserved.},
