@article{ WOS:000483172900001,
Author = {Zyla, Benjamin},
Title = {Eclecticism and the future of the burden-sharing research programme: Why
   Trump is wrong},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2020},
Volume = {41},
Number = {4},
Pages = {507-521},
Month = {SEP},
Abstract = {Since the birth of the North Atlantic Treaty Organization, the Europeans
   and the Americans have disagreed about who should share how much of the
   collective security burden. The input side of alliance burden sharing -
   that is, how many troops a member state contributes to the alliance -
   has been the privileged variable, both at the political as well as the
   academic levels. Other output variables (e.g. numbers of troops deployed
   to a particular mission) are highly contested. This article offers an
   analytically eclecticist framework for studying Atlantic burden sharing
   that allows combining variables on the input and output sides of the
   alliance burden sharing debate with those that consider it a social
   practice.},
Publisher = {SAGE PUBLICATIONS LTD},
