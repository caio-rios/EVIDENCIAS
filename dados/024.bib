   Lombardo, Emanuela, Univ Complutense Madrid, Inst Feminist Studies, Dept Polit Sci \& Adm, Madrid, Spain.},
DOI = {10.1111/1475-6765.12333},
ISSN = {0304-4130},
EISSN = {1475-6765},
