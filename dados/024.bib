@article{ WOS:000483713100003,
Author = {Hsiung, Benjamin O. and Djupe, Paul A.},
Title = {Religion and the Extension of Trust},
Journal = {POLITICAL BEHAVIOR},
Year = {2019},
Volume = {41},
Number = {3},
Pages = {609-631},
Month = {SEP},
Abstract = {The ability to cooperate with others, both individuals and institutions,
   is an essential social function built on trust. We explore the competing
   religious logics that shape the radius of trust, placing emphasis on
   communicated values in the social context of the congregation. Using
   cross-sectional data from American adults, we show the effects of
   religious beliefs that augment risk, values that demand outreach, and
   practices that capture experience with collective action. With a survey
   experiment, we show that priming different religious styles (inclusive
   of beliefs, values, and outreach) shifts the propensity to trust
   government and the social other in expected ways. In this way, we
   attempt to make sense of previous variant findings by suggesting that
   religious influence is dynamic and dependent on the religious style
   choices communicated to congregants.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
