   Usherwood, Simon, Univ Surrey, Polit, Guildford, Surrey, England.},
DOI = {10.1080/01402382.2019.1596692},
ISSN = {0140-2382},
EISSN = {1743-9655},
Keywords = {UK Independence Party; Brexit; populism; single-issue politics;
   leadership},
Keywords-Plus = {UK INDEPENDENCE PARTY; GENERAL-ELECTION; EUROPE; EUROSCEPTICISM;
   CONSERVATIVES; POLITICS; SUPPORT; STYLE},
