@article{ WOS:000485012400001,
Author = {Albertus, Michael},
Title = {Land Reform and Civil Conflict: Theory and Evidence from Peru},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2020},
Volume = {64},
Number = {2},
Pages = {256-274},
Month = {APR},
Abstract = {How does land reform impact civil conflict? This article examines this
   question in the prominent case of Peru by leveraging original data on
   all land expropriations under military rule from 1969 to 1980 and
   event-level data from the Peruvian Truth and Reconciliation Commission
   on rural killings during Peru's internal conflict from 1980 to 2000.
   Using a geographic regression discontinuity design that takes advantage
   of Peru's regional approach to land reform through zones that did not
   entirely map onto major preexisting administrative boundaries, I find
   that greater land reform dampened subsequent conflict. Districts in core
   areas of land reform zones that received intense land reform witnessed
   less conflict relative to comparable districts in adjacent peripheral
   areas where less land reform occurred. Further tests suggest that land
   reform mitigated conflict by facilitating counterinsurgency and
   intelligence gathering, building local organizational capacity later
   used to deter violence, undercutting the Marxist left, and increasing
   opportunity costs to supporting armed groups.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
