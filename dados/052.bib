@article{ WOS:000228622300008,
Author = {Drury, AC and Olson, RS and Van Belle, DA},
Title = {The politics of humanitarian aid: US foreign disaster assistance,
   1964-1995},
Journal = {JOURNAL OF POLITICS},
Year = {2005},
Volume = {67},
Number = {2},
Pages = {454-473},
Month = {MAY},
Abstract = {Previous studies of U.S. foreign aid have firmly established that
   foreign policy and domestic considerations strongly influence
   allocations of military and economic development assistance. Uncharted,
   however, is the question of similar influences on U.S. humanitarian aid.
   Analyzing U.S. foreign disaster assistance data from 1964 through 1995,
   this paper concludes that foreign policy and domestic factors not only
   influence disaster assistance allocations but that they are the
   overriding determinant. This impact is, however, somewhat differential:
   the initial ``yes/no{''} decision to grant disaster assistance is
   markedly political, but the subsequent ``how much{''} decision is also
   not devoid of political considerations.},
