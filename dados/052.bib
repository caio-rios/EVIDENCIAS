@article{ WOS:000229219200001,
Author = {Lowery, D and Gray, V and Wolak, J and Godwin, E and Kilburn, W},
Title = {Reconsidering the counter-mobilization hypothesis: Health policy
   lobbying in the American states},
Journal = {POLITICAL BEHAVIOR},
Year = {2005},
Volume = {27},
Number = {2},
Pages = {99-132},
Month = {JUN},
Note = {62nd Annual Meeting of the Midwest-Political-Science-Association,
   Chicago, IL, APR, 2004},
Organization = {Midwest Polit Sci Assoc},
Abstract = {Despite its widespread use since the concept was introduced by David
   Truman (1951. The Governmental Process. New York: Alfred A. Knopf),
   counter-mobilization by organized interests has remained theoretically
   ambiguous and rarely studied empirically. We more fully develop the
   concept of short-term counter-mobilization, distinguish it from
   long-term counter-mobilization, specify the conditions under which we
   might observe short-term counter-mobilization, and test the resulting
   hypotheses with data on health care lobby registrations in the American
   states during the late 1990s. We find little evidence of short-term
   counter-mobilization among health interest organizations, which leads us
   to more fully consider several null hypotheses about the limits of
   strategic behavior on the part of organized interests.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
