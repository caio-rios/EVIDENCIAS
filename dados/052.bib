@article{ WOS:000228321200004,
Author = {Benton, AL},
Title = {Dissatisfied democrats or retrospective voters? Economic hardship,
   political institutions, and voting behavior in Latin America},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2005},
Volume = {38},
Number = {4},
Pages = {417-442},
Month = {MAY},
Note = {Annual Meeting of the American-Political-Science-Association, BOSTON,
   MA, AUG 26-SEP 01, 2002},
Organization = {Amer Polit Sci Assoc},
Abstract = {This article examines recent trends in Latin American voting behavior
   and casts them in terms of sincere (economic) and strategic (electoral)
   concerns. It argues that thanks to years of economic adversity, Latin
   Americans have developed long, sophisticated economic memories. Although
   this has resulted in rising frustration with democratic government,
   according to recent opinion polls, it has not always led voters to
   punish all parties responsible for hardship at election time. A panel
   study of the region's presidential systems demonstrates that citizens
   punish incumbents by voting for established nonincumbents when electoral
   laws reduce opportunities available to small parties in the systems,
   even if nonincumbents have also been blamed for hard economic times.
   More permissive electoral systems, in contrast, encourage citizens to
   reject all parties responsible for economic decline. The analysis
   demonstrates how economic and electoral concerns interact to affect
   voting behavior, political accountability, and public opinion in Latin
   America.},
