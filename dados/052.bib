@article{ WOS:000228321200002,
Author = {Saiegh, SM},
Title = {Do countries have a ``democratic advantage{''}? Political institutions,
   multilateral agencies, and sovereign borrowing},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2005},
Volume = {38},
Number = {4},
Pages = {366-387},
Month = {MAY},
Abstract = {This article examines the effect of political institutions on countries'
   risk characteristics and the role that domestic political institutions
   play in determining the interest rates charged to less developed
   countries. According to the ``democratic advantage{''} argument,
   democracies should pay lower interest rates than authoritarian regimes
   because they are better able to make credible commitments. The author
   argues that such a claim must be revised in the case of developing
   countries. The results presented in this article support this assertion.
   First, they show that democracies are more likely to reschedule their
   debts, so they have no advantage; rather, the opposite is true. Second,
   there does not appear to be a significant difference between the
   interest rates paid by democracies and nondemocracies.},
Publisher = {SAGE PUBLICATIONS INC},
