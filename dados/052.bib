@article{ WOS:000230504000001,
Author = {Erk, J},
Title = {From Vlaams Blok to Vlaams Belang: The Belgian far-right renames itself},
Journal = {WEST EUROPEAN POLITICS},
Year = {2005},
Volume = {28},
Number = {3},
Pages = {493-502},
Month = {MAY},
Abstract = {On 14 November 2004, the Belgian far-right party Vlaams Blok changed its
   name to Vlaams Belang and instituted a number of changes in its
   programme. This was a response to the earlier decision of the Court of
   Cassation which had found Vlaams Blok to be in violation of the law
   against racism. As a result, some of the more extreme positions of
   Vlaams Blok have been dropped from the new statute of Vlaams Belang.
   Opinion is divided concerning whether or not the law against racism has
   worked by effectively setting the parameters for legally acceptable
   propaganda, or whether the recent changes would help the far-right
   expand its voter base by making it more mainstream. This article seeks
   to contrast these two points of view.},
