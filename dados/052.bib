@article{ WOS:000236936700006,
Author = {Von Ungern-Sternberg, T},
Title = {State intervention on the market for natural damage insurance},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2005},
Volume = {11},
Number = {4},
Pages = {123-138},
Month = {WIN},
Abstract = {We summarize the main results of our country studies for the market for
   property insurance. We draw conclusions about the way the best
   institutional organisation for this market. We conclude that both for
   the reasons of efficiency (lower sales and administrative costs) and to
   avoid problems of risk selection, public monopolies should play an
   important role. A further advantage of such a solution is that local
   monopolies have strong incentives to invest in efficient preventive
   measures.},
