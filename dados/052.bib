@article{ WOS:000235675400008,
Author = {Barrett, AW and Barrington, LW},
Title = {Bias in newspaper photograph selection},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2005},
Volume = {58},
Number = {4},
Pages = {609-618},
Month = {DEC},
Abstract = {Previous research has shown that visual images of political candidates
   can influence voter perceptions. This study examines newspaper
   photographs of candidates to deter-mine whether the favorableness of
   these pictures is related to the ``political atmosphere{''} of
   individual newspapers. In particular, we examine 435 candidate
   photographs from several races covered by seven newspapers during the
   1998 and 2002 general election seasons. Based on our analysis, we
   conclude that candidates endorsed by a particular newspaper-or whose
   political leanings match the political atmosphere of a given
   paper-generally have more favorable photographs of them published than
   their opponents.},
