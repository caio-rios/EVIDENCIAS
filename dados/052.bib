@article{ WOS:000229975100002,
Author = {Nickerson, DW},
Title = {Scalable protocols offer efficient design for field experiments},
Journal = {POLITICAL ANALYSIS},
Year = {2005},
Volume = {13},
Number = {3},
Pages = {233-252},
Month = {SUM},
Abstract = {Experiments conducted in the field allay concerns over external validity
   but are subject to the pitfalls of fieldwork. This article proves that
   scalable protocols conserve statistical efficiency in the face of
   problems implementing the treatment regime. Three designs are
   considered: randomly ordering the application of the treatment; matching
   subjects into groups prior to assignment; and placebo-controlled
   experiments. Three examples taken from voter mobilization field
   experiments demonstrate the utility of the design principles discussed.},
