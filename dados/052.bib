@article{ WOS:000236689900001,
Author = {Wagemann, C},
Title = {Private interest governments are dead. long live private interest
   governments? Lessons from Swiss cows},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2005},
Volume = {11},
Number = {3},
Pages = {1-25},
Month = {FAL},
Abstract = {This article looks at the most recent developments of the interest
   associations in the Swiss dairy sector. In the past, these had become
   famous as so-called ``Private Interest Governments{''} (PIGs) in which
   interest associations were equipped with public authority. The initial
   abolition of the PIG of the Swiss dairy sector in 1999 resulted in a
   significant and disruptive weakening of the traditional actors which
   were consequently transformed into liberalised service-oriented
   organisations, and it seemed that the Swiss dairy sector could be an
   example of a long-time ``path{''} which had come to an end. However,
   more recent developments, which were partially induced by the
   associations themselves and partially coincidental, have led to the
   emergence of a ``differentiated PIG{''}. Although associational
   governance has not been completely re-introduced, and the sector remains
   largely liberalised, the example shows that a path which has been
   followed for more than 80 years cannot simply be reversed and replaced
   by a new path, and that deeply institutionalised, structures can
   partially survive if a ``window of opportunity{''} opens.},
Publisher = {VERLAG RUEGGER},
Address = {POSTFACH 1470, ZUERICH, 8040, SWITZERLAND},
Type = {Article},
Language = {English},
Affiliation = {Wagemann, C (Corresponding Author), EUI, SPS, Via Roccettini 9, I-50016 Fiesole, Italy.
   European Univ Inst, Florence, Italy.},
DOI = {10.1002/j.1662-6370.2005.tb00360.x},
