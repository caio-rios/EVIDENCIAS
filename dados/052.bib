@article{ WOS:000228622300005,
Author = {Chen, KP and Niou, EMS},
Title = {Term limits as a response to incumbency advantage},
Journal = {JOURNAL OF POLITICS},
Year = {2005},
Volume = {67},
Number = {2},
Pages = {390-406},
Month = {MAY},
Abstract = {In this paper we develop a spatial model to provide an explanation for
   the seeming paradox that voters in some states reelect incumbents while
   unilaterally self-imposing legislative term limits. The model shows that
   voters are more likely to support term limits if the incumbent's
   position is farther from the median voter position or if the incumbent's
   party is more moderate. Furthermore, it suggests that term limits, or
   the threat of term limits, increases the responsiveness of politicians'
   policy platforms.},
