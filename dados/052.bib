@article{ WOS:000235087800010,
Author = {Quinn, T},
Title = {Choosing the least-worst government: The British general election of
   2005},
Journal = {WEST EUROPEAN POLITICS},
Year = {2006},
Volume = {29},
Number = {1},
Pages = {169-178},
Month = {JAN},
Abstract = {This article provides an overview of the British general election of
   2005. It examines the major political issues that arose during the Blair
   government's second term in office and their impact on the governing
   Labour Party's electoral support. Despite voters' growing sense of
   weariness with Labour, the Conservative opposition failed to convince
   the electorate that it was a credible government-in-waiting. The result
   was that Labour was comfortably returned to once, though with a
   much-reduced majority. The Liberal Democrats promoted from the
   unpopularity of the Iraq War, while minor parties won their highest ever
   tally of votes.},
