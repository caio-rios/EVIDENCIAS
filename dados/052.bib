@article{ WOS:000236689600001,
Author = {Tresch, A},
Title = {Government support in Swiss cantons: The case of federal votes from 1971
   to 1999},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2005},
Volume = {11},
Number = {2},
Pages = {1-25},
Month = {SUM},
Abstract = {The aim of this article is to explain inter-cantonal variations in
   government success and government support in federal votes from 1971 to
   1999. To do so, the author incorporates two different research
   traditions into her analytical frame, which allows her to determine the
   direct and indirect effects of party cues and structural determinants on
   the voting results. The empirical analysis at the cantonal level is
   based on a logistic regression and on structural equation models.
   Results show that German-speaking, Catholic and agrarian cantons are
   more reluctant to support the government in federal votes and that this
   skepticism increases according to the type and issue of the ballot.
   However, political parties in these cantons follow the voting
   recommendations of political authorities more often than in other
   cantons and therefore attenuate the inter-cantonal disparities of voting
   results. This finding suggests that cantonal parties are able to
   control, to some extent, the outcome of a vote by issuing
   recommendations supportive of the federal authorities' position during
   the referendum phase.},
Publisher = {VERLAG RUEGGER},
Address = {POSTFACH 1470, ZUERICH, 8040, SWITZERLAND},
