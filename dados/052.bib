Affiliation = {Simmons, BA (Corresponding Author), Harvard Univ, Dept Govt, 1033 Massachusetts Ave, Cambridge, MA 02139 USA.
   Harvard Univ, Dept Govt, Cambridge, MA 02139 USA.
   Harvard Univ, Dept Govt, Littauer Ctr, Cambridge, MA 02138 USA.},
