@article{ WOS:000233535800002,
Author = {Albertazzi, D and McDonnell, D},
Title = {The Lega Nord in the second Berlusconi government: In a league of its
   own},
Journal = {WEST EUROPEAN POLITICS},
Year = {2005},
Volume = {28},
Number = {5},
Pages = {952-972},
Month = {NOV},
Abstract = {For regionalist populists like the Lega Nord, participation in coalition
   ut national level requires striking a delicate balance between being a
   party of government and a movement of opposition. The key to this is
   choosing the right,'friends' and `enemies' within government. In
   contrast to its previous time in power in 1994, it: the second
   Berlusconi government ( 2001-05) the Lega cast itself as the Forza
   Italia leader's most faithfully, while being seen to be in almost
   constant conflict with its fellow junior coalition partners: Alleanza
   Nazionale (AN) and the UDC. Indeed, as AN repositions itself within a
   respectable govermental `European' Right, so the Lega appears ever more
   in a league of its own within the Italian centre-right. Based on
   exclusive recent interviews, this article examines the Lega's
   relationship to its heartland and its positions on issues such as
   immigration. Europe, globalisation and constitutional reform. We argue
   that the party has ransformed itself into an `institutionalised'
   populist movement that has successfully walked the tightrope of being
   seen to have one foot in and one foot out' of government.},
