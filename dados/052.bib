Volume = {67},
Number = {4},
Pages = {1190-1205},
Month = {NOV},
Abstract = {The rise of alternative viewing choices, brought about by the spread of
   cable television, has effectively reduced the audience for major
   presidential addresses. Has this change moderated the influence of major
   presidential speeches on public opinion? After examining the period from
   1954 to 2002, we provide evidence that the impact of presidential
   rhetoric in State of the Union addresses on public opinion has
   diminished as cable has flourished.},
