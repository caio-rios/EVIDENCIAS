@article{ WOS:000232114700009,
Author = {Major, R},
Title = {The Cambridge School and Leo Strauss: Texts and context of American
   political science},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2005},
Volume = {58},
Number = {3},
Pages = {477-485},
Month = {SEP},
Abstract = {Over the past quarter century, the Cambridge School of Intellectual
   History has had a profound influence on the study of political theory in
   the U.S. The scholarship of historians such as John Dunn, Quentin
   Skinner, and John Pocock has almost single-handedly defined the terms
   with which political scientists understand early modern thought, and
   consequently liberalism and its alternatives. In this essay I analyze
   Quentin Skinner's ``Meaning and Understanding in the History of
   Ideas{''} as the seminal argument for the Cambridge School's
   interpretive strategy In particular, I note the degree to which Skinner
   attacked the scholarship of Leo Strauss in order to establish the
   Cambridge approach. Contrary to Skinner, I argue Strauss too has a
   concern for genuine historical understanding. I conclude with a
   re-reading of Strauss' Persecution and the Art of Writing in order to
   show that Strauss' interpretive strategy ultimately comes much closer to
   the ``historicity{''} claimed by Skinner and others.},
