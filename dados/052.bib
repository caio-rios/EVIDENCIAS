@article{ WOS:000231412800003,
Author = {Morris, JS and Clawson, RA},
Title = {Media coverage of congress in the 1990s: Scandals, personalities, and
   the prevalence of policy and process},
Journal = {POLITICAL COMMUNICATION},
Year = {2005},
Volume = {22},
Number = {3},
Pages = {297-313},
Month = {JUL-SEP},
Note = {Annual Meeting of the American-Political-Science-Association,
   WASHINGTON, D.C., AUG 31-SEP 03, 2000},
Organization = {Amer Polit Sci Assoc},
Abstract = {In this article, we provide a comprehensive, systematic examination of
   media coverage of Congress in the 1990s. Specifically, we content
   analyze over 2,600 congressional news stories from the New York Times
   and CBS Evening News from 1990 through 1998. We find that the news media
   covered substantive policy concerns and the legislative process quite
   regularly and that stories focusing on individual personalities and
   political scandals were comparatively infrequent. We also find that
   legislative maneuvering is a mainstay. of congressional media coverage,
   and the democratic process is most often framed as conflict between
   parties and Congress and the president.},
