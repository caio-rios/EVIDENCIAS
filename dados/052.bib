@article{ WOS:000233643500001,
Author = {Bulkeley, H},
Title = {Reconfiguring environmental governance: Towards a politics of scales and
   networks},
Journal = {POLITICAL GEOGRAPHY},
Year = {2005},
Volume = {24},
Number = {8},
Pages = {875-902},
Month = {NOV},
Note = {Conference on Governing Environmental Flows - Reinventing the State in
   Global Modernity, Wageningen, NETHERLANDS, JUN 13-14, 2003},
Organization = {Environm Policy Grp; Wageningen Univ; Int Sociol Assoc; Res Comm RC24},
Abstract = {This paper seeks to develop an alternative account of the geographies of
   environmental governance to those current conceptions which tend to take
   space and scale for granted as pregiven, contained, natural entities.
   Through an engagement with the debates on the politics of scale, the
   argument is made that a new spatial grammar of environmental governance
   must be sensitive to both the politics of scale and the politics of
   networks. Rather than considering scalar and non-scalar interpretations
   of spatiality as necessarily opposite, the paper argues that through a
   more careful deployment of concepts of hierarchy and territory common
   ground between scalar and network geographies can be forged, and can
   inform our understanding of environmental governance. In making this
   argument, the paper provides an overview of contemporary configurations
   of global environmental governance, and seeks to illustrate by reference
   to one transnational municipal network, the Cities for Climate
   Protection programme, how governing the environment involves both
   political processes of scaling and resealing the objects and agents of
   governance, as well as attempts to create new, networked. arenas of
   governance. The paper concludes that recognition of new spatial grammars
   is necessary for understanding emerging hybrid forms of environmental
   governance and their political and ecological implications. (c) 2005
   Elsevier Ltd. All rights reserved.},
