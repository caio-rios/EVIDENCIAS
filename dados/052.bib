@article{ WOS:000232037300009,
Author = {Campbell, SH and Scott, JT},
Title = {Rousseau's politic argument in the Discourse on the Sciences and
   Arts},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2005},
Volume = {49},
Number = {4},
Pages = {818-828},
Month = {OCT},
Abstract = {Rousseau's arguments often turn on a correct understanding of the
   relationship between cause and effect. We argue that the principal
   cause-effect argument of the Discourse is actually the opposite of the
   one Rousseau appears to posit in his work. Whereas he initially seems to
   argue that the sciences and arts corrupt morals, his ultimate argument
   is that the corruption of morals is the cause of the advancement of the
   sciences and arts and of their corrupting effects. Behind both moral
   corruption and the advancement of the sciences and arts lies a more
   remote cause: human pride and the unequal social and political
   conditions that result from pride and then foster it. Rousseau takes
   advantage of this complex casual relationship by simultaneously
   presenting an initial causal argument that gives his essay its
   paradoxical character and obscuring the ultimate causal argument of the
   work because of its implications as a critique of political authority
   and inequality.},
