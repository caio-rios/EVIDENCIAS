@article{ WOS:000229631300006,
Author = {Engstrom, EJ and Kernell, S},
Title = {Manufactured responsiveness: The impact of state electoral laws on
   unified party control of the presidency and house of representatives,
   1840-1940},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2005},
Volume = {49},
Number = {3},
Pages = {531-549},
Month = {JUL},
Abstract = {The modern history of divided government in America suggests that the
   framers succeeded in creating a government Unresponsive to popular
   passions. Yet in the nineteenth century the party winning the presidency
   almost always captured control of the House of Representatives. Why and
   how could nineteenth century national elections be so responsive that
   the), resemble parliamentary outcomes? We identify electoral
   institutions present in the states that directly linked congressional
   elections to presidential coattails. Specifically, we estimate the
   impact of state ballot laws and the strategic design of congressional
   districts on presidential coattail voting from 1840 to 1940. We find
   that presidential elections, as mediated by state electoral laws,
   strongly account for unified party control of the House and the
   presidency throughout the nineteenth century.},
Publisher = {BLACKWELL PUBLISHING INC},
Address = {350 MAIN ST, MALDEN, MA 02148 USA},
Type = {Article},
Language = {English},
Affiliation = {Engstrom, EJ (Corresponding Author), Univ N Carolina, Chapel Hill, NC 27599 USA.
   Univ N Carolina, Chapel Hill, NC 27599 USA.
   Univ Calif San Diego, La Jolla, CA 92093 USA.},
DOI = {10.2307/3647730},
ISSN = {0092-5853},
Keywords-Plus = {CROSS-SECTION-DATA; CONGRESSIONAL ELECTIONS; PARTISAN BIAS;
   NATIONALIZATION; 19TH-CENTURY; REALIGNMENT},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {engstrom@unc.edu
   skernell@ucsd.edu},
