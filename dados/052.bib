@article{ WOS:000229518900005,
Author = {Hill, KQ and Matsubayashi, T},
Title = {Civic engagement and mass-elite policy agenda agreement in American
   communities},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2005},
Volume = {99},
Number = {2},
Pages = {215-224},
Month = {MAY},
Note = {62nd Annual Meeting of the Midwest-Political-Science-Association,
   Chicago, IL, APR, 2004},
Organization = {Midwest Polit Sci Assoc},
Abstract = {We test propositions about how different forms of civic engagement are
   related to democratic representation in American communities. Our data
   are for the samples of communities, their citizens, and their leaders
   originally examined by Verba and Nie in Participation in America (1972).
   Our analyses of those data. indicate that membership in bridging
   social-capital civic associations is unrelated to democratic
   responsiveness of leaders to the tnass public but that bonding
   social-capital membership is negatively associated with such
   responsiveness. We also demonstrate that bonding social-capital civic
   engagement weakens the democratic linkage processes inherent in
   elections.},
