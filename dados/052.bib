@article{ WOS:000236936700010,
Author = {Feld, LP and Hug, S},
Title = {Musings about the EU's constitutional future},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2005},
Volume = {11},
Number = {4},
Pages = {227-247},
Month = {WIN},
Abstract = {The constitutional future of the European Union (EU) has attracted many
   scholars in economics and political science to apply their knowledge on
   political institutions and propose concrete suggestions. We highlight
   that economists and political scientists proceed quite differently in
   this endeavour and suggest that, due to this, they also are exposed to
   different pitfalls. We illustrate this by critically assessing specific
   proposals made in the context of the proposed constitution for the EU.},
