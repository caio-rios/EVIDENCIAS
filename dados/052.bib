@article{ WOS:000236689900002,
Author = {Von Erlach, E},
Title = {Politicizing effects of associational memberships},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2005},
Volume = {11},
Number = {3},
Pages = {27-59},
Month = {FAL},
Abstract = {In this article the relationship between associational membership and
   the participation in political discussions is analysed. It is shown that
   members of voluntary associations are politically more engaged than
   persons without organisational affiliations. The results of the
   multivariate analyses however indicate that politicising effects of
   voluntary associations are limited as the strength of correlations
   between associational affiliation and the participation in political
   discussions substantially decreases if controls for education and
   political socialisation during adolescence are introduced. Associations
   do none the less contribute to the political engagement of its members
   as they offer opportunities to develop and practice civic skills. They
   can further stimulate the participation in political discussions by
   encouraging members to carry out and not avoiding conflicts.},
