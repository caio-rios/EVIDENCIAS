@article{ WOS:000232530100001,
Author = {Rudra, N and Haggard, S},
Title = {Globalization, democracy, and effective welfare spending in the
   developing world},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2005},
Volume = {38},
Number = {9},
Pages = {1015-1049},
Month = {NOV},
Abstract = {The literature on the effects of globalization on social policy and
   welfare, and the parallel literature on the effects of democracy,
   operate in mutual isolation to a surprising degree. This article extends
   the debate on the welfare state in the developing world by examining the
   social policy reactions of democratic and authoritarian governments to
   globalization. Using unbalanced panel data on 57 developing nations, and
   considering social security and health and education spending, the
   authors examine whether democratic and authoritarian regimes exhibit
   similar or different social spending priorities in the context of
   increasing economic openness. The results show that social spending in
   ``hard{''} authoritarian regimes is more sensitive to the pressures of
   globalization than in democratic or intermediate regimes.},
Publisher = {SAGE PUBLICATIONS INC},
