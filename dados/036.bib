@article{ WOS:000336196000004,
Author = {Garretson, Jeremiah J.},
Title = {Changing with the Times: The Spillover Effects of Same-Sex Marriage
   Ballot Measures on Presidential Elections},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2014},
Volume = {67},
Number = {2},
Pages = {280-292},
Month = {JUN},
Abstract = {Studies have shown that same-sex marriage (SSM) ballot measures affected
   voter turnout and primed voters in a manner that aided the Republican
   Party in 2004. However, if attitude strength plays a role in these
   spillover effects, then recent increases in the intensity of support for
   SSM on the left may have eroded-or even reversed-the pro-Republican
   electoral boost of these measures. Using individual- and county-level
   data, I demonstrate that more recent votes on SSM have mobilized more
   pro-Obanria SSM supporters than pro-Republican social conservatives.
   These findings are important for understanding how ballot measures may
   potentially affect candidate elections.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
