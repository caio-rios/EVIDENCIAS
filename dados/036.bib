   Tsatsanis, Emmanouil; Belchior, Ana Maria, CIES IUL, Lisbon, Portugal.
   Belchior, Ana Maria, Inst Univ Lisboa ISCTE IUL, Lisbon, Portugal.},
DOI = {10.1080/13608746.2014.975770},
ISSN = {1360-8746},
EISSN = {1743-9612},
