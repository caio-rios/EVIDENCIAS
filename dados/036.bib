   Mudde, Cas, Univ Georgia, Dept Int Affairs, Athens, GA 30602 USA.
   Zaslove, Andrej, Radboud Univ Nijmegen, Dept Polit Sci, Inst Management Res, POB 9108, NL-6500 HK Nijmegen, Netherlands.},
DOI = {10.1177/0010414013512600},
ISSN = {0010-4140},
EISSN = {1552-3829},
Keywords = {populism; measuring populism; voter attitudes; left populism; radical
   right populism},
Keywords-Plus = {LATIN-AMERICA; WESTERN-EUROPE; LEGA NORD; PARTIES; BELGIUM;
   NEOLIBERALISM; GOVERNMENT; AUSTRIA},
