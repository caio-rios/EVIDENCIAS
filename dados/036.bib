@article{ WOS:000344545700003,
Author = {Shah, Aqil},
Title = {Constraining consolidation: military politics and democracy in Pakistan
   (2007-2013)},
Journal = {DEMOCRATIZATION},
Year = {2014},
Volume = {21},
Number = {6},
Pages = {1007-1033},
Month = {SEP 19},
Abstract = {Why do some militaries retain high authoritarian prerogatives during
   transitions from militarized authoritarian rule? The Pakistan military's
   2007 extrication shows that an important part of the answer lies in the
   level of structural differentiation between the ``military
   government{''} and the ``military institution{''}. Despite sustained
   contentious opposition to military rule, the high level of separation
   between these two military dimensions of the state allowed the
   institutional military to delink itself from the discredited
   dictatorship and exit on its own terms. In the post-authoritarian
   context, the military has preserved its expansive prerogatives by using
   a variety of adaptive contestation mechanisms - including the
   mobilization of the media and the judiciary - that act as a continuing
   source of political instability and uncertainty.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
