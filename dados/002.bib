@article{ WOS:001782882300001,
Author = {Busemeyer, Marius R.},
Title = {The comparative political economy of inequality: the maturation of an
   emerging field},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 MAY 4},
Abstract = {This article reviews the evolution of research in Comparative Political
   Economy of Inequality (CPEI) over the past 25 years, highlighting key
   developments in the field. Early research in CPEI emphasised the
   political and institutional determinants of inequality, particularly the
   role of power resources, labour market institutions, and welfare state
   policies. Over time, scholarship has expanded to examine the
   consequences of inequality, focusing on political participation,
   preference formation, and biases in policy responsiveness. This article
   identifies a persistent dynamic of self-reinforcing inequality, where
   rising socio-economic disparities shape political behaviour, depress
   voter turnout, and limit redistributive policies. Additionally, it
   outlines a future research agenda, emphasising the role of political
   parties in mitigating or exacerbating inequalities and the issue of
   trade-offs in responsiveness to short- and long-term challenges.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
