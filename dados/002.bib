@article{ WOS:001707198200001,
Author = {Kronstein, Balint},
Title = {Far right political ecologies and the battery sector: The case of the
   CATL gigafactory in Debrecen, Hungary},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {127},
Month = {MAY},
Abstract = {The far right Hungarian government has sought to capitalize on the
   e-mobility transition, aiming to become the world's second-largest
   battery manufacturing country. While this goal aligns well with the
   economic agenda and pseudo-environmentalism of the climate
   denialist-turned government, it has also sparked significant
   sociopolitical opposition. This article examines the heated debate
   surrounding battery manufacturing in Hungary, particularly the
   Contemporary Amperex Technology Co. Limited {[}CATL] gigafactory project
   in Debrecen. This manufacturing plant is the centerpiece of the
   Hungarian government's economic strategy and is planned to be one of
   Europe's largest battery factories. Local society and politics are
   divided into two groups: proponents and opponents of the project. Both
   sides attempt to secure public support and employ nationalist,
   exclusionary and xenophobic communication strategies to influence the
   debate. The article conceptualizes the battery debate within the
   framework of far right political ecology and argues that both sides are
   attempting to falsely appear green. The findings suggest that
   environmentalism is conditional - ecological issues are used to support
   otherthan-ecological agendas - and that enemy creation is strategically
   employed to strengthen arguments, fostering an us versus them dichotomy
   and invoking fear - a rhetorical strategy previously associated with
   Fidesz-KDNP. Despite the strong contention surrounding battery
   manufacturing - scientific criticism and public opposition - the
   construction of the CATL gigafactory has continued and e-mobility has
   remained central to the Hungarian government's agenda.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
