@article{ WOS:001796827200001,
Author = {Fontana, Gianmarco},
Title = {The internal-external nexus in moderation processes: how international
   constraints drove HTS from radicalism to statecraft in Syria.},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 JUN 18},
Abstract = {This article analyzes how religious radical groups strategically
   moderate their behaviour in response to international constraints,
   prioritizing pragmatic survival and compliance over ideological purity
   in pursuit of legitimacy. The central question asks under what
   conditions pragmatic considerations override ideational factors in
   shaping the behaviour of such actors in their quest for and exercise of
   power. The article argues that international isolation and sanctions
   create incentives for moderation as groups seek survival, legitimacy,
   and security. This multi-pronged pressure creates tension between power
   and ideology, particularly in contexts of regime change. The analysis
   explores how the international system influences moderation, resulting
   in staged and conditional international recognition. Employing Hayat
   Tahrir al-Shaam (HTS) as a case-study, the article suggests that its
   moderation rewarded the former radical group with gradual international
   acceptance during the post-civil war state-building process in Syria.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
