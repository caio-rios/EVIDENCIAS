@article{ WOS:001815595200001,
Author = {Gavrilova, Sofia},
Title = {``Historically Russian land{''}. The Russian pedagogies of spatial
   continuity in geographical textbooks},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {130},
Month = {SEP},
Abstract = {This article examines how the Russian state deploys geographical
   education as a strategic tool of neo-imperial statecraft through the
   concept of spatial continuity. Building on critical geography, political
   geography, and postcolonial theory, it analyzes Russian geography
   textbooks (2021-2024) to show how the state crafts a seamless spatial
   imaginary that collapses imperial, Soviet, and post-Soviet geographies
   into a singular transhistorical meta-state. Geography is mobilised not
   to describe territorial change, but to deny it-naturalising
   expansionism, erasing ruptures, and reimagining contested regions such
   as Crimea and Donbas as integral parts of an eternal Russian space.
   Central to this operation is the Russian Geographical Society (RGS),
   which, under Putin's patronage, has become a key producer of public
   geographical knowledge and a civilisational entrepreneur. Geography
   textbooks function as territorial pedagogies that construct hierarchical
   regional identities-positioning Central Russia as the civilisational
   core while relegating peripheral regions to zones of extraction,
   exoticism, or underdevelopment. The analysis reveals how geography
   education becomes a means of ideological enclosure: encoding sacred
   geographies, legitimizing geopolitical aggression, and embedding
   imperial nostalgia into the everyday understanding of space. While
   focused on the Russian case, the article offers broader insights into
   how authoritarian regimes globally mobilize historical geographies to
   justify territorial claims. It argues that spatial continuity is not
   unique to Russia, but increasingly used across nationalist and
   authoritarian regimes to fabricate territorial legitimacy. Understanding
   this mechanism-how authoritarian geographies are constructed through
   pedagogical, cartographic, and discursive means-is critical for decoding
   the spatial strategies of contemporary power.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
