@article{ WOS:001814525100001,
Author = {Sczepanski, Ronja and Evans, Geoffrey},
Title = {Perceived class positions and opinion-based polarisation: experimental
   evidence from the UK},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 JUN 21},
Abstract = {Class divisions over emerging policy issues are well-documented, yet the
   mechanisms driving these divisions remain underexplored. This article
   argues that perceptions of how the working class positions itself on
   divisive political issues, specifically immigration and the environment,
   fuel polarisation between opinion-based groups and self-identified
   social classes. Using a vignette survey experiment in the UK, we
   leverage the base-rate fallacy to manipulate respondents' perceptions of
   the working class stance on these issues. Working class respondents feel
   significantly closer to opinion-based groups when they believe the
   working class is the majority within those groups, whether pro- or
   anti-immigration and pro- or anti-environment. Conversely, respondents
   with liberal orientations who perceive the working class as aligned with
   opposing camps express greater social distance from the working class, a
   pattern observed among both middle and working class respondents. Our
   findings illuminate how social and political polarisation are
   dynamically intertwined through perceptions of group opinion alignments.},
