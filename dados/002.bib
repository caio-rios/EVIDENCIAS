@article{ WOS:001759723000001,
Author = {Lin, I, Wen- and Datta, Ayona},
Title = {Embodied statecraft: The endurance of zhl jie` (pointing at the
   boundary) in Taiwan's land digitalisation},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {129},
Month = {AUG},
Abstract = {This paper examines the practice of ``embodied statecraft{''} as
   fundamental to Taiwanese government's `One Nation, One Map' (ONOM) land
   digitalisation initiative. We frame zhl jie` as a form of relational and
   embodied statecraft in which boundaries are negotiated and formally
   demarcated by state officials through consensus building with local
   stakeholders operating in parallel with the ONOM geospatial platform.
   Embodied statecraft foregrounds the often-overlooked bodily presence
   that is conducted through actions (quiet acceptance, selective
   deferral), gestures (pointing, nodding), affects (frustration,
   overwhelm) of state officials which constitute different ways that the
   state is materialised at a `molecular' scale of the boundary. This has
   concrete impacts on how the state governs its boundaries, and how
   cadastral maps are represented on the ONOM platform. We argue that zhl
   jie` endures in Taiwanese planning practice from the precolonial era
   since Taiwan's map temporalities and its geophysical restlessness on the
   Pacific `ring of fire' makes technological `fixes' to boundary
   mismatches untenable. Through interviews with central and local
   government officials, private professionals, and consultants, we find
   that embodied statecraft is fundamental to supporting Taiwan's
   digitalising initiatives. Rather than seeing territorial uncertainties
   as a problem of digitalisation, framing zhl jie` as a relational form of
   embodied statecraft enables us to understand how digitalising
   initiatives are, in themselves, temporal, situated, and embodied. This
   paper calls for political geographers to recognise the challenges of
   embodiment and relationality more generally in increasingly digital
   domains and consider that the digital is assembled through the
   asynchronous temporalities, embodied negotiations, and practical
   contingencies that underlie geospatial governance in Taiwan and
   elsewhere.},
Publisher = {ELSEVIER SCI LTD},
