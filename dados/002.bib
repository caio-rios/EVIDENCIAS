@article{ WOS:001773222800001,
Author = {Soontjens, Karolin and Beckers, Kathleen and van der Goot, Emma and
   Morosoli, Sophie},
Title = {Press and Prejudice: an Interview Study on Politicians' Perceptions of
   Partisan News Media Bias},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Volume = {43},
Number = {6},
Pages = {1005-1029},
Month = {NOV 2},
Abstract = {In democratic systems, relationships between politicians and journalists
   are often marked by both interdependence and tension. Prior research
   shows that when politicians perceive traditional news media as biased
   and voice these concerns, their interactions with journalists can become
   increasingly conflictual. However, little is known about what
   politicians actually mean when they blame legacy media for being
   slanted, or what they perceive as the underlying causes of such partisan
   news bias. Understanding these perceptions matters, as they shape
   politicians' interactions with journalists, their broader communication
   about the media, and, ultimately, the quality of democratic debate.
   Therefore, this study investigates politicians' perceptions of partisan
   news bias through face-to-face interviews with 110 Belgian members of
   parliament. Specifically, we examine how politicians define partisan
   bias and what they consider its main causes. We find that MPs primarily
   refer to selection and presentation bias when criticizing legacy media,
   frequently citing insufficient attention, unfair framing, and selective
   quoting as grievances. Both right- and left-leaning politicians
   attribute these issues to the presumed left-wing orientations of
   journalists. Right-wing MPs argue that journalists' ideological bias
   benefits leftist parties, whereas left-leaning MPs believe journalists
   disadvantage the left to avoid accusations of leftist bias. To a lesser
   extent, MPs also identify commercial pressures as a source of political
   bias in news coverage. Overall, the findings show that politicians
   attribute considerable power to the media and express a shared sense of
   dependence on its perceived biases and agendas.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
