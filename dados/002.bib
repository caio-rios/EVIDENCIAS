@article{ WOS:001800134200001,
Author = {Thal, Adam},
Title = {The Causes of Opposition to Teaching About Racism},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 JUN 23},
Abstract = {There is an ongoing effort to prevent professors from teaching about
   racism. Such restrictions are sometimes justified by pointing to
   concerns that are seemingly not about race, including the need to
   prevent liberal professors from indoctrinating students and make sure
   that students are learning useful subjects. I explore the extent to
   which these concerns can explain White Republicans' opposition to
   professors teaching about racism. I run survey experiments in which
   White Republicans evaluate hypothetical faculty job candidates. I find
   that concerns about liberal professors and the usefulness of college
   cannot fully explain White Republicans' opposition to professors
   teaching about racism. Instead, this opposition appears to be motivated
   to a substantial extent by concerns that professors will teach negative
   ideas about White people. With that said, concerns about liberal
   professors do appear to contribute to White Republicans' opposition to
   professors teaching about racism even if they cannot fully explain this
   opposition.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
