@article{ WOS:001783206200001,
Author = {Dring, Colin and Newman, Lenore and Wittman, Hannah},
Title = {The politics of protection: Agricultural planning, legitimacy, and
   dissent in Richmond, Canada},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {130},
Month = {SEP},
Abstract = {Agricultural landscapes are not only sites of production but arenas of
   ongoing political negotiation over property, identity, and rural-urban
   futures. We explore these and other political tensions embedded in
   agricultural land use planning in Richmond, British Columbia, a rapidly
   urbanizing municipality within British Columbia, Canada's Agricultural
   Land Reserve. Conflicts over residential development and changing
   agricultural practices challenge normative assumptions of farmland
   protection and the primacy of farming as a dominant economic driver in
   the region. Drawing on interviews with municipal officials, planners,
   and advocacy actors, alongside analysis of planning documents and media
   coverage, we show how planning regimes reorganize land-use conflict
   through consensus-oriented frameworks and technical instruments.
   Grassroots mobilizations and public dissent reveal competing imaginaries
   of legitimate farming and land stewardship that are selectively
   incorporated into planning processes. The analysis situates these
   tensions within a radical-agonistic planning framework, showing how
   dissent disrupts dominant narratives but is subsequently stabilized
   through institutional planning arrangements that redefine what counts as
   `agriculture'. Examining struggles over house size regulations, cannabis
   and vertical farming, and farmland access, we trace how uneven power
   relations shape regulatory outcomes and structure which agricultural
   futures become institutionally legitimate. Rather than resolving
   conflict, municipal planning in Richmond reconstitutes the terrain of
   dissent by translating political contestation into procedural
   consultation and regulatory stabilization, producing a revised consensus
   that privileges some actors, knowledges, and agricultural futures over
   others.},
