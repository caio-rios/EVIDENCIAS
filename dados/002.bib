@article{ WOS:001797710500001,
Author = {Pepic, Ivan},
Title = {The ``Communal College:{''} Cross-Ethnic Voting Rules and Census
   Requirements for Dyadic Consociational Democracies},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Month = {2026 JUN 21},
Abstract = {Electoral systems in deeply divided societies are pivotal for peace and
   stability among ethno-national groups. Consociationalism and
   centripetalism are the most widespread approaches from which derive the
   major incentives for electoral systems in deeply divided, dyadic
   societies. The article discusses electoral dysfunctionalities in dyadic
   societies and defends a new electoral system which incorporates
   centripetal cross-ethnic voting elements to be applied to consociational
   power-sharing arrangements. In order to prevent the largest ethnic
   groups from electing representatives of dominant minority groups to
   collective institutions, this electoral system offers a safeguard
   mechanism through electoral weights aligned with population census. The
   model is based on the conceptual framework of power-sharing democracies
   in deeply divided societies. To test the validity and necessity of this
   electoral model, this paper compares the regional cases of Bern, Cyprus,
   and the Federation of Bosnia and Herzegovina.
   Wahlsysteme in tief gespaltenen Gesellschaften sind entscheidend f \&
   uuml;r Frieden und Stabilit \& auml;t zwischen ethnonationalen Gruppen.
   Konsoziationalismus und Zentripetalismus sind die am weitesten
   verbreiteten Ans \& auml;tze, von denen die wichtigsten Anreize f \&
   uuml;r Wahlsysteme in tief gespaltenen, dyadischen Gesellschaften
   ausgehen. Der Artikel er \& ouml;rtert elektorale Dysfunktionalit \&
   auml;ten in dyadischen Gesellschaften und pl \& auml;diert f \& uuml;r
   ein neues Wahlsystem, das zentripetale, ethnien \& uuml;bergreifende
   Abstimmelemente enth \& auml;lt, die auf konsoziationalistische
   Machtteilungsvereinbarungen anzuwenden sind. Um zu verhindern, dass die
   gr \& ouml;ssten ethnischen Gruppen die Vertreter: innen dominanter
   Minderheitengruppen in kollektive Institutionen w \& auml;hlen, bietet
   dieses Wahlsystem einen Schutzmechanismus durch Stimmgewichte, die am
   Zensus ausgerichtet sind. Das Modell basiert auf dem Konzept der
   Machtteilungsdemokratie in tief gespaltenen Gesellschaften. Um die
   Validit \& auml;t und Notwendigkeit dieses elektoralen Modells zu pr \&
   uuml;fen, vergleicht dieser Artikel die regionalen F \& auml;lle Bern,
   Zypern und die F \& ouml;deration Bosnien und Herzegowina.
   Les syst \& egrave;mes \& eacute;lectoraux au sein des soci \& eacute;t
   \& eacute;s profond \& eacute;ment divis \& eacute;es sont essentiels \&
   agrave; la paix et \& agrave; la stabilit \& eacute; entre les groupes
   ethno-nationaux. Le consociationnalisme et le centrip \& eacute;talisme
   constituent les approches les plus r \& eacute;pandues dont d \&
   eacute;coulent les principales incitations pour les syst \& egrave;mes
   \& eacute;lectoraux dans les soci \& eacute;t \& eacute;s dyadiques et
   profond \& eacute;ment divis \& eacute;es. L'article traite des
   dysfonctionnements \& eacute;lectoraux dans les soci \& eacute;t \&
   eacute;s dyadiques et soutient un nouveau syst \& egrave;me \&
   eacute;lectoral qui int \& egrave;gre des \& eacute;l \& eacute;ments de
   vote centrip \& egrave;te trans-ethnique \& agrave; appliquer aux
   accords de partage du pouvoir consociationnels. Afin d'emp \& ecirc;cher
   les groupes ethniques les plus importants d'\& eacute;lire des repr \&
   eacute;sentant \& centerdot;es de groupes minoritaires dominants au sein
   des institutions collectives, ce syst \& egrave;me \& eacute;lectoral
   offre un m \& eacute;canisme de sauvegarde via des poids \&
   eacute;lectoraux align \& eacute;s sur le recensement de la population.
   Le mod \& egrave;le s'appuie sur le cadre conceptuel des d \&
   eacute;mocraties fond \& eacute;es sur le partage du pouvoir dans les
   soci \& eacute;t \& eacute;s profond \& eacute;ment divis \& eacute;es.
   Pour tester la validit \& eacute; et la n \& eacute;cessit \& eacute; de
   ce mod \& egrave;le \& eacute;lectoral, cet article compare les cas r \&
   eacute;gionaux de Berne, de Chypre et de la F \& eacute;d \&
   eacute;ration de Bosnie-et-Herz \& eacute;govine.
   I sistemi elettorali nelle societ \& agrave; profondamente divise sono
   fondamentali per la pace e la stabilit \& agrave; tra i gruppi
   etno-nazionali. Il consociazionalismo e il centripetalismo sono gli
   approcci pi \& ugrave; diffusi dai quali derivano i principali incentivi
   per i sistemi elettorali nelle societ \& agrave; diadiche profondamente
   divise. L'articolo discute le disfunzionalit \& agrave; elettorali nelle
   societ \& agrave; diadiche e difende un nuovo sistema elettorale che
   incorpora elementi di voto trans-etnico centripeto da applicare agli
   accordi consociazionali di condivisione del potere. Al fine di evitare
   che i gruppi etnici pi \& ugrave; ampi eleggano esponenti di gruppi
   minoritari dominanti nelle istituzioni collettive, questo sistema
   elettorale offre un meccanismo di salvaguardia attraverso pesi
   elettorali allineati al censimento della popolazione. Il modello si basa
   sul quadro concettuale delle democrazie a condivisione di potere nelle
   societ \& agrave; profondamente divise. Per verificare la validit \&
   agrave; e la necessit \& agrave; di questo modello elettorale, il
   presente lavoro confronta i casi regionali di Berna, Cipro e della
   Federazione di Bosnia ed Erzegovina.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
