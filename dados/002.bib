@article{ WOS:001809468400001,
Author = {Persson, Thomas and Widmalm, Sten and Casselbrant, Andre},
Title = {Speaking freely or staying silent? Self-censorship and democratic
   discontent in Sweden},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 JUN 30},
Abstract = {This article examines the prevalence and patterns of self-censorship in
   Sweden - widely regarded as one of the world's leading democracies -
   against the backdrop of global autocratization. While self-censorship is
   often studied in authoritarian contexts, we explore its occurrence in a
   democratic setting that has almost no formal constraints on free
   expression. Drawing on original survey data, we identify the
   individual-level factors associated with self-censorship, and we assess
   its variation across social contexts and issue areas. We find that
   self-censorship is both widespread and politically patterned. It is most
   common among individuals on the political right - especially
   sympathizers with the Sweden Democrats - as well as among persons who
   perceive immigration as a threat, who have low interpersonal or
   institutional trust, and who are strongly interested in politics.
   Self-censorship is most prevalent on social media, but it is also found
   in workplaces, educational settings, and personal relationships. The
   topic of immigration and integration is the one most often avoided,
   reflecting the polarized nature of public discourse on this question in
   Sweden. These results highlight how informal pressures - not just formal
   censorship - can narrow public discourse and suppress dissent, with
   potential consequences for democratic resilience and pluralism.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
