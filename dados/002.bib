@article{ WOS:001786708200001,
Author = {Goldfien, Michael A. and Joseph, Michael F. and Mcmanus, Roseanne W.},
Title = {The Domestic Sources of International Trust},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2026},
Month = {2026 JUN 8},
Abstract = {How do states overcome mistrust? Scholars argue that costly foreign
   policy signals build trust. But when trust is low, such as during
   rivalries, states are unwilling to use these signals for fear of being
   cheated. We argue that domestic policies can also build trust by
   revealing information about a state's likelihood of cooperating
   internationally when there is a correlation between domestic and
   international preferences. We further argue that domestic policies have
   a distinct advantage: the value states accrue from them depends less on
   international reciprocation. As a result, domestic choices can reassure
   counterparts at moments when trust is so low that costly international
   signals appear prohibitively risky. We test the implications of our
   theory in case studies of the Cold War's end and United States-South
   Korea trust-building post-coup, illuminating several phenomena the
   current literature struggles to explain: initial trust-building between
   enduring rivals, asymmetric trust-building, and trust-building through
   illiberal domestic policies.},
