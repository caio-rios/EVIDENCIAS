
@article{ WOS:001818815700001,
Author = {Kosiara-Pedersen, Karina},
Title = {Record-high fragmentation, clean drinking water and pigs' welfare: the
   Danish General Election 2026},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 JUL 3},
Abstract = {The Prime Minister herself called the 2022-2026 government weird, and it
   was special since it was made up of the two traditional major opponents.
   The election was called for no specific reason but it would have been no
   later than 31 October 2026. All 12 parties fielding candidates in the
   election gained representation. This resulted in a highly fragmented
   parliament, and no majority for either side, hence leaving the Moderates
   in the pivotal position - exactly where party leader Lars L \&
   oslash;kke Rasmussen wanted to be placed. The election yielded a
   four-leaf clover centre-left minority coalition government, formed with
   the support of the left-wing parties, but with expected collaboration
   with the centre-right parties.},
