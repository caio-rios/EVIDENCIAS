@article{ WOS:001799764600001,
Author = {Little, Conor},
Title = {The general election of November 2024 in the Republic of Ireland: Fianna
   Fáil and Fine Gael renew their vows},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {6},
Pages = {1602-1611},
Month = {SEP 19},
Abstract = {In the 2024 Irish elections, the main governing parties emerged
   more-or-less unscathed, with the largest party, Fianna F \& aacute;il,
   growing its seat share. Fianna F \& aacute;il and Fine Gael continued to
   lead the government, consolidating the core of a new coalition formula.
   As in 2020-2024, the political landscape would involve a centre-right
   government facing a predominantly left-of-centre opposition led by Sinn
   F \& eacute;in. The far right did not make significant inroads at the
   election, even if it did organise and contest the election to an extent
   not previously seen.},
