@article{ WOS:001754958100001,
Author = {Vallet, Cyrille},
Title = {Extractivism, ecocentrism and democracy. Imaginaries around rights of
   river and legal personhood of the Rhone River},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {128},
Month = {JUN},
Abstract = {In the context of the ecological crises, Rights of Nature and legal
   personhood have been proposed as potential solutions. Various studies
   focus on contextual, legal and operational implementation. In this
   contribution, the question is posed of how the legal personhood is
   materialized through imaginaries of what the river should be. I first
   introduce the three imaginaries mobilized: extractivism, ecocentrism and
   democracy. I then put forward three hypotheses which are subsequently
   tested through the discourses of actors on the Rhone River, a
   transboundary highly industrialized river where some proponents of the
   legal personhood are active. I demonstrate that the extractivist
   imaginary is well instituted, while the eco-centric imaginary cannot yet
   be seen as indicative of a comprehensive economic and political program.
   Promoters of the Rights of Nature are advocating new decision-making
   processes, which challenge the democratic imaginary. The conclusion
   drawn is that the Rights of Nature and legal personhood could be a way
   to re-enchant our Western democracies.},
