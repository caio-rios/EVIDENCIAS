@article{ WOS:001772078200001,
Author = {Mitteregger, Reto and Jocker, Thomas},
Title = {Do They Want, Can They, and Have They Been Asked? Generational
   Differences in Reasons for Non-Voting in Switzerland},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {2},
Pages = {218-244},
Month = {JUN},
Abstract = {In many advanced democracies, newer generations and younger citizens are
   less likely to vote than earlier generations and older individuals.
   However, despite this being an established empirical matter, less is
   known about the reasons why they decide to stay away from the polls.
   This' Age-Period-Cohort' (APC) study analyzes generational and age
   differences in reasons for abstaining using Swiss SELECTS post-election
   survey data from 1995 to 2023. We specifically examine the self-reported
   motivations of abstainers and how they diverge across cohorts and age
   groups. Our analysis demonstrates that newer cohorts of Swiss citizens
   are more likely to justify their abstention by indicating low levels of
   political interest and a lack of political knowledge, whereas age
   differences in reason-giving point to higher levels of political
   disillusionment among older non-voters. These findings have broad
   implications for understanding the higher levels of electoral abstention
   of younger generations and highlight ways of addressing these issues.},
