@article{ WOS:001740017800001,
Author = {Jalali, Carlos},
Title = {Preaching to the non-practising: religiosity, Chega and electoral
   change in Portugal},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2026},
Volume = {31},
Number = {2, SI},
Pages = {241-272},
Month = {APR 3},
Abstract = {Portugal's 2024 election marked a major electoral shift, driven by the
   radical right populist Chega. This article examines religious voting in
   2024, situating it within trends since 2002. Crucially, 2024 changes
   previous patterns. Rather than separating the Socialist Party from the
   centre-right and the radical left, the religious divide is relocated,
   distinguishing Chega from other parties. Despite its religious populism,
   Chega fails to mobilise practising Catholics, suggesting a vaccine
   effect, whereby regular churchgoers are comparatively resistant to
   voting for the radical right. Instead, it draws disproportionate support
   from cultural Catholics, who identify as Catholic but do not attend
   church. Overall, the study demonstrates how religious populism can
   reconfigure religious voting.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
