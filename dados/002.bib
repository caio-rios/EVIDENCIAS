@article{ WOS:001800854400001,
Author = {Milosav, Dorde and D'Arcy, Michelle},
Title = {Capturing legitimacy in captured states: an interview-based exploration
   of the validity of existing legitimacy measures in Serbia's hybrid
   regime},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 JUN 19},
Abstract = {Legitimacy is a foundational concept in political science typically
   measured through surveys assessing citizen perceptions of political
   institutions. However, the validity of existing measures is often
   assumed rather than tested, especially in hybrid regimes where
   institutional capture blurs distinctions between office and
   office-holder. Drawing on original semi-structured interviews with
   Serbian citizens, we find that conflation - the inability to separate
   office and office-holder - was high for questions on input side
   institutions such as trust in the president, the prime minister and the
   parliament, lower for output side institutions, such as the police,
   court and the tax authority, and most varied between respondents for
   general system questions. Our analysis suggests two main reasons for
   this pattern: first, citizens' evaluations of elected institutions rely
   more heavily on mediated information sources (e.g. TV, internet, print
   media), whereas views of bureaucratic institutions are often grounded in
   direct personal experience; second, respondents showed a weaker
   understanding of democratic principles than of expectations around
   public service delivery. These findings highlight potential item bias
   both between respondents within a hybrid regime and in cross-regime
   comparisons, calling into question the comparability and validity of
   standard legitimacy measures in European hybrid regimes.},
