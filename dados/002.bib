@article{ WOS:001784238200001,
Author = {Berndtsson, Joakim and Kruck, Andreas and Weiss, Moritz},
Title = {Bringing society (back) in? Defence transformations across Europe in the
   Zeitenwende},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 MAY 12},
Abstract = {European states have not responded uniformly to the growing Russian
   threat. While some states addressed it in a hierarchical mode of state
   capacity-building, others expanded the involvement of society in defence
   in a networked mode. What explains these varying degrees of societal
   involvement in European countries' defence policy making since 2014?
   Drawing on theories of path dependence and domestic approaches to
   defence policy, this article argues that the more domestic legacies
   favour inclusive and collaborative defence policy making, the more the
   respective country will involve the society in a networked mode. A
   comparative analysis of Sweden's, Germany's, and France's responses to
   Russia's war against Ukraine reveals a general increase in societal
   involvement but also cross-country variation consistent with the
   theoretical expectations of the domestic legacies' hypothesis. The
   article extends domestic theories of defence policy making to the
   politically vital but under-researched issue of societal involvement,
   while pointing to a Zeitenwende in strategic thinking.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
