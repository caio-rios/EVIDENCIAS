@article{ WOS:001756754800001,
Author = {Smith, Sara and Gergan, Mabel Denzin},
Title = {What is the frontier to the migrating bird? Ladakh, education-driven
   migration, and the frontier as home},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {129},
Month = {AUG},
Abstract = {The Himalaya have been narrated as a natural frontier-an ungovernable
   buffer between colonized South Asia and the rest of the continent, by
   colonial and postcolonial state powers. But what about those who call
   the frontier home? How do their understandings of place map onto these
   geonarratives of the frontier? In this article, we take up the concept
   of the geonarrative-how histories, stories, and knowledges are mobilized
   or even weaponized to untangle the ways the Himalayan frontier has been
   narrated from a distance by those who do not inhabit it. We explore how
   such narrations intersect with discourses of remoteness, racialization,
   and the temporal-spatial imaginaries that have long shaped the region.
   Tracing imperial and post-independence India's practices of knowledge
   production-through cartographic, material, and ideological means-we
   foreground how the frontier has been brought into the fold of empire and
   nation-building. Following Du Bois's question, ``How does it feel to be
   a problem?{''} we ask, ``How does it feel to be a frontier?{''} Drawing
   on our long-term work in Ladakh, we take up this question by centering
   the daily lived experiences of people for whom the frontier is
   home-including young college students who crisscross these mountains in
   pursuit of their own futures, and whose migratory trajectories both
   reinforce and trouble dominant frontier imaginaries.},
