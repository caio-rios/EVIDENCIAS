@article{ WOS:001779400400001,
Author = {Mohammadpour, Ahmad},
Title = {Dispossessed geographies: Statelessness and eco-resistance in Rojhelat},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {128},
Month = {JUN},
Abstract = {This article advances a decolonial sketch for understanding
   environmental racism in Iran by centering Rojhelat (Eastern/Iranian
   Kurdistan) as a site of what I conceptualize as a stateless ecology, an
   environmental condition inflicted when a nation or culture lacks
   meaningful political sovereignty over its own territory. Moving beyond
   Western-centric environmental justice approaches, the article
   articulates Persian-Shi'a nationalism as a racializing project that
   weaponizes environmental degradation to erode Kurdish land, life, and
   ecology. I focus on landmines, militarized wildfires, and dam
   construction to pinpoint how environmental governance in Rojhelat is
   structured through securitization, infrastructural abandonment, and
   extractive intervention. Drawing on Indigenous and decolonial thought,
   the article conceptualizes Kurdish eco-activism as an Indigenous
   politics of care, memory, and refusal that contests the state
   sovereignty and nationalist environmentalism. In doing so, the article
   reframes environmental justice through the lens of ecological
   sovereignty and anti-colonial selfdetermination.},
