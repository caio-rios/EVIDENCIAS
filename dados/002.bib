@article{ WOS:001804698800001,
Author = {Gerber, Elia and Freiburghaus, Rahel and Vatter, Adrian},
Title = {How the Electoral System Influences Personalization and Individual
   Campaign Spending: Evidence from Switzerland's First-Time Finance
   Disclosure Regulations},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {2},
Pages = {412-430},
Month = {JUN},
Abstract = {Personalization-greater candidate-centeredness at the expense of
   political parties-is a defining feature of 21st-century electoral
   politics. But to what extent does the electoral system shape this trend?
   We develop a theoretical argument rooted in the design of open-list
   proportional representation (OLPR). Because OLPR combines proportional
   seat allocation with intra-party competition, it creates opportunities
   for candidates to cultivate a personal vote. We argue that when the
   institutional potential for individual preference votes to shape
   electoral outcomes is high, candidates respond by investing more in
   personalized campaigning, reflected in higher individual campaign
   spending. We test this argument using novel data from the 2023 Swiss
   federal elections, the first held under mandatory campaign finance
   disclosure rules. Our findings show that greater voter ability to
   allocate individual preference votes is associated with higher
   in-dividual campaign spending, demonstrating how electoral systems
   influence candidate behavior and the role of money in politics.
   Die Personalisierung - eine st \& auml;rkere Ausrichtung auf die
   einzelnen Kandidierenden auf Kosten der politischen Parteien - ist ein
   pr \& auml;gendes Merkmal der Wahlen des 21. Jahrhunderts. Doch in
   welchem Ma ss e pr \& auml;gt das Wahlsystem diesen Trend? Wir
   entwickeln ein theoretisches Argument, das auf dem Prinzip der offenen
   Liste bei Verh \& auml;ltniswahlen (OLPR) basiert. Da die OLPR eine
   proportionale Sitzzuteilung mit parteiinternem Wettbewerb verbindet, er
   \& ouml;ffnet sie Kandidat{*}innen die M \& ouml;glichkeit, eine pers \&
   ouml;nliche W \& auml;hlerschaft aufzubauen. Wir argumentieren: Wenn das
   institutionelle Potenzial von Personenstimmen f \& uuml;r die Bestimmung
   von Wahlergebnissen hoch ist, reagieren Kandidat{*}innen mit h \&
   ouml;heren Investitionen in personalisierte Wahlkampagnen, was sich in h
   \& ouml;heren individuellen Wahlkampfausgaben widerspiegelt. Wir pr \&
   uuml;fen dieses Argument anhand neuer Daten der Schweizer
   Parlamentswahlen 2023, den ersten, die unter den Regeln der
   obligatorischen Offenlegung der Kampagnenfinanzierung stattfanden.
   Unsere Ergebnisse zeigen, dass ein gr \& ouml;sser Spielraum der W \&
   auml;hlenden, individuelle Pr \& auml;ferenzstimmen zu vergeben, mit h
   \& ouml;heren individuellen Wahlkampfausgaben einhergeht, und
   verdeutlichen damit wie Wahlsysteme das Kandidat{*}innenverhalten und
   die Rolle des Geldes in der Politik beeinflussen.
   La personnalisation - une plus grande centralit \& eacute; des candidat
   \& centerdot;es au d \& eacute;triment des partis politiques - est une
   caract \& eacute;ristique d \& eacute;terminante de la politique \&
   eacute;lectorale du XXIe si \& egrave;cle. Mais dans quelle mesure le
   syst \& egrave;me \& eacute;lectoral fa \& ccedil;onne-t-il cette
   tendance? Nous d \& eacute;veloppons un argument th \& eacute;orique
   fond \& eacute; sur la structure de la repr \& eacute;sentation
   proportionnelle avec liste ouverte (RPLO). Parce que la RPLO combine une
   allocation proportionnelle des si \& egrave;ges et une comp \&
   eacute;tition intra-parti, elle cr \& eacute;e des opportunit \&
   eacute;s pour les candidat \& centerdot;es de cultiver un vote
   personnel. Nous soutenons que lorsque le potentiel institutionnel des
   votes de pr \& eacute;f \& eacute;rence individuels pour influencer les
   r \& eacute;sultats \& eacute;lectoraux est \& eacute;lev \& eacute;,
   les candidat \& centerdot;es r \& eacute;agissent en investissant
   davantage dans des campagnes personnalis \& eacute;es, ce qui se traduit
   par des d \& eacute;penses de campagne individuelles plus \& eacute;lev
   \& eacute;es. Nous testons cet argument \& agrave; l'aide de donn \&
   eacute;es in \& eacute;dites issues des \& eacute;lections f \& eacute;d
   \& eacute;rales suisses de 2023, les premi \& egrave;res \& agrave; s'\&
   ecirc;tre tenues sous le r \& eacute;gime des r \& egrave;gles
   obligatoires de divulgation du financement des campagnes. Nos r \&
   eacute;sultats montrent qu'une plus grande capacit \& eacute; des \&
   eacute;lecteur \& centerdot;rice \& centerdot;s \& agrave; attribuer des
   votes de pr \& eacute;f \& eacute;rence individuels est associ \&
   eacute;e \& agrave; des d \& eacute;penses de campagne individuelles
   plus \& eacute;lev \& eacute;es, d \& eacute;montrant ainsi comment les
   syst \& egrave;mes \& eacute;lectoraux influencent le comportement des
   candidat \& centerdot;es et le r \& ocirc;le de l'argent en politique.
   La personalizzazione - una maggiore centralit \& agrave; delle
   candidature a scapito dei partiti politici - \& egrave; un tratto
   distintivo della politica elettorale del XXI secolo. Ma in che misura il
   sistema elettorale modella questa tendenza? Sviluppiamo una tesi teorica
   fondata sul meccanismo della rappresentazione proporzionale a lista
   aperta (OLPR). Poich \& eacute; l'OLPR combina l'assegnazione
   proporzionale dei seggi con la competizione intra-partitica, crea
   opportunit \& agrave; per chi si candida di coltivare un voto personale.
   Sosteniamo che quando il potenziale istituzionale dei voti di preferenza
   individuali nella determinazione dei risultati elettorali \& egrave;
   elevato, le persone candidate rispondono investendo maggiormente in
   campagne personalizzate, il che si riflette in una maggiore spesa
   elettorale individuale. Mettiamo alla prova questa tesi utilizzando dati
   inediti relativi alle elezioni federali svizzere del 2023, le prime
   tenutesi secondo le regole di divulgazione obbligatoria dei
   finanziamenti della campagna elettorale. I nostri risultati dimostrano
   che una maggiore capacit \& agrave; del corpo elettorale di assegnare
   voti di preferenza individuali \& egrave; associata a una spesa
   elettorale individuale pi \& ugrave; elevata, dimostrando come i sistemi
   elettorali influenzino il comportamento dei candidati e delle candidate
   e il ruolo del denaro in politica.},
