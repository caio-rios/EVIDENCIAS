@article{ WOS:001753559500001,
Author = {Liu, Yu and Zhu, Meng and Zhang, Kaiping and Wu, Wenquan},
Title = {The power of `big brothers': political leaders and regime changes in
   authoritarian states},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2026},
Month = {2026 APR 30},
Abstract = {Various perspectives have been proposed to explain regime change under
   authoritarianism, yet the role of autocrats- `the elephant in the room'-
   remains largely unexamined in large-N studies. This study addresses this
   gap by employing the Randomization Inference method that reshuffles
   historical leadership sequences as counterfactuals. Analyzing data from
   150 countries between 1946 and 2020, we find strong evidence that
   autocrats contribute substantially to variance in regime change and that
   their influence extends in both authoritarian and democratic directions.
   We also find that democratic leaders play a significant role in
   democratic backsliding but not in democratic deepening. Our findings
   contribute to the agency-structure debate on regime change by providing
   a systematic large-N validation of the agency perspective, thus
   complementing prior studies that have relied primarily on fragmented
   case studies.},
Publisher = {SAGE PUBLICATIONS LTD},
Address = {1 OLIVERS YARD, 55 CITY ROAD, LONDON EC1Y 1SP, ENGLAND},
