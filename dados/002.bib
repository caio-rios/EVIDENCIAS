@article{ WOS:001732678600001,
Author = {Gay-Antaki, Miriam},
Title = {The price of climate finance: Agency, knowledge and refusal in Mexico},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {128},
Month = {JUN},
Abstract = {Mexico receives the most international climate finance in Latin America
   after Brazil, yet there is little empirical evidence on lived
   experiences of people encountering climate finance initiatives. This
   paper works at the intersection of geographical perspectives on climate
   finance; feminist decolonial critiques of climate change; and feminist
   critiques on the coloniality of power. I argue that climate finance
   operates as a mechanism of epistemological imperialism, that reproduces
   colonial hierarchies through racialized-gendered logics positioning
   global South knowledge producers as perpetually deficient. Drawing on
   interviews with Mexican academics, government officials, and NGO
   representatives, I demonstrate how climate finance systematically
   excludes national priorities, community-based approaches, and
   sophisticated local climate knowledge, while siphoning resources to
   global North actors and institutions. I interpret Mexican actors'
   response through affirmative refusal, bringing into conversation
   decolonial feminisms with Black radical thought. Rather than accepting
   subordination, Mexican climate actors create spaces of mutual obligation
   organized through climate justice principles rather than debt-credit
   logic. Through affirmative refusal as feminist decolonial praxis, they
   forge alternatives that generate climate action beyond climate finance's
   reach.},
