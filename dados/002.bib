@article{ WOS:001720303200001,
Author = {Gennaro, Gloria},
Title = {Immigration, Public Housing, and Support for the French National Front},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {3},
Pages = {1011-1026},
Month = {JUL 1},
Abstract = {In Europe, urban peripheries that host public housing estates are often
   inhabited by a diverse population, including many migrants. In those
   places, far-right parties enjoy growing electoral support. This article
   asks, can expansionary public housing policies boost the electoral
   support of far-right parties in diverse communities? I exploit the
   staggered rollout of a French public housing policy to show that
   residents of municipalities with large pre-policy immigration shares
   vote more for the National Front in response to public housing
   expansion. The opposite happens in municipalities with low pre-policy
   exposure to immigration. The article investigates three potential
   mechanisms: compositional changes, material grievances, and latent group
   conflict. Separate empirical analyses of sociodemographic, housing, and
   newspaper data suggest that the third mechanism may drive the results.
   The article further discusses the theoretical and practical implications
   of these findings for understanding the challenges of adapting the
   welfare state to increasingly diverse societies.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
