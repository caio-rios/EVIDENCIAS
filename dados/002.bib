@article{ WOS:001782261500001,
Author = {Marquis, Lionel and Sparer, Jessy},
Title = {Poverty Attributions and Voting Choices in the 2023 Swiss National
   Elections},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {2},
Pages = {299-331},
Month = {JUN},
Abstract = {Is poverty a relevant issue for Swiss electoral politics and political
   behavior? In this paper we answer that question by showing that
   citizens' agreement with different causal attributions of poverty
   matters for their voting decisions. Of highest relevance is the
   difference between an ``individual blame{''} explanation (i.e., the poor
   are lazy) and a ``social blame{''} explanation (i.e., poverty arises
   from social injustice), which has various consequences for voting in
   favor of left, centrist, liberal, and radical right parties. Using data
   from the 2023 Selects panel survey, we show that poverty attributions
   are robustly associated with voting, and that these associations tend to
   be larger among more knowledgeable and involved voters. Finally, we show
   important nuances within the right camp, as social blame is negatively
   associated with voting for the Liberal Party, but not with voting for
   radical right parties.
   Ist Armut ein relevantes Thema f \& uuml;r Wahlpolitik und politisches
   Verhalten in der Schweiz? In diesem Beitrag beantworten wir diese Frage,
   indem wir aufzeigen, dass die Zustimmung zu verschiedenen Attributionen
   von Armut (causal attributions of poverty) die Wahlentscheidungen der B
   \& uuml;rger beeinflusst. Von gr \& ouml;sster Relevanz ist der
   Unterschied zwischen einer Erkl \& auml;rung, die die Schuld beim
   Einzelnen sucht (d. h. die Armen sind faul), und einer Erkl \&
   auml;rung, die der Gesellschaft die Schuld gibt (d. h. Armut entsteht
   durch soziale Ungerechtigkeit), was unterschiedliche Konsequenzen f \&
   uuml;r die Stimmabgabe zugunsten von linken, zentristischen, liberalen
   und rechtsextremen Parteien hat. Anhand von Daten aus der
   Selects-Panelbefragung von 2023 zeigen wir, dass die Zuschreibung von
   Armutssursachen einen robusten Zusammenhang mit dem Wahlverhalten
   aufweist und dass dieser Zusammenhang bei besser informierten und
   interessierten W \& auml;hlern tendenziell st \& auml;rker ist.
   Schliesslich zeigen wir wichtige Nuancen innerhalb des rechten Lagers
   auf, da die soziale Schuldzuweisung negativ mit der Stimmabgabe f \&
   uuml;r die Liberale Partei, aber nicht f \& uuml;r rechtsextreme
   Parteien, verbunden ist.
   La pauvret \& eacute; est-elle un enjeu pertinent pour la politique \&
   eacute;lectorale et le comportement politique en Suisse ? Dans cet
   article, nous montrons que l'adh \& eacute;sion des citoyens \& agrave;
   diff \& eacute;rentes attributions causales de la pauvret \& eacute;
   contribue \& agrave; fa \& ccedil;onner leurs d \& eacute;cisions de
   vote. Une opposition claire se dessine entre une explication fond \&
   eacute;e sur la \& laquo; faute individuelle \& raquo; (paresse) et une
   explication fond \& eacute;e sur la \& laquo; responsabilit \& eacute;
   sociale \& raquo; (injustice sociale) et se refl \& egrave;te dans le
   vote en faveur des partis de gauche, du centre, de droite lib \&
   eacute;rale et de droite radicale. \& Agrave; l'aide de l'enqu \&
   ecirc;te panel Selects de 2023, nous montrons que les attributions de la
   pauvret \& eacute; sont solidement associ \& eacute;es au vote,
   particuli \& egrave;rement chez les \& eacute;lecteurs mieux inform \&
   eacute;s et plus int \& eacute;ress \& eacute;s par les questions
   sociales. Enfin, des nuances importantes apparaissent au sein du camp de
   droite, car la responsabilit \& eacute; sociale est n \&
   eacute;gativement associ \& eacute;e au vote pour le Parti lib \&
   eacute;ral, mais pas pour les partis de droite radicale.
   La povert \& agrave; \& egrave; una questione rilevante per la politica
   elettorale e il comportamento politico in Svizzera? In questo articolo
   rispondiamo a tale domanda dimostrando che il consenso dei cittadini
   sulle diverse attribuzioni causali della povert \& agrave; influisce
   sulle loro decisioni di voto. Di massima rilevanza \& egrave; la
   differenza tra una spiegazione basata sulla ``colpa individuale{''}
   (ovvero, i poveri sono pigri) e una spiegazione basata sulla ``colpa
   sociale{''} (ovvero, la povert \& agrave; deriva dall'ingiustizia
   sociale), che ha diverse conseguenze sul voto a favore di partiti di
   sinistra, di centro, liberali e di estrema destra. Utilizzando i dati
   dell'indagine panel Selects del 2023, dimostriamo che le attribuzioni
   della povert \& agrave; sono fortemente associate al voto e che queste
   associazioni tendono ad essere pi \& ugrave; marcate tra gli elettori pi
   \& ugrave; informati e coinvolti. Infine, evidenziamo importanti
   sfumature all'interno dello schieramento di destra, poich \& eacute; la
   colpa sociale \& egrave; associata negativamente al voto per il Partito
   Liberale, ma non al voto per i partiti di estrema destra.},
