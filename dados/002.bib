@article{ WOS:001748820000001,
Author = {Kirshbaum, Sara M.},
Title = {Standing in the Gateway: Incidental Participation as a Mobilizer for
   Voting and Donating},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 APR 25},
Abstract = {Traditional mobilization tactics pre-suppose that the best (if not only)
   indicator of likelihood of voting in the future is voting in the past.
   However, there are many forms of political participation that are
   utilized and needed for a healthy democracy to function. Establishing a
   consistently participatory and representative electorate requires a
   broader understanding of the gateways through which people enter
   politics. This project examines one such gateway, asking: Can an
   incidental form of political participation impact future likelihood to
   participate in politics? Using a novel dataset that tracks four forms of
   participation with administrative data and multiple statistical tests, I
   find that individuals who are invited to and participate in signing a
   petition are more likely to participate in multiple forms of political
   activity in the future. This is the case for both individuals who have
   and who have not been as active in politics in the past.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
