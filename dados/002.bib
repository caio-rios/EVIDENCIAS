@article{ WOS:001737575000001,
Author = {Eisner, Leila and Rosset, Jan and Varone, Frederic},
Title = {Perceptual accuracy, policy congruence and electoral success of
   candidates},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {2},
Pages = {354-370},
Month = {JUN},
Abstract = {Recent research has documented that politicians are not good at
   estimating citizens' policy preferences, though their ability to do so
   varies across parties and individuals. The postulated link between this
   low perceptual accuracy and substantive representation has rarely been
   explored empirically. We analyse whether politicians' perceptual
   inaccuracy corresponds to a systematic opinion gap between candidates
   and their party voters. We also assess whether perceptual accuracy and
   policy congruence increase the likelihood of being elected among
   candidates. Our study presents levels of policy congruence between
   candidates and their party voters across various policy proposals, as
   well as levels of perceptual accuracy on the same items. It shows that
   candidates tend to over-estimate their electorate's level of
   conservatism. However, this does not translate into a systematic
   representation gap as candidates have more extreme positions than their
   electorate. Finally, neither perceptual accuracy nor policy congruence
   are associated with the likelihood of being elected.
   Aktuelle Forschungsarbeiten belegen, dass Politiker{*}Innen die
   politischen Pr \& auml;ferenzen der B \& uuml;rger{*}Innen nur
   unzureichend einsch \& auml;tzen k \& ouml;nnen, wobei diese F \&
   auml;higkeit je nach Partei und Individuum variiert. Der postulierte
   Zusammenhang zwischen dieser geringen Wahrnehmungsgenauigkeit und der
   substanziellen Repr \& auml;sentation wurde bisher selten empirisch
   untersucht. Wir analysieren, ob die mangelnde Wahrnehmungsgenauigkeit
   von Politiker{*}Innen mit einer systematischen Meinungskluft zwischen
   Kandidat{*}Innen und ihren Parteiw \& auml;hler{*}Innen einhergeht.
   Zudem untersuchen wir, ob Wahrnehmungsgenauigkeit und politische
   Kongruenz die Wahlwahrscheinlichkeit der Kandidat{*}Innen erh \&
   ouml;hen. Unsere Studie zeigt das Ausmass der politischen Kongruenz
   zwischen Kandidat{*}Innen und ihren Parteiw \& auml;hler{*}Innen bei
   verschiedenen politischen Vorschl \& auml;gen sowie die
   Wahrnehmungsgenauigkeit bei denselben Themen auf. Sie zeigt, dass
   Kandidat{*}Innen dazu neigen, ihre W \& auml;hlerschaft als zu
   konservativ einzusch \& auml;tzen. Dies f \& uuml;hrt jedoch nicht zu
   einer systematischen Repr \& auml;sentationsl \& uuml;cke, da
   Kandidat{*}Innen extremere Positionen einnehmen als ihre W \&
   auml;hlerschaft. Schliesslich stehen weder Wahrnehmungsgenauigkeit noch
   politische Kongruenz im Zusammenhang mit der Wahlwahrscheinlichkeit.
   Des recherches r \& eacute;centes ont montr \& eacute; que les
   responsables politiques peinent \& agrave; estimer les pr \& eacute;f \&
   eacute;rences politiques des citoyen.ne.s, bien que cette capacit \&
   eacute; varie selon les partis et les individus. Le lien postul \&
   eacute; entre cette faible pr \& eacute;cision de perception et la repr
   \& eacute;sentation substantielle a rarement fait l'objet d'\&
   eacute;tudes empiriques. Nous analysons si l'impr \& eacute;cision
   perceptive des politicien.ne.s correspond \& agrave; un \& eacute;cart
   d'opinion syst \& eacute;matique entre les candidat.e.s et les \&
   eacute;lecteur.trice.s de leur parti. Nous \& eacute;valuons \&
   eacute;galement si la pr \& eacute;cision de la perception et la
   congruence politique augmentent la probabilit \& eacute; d'\&
   eacute;lection des candidat.e.s. Notre \& eacute;tude pr \& eacute;sente
   les niveaux de congruence politique entre les candidat.e.s et leurs \&
   eacute;lecteur.trice.s sur diverses propositions politiques, ainsi que
   les niveaux de pr \& eacute;cision de la perception sur ces m \&
   ecirc;mes points. Elle montre que les candidat.e.s ont tendance \&
   agrave; surestimer le niveau de conservatisme de leur \&
   eacute;lectorat. Toutefois, cela ne se traduit pas par un \& eacute;cart
   de repr \& eacute;sentation syst \& eacute;matique, car les candidat.e.s
   occupent des positions plus extr \& ecirc;mes que leur \&
   eacute;lectorat. Enfin, ni la pr \& eacute;cision de la perception ni la
   congruence politique ne sont associ \& eacute;es \& agrave; la
   probabilit \& eacute; d'\& ecirc;tre \& eacute;lu.e.
   Ricerche recenti hanno documentato che i politici non sono abili nello
   stimare le preferenze politiche dei cittadini, sebbene questa capacit \&
   agrave; vari tra partiti e individui. Il legame ipotizzato tra questa
   scarsa accuratezza percettiva e la rappresentanza sostanziale \& egrave;
   stato raramente esplorato empiricamente. Analizziamo se l'imprecisione
   percettiva dei politici corrisponda a un divario sistematico di opinione
   tra i candidati e gli elettori del loro partito. Valutiamo inoltre se
   l'accuratezza percettiva e la congruenza politica aumentino la
   probabilit \& agrave; di elezione dei candidati. Il nostro studio
   presenta i livelli di congruenza politica tra candidati ed elettori su
   diverse proposte politiche, nonch \& eacute; i livelli di accuratezza
   percettiva sugli stessi temi. Emerge che i candidati tendono a
   sovrastimare il livello di conservatorismo del proprio elettorato.
   Tuttavia, ci \& ograve; non si traduce in un divario di rappresentanza
   sistematico, poich \& eacute; i candidati mantengono posizioni pi \&
   ugrave; estreme rispetto al loro elettorato. Infine, n \& eacute;
   l'accuratezza percettiva n \& eacute; la congruenza politica risultano
   associate alla probabilit \& agrave; di essere eletti.},
