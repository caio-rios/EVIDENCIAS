@article{ WOS:001717072800001,
Author = {De Jong, Marlotte and Butt, Bilal and Adunbi, Omolade},
Title = {Spaces of private conservation: State effects and hierarchical autonomy
   in private wildlife conservation},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {128},
Month = {JUN},
Abstract = {Over the past two decades, private wildlife conservancies have expanded
   across Kenya alongside state protected areas. Challenging framings that
   position conservancies as either filling governance gaps or acting as
   state subcontractors, this paper demonstrates that conservancies
   simultaneously reinforce and displace state authority, producing hybrid
   sovereignties. Drawing on Trouillot's theory of state effects, we
   examine how private conservancies operationalize isolation,
   identification, spatialization, and legibility to govern landscapes and
   populations. Rather than undermining state sovereignty, conservancies
   enable strategic delegation: the Kenyan state outsources costly,
   contentious governance functions to private actors who exercise coercive
   authority, while retaining ultimate control and accruing primary
   benefits. This produces hierarchies of autonomy in which conservancy
   managers wield substantial power over surrounding
   communities-determining resource access, authorizing force, deploying
   surveillance-yet operate beyond democratic accountability. By
   foregrounding institutional practices and individual decision-makers, we
   reveal how private conservation concentrates state-like authority in
   elite hands while distributing accountability to invisibility, with
   profound implications for environmental justice and conservation
   governance globally.},
Publisher = {ELSEVIER SCI LTD},
