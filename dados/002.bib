@article{ WOS:001808867900001,
Author = {Alkoc, Nursel and Tresch, Anke and Rennwald, Line},
Title = {The Effect of Topic Salience on Nonresponse, Self-Reported Turnout and
   Party Choice: An Experimental Study from the Swiss Election Study
   (Selects)},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {2},
Pages = {458-482},
Month = {JUN},
Abstract = {Political surveys are subject to nonresponse bias, leading to
   overestimated voter turnout and, at times, underestimated support for
   far-right parties. This study examines whether altering the salience of
   a survey's topic at the recruitment stage affects survey participation
   and nonresponse bias, and with what trade-offs. Using the panel survey
   of the Swiss Election Study (Selects 2023), respondents were randomly
   assigned to a high-salience condition emphasizing federal elections or a
   low-salience condition referring more broadly to societal and political
   issues. Low-salience framing modestly altered the composition of
   respondents in the first wave, increasing the share of non-voters and
   Swiss People's Party (SVP) voters, but also led to higher dropout in the
   second wave. Recruitment framing thus shapes who enters and remains in
   the survey: while it broadens initial participation, it reduces
   retention over time. Topic framing is therefore a relevant but
   constrained tool for addressing nonresponse bias in political surveys.
   Politische Umfragen unterliegen einem Non-Response-Bias, was zu einer \&
   Uuml;bersch \& auml;tzung der Wahlbeteiligung und teils zu einer
   Untersch \& auml;tzung der Unterst \& uuml;tzung f \& uuml;r
   rechtspopulistische Parteien f \& uuml;hrt. Diese Studie untersucht, ob
   die Ver \& auml;nderung der Salienz eines Umfragethemas in der
   Rekrutierungsphase die Teilnahmebereitschaft und den Non-Response-Bias
   beeinflusst und welche Zielkonflikte dabei bestehen. Unter Verwendung
   der Panelbefragung der Schweizer Wahlstudie (Selects 2023) wurden
   Teilnehmende zuf \& auml;llig einer Gruppe mit hoher Salienz (Betonung
   der nationalen Wahlen) oder einer Gruppe mit niedriger Salienz
   (allgemeinerer Bezug auf gesellschaftliche und politische Themen)
   zugewiesen. Ein Framing mit niedriger Salienz ver \& auml;nderte die
   Zusammensetzung der Befragten in der ersten Welle geringf \& uuml;gig:
   Der Anteil der Nichtw \& auml;hlerinnen sowie der W \& auml;hlerinnen
   der Schweizerischen Volkspartei (SVP) stieg, jedoch f \& uuml;hrte dies
   auch zu einer h \& ouml;heren Abbruchquote in der zweiten Welle. Das
   Rekrutierungs-Framing bestimmt somit, wer an der Umfrage teilnimmt und
   wer dabei bleibt: W \& auml;hrend es die anf \& auml;ngliche
   Teilnahmebereitschaft erh \& ouml;ht, verringert es die Bindung \&
   uuml;ber die Zeit. Thematisches Framing ist daher ein wichtiges, aber
   begrenztes Instrument zum Umgang mit Non-Response-Bias in politischen
   Umfragen.
   Les sondages politiques sont sujets \& agrave; des biais de non-r \&
   eacute;ponse, conduisant \& agrave; une surestimation de la
   participation \& eacute;lectorale et, parfois, \& agrave; une
   sous-estimation du soutien aux partis de droite populiste. Cette \&
   eacute;tude examine si la modification de la saillance du sujet d'une
   enqu \& ecirc;te au stade du recrutement affecte la participation et le
   biais de non-r \& eacute;ponse, et avec quels arbitrages. En utilisant
   l'enqu \& ecirc;te par panel de l'\& Eacute;tude \& eacute;lectorale
   suisse (Selects 2023), les personnes interrog \& eacute;es ont \&
   eacute;t \& eacute; assign \& eacute;es de mani \& egrave;re al \&
   eacute;atoire \& agrave; une condition de forte saillance (insistant sur
   les \& eacute;lections f \& eacute;d \& eacute;rales) ou \& agrave; une
   condition de faible saillance (faisant r \& eacute;f \& eacute;rence
   plus largement \& agrave; des enjeux soci \& eacute;taux et politiques).
   Le cadrage \& agrave; faible saillance a modestement modifi \& eacute;
   la composition des r \& eacute;pondant \& centerdot;es lors de la premi
   \& egrave;re vague, augmentant la part des non-votant \& centerdot;es et
   des \& eacute;lecteurs et \& eacute;lectrices de l'Union d \&
   eacute;mocratique du centre (UDC), mais a \& eacute;galement entra \&
   icirc;n \& eacute; un taux d'attrition plus \& eacute;lev \& eacute;
   lors de la deuxi \& egrave;me vague. Le cadrage du recrutement fa \&
   ccedil;onne ainsi qui entre dans l'enqu \& ecirc;te et qui y reste: bien
   qu'il \& eacute;largisse la participation initiale, il r \& eacute;duit
   la r \& eacute;tention au fil du temps. Le cadrage th \& eacute;matique
   est donc un outil pertinent mais limit \& eacute; pour traiter le biais
   de non-r \& eacute;ponse dans les sondages politiques.
   I sondaggi politici sono soggetti a bias di mancata risposta, che
   portano a una sovrastima dell'affluenza alle urne e, talvolta, a una
   sottostima del sostegno ai partiti di estrema destra. Questo studio
   esamina se la modifica della salienza dell'argomento di un sondaggio
   nella fase di reclutamento influenzi la partecipazione e il bias di
   mancata risposta, e con quali compromessi. Utilizzando l'indagine panel
   dello Studio elettorale svizzero (Selects 2023), le persone interpellate
   sono state assegnate casualmente a una condizione di alta salienza
   (enfasi sulle elezioni federali) o a una condizione di bassa salienza
   (riferimento pi \& ugrave; ampio a questioni sociali e politiche). Il
   framing a bassa salienza ha modificato modestamente la composizione del
   campione nella prima ondata, aumentando la quota di non votanti e di
   elettori ed elettrici dell'Unione Democratica di Centro (UDC), ma ha
   anche portato a un tasso di abbandono pi \& ugrave; elevato nella
   seconda ondata. Il framing di reclutamento modella quindi chi partecipa
   e chi rimane nel sondaggio: se da un lato amplia la partecipazione
   iniziale, dall'altro riduce la fidelizzazione nel tempo. Il framing
   tematico \& egrave; pertanto uno strumento pertinente ma limitato per
   affrontare il bias di mancata risposta nei sondaggi politici.},
