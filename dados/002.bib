@article{ WOS:001726834900001,
Author = {Rafa, Nazifa},
Title = {Governing through temporariness: Disaster, temporal
   governmentality, and refugee agency in the Rohingya camps},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {128},
Month = {JUN},
Abstract = {While scholarship has conceptualised camps as spaces of ``permanent
   temporariness{''}, less attention has been paid to the temporal politics
   of disaster management within camp settings. This article examines how
   temporariness is mobilised as a strategy of governmentality in the
   Rohingya refugee camps of Bangladesh, and how refugees enact temporal
   forms of agency in response. Drawing on ethnographic engagement and
   interviews, I introduce the concept of temporal governmentality to
   illustrate the management of disasters in displacement contexts through
   time. It shows how the Bangladeshi state and humanitarian actors
   co-produce this temporal regime by institutionalising short planning
   cycles, enforcing material impermanence, and invoking environmental
   logics that naturalise disaster risk. These practices suspend refugees
   in a perpetual present, sustaining protracted displacement and producing
   disaster vulnerability and precarious living conditions. At the same
   time, refugees engage in situated temporal agency, strategically
   synchronising with, resisting, and reinterpreting these temporal
   structures. From anticipating aid delays to informally reinforcing
   infrastructures, their actions represent contingent practices that make
   survival possible within the temporal logics of humanitarian
   governmentality. This article seeks to advance debates on refugee
   governance, protracted displacement, and disaster studies by
   articulating temporality as both a technology of control and a terrain
   of agency. It argues that attention to the tensions between top-down
   governmentality and bottom-up refugee agency is crucial for
   understanding how states manage protracted displacement settings under
   the backdrop of intensifying climate risks, and how refugees remake the
   horizons of possibility within these deferred futures.},
