@article{ WOS:001782887600001,
Author = {Fatima, Shumaila},
Title = {Disassembling accountability and democracy: varied effects of elements
   of accountability and democracy on public trust},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 MAY 28},
Abstract = {Previous literature on the impact of democracy on public trust is
   inconsistent. While some researchers find democracy associated with
   increased public trust, others find the opposite impact or no
   association between democracy and public trust. These inconsistent and
   contradictory findings may be due to the way democracy is measured and
   defined. There are many different facets of democracy, yet they are
   rarely delineated or decomposed to succinctly measure specific
   phenomena. To fill this gap in the previous literature, I conduct a
   two-way fixed effect regression with clustered robust standard errors
   for cross-national panel data of 161 countries on the relationship
   between public trust in governance and forms of accountability. I use
   Transparency International's corruption perception index as the outcome
   variable and forms of accountability, vertical, diagonal, horizontal,
   and comprehensive, as the main predictor variables and measure of
   democracy. I control for clean election, education equality, GDPPC, FDI,
   and total population. I find aggregated and diagonal accountability
   significantly associated with the trust measure, and vertical and
   horizontal accountability fail to reach a level of significance.
   Variations in the influence of comprehensive accountability and the
   types of accountability suggest the need to account for the individual
   components that make up accountability and democracy.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Fatima, S (Corresponding Author), Univ S Florida, Dept Sociol \& Interdisciplinary Social Sci, Tampa, FL 33620 USA.
   Fatima, Shumaila, Univ S Florida, Dept Sociol \& Interdisciplinary Social Sci, Tampa, FL 33620 USA.},
DOI = {10.1080/13510347.2026.2666833},
EarlyAccessDate = {MAY 2026},
ISSN = {1351-0347},
EISSN = {1743-890X},
Keywords = {Democratic elements; electoral democracy; vertical accountability;
