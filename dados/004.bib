@article{ WOS:001610178700001,
Author = {Timoneda, Joan C. and Escriba-Folch, Abel and Haynes, Kyle},
Title = {The trajectories of personalization: how dictators accumulate power over
   time},
Journal = {DEMOCRATIZATION},
Year = {2025},
Month = {2025 NOV 5},
Abstract = {This article examines the process by which leaders consolidate power at
   the expense of their support groups. While institutionalized power
   sharing has been widely studied, the steps, timing, and trajectories of
   personalization remain under-explored. Based on prior theoretical
   insights, we identify two main personalization pathways shaped by the
   leader's initial strength relative to the ruling coalition. First,
   dictators with weak initial positions gamble for resurrection by
   aggressively reshaping their inner circle early on in their tenures.
   Second, dictators with stronger initial positions consolidate control
   over the regime's structures over time. Strong leaders consolidate
   swiftly, while those with moderate strength follow a gradual, piecemeal
   approach, first securing control over appointments before purging rivals
   and establishing control over institutions. We adopt a multi-method
   approach to empirically evaluate our claims. First, quantitative tests
   using the disaggregated components of Geddes et al.'s (2018) data for
   the 1946-2010 period broadly support our claims across the population of
   cases. Brief case vignettes then help clarify the distinction between
   the different paths. These trajectories are a novel and important puzzle
   in the study of authoritarian politics and understanding them can help
   practitioners identify emerging strongmen and anticipate instability in
   global politics.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
