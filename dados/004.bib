@article{ WOS:001642835800001,
Author = {Fossati, Diego and Wong, Mathew Yh},
Title = {The egalitarian paradox: Democratic values, perceived inequality and
   political support},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {47},
Number = {5},
Pages = {784-799},
Month = {NOV},
Abstract = {A substantial body of literature suggests that economic inequality has
   negative repercussions on the functioning and quality of democracy. At
   the individual level, several studies have shown that satisfaction with
   democracy is lower among citizens who perceive high levels of
   inequality. However, the link between perceptions of inequality and
   democratic attitudes is more complex if we consider that democracy
   encompasses an egalitarian ethos and is often believed to have
   inequality-reducing properties. A higher perceived inequality can
   therefore have a dual impact on democratic attitudes: it may increase
   dissatisfaction with how democracy is implemented, but at the same time
   reinforce support for democratic principles and strengthen demand for a
   more democratic political regime. Empirical support for this thesis is
   found with an analysis of eight original surveys conducted in East and
   Southeast Asia, a region where economic development is crucial for
   democratic legitimacy.},
