@article{ WOS:001617016000001,
Author = {Dodeigne, Jeremy},
Title = {Hostility and democratic erosion: introducing the Political Hostility
   Scale (PHOS)},
Journal = {DEMOCRATIZATION},
Year = {2025},
Month = {2025 NOV 18},
Abstract = {Hostile rhetoric has become increasingly salient in contemporary
   democracies, as elite polarization now extends far beyond policy
   disagreement and adversarial debates towards ridicule, incivility, and
   even exclusionary or violent discourse. While mainstream concepts such
   as polarization usefully capture part of this trend, they remain too
   encompassing and obscure core differences in hostility types. Not all
   forms of hostility pose the same threat to democracy. Drawing on
   multidisciplinary scholarship, this article makes two main
   contributions. First, it introduces the Political Hostility Scale
   (PHOS), an integrated framework for analysing escalating forms of
   hostile rhetoric - ranging from (1) adversarial hostility and (2)
   incivility to (3) intolerance and (4) belligerence. Second, it proposes
   a normative threshold distinguishing agonistic from antagonistic
   hostility: the point at which partisan rivals are no longer treated as
   legitimate ``adversaries to be opposed{''} but as ``enemies to be
   eliminated{''}. This change in kind - not merely in intensity - marks a
   critical turning point for democratic erosion. By refining existing
   conceptual debates and providing a systematic tool, PHOS enables
   scholars to track hostile rhetoric comparatively and longitudinally,
   offering an early-warning instrument for identifying when democratic
   backsliding becomes imminent.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
