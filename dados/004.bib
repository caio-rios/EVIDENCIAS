@article{ WOS:001508845500003,
Author = {Engst, Benjamin G. and Grundmanns, David M. and Gschwend, Thomas},
Title = {How to Place Non-Majoritarian Institutions and Political Actors in a
   Common Policy Space: Spatial Modeling of Court-Executive Interactions},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {4},
Pages = {1335-1349},
Month = {OCT 1},
Abstract = {How can we estimate positions of non-majoritarian institutions in a
   common policy space? To answer this question, we take the highest courts
   as examples of powerful non-majoritarian institutions and develop a new
   scaling approach to estimate their positions in a common policy space
   with other political actors. In contrast to previous research, our
   approach neither relies on individual votes of justices nor assumes that
   justices ``inherit{''} positions from political actors who nominated
   them. Instead, for each court decision, we use the positions of
   political actors expressed in written statements as well as the courts'
   decision outcome to estimate comparable policy positions. In two
   applications, we position the German Federal Constitutional Court with
   different German governments and the European Court of Justice with
   different European governments in common policy spaces and validate
   them. Finally, we show how our common policy scores can be used to study
