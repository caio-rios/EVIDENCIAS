@article{ WOS:001596440400001,
Author = {Toklo, Sewordor and Allor, Precious Wedaga and Oboro-Offerie, Ruby
   Amanda},
Title = {Democracy under threat? The influence of perceived insecurity on public
   support for democratic governance in Africa},
Journal = {DEMOCRATIZATION},
Year = {2025},
Month = {2025 OCT 17},
Abstract = {While democracy has expanded globally, recent years have witnessed its
   erosion, even in longstanding democratic systems, often challenged by
   authoritarian-populist movements. At the heart of democratic resilience
   lies public support. Without public support, democratic institutions
   become fragile and vulnerable, particularly in times of crisis. This
   study shows how perceived insecurity influences democratic attitudes in
   Africa. We employ nearest neighbour matching techniques to estimate the
   impact of personal insecurity on democracy. We find that feeling unsafe,
   whether from neighbourhood crime or fear at home, reduces support for
   and satisfaction with democracy, highlighting the importance of everyday
   security for democratic legitimacy.},
