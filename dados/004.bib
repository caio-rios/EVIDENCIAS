@article{ WOS:001629137000001,
Author = {Kermani, Hossein and Neyazi, Taberez Ahmed and Lecheler, Sophie},
Title = {The Limits of Computational Propaganda: Investigating Underexplored
   Platforms and Contexts},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Volume = {43},
Number = {1},
Pages = {89-98},
Month = {JAN 2},
Abstract = {Despite a growing body of literature on computational propaganda,
   significant gaps remain in the existing literature, particularly in its
   Western-centric focus and emphasis on leading platforms, such as
   Twitter. This symposium attempts to address these gaps and extend our
   understanding of computational propaganda beyond Western contexts. The
   contributions of this symposium offer new theoretical insights, such as
   Performative Propaganda Engagement and the Reference Point Adjustment,
   to the literature. It also presents new empirical evidence from
   underexplored contexts, including Indonesia, the Philippines, China,
   Turkey, and Thailand. The papers published in the symposium provide a
   fresh understanding of these non-Western governments' novel tactics and
   practices in sharing computational propaganda, which is not necessarily
   limited to conventional forms of disinformation or social platforms.
   This essay introduces the collection by outlining the concept of
   computational propaganda, examining its core components, and identifying
   enduring gaps in the literature, before demonstrating how the included
   contributions address these gaps.},
