@article{ WOS:001601045300001,
Author = {Jenkins, Nash},
Title = {Mundane Heresy: The Subversive Communicative Style of Young
   Conservatives in the United States},
Journal = {POLITICAL COMMUNICATION},
Year = {2025},
Volume = {42},
Number = {6},
Pages = {1129-1149},
Month = {NOV 2},
Abstract = {This ethnographic study examines the social and political meaning-making
   processes that cohere a group of young conservative students in a
   College Republicans group at a private American university under a
   common political identity. Expanding on recent work identifying feelings
   of social estrangement and marginalization as inherent to contemporary
   right-wing political attachment, this article introduces the concept of
   mundane heresy to describe the provocative group style through which
   these students construct a liminal social space defined by its
   opposition to a dominant liberal campus culture. While recent
   scholarship approaches right-wing incivility as a mode of public
   political expression, I highlight similar transgressive practices in
   nonpublic social contexts, where the insularity of the group both
   recuperates their perceived estrangement and shields them from external
   social sanction. Through the group bonds constructed through this
   process, students produce a shared political identity defined not by
   political ideology but social heterodoxy.},
