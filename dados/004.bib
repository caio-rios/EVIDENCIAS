@article{ WOS:001622310400001,
Author = {Corantin, Keisha},
Title = {Settling on their ground: The shifting land politics of armed actors in
   the urban margins of Medellin},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {124},
Month = {JAN},
Abstract = {How do armed groups shape land orders in the urban margins? While the
   power dynamics of non-state armed actors over land resources have been
   extensively studied in rural contexts, urban settings have received far
   less attention. In response to the growing influence of criminal
   organizations in the informal land markets of Latin American cities,
   this article offers a historical perspective on the involvement of armed
   actors in Medellin's political economy of urban land. From guerrilla
   movements in the 1970s to contemporary criminal gangs, we trace how
   different groups have exercised land control in informal settlements.
   Building on this historical perspective, we argue that, while control
   over land access has long been a tool of territorialization for
   non-state armed actors, the contemporary criminal land market reflects a
   shift compared to earlier periods, as these actors seek to monopolize
   land control and extend their regulatory power over local populations.},
