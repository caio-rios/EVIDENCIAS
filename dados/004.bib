@article{ WOS:001608715500001,
Author = {Perello, Lucas and Agote, Pablo and Navia, Patricio},
Title = {Shade-grown authoritarianism? Revisiting coffee as a curse in Latin
   America and the Caribbean},
Journal = {DEMOCRATIZATION},
Year = {2025},
Month = {2025 NOV 5},
Abstract = {Studies have shown that, in many cases, natural resources can act as a
   curse, hindering democratization. However, much of what we know about
   the resource curse is derived almost exclusively from petroleum. This
   article builds on a rich body of work and expands those findings by
   exploring whether coffee yields similar results. The field remains
   split: some suggest that coffee exports and production restrain
   democracy by strengthening authoritarian regimes, while others are
   skeptical or reject that proposition. We contribute to the debate by
   examining the relationship between coffee exports and democracy levels
   in 17 Latin American and Caribbean countries from 1962 to 2010. Our
   two-way fixed effects model, instrumental variable design,
   difference-in-difference estimations, and dynamic effects for staggered
   treatments reveal an insightful non-finding. Echoing the claims of
   coffee curse skeptics, coffee has not had a significant impact on
   democracy in the region.},
