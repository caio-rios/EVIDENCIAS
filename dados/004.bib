@article{ WOS:001613300200001,
Author = {Del Panta, Gianni and Guidi, Mattia and Klingelhofer, Tristan},
Title = {The disproportional consequences of a proportional bargain: candidate
   selection within Italian electoral coalitions in 2022},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2026},
Volume = {31},
Number = {1},
Pages = {119-145},
Month = {JAN 2},
Abstract = {While disproportionality is traditionally attributed to the confluence
   of electoral system dynamics and the distribution of party support, this
   article identifies an additional mechanism: the allocation of
   candidacies among pre-electoral coalition partners. We analyse the 2022
   Italian election and show that intra-coalition disproportionality
   (especially on the right) resulted from an ostensibly proportional
   bargaining agreement, which was later undermined by shifts in party
   support between the time of candidate allocation and election day. We
   reflect on the broader implications of intra-coalition
   disproportionality for parliamentary representation and government
   formation and outline which parts of our argument extend beyond the 2022
   Italian election.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
