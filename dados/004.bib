@article{ WOS:001581722500001,
Author = {Ferreira da Silva, Frederico},
Title = {Affective polarisation and voting behavior in Portugal (2002-2024):
   consistent levels, growing electoral relevance},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2026},
Volume = {31},
Number = {2, SI},
Pages = {273-295},
Month = {APR 3},
Abstract = {While affective polarisation is seen as a defining feature of
   contemporary democracies, its implications for individual-level
   electoral behaviour remain underexplored. This article analyzes
   affective polarisation in Portugal between 2002 and 2024 and examines
   its correlation with voting behaviour, using post-electoral survey data
   from the Portuguese Election Study. It analyzes how contextual factors,
   such as the Great Recession and the entry of populist radical right
   parties into parliament, shaped the relationship between affective
   polarisation and voting behaviour. The results show moderate and stable
   levels of affective polarisation in Portugal, suggesting a modest
   influence of contextual factors on longitudinal trends. However, they
   also uncover a growing association between affective polarisation and
   electoral participation, and a positive correlation with voting for
   left- vs. right-wing parties.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
