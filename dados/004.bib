@article{ WOS:001626164300001,
Author = {Kros, Mathijs},
Title = {Ethnic harassment and political engagement of immigrants in Europe},
Journal = {WEST EUROPEAN POLITICS},
Year = {2025},
Month = {2025 NOV 7},
Abstract = {This article highlights the importance of ethnic harassment for the
   political engagement of immigrants in Europe. Previous research suggests
   that such negative experiences can either mobilise or demobilise
   immigrants. This article addresses these incongruent results by
   distinguishing between institutionalised and non-institutionalised forms
   of political engagement. It argues that how ethnic harassment affects
   engagement depends on the type of political activity. The results from
   logistic regression models, based on data from 12,659 respondents from
   17 countries, show that ethnic harassment is related to less political
   trust and a lower likelihood to vote in national elections but to a
   higher likelihood to participate in non-institutionalised political
   activities (demonstrations and petitioning). Moreover, results show that
   each instance of harassment can relate to more political engagement
   among people other than the initial victim. Such ripple effects have
   long been suggested in the literature, and this article puts them to an
   empirical test.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
