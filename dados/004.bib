@article{ WOS:001592482800001,
Author = {Silva, Tiago and Costa Lobo, Marina},
Title = {The 2024 European Parliament elections in Portugal: media, results, and
   vote determinants in national and European elections},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2026},
Volume = {31},
Number = {3, SI},
Pages = {395-421},
Month = {JUL 3},
Abstract = {This study examines the 2024 European Parliament election in Portugal by
   testing the second-order national election (SONE) model across three key
   dimensions: media coverage, electoral outcomes, and voting behaviour.
   Drawing on both media content and opinion survey data, the analysis
   moves beyond single-aspect studies to offer a more integrated
   perspective on the campaign and its effects. While the SONE model
   remains a useful framework, the results suggest important variation
   across dimensions and parties. The findings contribute to ongoing
   debates about the Europeanisation of EP elections and the evolving role
   of EU-level factors in shaping national political dynamics.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
