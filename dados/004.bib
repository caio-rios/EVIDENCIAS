@article{ WOS:001508845500002,
Author = {Poblete-Cazenave, Ruben},
Title = {Reputation Shocks and Strategic Political Responses},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {4},
Pages = {1431-1449},
Month = {OCT 1},
Abstract = {Information affecting a candidate's reputation might have significant
   consequences for elections and policymaking. Does information affect
   candidates' behavior? Using Brazilian elections and audits as an
   exogenous source of information, I show that (1) politicians respond to
   information by adapting political campaigns and public policy, and (2)
   the reaction depends on the information content. Both incumbent and
   challenger increase their campaign spending when detrimental information
   affects the incumbent's reputation. Conversely, beneficial information
   decreases candidates' spending. As information affects the expected
   competitiveness of elections, candidates adapt their spending
   accordingly. Yet, only information disclosed before electoral campaigns
   impacts spending. Furthermore, incumbents also adapt a conditional cash
   transfers program by increasing (decreasing) the beneficiaries when
   detrimental (beneficial) reputation shocks occur. The results shed light
   on how and when politicians react to different information shocks.},
