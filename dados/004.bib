@article{ WOS:001598153700001,
Author = {Clarke, Edward J. R. and Eckerle, Frank and Kerr, John R. and Hill,
   Stephen R. and Ling, Mathew and Marques, Mathew D. and Williams, Matt N.},
Title = {Extremism at the center: Uncovering political diversity among midpoint
   responders on the left-right self-placement item},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2026},
Volume = {47},
Number = {4},
Month = {JUN 9},
Abstract = {The midpoint of the left-right self-placement item is hiding important
   political diversity, and may be conflating moderate responders with
   populists and other political sub-groups. Survey researchers should
   consider this problem when examining relationships between political
   orientation and political attitudes. We suggest testing for
   non-linearity in these relationships, and measuring anti-establishment
   and populist beliefs separately. Researchers interested in building
   theories explaining the psychological underpinnings of ideological
   extremism should also consider the possibility that a qualitatively
   different type of ideological extremist self-places on the midpoint.},
