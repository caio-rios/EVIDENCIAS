@article{ WOS:001592455400001,
Author = {Huang, Kai-Ping and Koh, Young Joon},
Title = {Citizen attitudes and democratic resilience in Taiwan and Thailand: a
   comparative perspective},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {7},
Pages = {1789-1815},
Month = {OCT 3},
Abstract = {This article examines how values of checks and balances and pluralism
   influence individuals' democratic support in Taiwan and Thailand. The
   study categorizes citizens into four groups based on their commitment to
   democracy and their opposition to authoritarianism, allowing for an
   analysis of how democratic support has evolved along political events in
   the two countries. The findings indicate that checks and balances hold
   particular significance in Thailand, where it acts as a strong pushback
   to authoritarianism. In Taiwan, pluralism is crucial in bolstering its
   democratic regime. However, high levels of political polarization reduce
   democratic support, specifically when dealing with the legacies of
   authoritarian regimes. This study underscores the complex relationship
   between citizen values, political context, and democratic support,
   highlighting the need to consider the unique historical and political
   circumstances of each country when assessing the factors that contribute
   to democratic resilience.},
