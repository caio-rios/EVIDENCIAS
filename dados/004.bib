@article{ WOS:001619665200001,
Author = {Bates, Genevieve},
Title = {Threats and Commitments: International Tribunals and Domestic Trials in
   Peace Negotiations},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2025},
Month = {2025 NOV 21},
Abstract = {Does International Criminal Court (ICC) involvement affect the
   agreements parties to a civil conflict make, especially regarding
   matters of accountability? In this article, I argue that the ICC places
   a unique pressure on domestic elites negotiating peace in the wake of
   political violence. To avoid going to trial in the international arena,
   elites facing the threat of punishment have an incentive to agree to
   implement some form of domestic accountability, showing the Court that
   they can handle their own business. I evaluate my argument using data on
   the content of peace agreements negotiated between 2002 and 2019. I find
   that ICC involvement increases the probability that negotiators commit
   to accountability during peace processes. To explore potential
   mechanisms and more explicitly evaluate alternative explanations, I draw
   on case studies from Colombia and Sudan.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
