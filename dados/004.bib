@article{ WOS:001590896600001,
Author = {Lee, Amber Hye-Yon and Ahn, Chloe},
Title = {Talking Politics in a Polarized America: How Perceived Polarization
   Shapes Political Self-Censorship},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Volume = {48},
Number = {3},
Pages = {1661-1676},
Month = {SEP},
Abstract = {In today's polarized political climate, discussing politics can feel
   tricky or even risky. Many Americans report feeling uncomfortable and
   cautious about expressing their political views publicly and often
   choose to remain silent. What drives political self-censorship? This
   study examines how individuals' perceptions of the national political
   climate (specifically, perceived polarization) influence their
   willingness to speak. We argue that perceiving greater polarization and
   division in society heightens the perceived social costs of political
   expression, particularly in contexts where individuals are uncertain
   about how their views will be received, such as in interactions with
   those outside their close social circles. Using nationally
   representative panel data and an online survey experiment, we find that
   individuals who perceive greater polarization are more likely to
   self-censor. These effects occur primarily in public settings and
   interactions involving weak ties, acquaintances, and strangers,
   precisely the contexts where exposure to diverse perspectives is most
   likely. Our findings demonstrate that perceptions of the broader
   political environment can shape patterns of individual political
   expression, with implications for the availability of diverse viewpoints
   in the public sphere.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
