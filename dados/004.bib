@article{ WOS:001624951300001,
Author = {Choi, Ha Eun and de Marchi, Scott and Gallop, Max and Minhas, Shahryar},
Title = {Decisive or Distracted: The Effects of US Constraint on Security
   Networks},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2025},
Volume = {55},
Month = {NOV 27},
Abstract = {The rise of China as a global power has been a prominent feature in
   international politics. Simultaneously, the United States has been
   engaged in ongoing conflicts in the Middle East and South Asia for the
   past two decades, requiring a significant commitment of resources,
   focus, and determination. This paper investigates how third-party
   countries react to the United States' preoccupation with these
   conflicts, particularly in terms of diplomatic co-operation and
   alignment. We introduce a measure of US distraction and utilize
   network-based indicators to assess diplomatic co-operation or alignment.
   Our study tests the hypothesis that when the US is distracted, other
   states are more likely to co-operate with its principal rival, China.
   Our findings support this hypothesis, revealing that increased
   co-operation with China is more probable during periods of US
   distraction. However, a closer examination of state responses shows that
   democracies distance themselves from China under these circumstances,
   while non-democracies move closer.},
Publisher = {CAMBRIDGE UNIV PRESS},
