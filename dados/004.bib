@article{ WOS:001611865700001,
Author = {Costa, Patricio and Jalali, Carlos and Silva, Patricia},
Title = {Too young to party, ready to say enough? Youth turnout and the rise of
   Chega in Portugal},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2026},
Volume = {31},
Number = {2, SI},
Pages = {209-239},
Month = {APR 3},
Abstract = {This article investigates youth turnout and voting behaviour in Portugal
   in the new millennium. Using data from eight legislative elections and
   employing logistic regression models and multiple correspondence
   analysis, we explore how age, socioeconomic factors, and political
   preferences influence youth voting. While turnout of youth is
   consistently lower, the generational gap has remained stable,
   challenging the idea of a widening generational divide. We identify
   life-cycle effects, with participation increasing with age. Cluster
   analysis reveals marked intra-group differences: socioeconomic
   integration, especially higher education and active employment,
   increases the likelihood of voting, whereas political dissatisfaction
   and socioeconomic disengagement correlate with abstention. Yet
   discontent can also mobilise participation: in 2024, it was a key driver
   of youth support for the populist radical-right Chega.},
