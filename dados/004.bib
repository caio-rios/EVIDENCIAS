Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {nicholas.carnes@duke.edu
   noam.lupu@vanderbilt.edu},
Affiliations = {Duke University; Vanderbilt University},
Funding-Acknowledgement = {University of Southern California; Vanderbilt University},
Funding-Text = {We are grateful to Pablo Beramendi, Maria Carreri, Amanda Clayton, Sarah
   Cueva, Kristin Goss, Jonas Pontusson, Jesse Rhodes, Jan Rosset, Mallory
   Sorelle, Guillermo Toral, and seminar participants at University of
   Geneva; University of California, San Diego; University of Southern
