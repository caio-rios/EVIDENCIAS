@article{ WOS:001493258300004,
Author = {Bergman, Matthew E. and Krauss, Svenja and Thurk, Maria},
Title = {``In for a Penny, in for a Pound?{''} Evidence That Government Support
   Parties Cannot Dissociate Themselves from the Prime Minister's Party},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {4},
Pages = {1645-1649},
Month = {OCT 1},
Abstract = {Research has demonstrated that voters use coalition heuristics in their
   perceptions of party policy shifts: Junior coalition partners are
   perceived to shift in parallel to prime minister parties, while no such
   effect is found for opposition parties. Still, little is known of how
   voters perceive government support parties. Support parties publicly
   commit to side with the government on crucial votes yet are not formally
   represented in cabinet. We argue that voters indeed associate formal
   support parties with the cabinet and apply coalition heuristics
   accordingly. Drawing on data from 21 European countries, we provide
   evidence that voters perceive support parties shifting in parallel with
   the prime minister. To increase the internal validity of our
   cross-country findings, we additionally draw on an illustrative case
   study of Spain with individual-level panel data, which conforms to
   theoretical expectations. Our results have important implications for
   electoral competition, partisan behavior, and (minority) government
   formation.},
