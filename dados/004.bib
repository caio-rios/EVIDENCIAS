@article{ WOS:001626429200001,
Author = {Jung, Hoyong},
Title = {Transboundary Air Pollution and Public Opinions on Neighbouring
   Countries: Evidence from South Korea},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {47},
Number = {4},
Pages = {627-646},
Month = {SEP},
Abstract = {Air pollution is a transnational phenomenon with the potential to
   influence public perceptions and international attitudes. This study
   examines whether fine dust originating from China - particularly in the
   form of yellow dust - affects South Koreans' attitudes toward Chinese
   people. Using an instrumental variable approach to address endogeneity,
   the analysis finds little evidence of a significant relationship between
   objective pollution levels and anti-China sentiment. These results
   remain consistent across multiple model specifications. To interpret
   these results, the study examines the role of media and political
   communication in shaping public perceptions, suggesting how subjective
   attitudes may diverge from objective environmental conditions.},
Publisher = {SAGE PUBLICATIONS LTD},
