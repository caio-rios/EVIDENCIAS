@article{ WOS:001619260200001,
Author = {Marie, Awenig},
Title = {Why Do Politicians Overestimate Richer Voters' Opinions? Social
   Background and Interest Group Influence},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {1},
Pages = {102-128},
Month = {MAR},
Abstract = {Research on political representation has shown that the opinions of
   poorer voters are less well represented than those of richer voters.
   This study examines inequalities in politicians' perceptions of public
   opinion and investigates why some politicians have biased perceptions
   that favour richer voters. Two factors were considered. Firstly,
   descriptive representation is expected to play a role, with politicians
   from higher-status backgrounds being more likely to overestimate the
   opinions of higher-income voters. Secondly, politicians reporting
   contact with profit-oriented business groups are more likely to
   misperceive public opinion in favour of richer voters. This research
   uses data from surveys of politicians and citizens in Switzerland.
   Citizens gave their preferences regarding concrete policy issues, and
   politicians estimated public opinion on these same issues. The analysis
   finds a significant effect of politicians' backgrounds: politicians with
   higher-status backgrounds are more likely to misperceive public opinion
   in favour of richer voters compared to working-class politicians.
   Die Forschung zur politischen Repr \& auml;sentation zeigt, dass die
   Meinungen weniger wohlhabender W \& auml;hler{*}innen in politischen
   Entscheidungen weniger ber \& uuml;cksichtigt werden als jene von
   wohlhabenderen W \& auml;hler{*}innen. Diese Studie untersucht
   Ungleichheiten in den Wahrnehmungen der \& ouml;ffentlichen Meinung
   durch gew \& auml;hlte Repr \& auml;sentant{*}innen und analysiert,
   weshalb diese Wahrnehmungen zugunsten einkommensstarker W \&
   auml;hler{*}innen verzerrt sein k \& ouml;nnten. Zwei Mechanismen werden
   untersucht: die deskriptive Repr \& auml;sentation, bei der Repr \&
   auml;sentant{*}innen aus privilegierten sozialen Milieus das Gewicht der
   Meinungen wohlhabenderen W \& auml;hler{*}innen \& uuml;bersch \&
   auml;tzen, und die Einflussnahme von Interessengruppen, die durch
   Kontakte zu Wirtschaftsverb \& auml;nden verzerrte Wahrnehmungen beg \&
   uuml;nstigen k \& ouml;nnen. Die Untersuchung basiert auf Umfragedaten
   aus der Schweiz und kombiniert eine Befragung von B \& uuml;rger{*}innen
   (Erfassung der Pr \& auml;ferenzen zu politischen Sachfragen) mit einer
   Befragung gew \& auml;hlter Repr \& auml;sentant{*}innen (Erhebung ihrer
   Wahrnehmung der \& ouml;ffentlichen Meinung zu denselben Sachfragen).
   Die Ergebnisse zeigen einen signifikanten Effekt der sozialen Herkunft:
   Im Vergleich zu Repr \& auml;sentant{*}innen aus niedrigeren sozialen
   Schichten neigen solche aus h \& ouml;heren sozialen Schichten eher
   dazu, die \& ouml;ffentliche Meinung zugunsten wohlhabenderer W \&
   auml;hler{*}innen falsch einzusch \& auml;tzen.
   Les travaux sur la repr \& eacute;sentation politique montrent de fortes
   in \& eacute;galit \& eacute;s: les opinions des \& eacute;lectrices et
   \& eacute;lecteurs les moins fortun \& eacute;.e.s sont moins prises en
   compte dans les d \& eacute;cisions publiques. Cet article examine les
   in \& eacute;galit \& eacute;s dans les perceptions qu'ont les \&
   eacute;lu.e.s de l'opinion publique et analyse pourquoi ces perceptions
   peuvent \& ecirc;tre biais \& eacute;es en faveur des \&
   eacute;lectrices et \& eacute;lecteurs aux revenus \& eacute;lev \&
   eacute;s. Deux m \& eacute;canismes sont examin \& eacute;s: la repr \&
   eacute;sentation descriptive (les \& eacute;lu.e.s issu.e.s de milieux
   favoris \& eacute;s surestiment le poids des opinions des \&
   eacute;lectrices et \& eacute;lecteurs ais \& eacute;.e.s) et
   l'influence des groupes d'int \& eacute;r \& ecirc;ts \&
   eacute;conomiques. Cette recherche s'appuie sur des donn \& eacute;es
   collect \& eacute;es en Suisse, combinant une enqu \& ecirc;te aupr \&
   egrave;s de citoyen.ne.s (mesurant leurs pr \& eacute;f \& eacute;rences
   sur plusieurs enjeux politiques) et une enqu \& ecirc;te aupr \&
   egrave;s de parlementaires (\& eacute;valuant leur perception de
   l'opinion sur ces m \& ecirc;mes enjeux). Les r \& eacute;sultats r \&
   eacute;v \& egrave;lent un effet significatif du milieu social: les \&
   eacute;lu.e.s issu.e.s des classes sociales sup \& eacute;rieures per \&
   ccedil;oivent davantage l'opinion publique comme align \& eacute;e sur
   les pr \& eacute;f \& eacute;rences des \& eacute;lectrices et \&
   eacute;lecteurs ais \& eacute;.e.s.
   Gli studi sulla rappresentanza politica dimostrano che le opinioni degli
   elettori meno abbienti sono meno considerate nelle decisioni pubbliche
   rispetto a quelle degli elettori pi \& ugrave; facoltosi. Questo
   articolo esamina le disuguaglianze presenti nelle percezioni
   dell'opinione pubblica da parte dei parlamentari e analizza perch \&
   eacute; tali percezioni possono risultare distorte a favore degli
   elettori con redditi elevati. Vengono esaminati due meccanismi: la
   rappresentanza descrittiva (i rappresentanti provenienti da contesti
   privilegiati sovrastimano il peso delle opinioni degli elettori
   abbienti) e l'influenza dei gruppi di interesse economici. La ricerca si
   basa su dati raccolti in Svizzera, combinando un'indagine rivolta ai
   cittadini (che misura le preferenze su questioni politiche) e
   un'indagine rivolta ai parlamentari (che valuta la loro percezione
   dell'opinione pubblica sulle stesse questioni). I risultati evidenziano
   un effetto significativo dell'origine sociale: i parlamentari
   provenienti dalle classi superiori percepiscono maggiormente l'opinione
   pubblica come allineata alle preferenze degli elettori pi \& ugrave;
   abbienti.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Marié, A (Corresponding Author), ULB, Campus Solbosch Ave FD Roosevelt 50 CP 124, B-1050 Brussels, Belgium.
   Marie, Awenig, Univ Libre Bruxelles, Cevipol, Brussels, Belgium.},
DOI = {10.1111/spsr.70021},
EarlyAccessDate = {NOV 2025},
ISSN = {1424-7755},
EISSN = {1662-6370},
Keywords = {Descriptive representation; Inequalities; Interest groups; Perceptions;
