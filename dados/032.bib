@article{ WOS:000373710300001,
Author = {Soroka, Stuart N. and Johnston, Richard and Kevins, Anthony and Banting,
   Keith and Kymlicka, Will},
Title = {Migration and welfare state spending},
Journal = {EUROPEAN POLITICAL SCIENCE REVIEW},
Year = {2016},
Volume = {8},
