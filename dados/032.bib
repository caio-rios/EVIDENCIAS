ORCID-Numbers = {Koch, Natalie/0000-0003-4064-4620},
Funding-Acknowledgement = {Social Sciences Research Council; Andrew W. Mellon Foundation; Syracuse
   University's Geography Department; Maxwell School for Citizenship and
   Public Affairs},
Funding-Text = {This paper has benefited from the many insights of Political Geography's
   reviewers and editorial team, as well as from Neha Vora's stimulating
   feedback throughout this project's development and writing. Thanks also
   to Joe Stoll of the Syracuse Geography Department for his tireless work
