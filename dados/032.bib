   Tusalem, Rollin F., Arkansas State Univ, Polit Sci, State Univ, AR 72467 USA.},
DOI = {10.1177/0192512115593163},
ISSN = {0192-5121},
EISSN = {1460-373X},
Keywords = {Delegative democracies; patronage politics; Philippine politics;
