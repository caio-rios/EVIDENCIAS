@article{ WOS:000378728000012,
Author = {de Shalit, Avner},
Title = {The Ethics of Academic Boycott},
Journal = {JOURNAL OF POLITICS},
Year = {2016},
Volume = {78},
Number = {3},
Pages = {642-652},
Month = {JUL},
Abstract = {This article asks whether an academic boycott is morally justified. It
   does not relate to the question whether academia and politics should be
   mixed. Instead, relying on the case study of the debate surrounding the
   academic boycott of Israeli academia by British, and later American
   academics, the article analyzes the various arguments applying
   analytical political philosophy tools. Broadly speaking two families of
   argumentsconsequentialist and deontologicalare found. Consequentialist
   arguments rely on three psychological, sociological, and political
   assumptions that are false and make them counterproductive (bearing in
   mind the overall goal declared by the boycott promoters). Despite some
   initial appeal, the deontological arguments also fail, at least to a
   certain extent, to justify the boycott. Finally I discuss what I call
   selective boycotting.},
