@article{ WOS:000378728000027,
Author = {Abou-Chadi, Tarik and Orlowski, Matthias},
Title = {Moderate as Necessary: The Role of Electoral Competitiveness and Party
   Size in Explaining Parties' Policy Shifts},
Journal = {JOURNAL OF POLITICS},
Year = {2016},
Volume = {78},
Number = {3},
Pages = {868-881},
Month = {JUL},
Abstract = {This article investigates how the degree of electoral competition
   affects parties' policy positions. It follows a growing body of research
   on party positioning in multiparty competition that regards elections as
   signals for parties that have to choose their positions and issue
   strategies. In this article we argue that previous elections provide
   information about the competitiveness of the upcoming election. The
   expected degree of electoral competition affects parties' future policy
   positions since with increasing competitiveness of an election, parties
   have higher incentives to move toward a vote-maximizing position.
   However, what constitutes a vote-maximizing strategy varies between
   parties. While large mainstream parties have an incentive to moderate
   their positions, small and niche parties choose more extreme positions
   to distinguish themselves from their mainstream competitors. Applying a
   novel measure of electoral competitiveness, we find that the degree of
   electoral competition indeed determines parties' policy shifts, but that
   this effect is moderated by party size.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
Affiliation = {Abou-Chadi, T (Corresponding Author), Humboldt Univ, Dept Social \& Polit Sci, D-10099 Berlin, Germany.
   Abou-Chadi, Tarik; Orlowski, Matthias, Humboldt Univ, Dept Social \& Polit Sci, D-10099 Berlin, Germany.},
DOI = {10.1086/685585},
ISSN = {0022-3816},
EISSN = {1468-2508},
Keywords = {electoral competition; party competition; niche parties; small parties},
Keywords-Plus = {SPATIAL THEORY; MULTIPARTY SYSTEMS; ELECTIONS; CONSEQUENCES; GOVERNMENT;
   UNCERTAINTY; DEMOCRACY; IDEOLOGY; POSITION; RESPOND},
