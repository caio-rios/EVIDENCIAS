Volume = {14},
Number = {2},
Pages = {442-450},
Month = {JUN},
Abstract = {Higher education in the United States has proud roots in the mission to
   enable people to engage in self-governance. The current political
   context is pushing us in another direction. I discuss the context in
   Wisconsin in particular, and use the challenges there as a reason to
   consider the civic purposes of political science. Rather than allow the
   political winds to blow us further into elitism, I argue that we should
   renew our commitment to educating people for citizenship.},
