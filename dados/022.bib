@article{ WOS:000537176300002,
Author = {Jackson, John E.},
Title = {Corrected Standard Errors with Clustered Data},
Journal = {POLITICAL ANALYSIS},
Year = {2020},
Volume = {28},
Number = {3},
Pages = {318-339},
Month = {JUL},
Abstract = {The use of cluster robust standard errors (CRSE) is common as data are
   often collected from units, such as cities, states or countries, with
   multiple observations per unit. There is considerable discussion of how
   best to estimate standard errors and confidence intervals when using
   CRSE (Harden 2011; Imbens and Kolesar 2016; MacKinnon and Webb 2017;
   Esarey and Menger 2019). Extensive simulations in this literature and
   here show that CRSE seriously underestimate coefficient standard errors
   and their associated confidence intervals, particularly with a small
   number of clusters and when there is little within cluster variation in
   the explanatory variables. These same simulations show that a method
   developed here provides more reliable estimates of coefficient standard
   errors. They underestimate confidence intervals for tests of individual
   and sets of coefficients in extreme conditions, but by far less than do
   CRSE. Simulations also show that this method produces more accurate
   standard error and confidence interval estimates than bootstrapping,
   which is often recommended as an alternative to CRSE.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Jackson, JE (Corresponding Author), Univ Michigan, Dept Polit Sci, Ann Arbor, MI 48109 USA.
   Jackson, John E., Univ Michigan, Dept Polit Sci, Ann Arbor, MI 48109 USA.},
DOI = {10.1017/pan.2019.38},
Article-Number = {PII S104719871900038X},
ISSN = {1047-1987},
EISSN = {1476-4989},
