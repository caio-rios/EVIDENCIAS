@article{ WOS:000541426900001,
Author = {Louis, Winnifred and Thomas, Emma and McGarty, Craig and Lizzio-Wilson,
   Morgana and Amiot, Catherine and Moghaddam, Fathali},
Title = {The Volatility of Collective Action: Theoretical Analysis and Empirical
   Data},
