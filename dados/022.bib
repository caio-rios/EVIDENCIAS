Author-Email = {mgergan@fsu.edu},
Affiliations = {State University System of Florida; Florida State University},
Funding-Acknowledgement = {Center for Global Initiatives; Carolina Asia Center; Graduate School at
   UNC; Department of Geography},
Funding-Text = {This research for this article was supported with the generous grants
   and scholarships I received as a graduate student at UNC: The National
   Science Foundation, Center for Global Initiatives, The Carolina Asia
   Center, The Graduate School at UNC, and the Department of Geography. The
