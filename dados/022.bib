Web-of-Science-Categories  = {Political Science},
Author-Email = {rmmyrick@stanford.edu},
Affiliations = {Stanford University},
ORCID-Numbers = {Myrick, Rachel/0000-0002-9833-6041},
Funding-Acknowledgement = {Laboratory for the Study of American Values; Institute for Research in
   the Social Sciences at Stanford University},
Funding-Text = {This research was reviewed by the Stanford University Institutional
