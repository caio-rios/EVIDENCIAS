@article{ WOS:001067737500001,
Author = {Cardenas, Kimberly and Mohamed, Heather Silber and Michelson, Melissa R.},
Title = {The Political Consequences of Racialized Ethnic Identities},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2023},
Volume = {76},
Number = {4},
Pages = {1857-1871},
Month = {DEC},
Abstract = {Racial classifications are a social construct with no basis in biology;
   yet, race is an omnipresent and powerful factor in U.S. politics,
   shaping electoral boundaries, disbursement of resources, and political
   alliances (Omi and Winant 1994, Haney Lopez 1994). Race, then, is a
   malleable construct wielded by varying interests, with racial
   definitions changing in response to social and political battles. Some
   new immigrant groups initially classified as not white have been
   reclassified as white over time, thereby benefitting from associated
   legal, economic, and sociopolitical privileges. More recently, however,
   some Latinos have sought recognition as a distinct non-white racial
   group, in acknowledgment of the racialization of their identities over
   time. We seek to better understand who is most likely to support a
   racialized Latino identity, and the political consequences of this
   choice. Using data from the 2020 Collaborative Multiracial Post-election
   Survey, we test whether individuals who believe that a Latino identity
   is a racial identity are also more likely to be interested in and
   engaged in politics. We also examine the extent to which support for a
   racialized Latino identity is associated with progressive attitudes on
   racial issues.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Cardenas, K (Corresponding Author), Univ Penn, Dept Polit Sci, 133 S 36th St, Philadelphia, PA 19104 USA.
   Cardenas, Kimberly, Univ Penn, Dept Polit Sci, 133 S 36th St, Philadelphia, PA 19104 USA.
   Mohamed, Heather Silber, Clark Univ, Dept Polit Sci, Worcester, MA USA.
   Michelson, Melissa R., Menlo Coll, Dept Polit Sci, Atherton, CA USA.},
DOI = {10.1177/10659129231181079},
EarlyAccessDate = {JUN 2023},
ISSN = {1065-9129},
EISSN = {1938-274X},
Keywords = {Latinos; identity; race; racialization; political behavior; coalitions},
Keywords-Plus = {SKIN COLOR; LATINO; RACE; DISCRIMINATION; IMMIGRATION},
Research-Areas = {Government \& Law},
