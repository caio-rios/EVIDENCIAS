@article{ WOS:001014586500001,
Author = {Carella, Leonardo and Eggers, Andrew},
Title = {Electoral Systems and Geographic Representation},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2024},
Volume = {54},
Number = {1},
Pages = {40-68},
Month = {JAN},
Abstract = {Who gets represented in legislatures, and how does this depend on
   electoral institutions? Others have asked this question from the
   perspective of gender, race, and class. We focus on space, asking
   whether MPs disproportionately come from some places rather than others
   and how this depends on electoral rules. Using data on over 13,000
   legislators in sixty-two democracies, we developed a new measure to
   determine whether the spatial distribution of MP birthplaces matched the
   spatial distribution of the citizens they represented. Contrary to
   received wisdom, single-member district systems do not have more
   geographically representative parliaments than multi-member district
   systems, while mixed-member systems perform significantly better than
   both. We attribute the higher spatial representativeness of mixed-member
   systems to the contamination effects in their single-member tier. We
   present evidence for this explanation from a within-country analysis of
   elections in Italy, the UK, and Germany.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Carella, L (Corresponding Author), Univ Oxford, Nuffield Coll, Oxford, England.
   Carella, Leonardo, Univ Oxford, Nuffield Coll, Oxford, England.
   Eggers, Andrew, Univ Chicago, Dept Polit Sci, Chicago, IL USA.},
DOI = {10.1017/S0007123423000121},
EarlyAccessDate = {JUN 2023},
Article-Number = {PII S0007123423000121},
ISSN = {0007-1234},
EISSN = {1469-2112},
Keywords = {electoral systems; representation; legislatures; political geography;
