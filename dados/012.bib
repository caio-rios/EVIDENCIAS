@article{ WOS:000936486500001,
Author = {Morris, Kevin and Miller, Peter},
Title = {Authority after the Tempest: Hurricane Michael and the 2018 Elections},
Journal = {JOURNAL OF POLITICS},
Year = {2023},
Volume = {85},
Number = {2},
Pages = {405-420},
Month = {APR 1},
Abstract = {Hurricane Michael made landfall in the Florida panhandle 27 days before
   the 2018 elections. In the aftermath the governor issued Executive Order
   18-283, allowing election officials in eight affected counties to loosen
   a variety of voting laws and consolidate polling places but providing no
   emergency funding to maintain the planned number of polling places. We
   test the efficacy of the order, using a novel research design that
   separates the weather effects of the hurricane on turnout from the
   administrative effects of how the election was run. We find little
   evidence that the hurricane itself (as proxied by historically relative
   rainfall) reduced turnout but that the executive order likely had large,
   negative turnout effects thanks to widespread polling place
   consolidation. Natural disasters need not spell turnout disasters if
   state and local election officials can avoid reducing the number of
   polling places.},
Publisher = {UNIV CHICAGO PRESS},
