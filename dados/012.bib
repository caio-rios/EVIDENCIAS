@article{ WOS:001011791700001,
Author = {Neo, Ric},
Title = {Analysing the political effects of `fake news' deflections in the UK},
Journal = {WEST EUROPEAN POLITICS},
Year = {2024},
Volume = {47},
Number = {6},
Month = {SEP 18},
Abstract = {Empirical reports point to the increasing weaponisation of the `fake
   news' label - or unwarranted fake news accusations - by politicians.
   They see this as a discursive tool used by politicians to deflect
   critical reporting, delegitimise media outlets and achieve other
   political ends, suggesting that abuse of such deflections can benefit
   these political actors. Theoretically, `fake news' deflections in the
   face of emergent derogatory information may benefit politicians by
   allowing them to maintain the support and trust of citizens as well as
   reduce belief in the accusation - as long as the deceit is not exposed.
   To evaluate this hypothesis, a survey experiment (n = 1,420) was
   conducted, varying how British PM Boris Johnson responded to two
   separate damaging accusations. This enabled the assessment of the impact
   of the ensuing fake news deflections on UK citizens' belief in the
   accusation and also their opinion of the politician. Results show that
   employing fake news deflections reduces the respondents' belief in the
   accusation, increases support for the politician, and generally
   increases perceptions of his truthfulness. However, when the deflection
   is revealed to be false and the politician's deceit is exposed, citizens
   will revise their belief in the story, as well as punish the politician
   by significantly reducing their perception of his truthfulness and their
   support for him. Thus, while fake news deflections of emergent
   derogatory information are likely to reduce a citizen's belief in these
   allegations and muster political support, rampant abuse of fake news
   deflections may ultimately erode citizens' trust and support for the
   politician.},
