ISSN = {1058-4609},
EISSN = {1091-7675},
Keywords = {Group identity; politicization of science; social media; influencers;
   computational social science; cross-platform},
Keywords-Plus = {SOCIAL IDENTITY; POWER RELATIONS; MEDIA; DEINDIVIDUATION; INTERGROUP;
