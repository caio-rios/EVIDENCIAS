@article{ WOS:001075082700001,
Author = {Ho, Ming-sho and Ting, Yun-Chung},
Title = {Contentious Institutionalization of Protests under Democracy: The
   Evidence from Taiwan, 1986-2016},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2024},
Volume = {59},
Number = {3},
Pages = {825-844},
Month = {JUL},
Abstract = {While many scholarly works are concerned with how social protests
   promote democratization, this article addresses the causally reverse
   question: how democratization shapes the landscape of street protests.
   We use a unique database of 31 years of protest events in Taiwan, a
   smooth and successful case of authoritarianism-to-democracy transition,
   to engage in a dialogue with political transition theory, the
   institutionalization thesis and networked movement theory. The logistic
   regression analysis indicates that protest violence persists under
   consolidated democracy, but it is marginalized. We find an indirect
   effect from the growth of social movement organizations that foster the
   adaptation of festive and performative tactics, which are less
   confrontational in nature. Politicians' involvement, however, remains a
   constant source of disruptiveness. Our conclusion of contentious
   institutionalization finds that late-democratizing countries also
   gravitate towards becoming a `social movement society' as advanced
   democracies do, but in a highly compressed period of time.},
