@article{ WOS:000994697800001,
Author = {Koc-Michalska, Karolina and Klinger, Ulrike and Bennett, Lance and
   Roemmele, Andrea},
Title = {(Digital) Campaigning in Dissonant Public Spheres},
Journal = {POLITICAL COMMUNICATION},
Year = {2023},
Volume = {40},
Number = {3, SI},
Pages = {255-262},
Month = {MAY 4},
Abstract = {With the advent of digital media and social media platforms, the speed
   of innovation and technology adoption in campaigns have increased
   tremendously. At the same time, the campaign environment and its rules
   are in constant flow, as platform logics, party operations, and voter
   alignments both reflect and create instability in many political
   systems. Additionally, disinformation, foreign interference in
   campaigns, hyper-partisan media ecologies, and hyperactive users have
   all created changes in opinion climates. In light of these developments,
   and building on the theoretical concept of increasingly disrupted and
   dissonant public spheres (developed by Barbara Pfetsch and Lance
   Bennett), this special issue seeks to expand research on campaigning
   beyond assumptions of well-functioning political systems, to better
   understand the erosion of institutional legitimacy and trust, and their
   effects on communication processes. The special issue is organized
   within two conceptual approaches. The first cluster of manuscripts
   observes how political candidates, organizations, and parties optimize
   their behaviour within the dissonant political environment. The second
   part examines responses, perceptions, and consequences of the disrupted
   environment on the public. Finally, four integrated forum essays look
   into how dissonant public spheres may disturb democratic processes,
   discuss the role of data-driven campaigning, and address how limited
   access to platform data affects our understanding of dissonant public
   spheres.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
Type = {Article},
Language = {English},
Affiliation = {Koc-Michalska, K (Corresponding Author), Audencia Business Sch, Fac Social Sci, Nantes, France.
   Koc-Michalska, Karolina, Audencia Business Sch, Nantes, France.
   Koc-Michalska, Karolina, Univ Silesia, Fac Social Sci, Katowice, Poland.
   Klinger, Ulrike, European Univ Viadrina, European New Sch Digital Studies, Frankfurt, Germany.
   Bennett, Lance, Univ Washington, Ctr Journalism Media \& Democracy, Seattle, WA USA.
   Roemmele, Andrea, Hertie Sch Berlin, Berlin, Germany.},
DOI = {10.1080/10584609.2023.2173872},
