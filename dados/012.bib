@article{ WOS:001164412800005,
Author = {Cohen, Denis and Hanretty, Chris},
Title = {Simulating Party Shares},
Journal = {POLITICAL ANALYSIS},
Year = {2024},
Volume = {32},
Number = {1},
Pages = {140-147},
Month = {JAN},
Abstract = {We tackle the problem of simulating seat- and vote-shares for a party
   system of a given size. We show how these shares can be generated using
   unordered and ordered Dirichlet distributions. We show that a
   distribution with a mean vector given by the rule described in Taagepera
   and Allik (2006, Electoral Studies 25, 696-713) fits real-world data
   almost as well as a saturated model where there is a parameter for each
   rank/system size combination.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
