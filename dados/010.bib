@article{ WOS:001112735000001,
Author = {Bonotti, Matteo and Nwokora, Zim},
Title = {Political Finance and Party Systems in the Normative Theory of
   Partisanship: Toward a Civic Model},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2024},
Volume = {54},
Number = {3},
Pages = {693-711},
Month = {JUL},
Abstract = {Political finance in liberal democracies is often regarded as a source
   of pathology accompanied by demands for reform. But on what principles
   and values should political finance reform be grounded? The existing
   scholarship provides no more than sketchy advice on such matters. To
   address this gap, this paper presents a normative framework to evaluate
   political finance rules, which proposes (a) that the design of such
   rules should take account of the party system in which the financing
   rules will operate; (b) that both political finance rules and party
   systems should be evaluated in terms of three normative dimensions of
   partisanship (collegiality, systemic voice, and systemic
   accountability); and (c) that political finance reforms ought to
   counterbalance the pathologies inherent to different party systems. A
   set of political finance rules that satisfies these three conditions is
   an instantiation of what we describe as the `civic model of political
   finance'.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
