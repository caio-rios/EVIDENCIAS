   Heermann, Max; Leuffen, Dirk, Univ Konstanz, Dept Polit \& Publ Adm, Constance, Germany.
   Schuessler, Julian, Aarhus Univ, CEPDISC Ctr Expt Philosoph Study Discriminat, Dept Polit Sci, Aarhus, Denmark.},
DOI = {10.1111/1475-6765.12672},
EarlyAccessDate = {MAR 2024},
