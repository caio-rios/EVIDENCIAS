   Holliday, Derek E., Stanford Univ, Polarizat Res Lab, 616 Jane Stanford Way,Encina Hall West,Room 100, Stanford, CA 94305 USA.
   Holliday, Derek E., Stanford Univ, Dept Polit Sci, 616 Jane Stanford Way,Encina Hall West,Room 100, Stanford, CA 94305 USA.},
DOI = {10.1561/100.00022089},
ISSN = {1554-0626},
EISSN = {1554-0634},
