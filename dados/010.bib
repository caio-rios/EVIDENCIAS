   Basir, Tariq, Univ Pittsburgh, Ctr Governance \& Markets, Pittsburgh, PA 15213 USA.
   Datta, Soumya, South Asian Univ, Fac Econ, New Delhi, India.},
DOI = {10.1080/13510347.2023.2280993},
EarlyAccessDate = {DEC 2023},
ISSN = {1351-0347},
EISSN = {1743-890X},
Keywords = {Arab Spring; protests; conflict; regime change; MENA},
