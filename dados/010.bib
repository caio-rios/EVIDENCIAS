@article{ WOS:001192247300001,
Author = {Boyd, Christina L. and Collins, Jr., Paul M. and Ringhand, Lori A.},
Title = {Gender, Race, and Interruptions at Supreme Court Confirmation Hearings},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {119},
Number = {1},
Pages = {492-499},
Month = {FEB},
Abstract = {In this research letter, we examine whether gender and racial bias
   affect interruption rates at one of the most visible events in American
   politics: US Supreme Court confirmation hearings. Using original data
   from 1939 to 2022, we find that male and white participants are more
   likely to interrupt women and person of color speakers, respectively,
   relative to male and white speakers. This finding holds for both
   senators and nominees as interrupters. Our results provide evidence that
   biased interruptive behavior occurs in even the most public and salient
   of political settings and that it can be mitigated (or intensified) by
   shared (or opposite) partisanship among speaking pairs. We also find
   interruption inequalities are not isolated to women as the interrupted,
   revealing that people of color in political and legal settings are
   subject to heightened rates of interruptions as well.},
