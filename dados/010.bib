@article{ WOS:001138549400001,
Author = {Madariaga, Amuitz Garmendia and Riera, Pedro},
Title = {The nationalisation of subnational elections in polarised Spain: the May
   2023 regional and local elections},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2023},
Volume = {28},
Number = {2},
Pages = {231-257},
Month = {APR 3},
Abstract = {This article examines the May 2023 regional and local elections in
   Spain. The vote confirmed the territorial retrenchment of the
   left-leaning national government coalition members (PSOE and UP) and
   sparked a call for snap general elections. The outcome of these
   sub-national elections was notably shaped by the divergent trajectories
   of the newer parties (Cs, UP, and Vox), as well as by the considerable
   increase in the support of the main opposition party (PP). This report
   shows how the existing high levels of political polarisation contributed
   to nationalising the campaign and electoral results in May 2023.},
