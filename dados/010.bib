EISSN = {1755-7747},
Keywords = {Populist attitudes; participatory budgeting; democratic innovation;
   political participation; populism},
Keywords-Plus = {WESTERN-EUROPE; PEOPLE; TRUST; DELIBERATION; GOVERNMENT; FRAMEWORK;
