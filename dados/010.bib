ISSN = {0022-3816},
EISSN = {1468-2508},
Keywords = {credit access; social insurance; welfare; redistribution},
Keywords-Plus = {REDISTRIBUTION; INEQUALITY; FINANCIALIZATION; PREFERENCES; RISKS},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
