Pages = {944-960},
Month = {JUN},
Abstract = {How do Americans' preferences over judicial philosophy influence their
   support for judges and judicial decisions? Using an experiment attached
   to an adaptive choice-based conjoint analysis, we find that people hold
   preferences over judicial philosophies, that they rely on those
   preferences to evaluate judges and decisions, and that those preferences
   are not simply stand-ins for ideology and partisanship. These findings
   suggest that to understand people's support for judges and judicial
   decisions one must pay attention to judicial philosophy.},
