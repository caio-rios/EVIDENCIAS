@article{ WOS:000829685800009,
Author = {Arnaud, Brennetot},
Title = {Neoliberalizing state spaces in postwar Western Europe: The emergence of
   a new integrative regime of sovereignty},
Journal = {POLITICAL GEOGRAPHY},
Year = {2022},
Volume = {97},
Month = {AUG},
Abstract = {Contrary to recurrent statements that neoliberalism was implemented from
   the late 1970s in the United Kingdom and United States, this article
   shows how in fact, this political ideology was rolled out in Western
   Europe much earlier, in the years following World War II. The
   experiences of Italy, West Germany and France reveal how some neoliberal
   reformers took advantage of postwar geopolitical crises to impulse a new
   spatial regime of sovereignty based on macroregional economic
   integration and submission of domestic policies to international
   economic competition. Far from being hegemonic, this neoliberal opening
   up of state spaces is implemented within the framework of a composite,
   flexible and ever evolving policy regime. A multifactorial and complex
   explanatory framework is used to show how neoliberalization in Western
   Europe takes the shape of a systemic process of macro-regional economic
   integration.},
