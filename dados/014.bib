@article{ WOS:000855963900001,
Author = {Przeworski, Adam},
Title = {Formal Models of Authoritarian Regimes: A Critique},
Journal = {PERSPECTIVES ON POLITICS},
Year = {2023},
Volume = {21},
Number = {3},
Pages = {979-988},
Month = {SEP},
Abstract = {The very idea that authoritarian regimes ({''}autocracies{''}) may enjoy
   popular support is hard to fathom for democrats. Models of authoritarian
   regimes often entail tacit ideological assumptions, and many are driven
   by methodological fashions. They ignore the efforts of rulers to provide
   what people value. The psychology they assume is inadequate to predict
   actions. They are often too abstract to generate testable predictions.
   ``Support{''} for any regime is difficult to assess.},
