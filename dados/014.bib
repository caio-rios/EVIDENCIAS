@article{ WOS:000840720000002,
Author = {Landauer, Matthew},
Title = {Drinking Parties Correctly Ordered: Plato on Mass Participation and the
   Necessity of Rule},
Journal = {JOURNAL OF POLITICS},
Year = {2022},
Volume = {84},
Number = {4},
Pages = {2011-2022},
Month = {OCT 1},
Abstract = {This article supplements the familiar picture of Plato as a critic of
   democracy by reconstructing a Platonic theory of appropriate mass
   participatory politics. Plato's Laws offer a theory of how to evaluate
   collective institutions and group practices; an analysis of the
   conditions for collective action; and principles for the design of
   electoral institutions and other forms of mass participation. The
   central claim is that groups and associations, organized around any
   collective activity whatsoever, must be properly ruled (the necessity of
   rule principle {[}NRP]). The principle is developed and tested through
   the Stranger's analysis and qualified defense of drinking parties, which
   the dialogue connects to democracy. But Plato's democratic turn is
   limited. When the Stranger applies NRP to mass political participation,
   it yields a novel justification of open (nonsecret) voting, centered on
   how such procedures might foster coordination around the judgments of
   leading citizens rather than the judgments of the many.},
