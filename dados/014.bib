ISSN = {1058-4609},
EISSN = {1091-7675},
Keywords = {Indonesia; campaign appeals; ethnic diversity; religious diversity;
   election campaigns; election posters; campaign communications},
Keywords-Plus = {DEMOCRACY; IDENTITY; POLITICS; COMPETITION; CONFLICT; VOTE},
