@article{ WOS:000469537700001,
Author = {Anderson, Karen M. and Kurzer, Paulette},
Title = {The politics of mortgage credit expansion in the small coordinated
   market economies},
Journal = {WEST EUROPEAN POLITICS},
Year = {2020},
Volume = {43},
Number = {2, SI},
Pages = {366-389},
Month = {FEB 23},
Abstract = {Recent contributions to the comparative political economy literature
   claim that liberal market economies are vulnerable to asset booms and
   busts because of financial deregulation, shrinking welfare states and a
   political ideology emphasising financial self-sufficiency. This article
   examines the rapid expansion of mortgage lending in three coordinated
   market economies (CMEs): Denmark, Sweden and the Netherlands. This
   expansion is puzzling given that all three countries are CMEs with
   generous welfare states. Yet the pattern of mortgage lending resembles
   the Anglo-Saxon or liberal market economies (LMEs) more than other CMEs.
   The article argues that mortgage bubbles in the small CMEs emerged as
   the unintended outcome of pairing neoliberal programmes to expand home
   ownership with collectivist housing institutions. This resulted in
   supply restrictions and rising property values which saddled households
   with extraordinarily high mortgage debts. In short, mortgage credit
   bubbles are not unique to Anglo-liberal welfare states and may have
   different origins.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Anderson, KM (Corresponding Author), Univ Coll Dublin, Social Policy, Dublin, Ireland.
   Anderson, Karen M., Univ Coll Dublin, Social Policy, Dublin, Ireland.
   Kurzer, Paulette, Univ Arizona, Sch Govt \& Publ Policy, Polit Sci, Tucson, AZ USA.},
DOI = {10.1080/01402382.2019.1596421},
EarlyAccessDate = {MAY 2019},
