   Bekana, Dejene Mamo, Univ Milan, Dept Social \& Polit Sci, Milan, Italy.},
DOI = {10.1080/13510347.2019.1574296},
ISSN = {1351-0347},
EISSN = {1743-890X},
Keywords = {Institutions; democracy; autocracy; human capital; innovation; Africa},
Keywords-Plus = {CROSS-COUNTRY; ABSORPTIVE-CAPACITY; GROWTH; DEMOCRACY; INVESTMENT;
