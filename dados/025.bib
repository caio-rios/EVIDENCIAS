@article{ WOS:000483647800003,
Author = {Branco, Rui and Cardoso, Daniel and Guillen, Ana M. and Sacchi, Stefano
   and Balbona, David Luque},
Title = {Here to Stay? Reversals of Structural Reforms in Southern Europe as the
   Crisis Wanes},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2019},
Volume = {24},
Number = {2, SI},
Pages = {205-232},
Month = {APR 3},
Abstract = {This article answers the fundamental question of whether structural
   reforms on labour market regulation and social protection in Italy,
   Portugal and Spain passed during the sovereign debt crisis endured or
   were reversed once external conditionality waned. The study defines
   categorises and illustrates structural policy reversals. It finds there
   have been significant structural policy reversals across the three
   cases, but the bulk of these reforms enacted under conditionality
   endures. It also finds that the waning of conditionality and harsh
   economic austerity alone is not enough to bring about full structural
   policy reversals. Rather, full reversals occur when this condition is
   combined with a change in government and its ideological orientation, or
   when the High Courts step in.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Branco, R (Corresponding Author), NOVA Univ Lisbon, Dept Polit Studies, Lisbon, Portugal.
   Branco, Rui, NOVA Univ Lisbon, Dept Polit Studies, Lisbon, Portugal.
   Cardoso, Daniel, Portuguese Inst Int Relat, Lisbon, Portugal.
   Cardoso, Daniel, NOVA Univ Lisbon, Lisbon, Portugal.
   Guillen, Ana M., Univ Oviedo, Dept Sociol, Res Grp PROMEBI, Oviedo, Spain.
   Guillen, Ana M., European Social Observ, OSE, Advisory Boards, Brussels, Belgium.
