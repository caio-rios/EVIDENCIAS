@article{ WOS:000471828400016,
Author = {Weschle, Simon},
Title = {The Impact of Economic Crises on Political Representation in Public
   Communication: Evidence from the Eurozone},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2019},
Volume = {49},
Number = {3},
Pages = {1097-1116},
Month = {JUL},
Abstract = {External threats such as war have been shown to disrupt representation
   as politicians `put politics aside' and cooperate across cleavages. This
   article examines whether a severe economic crisis can have a similar
   effect. It introduces a new approach that provides a spatial
   representation of how political parties represent societal actors in
   their public interactions, based on more than 140,000 machine coded news
   events from eleven eurozone countries between 2001 and 2011. The study
   shows that in bad economic times, there is a compression of political
   representation: parties' relationships with the societal groups they are
   closest to become less cooperative, while their relationships with the
   groups they are least close to become less conflictual.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
