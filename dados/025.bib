@article{ WOS:000482350900005,
Author = {Knudsen, Erik and Johannesson, Mikael Poul},
Title = {Beyond the Limits of Survey Experiments: How Conjoint Designs Advance
   Causal Inference in Political Communication Research},
Journal = {POLITICAL COMMUNICATION},
Year = {2019},
Volume = {36},
Number = {2},
Pages = {259-271},
Month = {APR 3},
Abstract = {This paper calls attention to what is arguably the most notable
   advancement in survey experiments over the last decade: conjoint
   designs. The benefit of conjoint design is its capacity to study and
   compare the causal effects of several dimensions simultaneously.
   Although survey experiments have long been a preferred method for
   assessing causal effects, the method falls short when studying
   multidimensional causal relations.Researchers face a trade-off between a
   lack of statistical power or a restriction in experimental conditions.
   Conjoint designs solve this problem by letting the researcher vary an
   indefinite number of factors in one experiment. This method is quickly
   gaining ground in social and political science but has yet to be widely
   practiced in political communication research. This article argues that
   conjoint designs are ideal for studying political communication effects
   and highlights the possible benefits of using and innovating conjoint
   designs in political communication research. We make available sample
   scripts and demonstrate the value of this methodological technique
   through empirical examples of trust in news media and selective exposure
   to political news.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
Type = {Article},
Language = {English},
Affiliation = {Knudsen, E (Corresponding Author), Univ Bergen, Dept Informat Sci \& Media Studies, Fosswinckelsgate 6, N-7802 Bergen, Norway.
   Knudsen, Erik, Univ Bergen, Dept Informat Sci \& Media Studies, Fosswinckelsgate 6, N-7802 Bergen, Norway.
   Knudsen, Erik; Johannesson, Mikael Poul, Univ Bergen, Digital Social Sci Core Facil DIGSSCORE, Bergen, Norway.
