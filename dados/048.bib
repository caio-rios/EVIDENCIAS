   Lowery, David; Berkhout, Joost, Leiden Univ, Dept Publ Adm, NL-2300 RA Leiden, Netherlands.},
DOI = {10.1080/01402380802372670},
ISSN = {0140-2382},
Keywords-Plus = {ORGANIZED INTERESTS; BUSINESS INTERESTS; POLICY-MAKING; CORPORATISM;
   INSTITUTIONS; ACCESS; STATE; EU; POLITICS; BIAS},
