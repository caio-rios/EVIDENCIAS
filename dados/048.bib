@article{ WOS:000259238800018,
Author = {Hicklin, Alisa and Meier, Kenneth J.},
Title = {Race, structure, and state governments: The politics of higher education
   diversity},
Journal = {JOURNAL OF POLITICS},
Year = {2008},
Volume = {70},
Number = {3},
Pages = {851-860},
Month = {JUL},
Abstract = {This paper examines the politics of higher education diversity for both
   African Americans and Latinos, by investigating how the structure of the
   bureaucracy affects the relationship between descriptive and substantive
   representation. The key theoretical determinants of minority college
   enrollments are legislative representation, bureaucratic structure,
   university-level policies, and restrictions on affirmative action. A
   hierarchical linear model of 500+ universities over an 11-year period
   shows that each of these factors affects minority enrollments.},
