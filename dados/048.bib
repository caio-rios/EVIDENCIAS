@article{ WOS:000257627400001,
Author = {Jones, Martin},
Title = {Recovering a sense of political economy},
Journal = {POLITICAL GEOGRAPHY},
Year = {2008},
Volume = {27},
Number = {4},
Pages = {377-399},
Month = {MAY},
Note = {Annual Conference of the
   Royal-Geographical-Society/Institute-of-British-Geographers, London,
   ENGLAND, AUG, 2007},
Organization = {Royal Geog Soc; Inst British Geographers},
Abstract = {Political economy remains a pressing agenda for political geography and
   human geography more generally. This is evident from recent exchanges
   between (variously defined) Marxists and post-structuralists on the
   nature of society and space, via themes such as scale, space, region,
   public policy. being political, etc. The paper explores imaginative
   spaces for discussing differences and considers the potential of
   cultural political economy (CPE)-being advocated by amongst others Bob
   Jessop and Ngai-Ling Sum-to deliver on this. I highlight some of CPEs
   strengths and weaknesses, identify missing links, and then make
   recommendations on how to develop the geographical dimensions of
   cultural political economy, and, finally, urge serious engagement with
   the sited complexities and contradictions of representations and
   material practices. This is done via a study of the `skills society' in
   the UK. (c) 2008 Elsevier Ltd. All rights reserved.},
