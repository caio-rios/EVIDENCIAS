@article{ WOS:000256941800006,
Author = {Christiansen, Thomas and Vanhoonacker, Sophie},
Title = {At a critical juncture? Change and continuity in the institutional
   development of the Council Secretariat},
Journal = {WEST EUROPEAN POLITICS},
Year = {2008},
Volume = {31},
Number = {4},
Pages = {751-770},
Abstract = {This article provides a historical institutionalist perspective on the
   General Secretariat of the Council of Ministers-an institution that has
   expanded significantly over the course of the integration process and
   whose role in the institutional politics of the EU has been recognised
   as significant in the recent literature on the subject. Charting the
   history of the institution, we demonstrate the way in which the original
   institutional design contributed to a particular trajectory which can be
   understood as a `path-dependent' development. However, we also identify
   recent developments which can be seen as a break with the historical
   legacy of the Secretariat-an observation which raises the question as to
   whether the institution is at a critical juncture in its development.
   The article closes with an examination of the present and future
   challenges the Council Secretariat is facing at this time.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
