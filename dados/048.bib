@article{ WOS:000259238700010,
Author = {Huber, Evelyne and Mustillo, Thomas and Stephens, John D.},
Title = {Politics and social spending in Latin America},
Journal = {JOURNAL OF POLITICS},
Year = {2008},
Volume = {70},
Number = {2},
Pages = {420-436},
Month = {APR},
Abstract = {We examine the determinants of social expenditure in an unbalanced
   pooled time-series analysis for 18 Latin American countries for the
   period 1970 to 2000. This is the first such analysis of spending in
   Latin American countries with a full complement of regime, partisanship,
   state structure, economic, and demographic variables, making our
   analysis comparable to analyses of welfare states in advanced industrial
   countries. Democracy matters in the long run both for social security
   and welfare and for health and education spending, and-in stark contrast
   to OECD countries-partisanship does not matter. Highly repressive
   authoritarian regimes retrench spending on health and education, but not
   on social security.},
