Month = {JAN},
Abstract = {The role of the state in the promotion of social or generalized trust is
   one of the most important ongoing topics in social capital research. We
   suggest that the state can play a positive role in the creation of
   social trust as a third-party enforcer of private agreements. This
   positive effect depends on the efficacy of the state. We also argue that
   the effects of the state on social trust will be unevenly distributed
   among majoritarian and minoritarian ethnic groups. These hypotheses are
   tested using the European Social Survey (2002-03) and confirmed for a
   dataset of 22 European countries.},
