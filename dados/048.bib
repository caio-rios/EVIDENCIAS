@article{ WOS:000207519700008,
Author = {Lawoti, Mahendra},
Title = {Exclusionary Democratization in Nepal, 1990-2002},
Journal = {DEMOCRATIZATION},
Year = {2008},
Volume = {15},
Number = {2},
Pages = {363-385},
Abstract = {Procedural processes like periodic elections based on universal adult
   franchise, political rights and civil liberties may not ensure the
   inclusion of minorities in governance of multiethnic democracies. The
   Nepali case shows that exclusion from governance may in fact increase in
   new democracies. However, as the open polity facilitates awareness and
   mobilization among the disadvantaged groups, the over all effect,
   despite the exclusion, is democratization. The exclusion, however, could
   lead to the derailment of democracy as sections of the excluded groups
   question the legitimacy of the process that excludes them while others
   support non-democratic forces. This study discusses the role of
   historical legacies, majoritarian political institutions, informal
   norms, and political elite attitudes and behaviour for the continuation
   or increase in political exclusion in Nepal.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
