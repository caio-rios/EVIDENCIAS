@article{ WOS:000256006400013,
Author = {Holland, Breena},
Title = {Justice and the environment in Nussbaum's ``Capabilities Approach{''} -
   Why sustainable ecological capacity is a meta-capability},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2008},
Volume = {61},
Number = {2},
Pages = {319-332},
Month = {JUN},
Abstract = {What principles should guide how society distributes environmental
   benefits and burdens? Like many liberal theories of justice, Martha
   Nussbaum's ``capabilities approach{''} does not adequately address this
   question. The author argues that the capabilities approach should be
   extended to account for the environment's instrumental value to human
   capabilities. Given this instrumental value, protecting capabilities
   requires establishing certain environmental conditions as an independent
   ``meta-capability.{''} When combined with Nussbaum's nonprocedural
   method of political justification, this extension provides the basis for
   adjudicating environmental justice claims. The author applies this
   extended capabilities approach to assess the distribution of benefits
   and burdens associated with climate change.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
