@article{ WOS:000207519700005,
Author = {Luehiste, Kadri},
Title = {Support for Strongman Rule in Ethnically Divided Societies: Evidence
   from Estonia and Latvia},
Journal = {DEMOCRATIZATION},
Year = {2008},
Volume = {15},
Number = {2},
Pages = {297-320},
Abstract = {Using data from Estonia and Latvia from 2004, this study maps and
   analyzes support for authoritarianism in ethnically divided societies.
   It develops and tests three explanatory models, focusing on
   socialization and the political and economic aspects of regime
   performance. Because the correlates of authoritarian support may vary by
   ethnic group, separate models are run for the ethnic majority and the
   minority. The results lend some support to all three theoretical
   approaches, although none of these can be considered to be a powerful
   explanation of support for authoritarianism. The determinants of support
   for strongman rule vary with ethnicity, suggesting that future studies
   on political support in multiethnic societies should systematically
   control for the effects of ethnicity.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
