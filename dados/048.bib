@article{ WOS:000254700700008,
Author = {Armingeon, Klaus and Giger, Nathalie},
Title = {Conditional punishment: A comparative analysis of the electoral
   consequences of welfare state retrenchment in OECD nations, 1980-2003},
Journal = {WEST EUROPEAN POLITICS},
Year = {2008},
Volume = {31},
Number = {3},
Pages = {558-580},
Note = {15th International Conference of the Council-for-European-Studies,
   Chicago, IL, MAR 29-APR 02, 2006},
Organization = {Council European Studies},
Abstract = {Do incumbent parties that retrench the welfare state lose votes during
   the next election? That is the guiding question for our paper. We
   analyse elections and social policy reforms in 18 established OECD
   democracies from 1980 to 2003. We show that there is no strong and
   systematic punishment for governments which cut back welfare state
   entitlements. The likelihood of losing votes is the same for governments
   that retrench the welfare state as for those that do not. Rather,
   electoral punishment is conditional on whether governments have the
   chance to stretch retrenchment over a longer period of time, and whether
   social policy cuts are made an issue in the electoral campaign. If other
   political parties and the mass media do not put the theme on the agenda
   of the campaign, and if the retrenchment can be carried out in small
   steps during a longer governmental term, governments may considerably
   reduce welfare state effort without fear of major electoral
   consequences.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXFORDSHIRE, ENGLAND},
