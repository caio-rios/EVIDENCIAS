@article{ WOS:000252742600007,
Author = {Gibson, James L.},
Title = {Intolerance and political repression in the United States: A half
   century after McCarthyism},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2008},
Volume = {52},
Number = {1},
Pages = {96-108},
Month = {JAN},
Note = {Workshop for Preliminary Presentations of Findings from the Citizenship,
   Involvement, Democracy (CID) Survey Project, Georgetown Univ, CDATS,
   Washington, DC, 2005},
Abstract = {What consequences for political fireedom arise from high levels of
   political intolerance among the American public? Comparing surveys from
   1954 to 2005, 1 document the level of perceived freedom today and
   consider how it has changed since the McCarthy era. Levels of
   intolerance today and in 1954 are also compared. Next assessed is
   whether restrictions on freedom are uniformly perceived or whether some
   subsections of the population are more likely to feel repressed than
   others. I find that while intolerance may have declined somewhat since
   1954, perceived constraints on individual freedom have actually
   increased. These findings produce telling consequences for the subtheory
   of pluralistic intolerance. During McCarthyism, intolerance focused on
   the Left; today, many groups are not tolerated, so the loss of freedom
   is more widespread. Heretofore, many thought that pluralistic
   intolerance tended to be benign. At least in the case of the
   contemporary United States, it seems not to be.},
