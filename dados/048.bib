@article{ WOS:000257475600003,
Author = {Kaheny, Erin B. and Haire, Susan Brodie and Benesh, Sara C.},
Title = {Change over tenure: Voting, variance, and decision making on the US
   Courts of Appeals},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2008},
Volume = {52},
Number = {3},
Pages = {490-503},
Month = {JUL},
Abstract = {Existing scholarship on the voting behavior of U.S. Courts of Appeals
   judges finds that their decisions are best understood as a function of
   law, policy preferences, and factors relating to the institutional
   context of the circuit court. What previous studies have failed to
   consider, however, is that the ability to predict circuit judge
   decisions can vary in substantively important ways and that judges, in
   different stages of their careers, may behave distinctively. This
   article develops a theoretical framework which conceptualizes career
   stage to account for variability in voting by circuit judges and tests
   hypotheses by modeling the error variance in a vote choice model. The
   findings indicate that judges are more predictable in their voting
   during their early and late career stages. Case characteristics and
   institutional features of the circuit also affect voting consistency.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
