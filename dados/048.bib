@article{ WOS:000254295100011,
Author = {Panagopoulos, Costas and Francia, Peter L.},
Title = {The polls-trends - Labor unions in the United States},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2008},
Volume = {72},
Number = {1},
Pages = {134-159},
Month = {SPR},
Abstract = {In this study, we analyze data on public opinion and attitudes toward
   labor unions from the iPOLL Databank at the Roper Center for Public
   Opinion Research (University of Connecticut), the American National
   Election Study, and the Current Population Survey. Despite recent
   developments that suggest labor unions are in decline, we find organized
   labor has maintained reasonably strong public support. Although the data
   indicate that Americans remain skeptical about how much confidence they
   can place in unions and their leaders, the results make clear that the
   public continues to recognize the need for unions to protect the rights
   of workers. These results hold potentially important implications for
   the future of organized labor in the United States.},
