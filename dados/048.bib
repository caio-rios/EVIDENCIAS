@article{ WOS:000257475600008,
Author = {Hill, Kim Quaile and Matsubayashi, Tetsuya},
Title = {Church engagement, religious values, and mass-elite policy agenda
   agreement in local communities},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2008},
Volume = {52},
Number = {3},
Pages = {570-584},
Month = {JUL},
Note = {20th World Congress of the International-Political-Science-Association,
   Fukuoka, JAPAN, JUL 09-13, 2006},
Organization = {Int Polit Sci Assoc},
Abstract = {We provide evidence on two prominent but heretofore untested
   expectations about the relevance of religion for the democratic process:
   (1) that greater engagement in churches or comparable religious
   institutions and their organizational life enhances representational
   processes; and (2) that religious values in a community have greater
   influence on the latter processes, with more liberal religious values
   expected to enhance the responsiveness of community leaders to general
   public preferences. Using data on local communities in the United States
   in the late 1960s, we find strong support for the expected relevance of
   religious liberalism for representation, but none for the expected
   effect of church engagement. We provide evidence, too, that our findings
   about religious values are generalizable to present-day politics.},
