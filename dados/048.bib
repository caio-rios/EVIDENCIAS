@article{ WOS:000257579100002,
Author = {Esarey, Justin and Mukherjee, Bumba and Moore, Will H.},
Title = {Strategic interaction and interstate crises: A Bayesian Quantal Response
   estimator for incomplete information games},
Journal = {POLITICAL ANALYSIS},
Year = {2008},
Volume = {16},
Number = {3},
Pages = {250-273},
Month = {SUM},
Abstract = {Private information characteristics like resolve and audience costs are
   powerful influences over strategic international behavior, especially
   crisis bargaining. As a consequence, states face asymmetric information
   when interacting with one another and will presumably try to learn about
   each others' private characteristics by observing each others' behavior.
   A satisfying statistical treatment would account for the existence of
   asymmetric information and model the learning process. This study
   develops a formal and statistical framework for incomplete information
   games that we term the Bayesian Quantal Response Equilibrium Model (BQRE
   model). Our BQRE model offers three advantages over existing work: it
   directly incorporates asymmetric information into the statistical
   model's structure, estimates the influence of private information
   characteristics on behavior, and mimics the temporal learning process
   that we believe takes place in international politics.},
