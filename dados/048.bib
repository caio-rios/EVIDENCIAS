@article{ WOS:000254665400011,
Author = {Lau, Richard R. and Andersen, David J. and Redlawsk, David P.},
Title = {An exploration of correct voting in recent US presidential elections},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2008},
Volume = {52},
Number = {2},
Pages = {395-411},
Month = {APR},
Note = {64th Annual Conference of the Midwest-Political-Science-Association,
   Chicago, IL, APR 20-23, 2006},
Organization = {Midwest Polit Sci Assoc},
Abstract = {Lau and Redlawsk (1997) proposed that the quality of voter decision
   making can be evaluated by measuring what they called correct voting -
   the extent to which people vote in accordance with their own values and
   priorities - but in so doing provided little guidance about what
   actually determines whether voters can make such high-quality decisions.
   This article develops a framework for analyzing the vote decision that
   views the quality of decision making as a joint function of individual
   characteristics and various higher-level campaign factors. We
   hypothesize that differences in cognitive capacity, political
   motivation, the availability of political heuristics, and macrolevel
   factors that affect the difficulty of the choice confronting citizens,
   including the nature of the political information environment, should
   all affect the probability of a correct vote. We find significant
   support for seven proposed hypotheses across three levels of analysis,
   which places responsibility for incorrect votes on both the individual
   and our electoral system.},
