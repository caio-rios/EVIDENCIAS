@article{ WOS:000267570600004,
Author = {Fernandez-Alvarez, Antonio},
Title = {Turkish Agricultural Trade in the European Union: Opportunities and
   Challenges},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2008},
Volume = {13},
Number = {4},
Pages = {477-493},
Abstract = {This article analyses the sector specialisation of Turkish agriculture
   in the European Union (EU) market and the likely direction of future
   agricultural trade flows and their effects. High levels of
   specialisation are found for Mediterranean products, but not for
   continental products. The empirical results obtained and the Spanish
   agricultural trade experience in the EU market tend to support the idea
   that on the assumption of further market liberalisation between the EU
   and Turkey, or an eventual integration of Turkey into the EU, the
   direction of Turkish agricultural trade flows and their effects are
   mostly determined by the country's present levels of sector
   specialisation.},
