@article{ WOS:000254806900004,
Author = {Lin, Jie-Shin},
Title = {Learning and party competition},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2008},
Volume = {14},
Number = {1},
Pages = {131-155},
Abstract = {Downs (1957) analysis of political ideologies by means of a spatial
   analogy suggests that parties' efforts to attract votes lead them to
   adopt a median position. However other studies have drawn different
   conclusions. In so doing, these studies subject the underlying approach,
   known as rational-choice paradigm, to revision. An example of an
   alternative to super-rational players is the range of models based on
   the concept of the socio-economy as a number of boundedly rational,
   adaptive agents interacting with each other. In this study, we will
   consider a typology of two-party competition based on two different
   learning environments, i.e. individual and social learning. Our results
   suggest that in the environment of population learning we have the
   median outcome, i.e. conventional, and in the one of individual learning
   we have the outcome of divergence.},
