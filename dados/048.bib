@article{ WOS:000256941800002,
Author = {Hofmann, Herwig C. H.},
Title = {Mapping the European administrative space},
Journal = {WEST EUROPEAN POLITICS},
Year = {2008},
Volume = {31},
Number = {4},
Pages = {662-676},
Abstract = {The European administrative space is the area in which increasingly
   integrated administrations jointly exercise powers delegated to the EU
   in a system of shared sovereignty. Its development has been evolutionary
   and fluid. Its structures have been established on a case-by-case basis
   in different policy areas. Despite this differentiation, the phenomenon
   of administrative cooperation has led to an `integrated administration'
   in the form of an intensive and often seamless cooperation between
   national and supranational administrative actors and activities. This
   article explores the reasons for and consequences of this development.},
