@article{ WOS:000258238900002,
Author = {Milic, Thomas},
Title = {Left, center, right: What are the foundations of the Swiss citizens'
   ideological self-placement?},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2008},
Volume = {14},
Number = {2},
Pages = {245-285},
Abstract = {Electoral behaviour analysis often regards the left-right self-placement
   as a reliable predictor for individual decision making. However, to date
   it is not clear how the left-right self-placement really determines the
   polls. One reason for this lack of clarity is that the foundations of
   ideological self-placement are still controversial. Is it a surrogate of
   party sympathy, is it derived from social policy preferences, or is it -
   at least partly - a data artefact? The empirical analysis shows that
   party affiliation and political awareness must be considered as
   intervening variables. Thus four analytic groups can be distinguished
   among which the conclusions differ.},
Publisher = {VERLAG RUEGGER},
