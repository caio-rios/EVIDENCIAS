@article{ WOS:000251764900004,
Author = {Criado, Henar},
Title = {The effects of party mobilisation strategies on the vote: The PSOE and
   the PP in the 1996 Spanish election},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2008},
Volume = {47},
Number = {1},
Pages = {80-100},
Month = {JAN},
Abstract = {In this article, the author analyses the impact of parties' mobilisation
   strategies at the district level on their vote share in the Spanish 1996
   general elections. In order to do this, the author has estimated a
   multilevel model to test the impact of aggregate mobilisation variables
   at the district level controlling for voters' individual
   characteristics. The efforts made by the two main Spanish parties
   increased their share of the vote. Moreover, their strategies seem to be
   more efficient for some profiles of voters than for others. The
   mobilisation of the PSOE especially affected those who had clear
   political preferences, whereas the PP's mobilisation had stronger
   effects on less politically aware voters.},
