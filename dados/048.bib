@article{ WOS:000254073900006,
Author = {Gimpel, James G. and Karnes, Kimberly A. and McTague, John and
   Pearson-Merkowitz, Shanna},
Title = {Distance-decay in the political geography of friends-and-neighbors
   voting},
Journal = {POLITICAL GEOGRAPHY},
Year = {2008},
Volume = {27},
Number = {2},
Pages = {231-252},
Month = {FEB},
Abstract = {We articulate a theory of the relevance of distance to candidate support
   in election campaigns. Anchoring our effort in V.O. Key's reflections on
   localism from a half century ago, we test whether distance from a
   candidate's hometown base exacts a toll on support for that candidate in
   general elections. Employing a geographic information system (GIS), we
   measure the distance between a candidate's home county, and every other
   county in the state. This method permits a direct test of the
   distance/localism hypothesis. Our results show that the impact of
   distance is non-linear, consistent with a classic distance-decay
   formulation of the effect. Notably, however, this effect operates only
   over a limited electoral terrain. Distance from a candidate's hometown
   does not matter to the political support of the most geographically
   isolated populations, where candidates rarely emerge. (c) 2007 Elsevier
   Ltd. All rights reserved.},
Publisher = {ELSEVIER SCI LTD},
