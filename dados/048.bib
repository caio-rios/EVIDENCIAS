@article{ WOS:000254215300005,
Author = {Denny, Kevin and Doyle, Orla},
Title = {Political interest, cognitive ability and personality: Determinants of
   voter turnout in Britain},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2008},
Volume = {38},
Number = {2},
Pages = {291-310},
Month = {APR},
Abstract = {This article uses longitudinal data from the National Child Development
   Study (NCDS) to investigate the determinants of voter turnout in the
   1997 British general election. It introduces measures of cognitive
   ability and personality into the participation literature and finds that
   they are significant determinants of turnout. It also shows that
   standard turnout models may be biased by the inclusion of the much used
   `interest in politics' measure. A bivariate probit model of turnout and
   political interest finds that individuals with high comprehension
   ability and an aggressive personality are more likely to both turn out
   to vote and have an interest in politics.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
Type = {Article},
Language = {English},
Affiliation = {Denny, K (Corresponding Author), Univ Coll Dublin, UCD Sch Econ, Geary Inst, Dublin, Ireland.
   Denny, Kevin, Univ Coll Dublin, UCD Sch Econ, Geary Inst, Dublin, Ireland.
   Doyle, Orla, Univ Coll Dublin, UCD Geary Inst, Dublin, Ireland.},
DOI = {10.1017/S000712340800015X},
ISSN = {0007-1234},
EISSN = {1469-2112},
