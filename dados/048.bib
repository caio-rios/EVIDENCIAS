@article{ WOS:000207522000008,
Author = {Alford, John R. and Funk, Carolyn L. and Hibbing, John R.},
Title = {Beyond Liberals and Conservatives to Political Genotypes and Phenotypes},
Journal = {PERSPECTIVES ON POLITICS},
Year = {2008},
Volume = {6},
Number = {2},
Pages = {321-328},
Month = {JUN},
Abstract = {In the past, most political scientists have been oblivious to the
   growing empirical evidence challenging environmental determinism.
   Professor Charney, apparently as a result of the fact that genes and the
   environment interact in a complex fashion, advocates that this passive
   unawareness be replaced by active denial. Science, however, does not
   advance by avoiding important relationships merely because they are
   complicated and, fortunately, science is not heeding Charney's
   ideologically-based fears. Molecular geneticists, often working in
   tandem with political scientists, are quickly moving beyond twin studies
   to identify the specific suites of genes and biological systems that
   predict variation in core political preferences, whatever labels those
   preferences might be given in a particular culture at a particular time.
   We sympathize with the fact that our empirical findings, like those of
   so many behavioral geneticists, make Charney uncomfortable; still, his
   critique serves up nothing new-empirically or otherwise. Just as
   analyses of the roots of sexual preferences cannot presumptively ignore
   genetics, neither can analyses of the roots of political preferences.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
Type = {Article},
Language = {English},
Affiliation = {Alford, JR (Corresponding Author), Rice Univ, Houston, TX 77251 USA.
   Alford, John R., Rice Univ, Houston, TX 77251 USA.
   Funk, Carolyn L., Virginia Commonwealth Univ, Richmond, VA 23284 USA.
   Hibbing, John R., Univ Nebraska, Lincoln, NE 68583 USA.},
DOI = {10.1017/S1537592708080638},
ISSN = {1537-5927},
EISSN = {1541-0986},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {jra@rice.edu
   clfunk@vcu.edu
   jhibbing@unl.edu},
