@article{ WOS:000260849200002,
Author = {Malesky, Edmund J. and Samphantharak, Krislert},
Title = {Predictable Corruption and Firm Investment: Evidence from a Natural
   Experiment and Survey of Cambodian Entrepreneurs},
Journal = {QUARTERLY JOURNAL OF POLITICAL SCIENCE},
Year = {2008},
Volume = {3},
Number = {3},
Pages = {227-267},
Abstract = {This paper utilizes a unique dataset of 500 firms in ten Cambodian
   provinces and a natural experiment to test a long-held convention in
   political economy that the predictability of a corruption is at least as
   important for firm investment decisions as the amount of bribes a firm
   must pay, provided the bribes are not prohibitively expensive. Our
   results suggest that this hypothesis is correct. Firms exposed to a
   shock to their bribe schedules by a change in governor invest
   significantly less in subsequent periods, as they wait for new
   information about their new chief executive. Furthermore, the amount of
   corruption (both measured by survey data and proxied by the number of
   commercial sex workers) is significantly lower in provinces with new
   governors. Our findings are robust to a battery of firm-level controls
   and province-level investment climate measures.},
Publisher = {NOW PUBLISHERS INC},
