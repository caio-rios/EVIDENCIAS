@article{ WOS:000259148000011,
Author = {Herron, Michael C. and Wiseman, Alan E.},
Title = {Gerrymanders and theories of law making: A study of legislative
   redistricting in Illinois},
Journal = {JOURNAL OF POLITICS},
Year = {2008},
Volume = {70},
Number = {1},
Pages = {151-167},
Month = {JAN},
Note = {Annual Meeting of the American-Political-Science-Association, Chicago,
   IL, SEP 02-05, 2004},
Organization = {Amer Polit Sci Assoc},
Abstract = {Redistricting politics in Illinois provide a novel opportunity for
   testing competing theories of law making. With this in mind, we
   demonstrate that the post-2000 Census redistricters in Illinois,
   dominated by Democrats, strategically reshuffled district demographic
   profiles in an attempt to convert relatively liberal Republican
   districts to conservative Democratic districts in the state Senate while
   decreasing and increasing the ideological diversity of the Democrats and
   Republicans, respectively, in the House. Such reshufflings suggest that
   legislative politics in Illinois are conducted in a manner consistent
   with vote-buying theories of coalition formation.},
