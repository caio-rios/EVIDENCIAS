@article{ WOS:000255867000005,
Author = {Kam, Cindy D. and Nam, Yunju},
Title = {Reaching out or pulling back: Macroeconomic conditions and public
   support for social welfare spending},
Journal = {POLITICAL BEHAVIOR},
Year = {2008},
Volume = {30},
Number = {2},
Pages = {223-258},
Month = {JUN},
Abstract = {In economic hard-times, do Americans call for increases in governmental
   assistance, or do they clamor for declines in government assistance? We
   address this question by identifying the impact of state-level
   macroeconomic conditions on public support for social welfare spending.
   We analyze individual-level data from the 1984-2000 National Election
   Studies, combined with state-level macroeconomic indicators of
   inflation, unemployment, and productivity. We find that state-level
   inflation, not state-level unemployment nor state-level productivity,
   consistently and consequentially shapes citizens' support for social
   welfare. With rising inflation, Americans become more supportive of
   means-tested social welfare spending. Our analyses generally reaffirm
   the value Americans place on the social welfare safety net, especially
   during times of economic duress. When the going gets tough, Americans
   reach out, rather than pull back.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Kam, CD (Corresponding Author), Univ Calif Davis, Dept Polit Sci, 1 Shields Ave, Davis, CA 95616 USA.
   Kam, Cindy D., Univ Calif Davis, Dept Polit Sci, Davis, CA 95616 USA.
   Nam, Yunju, Washington Univ, George Warren Brown Sch Social Work, St Louis, MO 63130 USA.},
DOI = {10.1007/s11109-007-9048-3},
ISSN = {0190-9320},
Keywords = {public opinion; welfare; inflation; unemployment; economic conditions},
