@article{ WOS:000254665400010,
Author = {Gimpel, James G. and Lee, Frances E. and Pearson-Merkowitz, Shanna},
Title = {The check is in the mail: Interdistrict funding flows in congressional
   elections},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2008},
Volume = {52},
Number = {2},
Pages = {373-394},
Month = {APR},
Abstract = {This article analyzes the financial ties between congressional
   candidates and individual donors residing outside those candidates'
   districts. Congressional campaigns today rely more heavily on
   nonresidents than in the past, with contests in the typical district
   drawing more than two-thirds of individual donations from nonresidents.
   Empirical results reveal that nonresident contributions are primarily
   partisan and strategic in nature, rather than access-oriented or
   expressive/identity-based. Funds are efficiently redistributed from a
   small number of highly educated, wealthy congressional districts to
   competitive districts anywhere in the country. Big donors direct funds
   where they can make a difference for party control of seats, even if
   those investments are hundreds, or even thousands, of miles away.},
