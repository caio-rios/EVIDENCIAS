@article{ WOS:000256006400012,
Author = {Sprague, Mary},
Title = {The effects of measurement and methods decisions on committee preference
   outlier results},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2008},
Volume = {61},
Number = {2},
Pages = {309-318},
Month = {JUN},
Abstract = {Studies of outlying committee preferences have been conducted with
   different preference measures and methodological approaches and have
   generated conflicting results. To assess the effects of these study
   design differences, I use multiple methodological approaches to examine
   committee-floor differences with jurisdiction-specific interest group
   data during a longer time period than earlier studies. After comparing
   results across methods, I compare them to past findings using the same
   method but different preference measures. I find that differences in
   preference measures largely explain previous contradictory results.
   Additionally, outlying tendencies exist among all committees expected to
   be outliers under conditional claims of the distributive theory.},
