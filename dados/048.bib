@article{ WOS:000257940200004,
Author = {Radin, Dagmar},
Title = {World Bank funding and health care sector performance in Central and
   Eastern Europe},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2008},
Volume = {29},
Number = {3},
Pages = {325-347},
Month = {JUN},
Abstract = {This article looks at the impact of World Bank funding on health care
   sector performance in Central and Eastern European countries. The World
   Bank has been one of few organizations involved in health care sector
   assistance in these nations during the transition period, mainly through
   funds disbursement. This article tests hypotheses that those countries
   that perform better economically, that are more favorably evaluated by
   the World Bank, and that have more effective institutions are also more
   likely to benefit from World Bank assistance, through improvements in
   the performance of their health care sectors.},
