@article{ WOS:000186026600006,
Author = {Lubell, M},
Title = {Collaborative institutions, belief-systems, and perceived policy
   effectiveness},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2003},
Volume = {56},
Number = {3},
Pages = {309-323},
Month = {SEP},
Abstract = {In this article I combine two existing policy theories, institutional
   rational choice and the Advocacy Coalition Framework, to explain actor
   perceptions of the effectiveness of public policies targeting
   common-pool resource dilemmas in coastal watersheds. Survey data from
   estuaries with and without the USEPAs National Estuary Program provides
   evidence for two main hypotheses. First, perceived policy effectiveness
   is a function of ``collective-action beliefs{''}: beliefs about
   situational variables that determine the benefits and transaction costs
   of collective action within the estuary action arena. Second, the
   effects of policy-core beliefs and institutional structure on perceived
   policy effectiveness are interdependent. In particular, governance
   institutions have a favorable effect on perceived policy effectiveness
   among political actors whose policy-core beliefs are congruent with the
   structure of the institution.},
