@article{ WOS:000183044500004,
Author = {Jennings, MK and Andersen, EA},
Title = {The importance of social and political context: The case of aids
   activism},
Journal = {POLITICAL BEHAVIOR},
Year = {2003},
Volume = {25},
Number = {2},
Pages = {177-199},
Month = {JUN},
Abstract = {We utilize a 1992 survey of approximately, 2500 AIDS activists to
   analyze their degree of participation. Activity levels were affected by
   several traditional predictors, but the inclusion of contextual measures
   indicating the activists' connection with AIDS, especially the pain and
   loss incurred, led to a much fuller and more complex explanatory model.
   We argue that a richer comprehension of political participation requires
   more studies of issue-specific activists and the specification of
   contexual features that serve to motivate more intensive degrees of
   participation.},
