@article{ WOS:000184083100005,
Author = {Banducci, SA and Karp, JA},
Title = {How elections change the way citizens view the political system:
   Campaigns, media effects and electoral outcomes in comparative
   perspective},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2003},
Volume = {33},
Number = {3},
Pages = {443-467},
Month = {JUL},
Note = {Regional Conference of the
   World-Association-for-Public-Opinion-Research, UNIV NAVARRA, PAMPLONA,
   SPAIN, NOV, 2000},
Organization = {World Assoc Public Opinion Res},
Abstract = {Attitudes towards the political system have often been assumed to be
   stable attributes that are not easily influenced by short-term forces.
   We examine the extent to which attention to media coverage, campaign
   activity and electoral outcomes can mobilize support for the political
   system in the context of an election campaign. Using pre-election and
   post-election survey panels from the United States, Britain and New
   Zealand, we find only small shifts in aggregate measures of system
   support. However, we find that there are significant shifts in system
   support at the individual level that can be explained by status as
   election winners, attention to the media, particularly serious news
   coverage and economic perceptions. The results have implications for the
   debate over measures of system support such as trust, cynicism and
   efficacy.},
Publisher = {CAMBRIDGE UNIV PRESS},
