@article{ WOS:000180711500002,
Author = {Alvarez, RM and Bedolla, LG},
Title = {The foundations of Latino voter partisanship: Evidence from the 2000
   election},
Journal = {JOURNAL OF POLITICS},
Year = {2003},
Volume = {65},
Number = {1},
Pages = {31-49},
Month = {FEB},
Note = {Meeting of the Western-Political-Science-Association, LAS VEGAS, NV,
   2001},
Organization = {West Polit Sci Assoc},
Abstract = {Studies of partisan identification in the U.S. have concentrated on
   Anglo Americans. We argue that by focusing only on the descendents of
   naturalized, mostly white, immigrants, that previous research may have
   been biased toward largely sociological accounts for the development of
   partisan attitudes. Here we study the partisan affiliations of Latino
   voters and argue that by examining their partisan attitudes we should
   find that their partisanship is more explicitly political than Anglos.
   We utilize a telephone survey of Latino likely voters in the 2000
   presidential election and find that Latino voter partisanship is shaped
   by both political and social factors.},
