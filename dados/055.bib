@article{ WOS:000180861100007,
Author = {Kumar, S},
Title = {Power cycle analysis of India, China, and Pakistan in regional and
   global politics},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2003},
Volume = {24},
Number = {1},
Pages = {113-122},
Month = {JAN},
Abstract = {Structural change in Asia among India, China, and Pakistan has been
   intense and is directly associated with the instability that has
   resulted. As these governments move for-ward on their regional and
   global power cycles, what points of non-linearity (critical points) yet
   await the region and the larger system, and with what effect? The
   article calls for management of the foreign policy role such that
   comparative calm is sustained in the midst of structural change and
   uncertainty.},
