@article{ WOS:000186026600007,
Author = {Holyoke, TT},
Title = {Choosing battlegrounds: Interest group lobbying across multiple venues},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2003},
Volume = {56},
Number = {3},
Pages = {325-336},
Month = {SEP},
Note = {58th Annual Meeting of the Midwest-Political-Science-Association,
   CHICAGO, IL, APR 27-30, 2000},
Organization = {Midwest Polit Sci Assoc},
Abstract = {Most research on the lobbying strategies of organized interests is venue
   specific. Yet organized interests frequently lobby in many different
   kinds of institutional venues, often on a single issue. I develop and
   test a model of the decision to lobby in one venue over another on a
   specific issue. included in the model is the impact of oppositions from
   opposing interests in a particular venue, a factor that has not been
   considered in past research. I test the model with data from interviews
   with lobbyists for groups that were active on the issue of financial
   modernization between 1997 and 1999. I find significant variation in the
   amount of lobbying performed by different organizations on this issue in
   different venues expectations of opposition from other interests are a
   significant factor in the decision to lobby in a given venue.},
