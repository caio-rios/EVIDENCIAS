@article{ WOS:000182380200006,
Author = {Finocchiaro, CJ},
Title = {An institutional view of congressional elections: The impact of
   congressional image on seat change in the house},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2003},
Volume = {56},
Number = {1},
Pages = {59-65},
Month = {MAR},
Note = {Annual Meeting of the Southern-Political-Science-Association, SAVANNAH,
   GA, NOV 03-06, 1999},
Organization = {SO Polit Sci Assoc},
Abstract = {The literature on seat change in U.S. House elections abounds with
   explanations regarding the factors contributing to the biennial change
   in the partisan balance of the body While a number of theoretically and
   empirically appealing models have been presented, many base their
   explanations around presidential politics and a variety of factors
   independent of Congress. In this article, I argue that, in developing
   models of congressional seat change, it is worthwhile to consider how
   the public image of the institution impacts the electoral success of its
   members. I describe and test a model that captures the influence of the
   public's perception of Congress on party seat change. Encompassing tests
   suggest that this framework significantly improves upon existing models.
   The results underscore the importance of endogenous, Congress-specific
   factors in explaining aggregate seat change in the U.S. House of
   Representatives.},
