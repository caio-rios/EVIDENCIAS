@article{ WOS:000182153700004,
Author = {Dimitrakopoulos, DG},
Title = {Power, norms and institutional change in the European Union: The
   protection of the free movement of goods},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2003},
Volume = {42},
Number = {2},
Pages = {249-270},
Month = {MAR},
Abstract = {How do European Union (EU) institutions change? Using an
   institutionalist approach, this article highlights the interplay between
   power, cognitive limits and the normative order that underpins
   institutional settings and assesses their impact upon the process of
   institutional change. Empirical evidence from recent attempts to
   reinforce the protection of the free movement of goods in the EU
   suggests that, under conditions of uncertainty, actors with ambiguous
   preferences assess attempts at institutional change on the basis of the
   historically defined normative order which holds a given institutional
   structure together. Hence, path dependent and incremental change occurs
   even when more ambitious and functionally superior proposals are on
   offer.},
