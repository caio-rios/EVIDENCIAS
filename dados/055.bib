@article{ WOS:000183974000004,
Author = {Leeds, BA},
Title = {Do alliances deter aggression? The influence of military alliances on
   the initiation of militarized interstate disputes},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2003},
Volume = {47},
Number = {3},
Pages = {427-439},
Month = {JUL},
Note = {Annual Meeting of the Midwest-Political-Science-Association, CHICAGO,
   ILLINOIS, APR 19-29, 2001},
Organization = {Midwest Polit Sci Assoc},
Abstract = {Scholars have long debated the effects of military alliances on the
   likelihood of war, and no clear support has emerged for the argument
   that alliances improve the prospects for peace through effective
   deterrence nor that they kindle the flames of war. In this study, I
   argue that alliance commitments affect the probability that a potential
   challenger will initiate a militarized interstate dispute because
   alliances provide information about the likelihood that others will
   intervene in a potential conflict. Yet, different agreements provide
   different information. Alliance commitments that would require allies to
   intervene on behalf of potential target states reduce the probability
   that a militarized dispute will emerge, but alliance commitments
   promising offensive support to a potential challenger and alliances that
   promise nonintervention by outside powers increase the likelihood that a
   challenger will initiate a crisis. As diplomats have long understood,
   the specific content of international agreements helps to determine
   their effects.},
Publisher = {BLACKWELL PUBLISHING INC},
Address = {350 MAIN ST, MALDEN, MA 02148 USA},
Type = {Article; Proceedings Paper},
Language = {English},
