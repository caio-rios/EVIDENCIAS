@article{ WOS:000181941900003,
Author = {Gustafsson, G},
Title = {Church-state separation Swedish-Style},
Journal = {WEST EUROPEAN POLITICS},
Year = {2003},
Volume = {26},
Number = {1},
Pages = {51+},
Month = {JAN},
Abstract = {A more than 40-year-long process came to an end when relations between
   the Church of Sweden and the state were formally changed in the year
   2000. Social Democrats and Liberals had taken the initiative in the
   1950s. Several proposals for disestablishment were put forward in the
   1970s, but none of them. achieve political consensus. In addition, the
   representatives for all the political parties on the elected parochial
   church councils opposed every change, whereas the clergy often took a
   more positive view. Only in the 1990s did the political and the
   ecclesiastical systems finally agree a settlement that gave the Church
   of Sweden a greater degree of liberty. Even so, a Law for the Church of
   Sweden still defines the framework for the structures and work of the
   church.},
