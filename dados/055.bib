@article{ WOS:000181753900002,
Author = {Campbell, AL},
Title = {Participatory reactions to policy threats: Senior citizens and the
   Defense of Social Security and Medicare},
Journal = {POLITICAL BEHAVIOR},
Year = {2003},
Volume = {25},
Number = {1},
Pages = {29-49},
Month = {MAR},
Abstract = {The sociodemographic factors emphasized in much participation research
   cannot explain abrupt changes in levels of activity. This study shows
   how threat of undesirable policy change acts as an impetus to
   participatory activity, helping to explain temporal variation in
   participation. Newly available individual-level time-series data are
   used to show surges in senior citizen letter writing in response to
   threats to Social Security and Medicare during the 1980s. Policy threat
   interacts with individual characteristics to produce variations in
   participatory reaction congruent with the magnitude of the threat to the
   individual.},
Publisher = {KLUWER ACADEMIC/PLENUM PUBL},
