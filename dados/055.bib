@article{ WOS:000184793500003,
Author = {Remmer, KL and Gélineau, F},
Title = {Subnational electoral choice -: Economic and referendum voting in
   Argentina, 1983-1999},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2003},
Volume = {36},
Number = {7},
Pages = {801-821},
Month = {SEP},
Abstract = {Are the policy failures of subnational officials reliably punished by
   voters, or do subnational elections instead pivot around national
   trends? This study attempts to shed new light on these questions by
   exploring subnational elections in the Argentine context. Building on a
   modified version of the referendum-voting model, our analysis suggests
   that the fate of candidates in both national and subnational elections
   is shaped by the performance of the incumbent presidential
   administration. At the same time, however, we also find evidence that
   voters respond to the policy choices of subnational governments, albeit
   in ways that attenuate, rather than strengthen, the nexus between policy
   responsibility and electoral accountability.},
