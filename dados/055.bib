Pages = {345-376},
Month = {JUN},
Note = {Meeting of the International-Society-of-Political-Psychology, AMSTERDAM,
   NETHERLANDS, JUL 18-21, 1999},
Organization = {Int Soc Polit Psychol},
Abstract = {This paper presents new terms for analyzing individuals' national
   attitudes and their conceptualization and operationalization, a
   universal psychological structure in which these concepts interconnect,
   and a nationalism explanatory model. Three empirical studies using
   anonymous self-administered surveys served to test and improve national
   attitude assessment and its developmental theory. These empirical
   studies were conducted in a well established state (the Netherlands), a
   recently established state (Slovakia), and a region in which a
   considerable proportion of citizens are striving to develop a new
   independent state (the Basque Autonomous Community of Spain).},
