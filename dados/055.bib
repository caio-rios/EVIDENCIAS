@article{ WOS:000180774200001,
Author = {Bowler, S and Donovan, T and Karp, JA},
Title = {When might institutions change? Elite support for direct democracy in
   three nations},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2002},
Volume = {55},
Number = {4},
Pages = {731-754},
Month = {DEC},
Abstract = {Legislators typically control the design of political institutions, and
   can be expected to craft rules that work to their advantage. In some
   nations, however, legislators adopt provisions for direct democracy-an
   institution that might weaken the control that established parties and
   incumbents have over political agendas. We examine the nature of
   legislative support for direct democracy by surveying legislators and
   legislative candidates in Canada, New Zealand and the United States. We
   find that support is conditioned by factors internal to the legislative
   setting (affiliation with a governing party, incumbency, and tenure) and
   by ideology and subjective attitudes about democracy We discuss how our
   findings relate to broader questions about when elites might change
   democratic institutions they control.},
Publisher = {UNIV UTAH},
