@article{ WOS:000271826800012,
Author = {Hilbink, Lisa},
Title = {The Constituted Nature of Constituents' Interests Historical and
   Ideational Factors in Judicial Empowerment},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2009},
Volume = {62},
Number = {4},
Pages = {781-797},
Month = {DEC},
Abstract = {Through an analysis of constitutional transitions in one democratizing
   case (Spain 1978) and one authoritarian case (Chile 1980), this article
   argues that judicial empowerment can be accurately explained only
   through reference to the historical and ideational context in which
   institutional designers operate. Historical and ideational factors-that
   is, shared experiences, beliefs, identities, ideologies, and
   interpretations of events and sequences of events at home or
   abroad-shape the way that political actors perceive their interests,
   formulate their strategies, and justify their decisions and are thus
   crucial to explaining when, why, and how institutional designers choose
   to empower courts.},
