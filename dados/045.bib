Pages = {389-415},
Abstract = {This article introduces a new concept to the literature on authoritarian
   regimes - the `democratic enclave' - and contrasts it to the well-known
   concept of the `authoritarian enclave'. The meaning and description of
   democratic enclaves is given. A causal theory of democratic enclaves is
   outlined and their consequences considered. Theoretical and policy
   implications follow.},
