   Franchino, Fabio, Univ Milan, Dept Social \& Polit Studies, I-20122 Milan, Italy.
   Hoyland, Bjorn, Univ Oslo, Dept Polit Sci, N-0317 Oslo, Norway.},
DOI = {10.1017/S0003055409990177},
ISSN = {0003-0554},
EISSN = {1537-5943},
Keywords-Plus = {EUROPEAN INTEGRATION; POLICY-MAKING; TRANSPOSITION; GOVERNMENT; EU;
   CONFIDENCE; VOTE},
Research-Areas = {Government \& Law},
