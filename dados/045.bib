@article{ WOS:000271598600020,
Author = {Kriner, Douglas and Shen, Francis},
Title = {Limited War and American Political Engagement},
Journal = {JOURNAL OF POLITICS},
Year = {2009},
Volume = {71},
Number = {4},
Pages = {1514-1529},
Month = {OCT},
Abstract = {Prior studies of war and political engagement focus on mass mobilizing,
   successful conflicts and treat war as a monolithic variable affecting
   all Americans equally. In this study, we analyze the more limited, less
   successful conflicts prevalent since 1945, and we examine the influence
   of disparities in local communities' casualty rates on their residents'
   patterns of political engagement. Using both individual- and
   aggregate-level data, we show that citizens from communities that
   suffered high casualty rates in the Vietnam and Korean Wars were
   significantly less politically engaged in each conflict's wake than
   their peers from low-casualty communities.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
