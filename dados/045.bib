@article{ WOS:000269705800006,
Author = {Rabinowitz, Joshua L. and Sears, David O. and Sidanius, Jim and
   Krosnick, Jon A.},
Title = {Why Do White Americans Oppose Race-Targeted Policies? Clarifying the
   Impact of Symbolic Racism},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2009},
Volume = {30},
Number = {5},
Pages = {805-828},
Month = {OCT},
Abstract = {Measures of symbolic racism (SR) have often been used to tap racial
   prejudice toward Blacks. However, given the wording of questions used
   for this purpose, some of the apparent effects on attitudes toward
   policies to help Blacks may instead be due to political conservatism,
   attitudes toward government, and/or attitudes toward redistributive
   government policies in general. Using data from national probability
   sample surveys and an experiment, we explored whether SR has effects
   even when controlling for these potential confounds and whether its
   effects are specific to policies involving Blacks. Holding constant
   conservatism and attitudes toward limited government, SR predicted
   Whites' opposition to policies designed to help Blacks and more weakly
   predicted attitudes toward social programs whose beneficiaries were
   racially ambiguous. An experimental manipulation of policy beneficiaries
   revealed that SR predicted policy attitudes when Blacks were the
   beneficiary but not when women were. These findings are consistent with
   the claim that SR's association with racial policy preferences is not
   due to these confounds.},
Publisher = {WILEY-BLACKWELL PUBLISHING, INC},
