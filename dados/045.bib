@article{ WOS:000271598600011,
Author = {Peress, Michael},
Title = {Optimal Supermajority Requirements in a Two-Party System},
Journal = {JOURNAL OF POLITICS},
Year = {2009},
Volume = {71},
Number = {4},
Pages = {1379-1393},
Month = {OCT},
Abstract = {Legislative governance in the United States is characterized by a system
   of checks and balances. On the one hand, agenda-setting power is
   concentrated. The majority party has significant control over the
   agenda. Such power is tempered by supermajority requirements (such as
   the 60-vote requirement for invoking cloture), bicameralism, and the
   presidential veto. I develop a theory of legislative outcomes which
   incorporates supermajority requirements. 1 argue that supermajority
   requirements can, in fact, serve an important purpose in balancing
   concentrated agenda-setting power. I find that substantial supermajority
   requirements are optimal for legislation, if the aim is to enact
   policies preferred by the median voter.},
