@article{ WOS:000289635400004,
Author = {Freire, Andre},
Title = {A New Era in Democratic Portugal? The 2009 European, Legislative and
   Local Elections},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2010},
Volume = {15},
Number = {4},
Pages = {593-613},
Abstract = {The main objective of this article is to analyse the campaigns and
   results of the three 2009 Portuguese elections: European, legislative
   and local. The 2009 election cycle also revealed some significant
   changes in the party system format (especially in the first two
   elections) which might have major consequences for the functioning of
   the political system, especially if the results are not merely short
   term and continue in future legislative elections, signalling a major
   change in the democratic model with a return to the kind of policies
   typical of the consensual period and away from the kind of policies
   typical of majoritarian one.},
