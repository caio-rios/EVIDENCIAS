@article{ WOS:000271598600009,
Author = {Saiegh, Sebastian M.},
Title = {Political Prowess or ``Lady Luck{''}? Evaluating Chief Executives'
   Legislative Success Rates},
Journal = {JOURNAL OF POLITICS},
