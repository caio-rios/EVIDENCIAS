@article{ WOS:000271826800011,
Author = {Shambayati, Hootan and Kirdis, Esen},
Title = {In Pursuit of ``Contemporary Civilization{''}: Judicial Empowerment in
   Turkey},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2009},
Volume = {62},
Number = {4},
Pages = {767-780},
Month = {DEC},
Abstract = {Turkey's powerful Constitutional Court serves as an administrative
   attache of state elites in overseeing the political arena and
   transforming the society. Looking at the courts as administrative agents
   suggests that the ruling elite might turn to courts not in an attempt to
   safeguard their immediate interests, but to transform the society by
   extending the reach of the state. The authors contend that in countries
   where the state pursues a civilizing mission, judicial empowerment is an
   attractive tool for defending the state against powerful segments of the
   society who might subscribe to different civilizing projects.},
