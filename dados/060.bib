@article{ WOS:001575897100001,
Author = {Aanstoos, Kristen},
Title = {A Voice at the Table: How Women in Peace Processes Shape Political
   Representation},
Journal = {POLITICS \& GENDER},
Year = {2025},
Volume = {21},
Number = {3},
Pages = {431-461},
Month = {SEP},
Abstract = {Women's political representation is a key indicator of peace and
   stability in postconflict states, but we do not yet fully understand the
   factors that lead to sustained increases in women's representation after
   conflict. This article proposes and tests a new variable affecting
   changes in women's legislative representation in postconflict states:
   types of women's participation in the peace process. Using multivariate
   regressions, this study finds that local women's participation in
   high-influence roles and in both Track I and II processes significantly
   increases women's representation after conflict, while international
   women in peace processes do not. Women's movements only increase women's
   representation after conflict in combination with local women in peace
   processes. These findings illustrate one important outcome of local
   women's inclusion in peace processes and highlight the importance of
   inclusive peace processes for postconflict democratic outcomes.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Aanstoos, K (Corresponding Author), Univ Southern Calif, Dept Polit Sci \& Int Relat, Los Angeles, CA 90007 USA.
   Aanstoos, Kristen, Univ Southern Calif, Dept Polit Sci \& Int Relat, Los Angeles, CA 90007 USA.},
DOI = {10.1017/S1743923X2510038X},
