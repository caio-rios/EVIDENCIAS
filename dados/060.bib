@article{ WOS:001585966400001,
Author = {de Jonge Oudraat, Chantal and Brown, Michael E.},
Title = {The WPS Agenda Beyond 2025: Time for a WPS Treaty},
Journal = {POLITICS \& GENDER},
Year = {2025},
Volume = {21},
Number = {3},
Pages = {718-725},
Month = {SEP},
Abstract = {Over the first quarter of the 21st century, the Women, Peace, and
   Security (WPS) agenda became established as the most important policy
   framework linking gender issues to peace and security problems. WPS work
   has proceeded along two tracks: a nongovernmental track comprised of
   women's rights activists and gender scholars; and a policy track
   directed by national governments and intergovernmental organizations
   (Brown and de Jonge Oudraat 2025). Both tracks have been instrumental in
   advancing the WPS agenda, including the adoption by the UN Security
   Council of ten WPS resolutions-starting with Resolution 1325 in October
   2000. The 25th anniversary of UNSCR 1325 is an appropriate occasion to
   assess WPS accomplishments to date and define WPS priorities for the
   years ahead.},
