@article{ WOS:001900325800001,
Author = {Reher, Stefanie and Liu, Shan-Jan Sarah},
Title = {Intersecting Identities: How Gender and Disability Shape Voter
   Perceptions of Election Candidates},
Journal = {POLITICS \& GENDER},
Year = {2026},
Month = {2026 OCT 12},
Abstract = {Voters' perceptions of election candidates are known to be shaped by
   stereotypes about candidates' characteristics and social identities,
   including gender and disability. More recently, scholars have started
   paying attention to how the intersection of politicians' identities
   shapes citizens' perceptions of them, recognizing that identities do not
   simply ``add up{''} but give rise to distinct stereotypes and
   expectations. This paper explores how candidate gender and disability
   affect voter perceptions through a survey experiment with a conjoint
   design in the UK and the US. The findings reveal a complex picture in
   which candidate gender and disability interact in shaping some, but not
   the majority, of voters' perceptions of candidates' traits, competences,
   beliefs, as well as voter support. The study underlines that
   intersectional approaches are fundamental to advancing our understanding
   of voter attitudes and behavior, candidate competition, and the
   representation of social groups.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
