Year = {2025},
Volume = {21},
Number = {1},
Pages = {131-136},
Month = {MAR},
Abstract = {In the 20 years since the founding of Politics \& Gender, gender and
   politics scholarship has coalesced into a distinct body of research and
   community of scholarship (Sawer 2025; Tripp 2025). The research
   published in this journal and others cuts across the traditional
   political science subfields, methodological approaches, and regional
   boundaries. While engaging with different topics and parts of the larger
   discipline, gender and politics research distinguishes itself through
   its turning around a shared understanding that gender plays a critical
   explanatory role in our political worlds - whether that be in the
   gendered ways that politics is enacted or the gendered consequences of
   political actions. There is a shared language of scholarship amongst
   researchers.},
