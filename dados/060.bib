@article{ WOS:001475728900001,
Author = {Garcia, Daniela Philipson and True, Jacqui and Abbashar, Aida and
   Akbari, Farkhondeh and Asadi, Pardis and Aung, Isabella and Dadpour,
   Rana and Cardenas, Magda Lorena and Dhanani, Priya and Lai, Ruby and
   Matveiva, Olga and Navumau, Vasil and Rudnik, Alesia and Scheyer,
   Victoria and Manoilenko, Hanna and Zulver, Julia and Hanifah, Hana and
   Maureen Brunt Women \& Democratic Change Network},
Title = {Is Scholar-Activism an Oxymoron? Reflecting on the Challenges and
   Opportunities for Scholarly Activism or Activist Scholarship in the
   Politics and Gender Field},
Journal = {POLITICS \& GENDER},
Year = {2025},
Volume = {21},
Number = {4},
Pages = {1110-1118},
Month = {DEC},
Abstract = {Scholar-activism, which we define as scholarship that seeks to
   contribute knowledge to activism is often underappreciated. From a
   methodological perspective, the positionality of scholar-activists is
   too often misunderstood. Yet scholar-activism is a relatively common
   approach to generating new knowledge about hard-to-access, repressive
   contexts while also assisting political movements and their strategies.
   Feminist-informed scholarship necessitates scholar-activism because it
   is driven by an emancipatory purpose that demands critical reflexivity
   about the power of epistemology, boundaries, relationships, and the
   researcher's situatedness (Ackerly and True 2020, 22). We argue that a
   deeper understanding of scholar-activism and lived experiences is vital
   for furthering knowledge and impact in the politics and gender field.},
