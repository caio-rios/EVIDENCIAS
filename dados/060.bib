@article{ WOS:000921617000001,
Author = {Alsahi, Huda},
Title = {Mapping Gender and Women's Studies in the Arab Gulf: How to Move It from
   the Margins?},
Journal = {POLITICS \& GENDER},
Year = {2023},
Volume = {19},
Number = {1},
Pages = {296-301},
Month = {MAR},
Abstract = {Over the past few decades, the Arab Gulf has witnessed tremendous
   socioeconomic and structural transformation coupled with major reforms
   to modernize the higher education sector. These reforms have focused on
   establishing partnerships with foreign universities and/or hosting
   international branch campuses to promote diverse, liberal, and
   high-quality educational programs. While these far-reaching reforms have
   undeniably led to a dramatic increase in the number of academic
   institutions (Baghdady 2017), these institutions have mostly reproduced
   traditional educational structures and paradigms, with little
   contribution to the advancement of more liberal and progressive ideas
   and/or areas of study, namely, gender and women's studies (GWS).},
