@article{ WOS:000952431500001,
Author = {Tripp, Aili Mari},
Title = {How African Autocracies Instrumentalize Women Leaders},
Journal = {POLITICS \& GENDER},
Year = {2024},
Volume = {20},
Number = {1},
Pages = {217-222},
Month = {MAR},
Abstract = {Although democratic countries historically have had stronger outcomes in
   advancing gender equality than other regime types, many authoritarian
   regimes in Africa have proved rather adept at adopting women's rights
   provisions, making extensive constitutional and legislative reforms, and
   promoting women as leaders. These outcomes are particularly evident when
   it comes to women's political representation, where one finds little
   difference between authoritarian and democratic regimes in Africa. This
   essay explores how authoritarian regimes in Africa came to promote women
   leaders and how the instrumentalization of women leaders served to
   enhance the longevity of their rule.},
