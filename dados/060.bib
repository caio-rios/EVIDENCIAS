@article{ WOS:001789152000001,
Author = {Ferree, Myra Marx},
Title = {Rethinking Family as a Care Justice Strategy},
Journal = {POLITICS \& GENDER},
Year = {2026},
Month = {2026 JUN 10},
Abstract = {The assumption that family ties devalue caring by making it ``women's
   work{''} is commonplace. However, it is deeply problematic for three
   reasons: care is more than work; both material and immaterial goods are
   given value through institutional and interpersonal choices; and
   ``family{''} is not only done in a patriarchal fashion. Each of these
   limitations can be overcome if giving and receiving care are valued; if
   so, a just society will be a caring one.},
