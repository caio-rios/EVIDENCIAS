Pages = {658-664},
Month = {SEP},
Abstract = {For nearly a decade, the concept of feminist foreign policy1 (FFP) has
   garnered global attention, with numerous countries adopting or
   expressing the intent to adopt such policies. However, the roles of
   Africans within these discourses, as both target and agents of FFP, has
   been uncertain. The particular attention paid by FFP to the Global South
   makes the exclusion of African knowledges especially jarring.},
