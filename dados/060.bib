ISSN = {1743-923X},
EISSN = {1743-9248},
Keywords-Plus = {PORTFOLIO ALLOCATION; COALITION PAYOFFS; CABINET MINISTERS;
   LEGISLATURES; WOMEN; REPRESENTATION; APPOINTMENT; CONTEXT; QUOTAS; NORMS},
Research-Areas = {Government \& Law; Women's Studies},
Web-of-Science-Categories  = {Political Science; Women's Studies},
