@article{ WOS:000416416600013,
Author = {Elias, Juanita},
Title = {Continuing the Conversation ... Some Reflections},
Journal = {POLITICS \& GENDER},
Year = {2017},
Volume = {13},
Number = {4},
Pages = {747-751},
Month = {DEC},
Abstract = {The diverse collection of short reflections included in this Critical
   Perspectives section looks to continue a conversationa conversation that
   played out in the pages of this journal (Elias 2015) regarding the
   relationship between two strands of feminist international relations
   scholarship: feminist security studies (FSS) and feminist international
   political economy (IPE). In this forum, the contributors return to some
   of the same ground, but in doing so, they bring in new concerns and
   agendas. New empirical sites of thinking through the nexus between
   security and political economy from a feminist perspective are explored:
   war, women's lives in postconflict societies, and international security
   governance institutions and practices.},
