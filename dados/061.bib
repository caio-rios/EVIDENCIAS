@article{ WOS:000383002700006,
Author = {Spierings, Niels},
Title = {Multilevel Analysis as a Tool to Understand the Spatio-Temporality of
   Gender},
Journal = {POLITICS \& GENDER},
Year = {2016},
Volume = {12},
Number = {3},
Month = {SEP},
Abstract = {As illustrated by these definitions from the Oxford Handbook of Gender
   and Politics, context dependency is a defining characteristic of gender,
   since gender and intersectional inequalities differ spatially and
   temporarily in how they are organized. It is on this issue of context
   dependency where gender studies scholars often collide with (the
   application and interpretation) of regression-based statistical analysis
   in debates about quantitative methods (see Spierings 2012).},
