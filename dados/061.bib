@article{ WOS:000430316700015,
Author = {Boryczka, Jocelyn M.},
Title = {WANTED: Hillary Clinton, Suspect Citizen},
Journal = {POLITICS \& GENDER},
Year = {2018},
Volume = {14},
Number = {1, SI},
Pages = {121-127},
Month = {MAR},
Abstract = {Lock her up! Lock her up! Lock her up! This battle cry erupted at one
   Donald Trump rally after another throughout the 2016 presidential
   campaign. Trump even threatened to jail Hillary Rodham Clinton (HRC) if
   he won the election. Crooked Hillary emerged as Trump's disparaging
   nickname for his Democratic opponent. Taking a further moralistic step,
   Trump equated HRC with pure evil, calling her the devil at an August
   2016 campaign rally in Pennsylvania.},
