@article{ WOS:000451709900009,
Author = {Krook, Mona Lena},
Title = {Violence against Women in Politics: A Rising Global Trend},
Journal = {POLITICS \& GENDER},
Year = {2018},
Volume = {14},
Number = {4},
Pages = {673-675},
Month = {DEC},
Abstract = {Recent years have witnessed a troubling rise in reports of assault,
   intimidation, and abuse directed at politically active women. The United
   Nations General Assembly first called for zero tolerance for violence
   against female candidates and elected officials in Resolution 66/130 in
   2011. In 2012, Bolivia became the first country in the world to
   criminalize political violence and harassment against women, in response
   to a more than decade-long campaign by locally elected women to document
   the numerous injuries and abuses they confronted. Resonating across the
   region, this development led the states-parties to the Inter-American
   Convention on the Prevention, Punishment and Eradication of Violence
   against Women to endorse a Declaration on Political Violence and
   Harassment against Women in 2015.},
