@article{ WOS:000451709900012,
Author = {Kuperberg, Rebecca},
Title = {Intersectional Violence against Women in Politics},
Journal = {POLITICS \& GENDER},
Year = {2018},
Volume = {14},
Number = {4},
Pages = {685-690},
Month = {DEC},
Abstract = {The field of violence against women in politics (VAWIP) is so new, it
   seems unfair to discuss its gaps; rather, the study of VAWIP is defined
   by its uncharted territory. The bulk of existing literature, compiled by
   scholars as well as practitioners, emphasizes theoretical
   conceptualization, empirical forms of violence, and the tracking of
   incidents across regions (Krook 2017; Krook and Restrepo Sanin 2016).
   Researchers have stressed the gendered motivations and implications of
   VAWIP. In short, women are targets of violence because they are women
   and because they are in politics.},
