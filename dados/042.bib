@article{ WOS:000290587000005,
Author = {Pluemper, Thomas and Troeger, Vera E.},
Title = {Fixed-Effects Vector Decomposition: Properties, Reliability, and
   Instruments},
Journal = {POLITICAL ANALYSIS},
Year = {2011},
Volume = {19},
Number = {2},
Pages = {147-164},
Month = {SPR},
Abstract = {This article reinforces our 2007 Political Analysis publication in
   demonstrating that the fixed-effects vector decomposition (FEVD)
   procedure outperforms any other estimator in estimating models that
   suffer from the simultaneous presence of time-varying variables
   correlated with unobserved unit effects and time-invariant variables. We
   compare the finite-sample properties of FEVD not only to the
   Hausman-Taylor estimator but also to the pretest estimator and the
   shrinkage estimator suggested by Breusch, Ward, Nguyen and Kompas
   (BWNK), and Greene in this symposium. Moreover, we correct the
   discussion of Greene and BWNK of FEVD's asymptotic and finite-sample
   properties.},
