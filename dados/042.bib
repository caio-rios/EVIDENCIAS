@article{ WOS:000288226300009,
Author = {Sapiro, Virginia and Walsh, Katherine Cramer and Strach, Patricia and
   Hennings, Valerie},
Title = {Gender, Context, and Television Advertising: A Comprehensive Analysis of
   2000 and 2002 House Races},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2011},
Volume = {64},
Number = {1},
Pages = {107-119},
Month = {MAR},
Abstract = {Are men and women portrayed differently in campaigns? Much scholarship
   and commentary expects that this is so, yet previous studies provide
   ambiguous evidence on the extent of gender difference.The authors
   provide a comprehensive analysis of gender differences in television
   advertisements in congressional races in 2000 and 2002 with data that
   allow them to take into account the frequency of airings, the
   sponsorship of the advertisements, partisanship, and competitiveness of
   the race. Although some gender differences emerge, the analysis reveals
   undeniable similarity in the presentation of male and female candidates
   in television advertisements.},
