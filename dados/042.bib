@article{ WOS:000294078800009,
Author = {Storey, Benjamin},
Title = {The Problem of Admiration in Rousseau's ``Sad and Great System{''}},
Journal = {JOURNAL OF POLITICS},
Year = {2011},
Volume = {73},
Number = {3},
Pages = {735-747},
Month = {JUL},
Abstract = {This article examines Rousseau's understanding of the phenomenon of
   admiration. I begin with a discussion of Rousseau's critique of the
   enlightenment understanding of the relation among admiration, charisma,
   and fanaticism found in Voltaire's Mahomet. I then turn to Rousseau's
   own account of the nature of admiration and his argument that admiration
   is necessarily ubiquitous in social life, even in the minds of
   apparently cynical men. Next, I look to Rousseau's indications of how
   this psychic passion can be constrained and turned to good use for
   political and moral education. Finally, I offer a critical assessment of
   Rousseau's view of admiration, arguing that he shows persuasively that
   admiration is inevitable in social life, but that his ``system{''}
   offers no standard of the truly admirable grounded in nature. Rousseau
   thus teaches us an important lesson about ourselves, but leaves us in
   need of guidance we cannot find in his system.},
