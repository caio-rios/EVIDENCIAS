Volume = {30},
Number = {6},
Pages = {301-310},
Month = {AUG},
Abstract = {Contributions from political, health and economic geography, social
   policy and environmental policy studies are brought together here in
   order to examine the implications of a `libertarian paternalist'
   political `project' which seeks to react in pragmatic and ideological
   terms to the excesses and limitations of neoliberalism in liberal
   democratic contexts. The authors explore the contemporary relevance and
   historical antecedents also-called `nudge' tactics of governing, and
   draw attention to the political geographies encountered in this popular
   political programme in specific cases. (C) 2011 Elsevier Ltd. All rights
   reserved.},
