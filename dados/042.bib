@article{ WOS:000293903400006,
Author = {Nelson, Thomas E. and Gwiasda, Gregory and Lyons, Joseph},
Title = {Vilification and Values},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2011},
Volume = {32},
Number = {5},
Pages = {813-835},
Month = {OCT},
Abstract = {Social values are an important foundation of political attitudes, yet
   political controversies often embody conflicts between values, placing
   the citizen in an awkward position of having to prioritize competing
   values. One strategy is to consider the groups that are symbolically
   associated with the competing values. Groups held in high esteem will
   enhance associated values; groups held in disregard will diminish
   associated values. Persuasive communicators exploit this process by
   assailing groups that have been publicly associated with certain issue
   positions or values as ``extreme{''} or ``radical.{''} Even if the group
   represents a consensus value like equal opportunity, the extremist label
   suggests the group's agenda embodies an excessive and uncompromising
   imposition of this value. This article reports on four experiments that
   investigated how the extremist label can undermine support for a group's
   position. We further examine how reputation affects judgments of value
   priorities.},
