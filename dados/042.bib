   European Univ Inst, Dept Polit \& Social Sci, I-50014 Florence, Italy.},
DOI = {10.1111/j.1540-5907.2011.00535.x},
ISSN = {0092-5853},
Keywords-Plus = {PRESIDENTIAL POPULARITY; CONGRESSIONAL ELECTIONS; PARTY PREFERENCE;
   MODEL; VOTE; ELECTORATE; BEHAVIOR; LOYALTY; DECLINE; BRITAIN},
