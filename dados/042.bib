@article{ WOS:000292391500008,
Author = {Lenz, Gabriel S. and Lawson, Chappell},
Title = {Looking the Part: Television Leads Less Informed Citizens to Vote Based
   on Candidates' Appearance},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2011},
Volume = {55},
Number = {3},
Pages = {574-589},
Month = {JUL},
Abstract = {As long as there has been democratic government, skeptics have worried
   that citizens would base their choices and their votes on superficial
   considerations. A series of recent studies seems to validate these
   fears, suggesting that candidates who merely look more capable or
   attractive perform better in elections. In this article, we examine the
   underlying process behind the appearance effect. Specifically, we test
   whether the effect of appearance is more pronounced among those who know
   little about politics but are exposed to visual images of candidates. To
   do so, we combine appearance-based assessments of U. S. Senate and
   gubernatorial candidates with individual-level survey data measuring
