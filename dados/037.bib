@article{ WOS:000330793200002,
Author = {Bird, Karen},
Title = {Ethnic quotas and ethnic representation worldwide},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2014},
Volume = {35},
Number = {1},
Pages = {12-26},
Month = {JAN},
Abstract = {This article makes theoretical and empirical contributions towards
   understanding the form and function of ethnic quotas that are applied in
   various countries around the world. It advances a classification scheme
   for sorting through the broad variation in these electoral mechanisms.
   Initial exploration suggests that variation among ethnic quota schemes
   corresponds more with regime type, and less with differences in ethnic
   demography. Nevertheless, particular rules do operate differently in
   relation to ethnic diversity and inter-group conflict. Different rules
   also appear to have an impact on representational dynamics, including
   the capacity of minority ethnic representatives to exercise legislative
   influence on matters of concern to their community.},
