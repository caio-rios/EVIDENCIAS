@article{ WOS:000326879200009,
Author = {Black, Ryan C. and Schutte, Rachel A. and Johnson, Timothy R.},
Title = {Trying to Get What You Want: Heresthetical Maneuvering and US Supreme
   Court Decision Making},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2013},
Volume = {66},
Number = {4},
Pages = {819-830},
Month = {DEC},
Abstract = {Riker famously theorized that political actors faced with suboptimal
   outcomes might be able to garner a more desirable one by adding issues
   to the agenda. To date, limited support for Riker's theory of
   heresthetics exists, primarily consisting of case studies and anecdotal
   evidence. We offer a systematic analysis of heresthetical maneuvers in
   the context of Supreme Court decision making. We argue justices who
   oppose a potential case outcome may add alternative issues to the record
   in an effort to restructure the terms of debate. Data from justices'
   behavior during oral argument support Riker's theory.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
