@article{ WOS:000342315100001,
Author = {Petmesidou, Maria and Guillen, Ana M.},
Title = {Can the Welfare State as We Know It Survive? A View from the
   Crisis-Ridden South European Periphery},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2014},
Volume = {19},
Number = {3, SI},
Pages = {295-307},
Abstract = {South European countries have been hit hardest and longest by the
   post-2008 economic crisis. This has brought their welfare states under
   acute strain. Unmet need has sharply increased while significant welfare
   reforms and (more or less) deep cuts and changes in social spending have
   been prominent in the repertoire of the crisis management solutions
   implemented by the governments (under European Union constraints and the
   strict rescue-deal requirements for Greece and Portugal). This
   introduction briefly reviews reform trends prior to and during the
   crisis in order to highlight convergent and divergent paths among the
   four countries and outline the major questions addressed by the
   contributions to this volume.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
