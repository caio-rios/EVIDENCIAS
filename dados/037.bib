@article{ WOS:000332371500006,
Author = {Kerner, Andrew and Lawrence, Jane},
Title = {What's the Risk? Bilateral Investment Treaties, Political Risk and Fixed
   Capital Accumulation},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2014},
Volume = {44},
Number = {1},
Pages = {107-121},
Month = {JAN},
Abstract = {This article argues that the political risk associated with foreign
   direct investment (FDI) is primarily a function of investment in
   fixed-capital, and not a homogeneous feature of FDI. As such, empirical
   tests of a political institution's ability to mitigate political risk
   should focus directly on investments in fixed capital and not on more
   highly aggregated measures of multinational corporation (MNC) activity,
   such as FDI flow and stock data that are affected by the accumulation of
   liquid assets in foreign affiliates. We apply this to the study of
   bilateral investment treaties (BITs). We find that BITs with the United
   States correlate positively with investments in fixed capital and have
   little, if any, correlation with other measures of MNC activity.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
