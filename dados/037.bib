@article{ WOS:000339656700005,
Author = {Kim, Won Sub and Choi, Young Jun},
Title = {Revisiting the Role of Bureaucrats in Pension Policy-making: The Case of
   South Korea},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2014},
Volume = {49},
Number = {2},
Pages = {264-289},
Month = {APR},
Abstract = {This article aims to provide an understanding of the dynamics of pension
   politics in South Korea with a particular focus on the role of
   bureaucrats. In order to explain the reforms, this research will closely
   examine how the expertise and legitimacy of civil servants, together
   with their institutional positioning, have affected their power and role
   in the policy-making process. This article will argue that bureaucrats,
   particularly the welfare bureaucracy, attained their major reform goals
   by associating and competing with other political actors in two major
   reforms.},
