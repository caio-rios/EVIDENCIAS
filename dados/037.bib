@article{ WOS:000334680700006,
Author = {Artabe, Alaitz and Gardeazabal, Javier},
Title = {Strategic Votes and Sincere Counterfactuals},
Journal = {POLITICAL ANALYSIS},
Year = {2014},
Volume = {22},
Number = {2},
Pages = {243-257},
Month = {SPR},
Abstract = {The random utility model (RUM) of voting behavior can account for
   strategic voting by making use of proxy indicators that measure voter
   incentives to vote strategically. The contribution of this article is to
   propose a new method to estimate the RUM in the presence of strategic
   voters, without having to construct proxy measures of strategic voting
   incentives. Our method can be used to infer the counterfactual sincere
   vote of those who vote strategically and provides an estimate of the
   size of strategic voting. We illustrate the procedure using
   post-electoral survey data from Spain. Our calculations indicate that
   strategic voting in Spain is about 2.19\%.},
