@incollection{ WOS:000342053600009,
Author = {Hertog, James K. and Zuercher, Robert J.},
Editor = {Reinemann, C},
Title = {Political Communication in social transformation and revolution},
Booktitle = {POLITICAL COMMUNICATION},
Series = {Handbooks of Communication Science},
Year = {2014},
Volume = {18},
Pages = {167-186},
Abstract = {This chapter reviews literature on the role of individual and mass
   communication in social transformation and revolution. The authors argue
   that many functions crucial to sweeping social transformation have
   always been dependent upon communications. Based on a lifecycle model of
   social movements, the chapter reflects upon how social change advocates
   develop communications strategies, build movements dedicated to enacting
   change, promote their political program, organize action among
   supporters during periods of public contention, and maintain advocacy
   organizations during periods of retrenchment. Moreover, the authors show
   that new technologies have been rapidly incorporated into communications
   strategies by both advocates for and opponents of social transformation.
   However, the ultimate impact of these and future changes worldwide on
   advocacy for social change is unknowable but certain to be profound.},
