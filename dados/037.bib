@incollection{ WOS:000342053600026,
Author = {Knobloch-Westerwick, Silvia},
Editor = {Reinemann, C},
Title = {Selection, perception, and processing of political messages},
Booktitle = {POLITICAL COMMUNICATION},
Series = {Handbooks of Communication Science},
Year = {2014},
Volume = {18},
Pages = {507-526},
Abstract = {This chapter reviews literature on selective exposure in political
   communication. It first points to the importance of selectivity given an
   unprecedented amount and diversity of media sources. The chapter then
   focuses on the antecedents, psychological processes (e.g., confirmation
   bias), and outcomes of selective exposure to media content. The
   relevance of media credibility and hostile media perceptions, of
   tendencies to self-confirm, and of informational utility for selective
   exposure are discussed. The chapter then reflects on the consequences of
   selective exposure for the accessibility of attitudes and partisanship.
   The author concludes that selective exposure is in fact governed by
   attitude importance and a confirmation bias, even though informational
   utility may override this tendency under certain circumstances.},
