@article{ WOS:001501196400001,
Author = {Bashirov, Galib and Akbarzadeh, Shahram and Yilmaz, Ihsan and Ahmed,
   Zahid Shahab},
Title = {Diffusion of digital authoritarian practices in China's neighbourhood:
   the cases of Iran and Pakistan},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {2},
Pages = {247-270},
Month = {FEB 17},
Abstract = {This article examines mechanisms for the diffusion of digital
   authoritarian practices, focusing on China and two of its regional
   partners in South and West Asia: Iran and Pakistan. We investigate types
   of digital authoritarian practices, such as legal frameworks, online
   censorship, and urban surveillance, and how these practices have been
   adopted. An analytical framework is developed to identify three
   mechanisms of diffusion: learning, emulation, and cooperative
   interdependence. Our findings indicate that internally and externally
   driven learning is the most significant mechanism for the spread of
   digital authoritarian practices in Iran and Pakistan. Both governments
   adapted their strategies from their experiences with protest movements
   in the early 2010s, while China's promotion of digital authoritarianism
   facilitated this learning process. Emulation, driven by cultural and
   political alignment and China's role as an authoritarian model, has
   significantly influenced the adoption of legal norms to restrict the
   internet. Cooperative interdependence, through trade relationships and
   loan agreements under China's Belt and Road Initiative (BRI), has
   enabled the transfer of censorship and surveillance technologies to
   neighbouring countries.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
