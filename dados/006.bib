@article{ WOS:001444444100001,
Author = {Altenburger, Sven},
Title = {Reconsidering Military and Civil Conscription},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {2},
Pages = {464-478},
Month = {APR 1},
Abstract = {Contemporary scholars, including political scientists and political
   philosophers, tend to hold a highly critical view of military and civil
   conscription. However, these institutions are clearly back on the
   European political agenda. In light of this gap between academic
   political thought and political practice, this article reconsiders the
   arguments against and in favor of military and civil conscription. By
   drawing on a wide range of normative, military, social, civic,
   political, and fiscal-economic considerations, a comprehensive and
   nuanced examination of various lines of reasoning is provided that
   bridges more specialized discussions. The analysis yields the conclusion
   that the prevailing critical view of military and civil conscription
   within scholarship is too one-sided and that, overall, there remains
   much to be said in favor of these institutions.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
