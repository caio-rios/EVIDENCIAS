   smonroe@yale-nus.edu.sg},
Affiliations = {Harvard University; National University of Singapore},
ORCID-Numbers = {Monroe, Steve/0000-0001-7206-3041},
Funding-Acknowledgement = {Yale-NUS College},
Funding-Text = {We are deeply grateful to the editors Ana Arjona and Wendy Pearlman and
   the four anonymous reviewers for their guidance, patience, and support.
   We also thank Faisal Ahmed, Basil Bastaki, John Gerring, Marlene Jugl,
   Matt Khoo, Soo Yeon Kim, Bob Kubinec, Martin Mattson, Nimah Mazaheri,
