@article{ WOS:001597104700001,
Author = {Gianola, Giada},
Title = {Bring the Public In: Assessing Non-Participants' Legitimacy Perceptions
   of a Digital Democratic Innovation in a Swiss Experiment},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {4},
Pages = {622-643},
Month = {DEC},
Abstract = {Democratic innovations, i.e., participatory processes where citizens
   deliberate and produce various outputs, typically involve few
   participants. Since the produced outputs impact the entire population,
   the small number of participants raises legitimacy concerns. This study
   examines whether providing non-involved citizens with additional
   information about the participatory process enhances the legitimacy of
   democratic innovations. Using a framed field experiment with a digital
   democratic innovation (DDI), it explores how citizens who did not
   participate but watched an explanatory video about the DDI process
   perceived the DDI's legitimacy compared to a control group that did not
   watch the video. The findings reveal that additional information on the
   process influenced perceptions of process legitimacy positively but
   affected perceptions of output legitimacy negatively. The study thus
   contributes to the discussion on democratic innovations by highlighting
   the complex nature of legitimacy perception in digital democratic
   contexts.
   Demokratische Innovationen, d. h. partizipatorische Prozesse, in denen
   deliberiert und verschiedene Outputs produziert werden, umfassen in der
   Regel nur wenige Teilnehmende. Da die produzierten Outputs Auswirkungen
   auf die gesamte Bev \& ouml;lkerung haben, wirft die geringe Zahl der
   Teilnehmenden Bedenken bez \& uuml;glich der Legitimit \& auml;t
   demokratischer Innovationen auf. In dieser Studie wird untersucht, ob
   die Bereitstellung zus \& auml;tzlicher Informationen \& uuml;ber den
   Partizipationsprozess f \& uuml;r nicht involvierte Personen die
   Legitimit \& auml;t demokratischer Innovationen erh \& ouml;ht. Anhand
   eines Feldexperiments mit einer digitalen demokratischen Innovation
   (DDI) wird untersucht, wie Personen, die nicht teilgenommen, aber ein
   Erkl \& auml;rungsvideo \& uuml;ber den DDI-Prozess gesehen haben, die
   Legitimit \& auml;t der DDI im Vergleich zu einer Kontrollgruppe, die
   das Video nicht gesehen hat, wahrnehmen. Die Ergebnisse zeigen, dass zus
   \& auml;tzliche Informationen \& uuml;ber den Prozess die Wahrnehmung
   der Prozesslegitimit \& auml;t positiv, die Wahrnehmung der
   Output-Legitimit \& auml;t jedoch negativ beeinflussten. Die Studie tr
   \& auml;gt zur Diskussion \& uuml;ber demokratische Innovationen bei,
   indem sie die komplexe Natur der Legitimit \& auml;tswahrnehmung in
   digitalen demokratischen Kontexten hervorhebt.
   Les innovations d \& eacute;mocratiques, \& agrave; savoir, des
   processus participatifs o \& ugrave; les participant.e.s d \& eacute;lib
   \& egrave;rent et produisent divers outputs, impliquent un nombre
   restreint de personnes. Or, leur faible nombre soul \& egrave;ve des
   questions de l \& eacute;gitimit \& eacute;, car les outputs g \&
   eacute;n \& eacute;r \& eacute;s impactent l'ensemble de la population.
   Cette \& eacute;tude examine si fournir des informations suppl \&
   eacute;mentaires sur le processus participatif \& agrave; des personnes
   non impliqu \& eacute;es renforce la l \& eacute;gitimit \& eacute; des
   innovations d \& eacute;mocratiques. \& Agrave; l'aide d'une m \&
   eacute;thode exp \& eacute;rimentale sur une innovation d \&
   eacute;mocratique num \& eacute;rique (IDN), elle analyse comment celles
   et ceux expos \& eacute;.e.s \& agrave; une vid \& eacute;o explicative
   sur l'IDN per \& ccedil;oivent sa l \& eacute;gitimit \& eacute; par
   rapport \& agrave; un groupe de contr \& ocirc;le n'ayant pas regard \&
   eacute; la vid \& eacute;o. Les r \& eacute;sultats montrent que ces
   informations renforcent la l \& eacute;gitimit \& eacute; per \&
   ccedil;ue du processus, mais affaiblissent celle de l'output. L'\&
   eacute;tude contribue au d \& eacute;bat sur les innovations d \&
   eacute;mocratiques en soulignant la complexit \& eacute; de la
   perception de la l \& eacute;gitimit \& eacute; dans les contextes num
   \& eacute;riques.
   Le innovazioni democratiche, ossia i processi partecipativi in cui si
   delibera e si producono vari output, coinvolgono generalmente poche
   persone. Poich \& eacute; gli output generati hanno un impatto
   sull'intera popolazione, il numero ridotto di partecipanti solleva
   questioni di legittimit \& agrave;. Questo studio esamina se fornire
   informazioni aggiuntive sul processo partecipativo a chi non \& egrave;
   coinvolto aumenti la legittimit \& agrave; delle innovazioni
   democratiche. Attraverso un esperimento con un'innovazione democratica
   digitale (IDD), si analizza come coloro che non hanno partecipato, ma
   hanno visto un video esplicativo sul processo IDD, abbiano percepito la
   legittimit \& agrave; della IDD rispetto a un gruppo di controllo che
   non ha visto il video. I risultati rivelano che le informazioni
   aggiuntive sul processo hanno influenzato positivamente la percezione
   della legittimit \& agrave; del processo, ma hanno influito
   negativamente sulla percezione della legittimit \& agrave; dell'output.
   Lo studio contribuisce al dibattito sulle innovazioni democratiche
   evidenziando la natura complessa della percezione della legittimit \&
   agrave; nei contesti di democrazia digitale.},
Publisher = {WILEY},
