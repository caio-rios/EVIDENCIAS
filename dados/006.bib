   Hartland, Alex; Braun, Daniela; Carteny, Giuseppe; Navarrete, Rosa M., Saarland Univ, Dept European Social Res, Saarbrucken, Germany.
   Reinl, Ann-Kathrin, Leibniz Inst Social Sci, GESIS, Mannheim, Germany.},
DOI = {10.1080/01402382.2025.2498838},
