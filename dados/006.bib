@article{ WOS:001514150400001,
Author = {Patrin, Maria},
Title = {Democratic standards in external differentiation: the area of freedom,
   security and justice},
Journal = {WEST EUROPEAN POLITICS},
Year = {2025},
Volume = {48},
Number = {5, SI},
Pages = {1002-1028},
Month = {JUL 29},
Abstract = {The article investigates standards of democracy and accountability in
   external differentiated integration. It focuses on the area of freedom
   security and justice as a highly differentiated EU policy domain that
   combines patterns of internal and external differentiation. Two case
   studies in the field of Schengen and police cooperation illustrate how
   differentiated policies can affect participating third countries in
   democratic terms. The analysis shows that although countries associated
   to EU policies maintain their full sovereignty and jurisdiction, the
   pressure to comply is high and the threat of exclusion can lead to
   incongruence in both participation in decision making and
   accountability. Furthermore, the overlap between internal and external
   differentiation results in a frayed participation landscape that
   obfuscates accountability processes and can create legal uncertainty.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
