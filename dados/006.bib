EISSN = {1873-5096},
Keywords = {Self-determination; Relationality; Intersectionality; Decoloniality;
   State; Indigenous peoples},
Keywords-Plus = {INDIGENOUS PEOPLES; CONSERVATION; ONTOLOGY; VIOLENCE},
Research-Areas = {Geography; Government \& Law},
Web-of-Science-Categories  = {Geography; Political Science},
