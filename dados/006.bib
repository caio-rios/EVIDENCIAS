@article{ WOS:001462095500001,
Author = {Reveilhac, Maud and Morselli, Davide},
Title = {ChatGPT as a voting application in direct democracy},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {3, SI},
Pages = {511-532},
Month = {SEP},
Abstract = {The study examines the potential role of ChatGPT as a tool for popular
   voting. It assesses ChatGPT's positions on four voting objects (three
   initiatives and one referendum) by simulating various Swiss voter
   profiles (neutral, centrist, left, right, progressist, and conservative)
   and comparing these to its default stance. Additionally, ChatGPT's
   responses to arguments for and against each object were analyzed for
   consistency with its voting patterns. The study compared ChatGPT's
   decisions to real voting outcomes, fixing the temperature and collecting
   100 answers per question to ensure reliability. Results showed that
   voting decisions varied by model version (GPT-3.5 or GPT-4) and language
   (French or German), indicating cultural and model iteration influences.
   ChatGPT's decisions did not consistently align with a left-progressist
   stance, highlighting the impact of language, model versions, and
   contextual factors on political interpretations.
   Die Studie untersucht die potenzielle Rolle von ChatGPT als Instrument
   bei Volksabstimmungen. Sie bewertet die Positionen von ChatGPT zu vier
   Abstimmungsgegenst \& auml;nden (drei Initiativen und einem Referendum),
   indem verschiedene Schweizer W \& auml;hlerprofile (neutral, Mitte,
   links, rechts, progressiv und konservativ) simuliert und mit der
   Standardhaltung von ChatGPT verglichen werden. Zudem wurden die
   Antworten von ChatGPT auf Argumente f \& uuml;r und gegen jedes
   Abstimmungsobjekt auf ihre \& Uuml;bereinstimmung mit den
   Abstimmungsmustern analysiert. Die Entscheidungen von ChatGPT wurden mit
   den tats \& auml;chlichen Abstimmungsergebnissen verglichen, wobei eine
   feste Temperatur verwendet und 100 Antworten pro Frage gesammelt wurden.
   Die Ergebnisse zeigen, dass die Abstimmungsentscheidungen je nach
   Modellversion (GPT-3.5 oder GPT-4) und Sprache (Franz \& ouml;sisch oder
   Deutsch) variierten, was auf kulturelle und modellbedingte Einfl \&
   uuml;sse hinweist. Die Entscheidungen von ChatGPT stimmten nicht
   durchgehend mit einer links-progressiven Haltung \& uuml;berein, was
   darauf hindeutet, dass Sprache, Modellversionen und Kontextfaktoren sich
   auf politische Interpretationen auswirken.
   L'\& eacute;tude explore le r \& ocirc;le potentiel de ChatGPT dans le
   cadre des votations populaires. Elle examine les positions de ChatGPT
   sur quatre objets de vote (trois initiatives et un r \& eacute;f \&
   eacute;rendum) en simulant divers profils d'\& eacute;lecteurs suisses
   (neutre, centriste, de gauche, de droite, progressiste et conservateur)
   et en les comparant \& agrave; sa position par d \& eacute;faut. Les r
   \& eacute;ponses de ChatGPT aux arguments pour et contre chaque objet
   ont \& eacute;t \& eacute; analys \& eacute;es afin d'\& eacute;valuer
   leur coh \& eacute;rence avec les sch \& eacute;mas de vote. L'\&
   eacute;tude a \& eacute;galement compar \& eacute; les d \&
   eacute;cisions de ChatGPT aux r \& eacute;sultats r \& eacute;els des
   votes, en fixant la temp \& eacute;rature et en collectant 100 r \&
   eacute;ponses par question pour assurer une fiabilit \& eacute;
   optimale. Les r \& eacute;sultats ont r \& eacute;v \& eacute;l \&
   eacute; que les d \& eacute;cisions de vote variaient en fonction de la
   version du mod \& egrave;le (GPT-3.5 ou GPT-4) et de la langue utilis \&
   eacute;e (fran \& ccedil;ais ou allemand), mettant en \& eacute;vidence
   des influences culturelles et des diff \& eacute;rences li \& eacute;es
   aux it \& eacute;rations du mod \& egrave;le. Les d \& eacute;cisions de
   ChatGPT ne correspondaient pas syst \& eacute;matiquement \& agrave; une
   position gauche-progressiste, soulignant l'impact de la langue, des
   versions du mod \& egrave;le et des facteurs contextuels sur les interpr
   \& eacute;tations politiques.
   Lo studio analizza il ruolo potenziale di ChatGPT come strumento per le
   votazioni popolari, esaminando le posizioni di ChatGPT su quattro
   oggetti di voto (tre iniziative e un referendum) tramite la simulazione
   di diversi profili di elettori svizzeri (neutro, centrista, di sinistra,
   di destra, progressista e conservatore) e confrontandoli con la
   posizione predefinita del modello. Vengono analizzate, inoltre, le
   risposte di ChatGPT agli argomenti a favore e contro ciascun oggetto per
   verificarne la coerenza con i suoi schemi di voto. Infine, sono state
   confrontate le decisioni di ChatGPT con i risultati reali delle
   votazioni, fissando una temperatura costante e raccogliendo 100 risposte
   per domanda al fine di garantirne l'affidabilit \& agrave;. I risultati
   evidenziano che le decisioni di voto variano in base alla versione del
   modello (GPT-3.5 o GPT-4) e alla lingua utilizzata (francese o tedesco),
   indicando influenze culturali e legate all'evoluzione del modello. Le
   decisioni di ChatGPT non risultano sistematicamente allineate a una
   posizione progressista di sinistra, sottolineando l'impatto della
   lingua, delle version del modello e dei fattori contestuali sulle
   interpretazioni politiche.},
