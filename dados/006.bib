@article{ WOS:001462154100001,
Author = {Zulianello, Mattia},
Title = {Populist radical right vs populist radical right in power: signalling
   ideological commitment or competence?},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2025},
Volume = {30},
Number = {1, SI},
Pages = {107-132},
Month = {JAN 2},
Abstract = {This article investigates the communication strategies of the populist
   radical right (PRR) focusing on the co-existence of different actors of
   this party family in power. Methodologically, it carries out a content
   analysis of the social media posts published by Brothers of Italy (FdI)
   and the League, and their leaders Giorgia Meloni and Matteo Salvini,
   before and after the 2022 general elections. The findings suggest a
