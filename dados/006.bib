@article{ WOS:001445234600001,
Author = {Schindler, Danny},
Title = {Recall rules as a legalistic autocrat's toolkit. The case of Zimbabwe},
Journal = {DEMOCRATIZATION},
Year = {2025},
Volume = {32},
Number = {6},
Pages = {1496-1517},
Month = {AUG 18},
Abstract = {While research on autocratic legalism has shown that incumbents deploy
   various legal instruments to ensure their survival, the use of recall
   rules to subdue opposition forces has received little attention.
   Moreover, recalls within parties and against MPs are largely
   understudied as the burgeoning recall literature mainly focusses on the
   removal of executive actors. Connecting both strands of literature and
   following the call to capture the variety of recall practices in diverse
   settings, the article analyses the dubious recalls in Zimbabwe after the
   2023 general election. Conceptually, we argue for extending recall
   typologies to include party-based rules and for investigating the
   variance in the ``democraticness{''} of pertinent practices.
   Empirically, we provide an in-depth study on the purposes, scope
   conditions and mechanisms of what we call sham recalls. Highlighting how
   recalls can be weaponized to limit space for opposition, the Zimbabwean
   case also shows that legalistic autocrats benefit from vague rules of
   the game. The study thus offers insights into how incumbents weaken
   multi-party legislatures through post-electoral strategies which help to
   preserve a rule of law fa \& ccedil;ade.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
