@article{ WOS:001488036900001,
Author = {Osei, Anja and Wali, Christian Wali and Akinocho, Herve},
Title = {Personalization, elite cohesion, and regime stability: differing
   outcomes in Cameroon and Gabon},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {5, SI},
Pages = {1107-1132},
Month = {JUL 4},
Abstract = {African politics has often been analyzed as highly personalized. It has
   remains difficult, however, to measure the extent to which power is
   actually personalized and centralized in different countries. With the
   availability of new and better data, it now becomes possible to study
   different models of executive personalization and elite cohesion. This
   article compares Cameroon and Gabon, two countries that share a number
   of similarities: both are situated in Central Africa and have highly
   centralized and personalized presidential systems. For decades,
   incumbents in both countries held on to power, until a military coup in
   Gabon finally unseated Ali Bongo. This outcome can be explained by
   looking at intra-elite relations and appointment politics. Using data on
   elite networks, it will be argued that the extreme interconnectedness of
   Gabonese elites actually placed a constraint on Bongo, who was finally
   sidelined by competing elites and the military. Biya in Cameroon, by
   contrast, has created different channels of elite appointments that
   separate ambitious elites from each other and thereby enhance his sole
   position of power. The two cases demonstrate the need for data-driven
   approaches to understand the relations between personalist rulers and
   their allies.},
