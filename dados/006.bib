@article{ WOS:001492885200001,
Author = {Kroken, Vibeke and Murdoch, Zuzana and Geys, Benny},
Title = {Time tactics in public administration: evidence from a survey experiment},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {5},
Pages = {1279-1306},
Month = {JUL 29},
Abstract = {The speed of administrative decision making is an enduring point of both
   public and academic debate. This article offers novel evidence about
   when public administrations exploit specific institutional rules to slow
   down or speed up the policy-making process. The use of such bureaucratic
   `time tactics' is argued to be depending on: (i) proximity to elections,
   and (ii) positive/negative expert assessments of policy proposals. A
   pre-registered between-subjects survey experiment fielded among national
   public administrators in Norway (N = 1,670) reveals that proximity to
   elections makes bureaucrats less - not more - inclined to slow down the
   policy-making process. Furthermore, bureaucrats are less likely to
   fast-track policies with negative expert assessments, but are not more
   likely to fast-track policies with positive expert assessments (relative
   to a control group). These findings offer important new insights into
   the nature of bureaucratic politics.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Murdoch, Z (Corresponding Author), Univ Bergen, Dept Govt, Bergen, Norway.
   Kroken, Vibeke; Murdoch, Zuzana, Univ Bergen, Dept Govt, Bergen, Norway.
   Geys, Benny, BI Norwegian Business Sch, Dept Econ, Bergen, Norway.},
DOI = {10.1080/01402382.2025.2499996},
EarlyAccessDate = {APR 2025},
ISSN = {0140-2382},
EISSN = {1743-9655},
Keywords = {Bureaucratic politics; time tactics; prevention focus; survey experiment},
Keywords-Plus = {SOCIAL DESIRABILITY BIAS; CIVIL-SERVANTS; REGULATORY DELAY; PERFORMANCE;
   LEGITIMACY; DEMOCRACY; AVERSION; CYCLES; SPEED; PACE},
