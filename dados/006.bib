@article{ WOS:001429769800001,
Author = {Hasanaj, Valon and Stadelmann-Steffen, Isabelle},
Title = {Gendered leadership and political structures: A global analysis of
   crisis responses across 150 countries},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {47},
Number = {1},
Pages = {75-96},
Month = {JAN},
Abstract = {This study explores the role of leaders' gender and its interaction with
   political structures in shaping countries' responses to the recent
   pandemic crisis, analysing data from over 150 countries. We investigate
   how leadership - during the early, peak and later stages of the crisis -
   impacted national strategies across various dimensions, including
   politics, health and the economy. A key focus is on whether female
   leaders differed from male leaders in their crisis responses and how the
   presence of women in parliament and the level of democratic freedoms
   might alter these dynamics. Our initial findings indicate that female
   leaders tended to implement more rigorous measures at the beginning of
   the crisis across all examined dimensions. However, the difference in
   responses between genders diminished over time, underscoring the
   evolving nature of leadership influence. Additionally, our research
   shows that the effects of a leader's gender on policy responses are
   significantly shaped by the country's political environment,
   particularly the extent of democratic freedoms and female representation
   in parliament.},
