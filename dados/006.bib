@article{ WOS:001466621300001,
Author = {Matthews, Austin S.},
Title = {Was ``The Revo{''} a coup d'etat? An assessment of the 1979 regime
   change in Grenada},
Journal = {DEMOCRATIZATION},
Year = {2025},
Volume = {32},
Number = {8},
Pages = {2071-2090},
Month = {NOV 17},
Abstract = {How should we classify the 1979 regime change that established a radical
   communist government on the Caribbean island of Grenada? Since the
   1980s, scholars and commentators have debated whether Maurice Bishop's
   party dictatorship came to power via a coup d'etat or a popular
   revolution. This distinction is crucial for understanding the regime's
   development and durability. To resolve this debate, I apply qualified
   definitions of social revolution and coup d'etat to a detailed case
   study of the Grenadian regime change on 13 March 1979. This analysis
   draws upon original interviews with participants conducted in 2024,
   archival records, and secondary sources from both Grenada and abroad.
   The evidence suggests that the 1979 transition is best understood as a
   social revolution, challenging the validity of the enduring coup
   designation advanced by some analysts and public figures. These findings
   contribute to scholarship in comparative politics and Cold War history,
   along with being relevant to broader public discourse in the region.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
