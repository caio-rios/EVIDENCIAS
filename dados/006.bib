@article{ WOS:001489707900001,
Author = {Koesel, Karrie J. and Sarkissian, Ani},
Title = {Religion and the authoritarian toolkit: are carrots substitutes for
   sticks?},
Journal = {DEMOCRATIZATION},
Year = {2025},
Volume = {32},
Number = {8},
Pages = {2113-2136},
Month = {NOV 17},
Abstract = {This study investigates how the authoritarian toolkit is used against a
   lesser-studied type of opposition: religious groups. We explore how
   authoritarian rulers balance instruments of repression and co-optation,
   and test whether strategies designed to co-opt religious life reduce the
   regime's use of repression. Capitalizing on detailed data on state
   policies toward religious groups from 185 countries over 24 years, we
   compare how four co-optive tools - patronage, policy concessions,
   political parties, and bureaucracies - are used to buy off and
   encapsulate religious groups, facilitate compliance, gather information,
   and signal regime authority. We find that different tools of co-optation
   have multi-directional effects on regime repression. When dictators use
   patronage and policy concessions to co-opt religious communities, they
   continue to use sticks, whereas religious political parties and
   state-led religious bureaucracies reduce regime repression. These
   findings challenge the conventional wisdom that co-optation is a
   substitute for repression and advance our understanding of how dictators
   balance different instruments of control against groups who have the
   potential to be both supportive and subversive.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
