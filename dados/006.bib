@article{ WOS:001448650800001,
Author = {Awad, Emiel and Minaudier, Clement},
Title = {Persuasive lobbying and the value of connections},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Volume = {70},
Number = {2},
Pages = {539-554},
Month = {APR},
Abstract = {The inflow of money into politics and the influence of interest groups
   on policies are well-documented, but the monetary value of accessing
   policymakers is less well-understood. As a result, it is unclear what
   inferences researchers can draw from lobbying expenditures about
   interest groups' strategies and their ideological alignment with
   policymakers. We study a model of informational lobbying with a
   collective decision-making body and endogenous reforms to investigate
   the determinants of the value of access. We show that the funds flowing
   to a given policymaker depend not only on this policymaker's ideology
   and procedural power but also on the overall distribution of preferences
   and power among other policymakers. Two policymakers with the same
   ideology and procedural power might therefore attract different amounts
   of contributions, depending on the preferences of fellow policymakers.
   Our results help clarify empirical research linking lobbying
   expenditures by interest groups to politicians' ideologies and power.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Minaudier, C (Corresponding Author), City St Georges Univ London, Dept Econ, London EC1V 0HB, England.
   Awad, Emiel, Oxera Consulting LLP, Amsterdam, Netherlands.
   Minaudier, Clement, City St Georges Univ London, Dept Econ, London EC1V 0HB, England.},
DOI = {10.1111/ajps.12965},
EarlyAccessDate = {MAR 2025},
ISSN = {0092-5853},
EISSN = {1540-5907},
Keywords-Plus = {CAMPAIGN CONTRIBUTIONS; EUROPEAN PARLIAMENT; TESTING THEORIES; ACCESS;
   INFORMATION; INTERESTS; COMMITTEE; STRATEGIES; SUBSIDIES; IDEOLOGY},
