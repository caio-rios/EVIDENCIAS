@article{ WOS:001439134200001,
Author = {Tanaka, Satoshi},
Title = {The political economy of power-sharing: patronage politics and ethnic
   party dominance in post-Dayton Bosnia},
Journal = {DEMOCRATIZATION},
Year = {2025},
Volume = {32},
Number = {6},
Pages = {1450-1473},
Month = {AUG 18},
Abstract = {Why do ethnic parties stay dominant in post-war Bosnian politics? This
   article addresses this question by examining the institutional effects
   of power-sharing introduced by the Dayton Peace Agreement. Based on the
   theories of patronage politics, this article presents a theoretical
   framework to capture the political economy effects of power-sharing in
   favouring ethnic parties to monopolize the public sector employment for
   their patronage in post-war democracy. I argue that power-sharing
   functions to create employment opportunities in the public sector along
   ethnic lines and allows ethnic parties to seize control over them,
   thereby consolidating ethnic party dominance in post-war politics.
   Applying the theoretical framework to the Bosnian case, I conduct two
   empirical analyses to address the question. First, combining qualitative
   and quantitative evidence, I present how the distribution of patronage
   underpins the rule of ethnic parties in post-war Bosnian politics.
   Second, using information drawn from several archival data, including
   local newspapers, I examine how power-sharing entrenches the
   patronage-based rule of ethnic parties by providing them with
   preferential access to state resources. The analyses present new
   theoretical and empirical insights into the effectiveness of
   power-sharing for conflict resolution from the political-economy
   perspective.},
