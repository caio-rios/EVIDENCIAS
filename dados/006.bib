@article{ WOS:001444514300001,
Author = {Bicakova, Alena and Jurajda, Stepan},
Title = {Political Preferences Through Stages of the COVID-19 Pandemic},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2025},
Volume = {78},
Number = {3},
Pages = {860-874},
Month = {SEP},
Abstract = {How durable are the political accountability effects of the worst
   pandemic in a century? We track the effects of the COVID-19 pandemic on
   political preferences through its ``high{''} and ``low{''} phases in the
   Czech Republic. Uniquely, we ask about the effects of both the health
   and the economic costs of the pandemic measured at both personal and
   municipality levels. Consistent with the literature, we estimate effects
   suggestive of political accountability of leaders during ``high{''}
   pandemic phases without higher support for non-democratic alternatives.
   However, we also find that the pandemic political accountability effects
   are mostly short-lived, and do not extend to the first post-pandemic
   elections.},
