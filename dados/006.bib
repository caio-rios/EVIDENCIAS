@article{ WOS:001448482300001,
Author = {Cella, Lautaro and Cinar, Ipek and Stokes, Susan and Uribe, Andres},
Title = {Building Tolerance for Backsliding by Trash-Talking Democracy: Theory
   and Evidence From Mexico},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2026},
Volume = {59},
Number = {6},
Pages = {1226-1253},
Month = {MAY},
Abstract = {Leaders who seek to build public toleration for democratic backsliding
   have a little-noticed strategy at their disposal: degrading their
   democracies in the eyes of their citizens. If voters can be induced to
   believe that their democracy is already broken, then nothing of value is
   lost when leaders attack the courts, vilify the press, or undermine
   confidence in elections. We call this strategy trash-talking democracy,
   and study it in the context of contemporary Mexico. We use text-as-data
   methods to show that President Andr \& eacute;s Manuel L \& oacute;pez
   Obrador spent more time trash-talking his democracy than he did
   deepening partisan polarization. With a survey experiment we show that
   exposure to L \& oacute;pez Obrador's trash-talking of the courts
   elicits anti-democratic attitudes among Mexicans - both among his
   supporters and among supporters of the opposition. Strategies to resist
   backsliding should include not just efforts at de-polarization but also
   at restoring confidence in democratic institutions.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Uribe, A (Corresponding Author), Univ Wisconsin Madison, 110 North Hall, Madison, WI 53706 USA.
   Cella, Lautaro; Cinar, Ipek; Stokes, Susan, Univ Chicago, Chicago, IL USA.
   Uribe, Andres, Univ Wisconsin Madison, 110 North Hall, Madison, WI 53706 USA.},
DOI = {10.1177/00104140251328024},
EarlyAccessDate = {MAR 2025},
ISSN = {0010-4140},
EISSN = {1552-3829},
Keywords = {democratization and regime change; Latin American politics; quality of
