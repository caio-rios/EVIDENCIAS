ORCID-Numbers = {Constantinou, Costas M/0000-0002-0049-9249
   Loong, Shona/0009-0002-3466-8431
   Regassa, Asebe/0000-0002-9126-9253
   Kuokkanen, Rauna/0000-0002-6720-5962},
Funding-Acknowledgement = {Department of Social and Political Sciences, University of Cyprus; Fiona
   McConnell's Philip Leverhulme Prize for Geography},
Funding-Text = {This intervention is based on two workshops on the theme of `Reimagining
   Self-Determination' organized at the University of Oxford, 23-24 March
   2023, and at the University of Cyprus, 19-20 June 2023. We thank the
   participants in these lively workshops for sharing their experiences and
