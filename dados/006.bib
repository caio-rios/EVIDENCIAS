@article{ WOS:001422694300001,
Author = {Axelsen, David V.},
Title = {Members Only? Why Associational Autonomy Cannot Justify Closing State
   Borders},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {2},
Pages = {634-648},
Month = {APR 1},
Abstract = {It is usually assumed that states have a right to exclude immigrants.
   Defenders of the Associational View argue that states are justified in
   closing their borders to immigrants because having the right to exclude
   is necessary for members to be able to control the character of their
   association. It is necessary to protect associational autonomy. Unlike
   in a domestic setting, however, individuals lack several other key
   components of associational autonomy internationally. On this
   background, therefore, it is not clear that the right to exclude better
   protects associational autonomy than its absence. I explore three
   potential solutions to this problem, drawn from contemporary versions of
   the Associational View. The three solutions fall short since,
   ultimately, they do not provide sound justifications for the unilateral
   right to exclude migrants. Building on this discussion, I set out some
   institutional elements that should be present in a well-conceived
   instantiation of associational autonomy.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
