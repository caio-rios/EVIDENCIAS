@article{ WOS:001479860200001,
Author = {Emmenegger, Patrick and Leemann, Lucas and Thoma, Andreina and Walter,
   Andre},
Title = {Municipality-Level Outcomes of Direct-Democratic Votes in Switzerland,
   1866-2023},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {4},
Pages = {753-770},
Month = {DEC},
Abstract = {Switzerland relies heavily on direct-democratic institutions to decide
   on a wide range of political issues. Since 1848, more than 600
   direct-democratic votes have taken place at the national level. However,
   the lack of comprehensive data has limited the systematic use of these
   votes for research. This paper introduces a new dataset containing
   municipality-level outcomes for all direct-democratic votes from 1866 to
   1944, and supplements post-1945 data to fill gaps in previous
   collections. Spanning over 150 years, the new dataset contains more than
   1.3 million observations. Several empirical illustrations demonstrate
   the dataset's potential for research.
   La Suisse s'appuie fortement sur des institutions de d \&
   eacute;mocratie directe pour d \& eacute;cider d'un large \&
   eacute;ventail de questions politiques. Depuis 1848, plus de 600 votes
   de d \& eacute;mocratie directe ont eu lieu au niveau national.
   Cependant, le manque de donn \& eacute;es compl \& egrave;tes a limit \&
   eacute; l'utilisation syst \& eacute;matique de ces votes pour la
   recherche. Cet article pr \& eacute;sente un nouvel ensemble de donn \&
   eacute;es contenant les r \& eacute;sultats au niveau municipal de tous
   les votes de d \& eacute;mocratie directe de 1866 \& agrave; 1944, et
   compl \& egrave;te les donn \& eacute;es post \& eacute;rieures \&
   agrave; 1945 afin de combler les lacunes des collections pr \& eacute;c
   \& eacute;dentes. Couvrant plus de 150 ans, le nouvel ensemble de donn
   \& eacute;es contient plus de 1,3 million d'observations. Plusieurs
   illustrations empiriques d \& eacute;montrent le potentiel de l'ensemble
   de donn \& eacute;es pour la recherche.
   Die Schweiz st \& uuml;tzt sich stark auf direktdemokratische
   Institutionen, um \& uuml;ber eine Vielzahl von politischen Fragen zu
   entscheiden. Seit 1848 haben mehr als 600 direktdemokratische
   Abstimmungen auf nationaler Ebene stattgefunden. Der Mangel an
   umfassenden Daten hat jedoch die systematische Nutzung dieser
   Abstimmungen f \& uuml;r die Forschung eingeschr \& auml;nkt. In diesem
   Beitrag wird ein neuer Datensatz vorgestellt, der die Ergebnisse aller
   direktdemokratischen Abstimmungen auf Gemeindeebene von 1866 bis 1944
   enth \& auml;lt und die Daten ab 1945 erg \& auml;nzt, um L \& uuml;cken
   in fr \& uuml;heren Sammlungen zu schliessen. Der neue Datensatz, der
   sich \& uuml;ber 150 Jahre erstreckt, enth \& auml;lt mehr als 1,3
   Millionen Beobachtungen. Mehrere empirische Illustrationen zeigen das
   Potenzial des Datensatzes f \& uuml;r die Forschung.
   La Svizzera si affida alle istituzioni democratiche dirette per decidere
   su svariate questioni politiche. Dal 1848, si sono svolti pi \& ugrave;
   di 600 votazioni democratiche dirette a livello nazionale. Tuttavia, la
   mancanza di dati completi ha limitato l'utilizzo sistematico di queste
   votazioni per la ricerca. Questo articolo introduce un nuovo dataset
   contenente i risultati a livello comunale di tutte le votazioni
   democratiche dirette dal 1866 al 1944 e integra i dati successivi al
   1945 per colmare le lacune delle raccolte dati precedenti. Il nuovo
   dataset, che copre oltre 150 anni, contiene pi \& ugrave; di 1,3 milioni
   di osservazioni. Diverse illustrazioni empiriche dimostrano il
   potenziale del dataset per la ricerca.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Emmenegger, P (Corresponding Author), Univ St Gallen, Sch Econ \& Polit Sci, Muller Friedberg Str 8, CH-9000 St Gallen, Switzerland.
   Emmenegger, Patrick, Univ St Gallen, Polit Sci, St Gallen, Switzerland.
   Leemann, Lucas; Walter, Andre, Univ Zurich, Polit Sci, Zurich, Switzerland.
   Walter, Andre, Univ Zurich, Zurich, Switzerland.
   Thoma, Andreina, Univ Luxembourg, Inst Polit Sci, Esch Sur Alzette, Luxembourg.},
DOI = {10.1111/spsr.12658},
