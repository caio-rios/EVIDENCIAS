@article{ WOS:001693022200001,
Author = {Hernandez, Natalie and Lockhart, Mackenzie and Gerber, Alan S. and
   Huber, Gregory A.},
Title = {Abortion policy preferences are structured, stable, and consequential},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Month = {2026 FEB 18},
Abstract = {Do Americans have structured, stable, and consequential policy
   preferences that shape political outcomes? We explore this question
   through the case of abortion, using a large-scale panel dataset (n
   approximate to 130,000) and applying three key diagnostics: coherence,
   stability, and changes in vote choice. First, we demonstrate that
   abortion policy preferences exhibit logical coherence, both within and
   across reasons for seeking an abortion. Second, we show that these
   preferences are highly stable over time-more so than personality
   traits-suggesting that abortion attitudes are deeply engrained rather
   than fleeting opinions. Lastly, we find that abortion policy
   preferences, measured before the U.S. Supreme Court overturned Roe v.
   Wade in 2022, predict shifts in intended voting behavior between 2020
   and 2024. This overall pattern helps rule out key theoretical
   alternatives, such as non-opinions, attitudes following vote choice, and
   elite cues. Additionally, these findings highlight the significant and
   independent role of abortion attitudes in shaping American political
   behavior.},
