@article{ WOS:001694719000001,
Author = {Hruska, Jan and Hanley, Sean},
Title = {Are the upper chambers a source of democratic resilience? Evidence from
   elite perceptions in the Czech Republic},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 FEB 18},
Abstract = {In recent years, several Central and Eastern European countries,
   including Poland, Hungary, and Slovakia, have experienced significant
   democratic backsliding. The Czech Republic was also perceived as a
   possible case of democratic backsliding after populist billionaire
   Andrej Babi \& scaron; became Prime Minister in 2017, running on a
   platform including proposals to transform the constitutional system.
   However, no major ``reforms{''} took place, and little democratic
   backsliding occurred. This article examines Czech democratic resilience,
   focusing on the under-researched issue of institutional resilience
   through a study of the upper chamber of Parliament (the Senate).
   Although they can empower anti-democratic holdovers, the upper chambers'
   primary role is often to guard the stability of democratic
   constitutional systems. Drawing on semi-structured interviews with Czech
   senators, the article examines how senators perceived the Senate's
   capacity and legitimacy to safeguard democracy. The findings suggest
   that the Senate's contribution to democratic resilience stems less from
   formal authority than its self-perception and resultant independent
   behaviour. By perceiving itself as a guardian of democracy and acting
   assertively and autonomously from the executive-dominated lower chamber,
   the Senate strengthened liberal constitutionalism in Czechia. The
   article thus offers a new perspective on the mechanisms of democratic
   resilience and the potential of upper chambers to mitigate democratic
   erosion.},
