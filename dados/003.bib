@article{ WOS:001683638500001,
Author = {Bornstein, Quinn M. and Gimpel, James G.},
Title = {Good bridges make good neighbors: The convergence of political support
   astride the Connecticut river},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {126},
Month = {APR},
Abstract = {Does social and political influence cross geophysical borders that
   present barriers to human interaction? The natural environment is
   abundant with features such as rivers, lakes, and mountain ranges that
   impede the social relations that make socialization and political
   influence possible. Our empirical focus is on the Connecticut River, a
   discontinuity forming the eastern border of Vermont, and the western
   border of New Hampshire. This is an especially suitable boundary to
   examine because in the post-World War II period, the two states have
   followed distinctive political trajectories, with Vermont becoming a
   Democratic political stronghold, while New Hampshire has leaned far more
   Republican, or, more recently, remained competitive between the two
   major parties. We find that proximity to a bridge at this riparian
   border is associated with greater similarity in town-level presidential
   and gubernatorial voting across the 50-year span from 1970 to 2022.
   Additionally when two towns are joined by a bridge, the difference in
   their presidential and gubernatorial Democratic (Republican) vote share
   decreases. When no bridge is present to enable cross-boundary
   interaction, the towns have remained politically more divergent, like
   their respective states.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
