@article{ WOS:001698468300001,
Author = {Dagvadorj, Gandi and Zhai, Yida},
Title = {Gender ideology and political participation: evidence from Mongolia as a
   third-wave democracy},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 FEB 21},
Abstract = {This study examines the relationship between gender ideology and
   political participation in Mongolia, a third-wave democracy. Utilizing
   nationwide survey data, the analysis focuses on five forms of political
   participation: voting, political mobilization, petition signing,
   protest, and online activism. The findings reveal that individuals with
   more egalitarian gender ideologies are significantly more likely to vote
   and sign petitions, but less likely to engage in protest activities.
   Within-gender patterns reveal that women with high egalitarian gender
   ideologies are more likely to participate in petition signing, although
   this effect is not statistically significant for men. Urban residents
   exhibit higher levels of non-voting participation; however, the
   influence of gender ideology is more pronounced in rural areas,
   particularly in relation to online activism and political mobilization.
   These results suggest that the relationship between gender ideology and
   political participation is related to broader social and geographic
   contexts in Mongolia. Understanding these dynamics provides valuable
   insight into how inclusive participation might be promoted in emerging
   democratic systems.},
