Affiliations = {University of London; University College London; University of Toronto;
   University of Tokyo; University of California System; University of
   California Berkeley; Harvard University; University of Twente},
Funding-Acknowledgement = {Balzan Foundation},
Funding-Text = {Research for this article, and discussion at several research meetings,
