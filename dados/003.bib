@article{ WOS:001583980900001,
Author = {Desai, Zuheir},
Title = {A Theory of Electoral Competition in Developing Democracies},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {1},
Pages = {63-78},
Month = {JAN 1},
Abstract = {Elections in developing democracies often involve the politicization of
   social cleavages, whereas the economic dimension seems politically
   insignificant. How does economic development affect this state of
   affairs? I show that development-led economic mobility structures voting
   behavior around policy but can aggravate campaigning on the social
   cleavage. A preponderance of poor voters leads the Right to adopt a
   platform that is nearly identical to that of the Left and to campaign
   more on the social dimension. Development increases policy polarization,
   thereby increasing the significance of the economic dimension. However,
   its effect on campaigning on the social dimension depends on the nature
   of the social cleavage. Development promotes divisive campaigning in a
   primordial majority-minority cleavage and has a moderating effect only
   under relatively optimistic assumptions. The results provide a
   structural explanation for the apparent unimportance of the economic
   dimension in developing democracies and outline conditions under which
   development exacerbates the politicization of social divisions.},
