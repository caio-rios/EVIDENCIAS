@article{ WOS:001723403900001,
Author = {Kovalov, Maksym},
Title = {Mobilizing the margins or endangering democracy? Populism and
   participation in Poland},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 MAR 21},
Abstract = {This article examines how populism shaped political participation in
   Poland between 2001 and 2007, focusing on two mechanisms: inclusion and
   disenchanted mobilization. First, it explores how populist appeals in
   opposition contributed to the political inclusion of previously
   disengaged or marginalized citizens. Second, it analyzes how populism in
   government elevated political conflict, heightened citizen anxiety, and
   contributed to higher mobilization and voter turnout in opposition to
   populism. Drawing on quantitative data from the Polish National Election
   Studies and qualitative data from elite interviews with Polish party
   officials and academic experts, the article finds that participation of
   new voters and new groups of politicians increased in the 2001 and 2005
   elections because of populist mobilizational efforts, or in support of
   populism. On the other hand, participation in the 2007 election
   increased in opposition to populism, as voter turnout was largely
   reactive and driven by public backlash against the confrontational style
   and illiberal policies of the governing populist coalition that were
   perceived as a threat to democratic norms and institutions.},
