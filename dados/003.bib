Funding-Acknowledgement = {Susan Louise Dyer Peace Fellowship at Stanford University's Hoover
   Institution; University of Virginia's Quantitative Collaborative; Batten
   Institute for Entrepreneurship and Innovation},
Funding-Text = {Support for this research was provided by the University of Virginia's
   Quantitative Collaborative, Dean of Arts \& Sciences, Vice President for
