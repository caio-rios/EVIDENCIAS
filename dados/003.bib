@article{ WOS:001739796900001,
Author = {Bergh, Johannes and Aardal, Bernt},
Title = {The 2025 Norwegian election},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {5},
Pages = {1370-1382},
Month = {JUL 29},
Abstract = {In the parliamentary election of September 2025 the Labour government
   was re-elected against the odds. Only 9 months earlier, in December
   2024, polls had indicated that the coalition of Labour and the Centre
   Party was heading towards defeat, and that Erna Solberg would return as
   Premier. Shortly after the 2021 election the centre-left coalition
   started to lose support, not least due to record high electricity bills,
   steep inflation and increasing interest rates. The war between Russia
   and Ukraine added to the anxiety of many voters. However, when the
   Centre Party left the government in January 2025, a reshuffling of the
   government brought new optimism to centre-left parties. Jens
   Stoltenberg, the former general secretary of NATO, was a particularly
   popular choice as finance minister, and contributed to increased
   popularity for Labour. Adding to this, several economic indicators
   showed a positive trend, leading to a win for the centre-left parties.},
