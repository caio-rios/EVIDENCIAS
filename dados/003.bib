@article{ WOS:001706653100001,
Author = {Dunlap, Alexander A.},
Title = {Attacking the roots: On the limited development of (green) colonialism},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {125},
Month = {MAR},
Abstract = {While (green) colonialism prevails, this commentary encourages deeper
   definitions and dissection of how (neo) colonial structures. Unequal
   exchange and environmental/climate justice (E/CJ) discourses, this
   commentary argues, only recgonizes the distributive symptoms of plunder
   while obscuring the statist and terricidal structures that sustain
   (neo)colonialism and its `greening' efforts. Recounting green
   colonialism definitions, and recognizing the elided works in colonial
   genocide studies, the commentary advocates political organization that
   can defeat colonial/statist ideologies, logics and myth while organizing
   defense against invading imperial powers.},
