@article{ WOS:001736252600001,
Author = {Lenz, Alexa and Knill, Christoph and Steinebach, Yves},
Title = {Addition preferences among policymakers as driver of policy growth},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 MAR 24},
Abstract = {Policy growth has become a defining feature of modern governance,
   contributing to administrative overload and reduced policy
   effectiveness. While most research addresses this phenomenon from a
   macro-level perspective, this study examines how individual policymakers
   contribute to policy growth through a systematic preference for additive
   policy solutions. Integrating insights from social psychology, public
   administration, and political science, the article argues that addition
   preferences stem from cognitive mechanisms, such as subtraction neglect,
   and strategic incentives linked to policy expansion. Using a survey
   experiment with 1,454 elected policymakers in Norway, it tests the
   prevalence of addition preferences and how they are influenced by
   contextual conditions. The results reveal (1) a persistent addition
   preference among policymakers; and (2) that information about available
   implementation capacities can slightly reduce these tendencies. These
   findings advance behavioural understanding of policy development and
   democratic governance, emphasising the need to expose decision-makers to
   implementation realities.},
