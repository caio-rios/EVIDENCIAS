@article{ WOS:001761467700001,
Author = {Scarrow, Susan E.},
Title = {Party decline revisited: eras and aspects of change},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 MAR 13},
Abstract = {Political scientists have been diagnosing and debating party decline in
   European parliamentary democracies for over half a century. Spurred by
   the fiftieth anniversary of these debates, this article re-examines
   changes associated with the decline diagnosis. It argues that the term
   endures partly because the lack of a standard definition allows it to be
   applied to shifting cases and symptoms. This article thus re-frames
   party decline as five testable sub-hypotheses, then assesses ongoing
   support for each, focusing on 12 European parliamentary democracies to
   which the diagnosis was originally applied. Disentangling these
   sub-hypotheses clarifies the terms of the debate and suggests that
   trends in some areas may have stabilised or even rebounded in the
   twenty-first century despite the ongoing decline of many classic
   catch-all parties. The article concludes by arguing for retiring the
   umbrella `decline' label in favour of more differentiated approaches
   which can illuminate relations between different areas of political
   change.},
