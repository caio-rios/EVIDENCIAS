@article{ WOS:001555104900001,
Author = {Brennan, Jason and Freiman, Christopher},
Title = {Political Speech for Democratic Realists},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {1},
Pages = {377-389},
Month = {JAN 1},
Abstract = {This article considers how recent and classic work on political
   behavior, from the Michigan model and the related democratic realist
   schools, bear on philosophical issues of political speech. We argue that
   most ordinary citizens' political speech should not be taken at face
   value as an expression of sincere belief. Most of citizens' political
   speech is a form a signaling. We argue this research has important
   philosophical implications that make trouble for democratic theory. It
   implies citizens are not deeply committed to much of what they say about
   politics. It implies that voters' support for candidates and parties has
   less normative significance than commonly thought. It implies that
   politicians often cannot successfully make or break promises to most
   citizens. It also implies citizens have less reason to disassociate from
   one another on the basis of seemingly bad speech.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
