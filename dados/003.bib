@article{ WOS:001656290300001,
Author = {Bos, Ellen and Kneuer, Marianne},
Title = {The sequencing of academic freedom violations during democratic erosion:
   Comparing the cases of Hungary and Poland},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2026},
Month = {2026 JAN 7},
Abstract = {This paper addresses the widely accepted but still little elaborated
   observation that democratic erosion evolves in a sequential manner. We
   argue that the violation of academic freedom takes place after the
   incumbent erosion agents changed the democratic rules and secured grip
   on power. The analysis bases on a focused comparison of two cases of
   democratic erosion in the European Union - Hungary (2010-) and Poland
   (2015-2023) - tracing the evolution of measures curtailing academic
   freedom. The findings confirm that the attack against academic freedom
   is implemented with a time lag. Although the illiberal governments in
   Hungary and Poland sought from the outset to increase their influence on
   academia and to shape the public debate, tangible restrictions occurred
   only after political institutions had been reshaped in a way that would
   ensure their stay in power. Moreover, our longitudinal perspective
   reveals that, over time, measures are not only increasing in number, but
   also in scope and severity.},
