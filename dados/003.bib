@article{ WOS:001667206400001,
Author = {Beauvais, Edana and Enders, Adam M.},
Title = {Toward a Theory and Measure of Racial Benevolence},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 JAN 22},
Abstract = {Most work on racial attitudes considers explicitly hostile outgroup
   evaluations. What about racial attitudes that appear subjectively
   positive but reinforce racial inequality more broadly? Research in
   social psychology shows that sexist attitudes are ambivalent; sexism can
   be hostile or benevolent. Building on the nascent idea that racial
   prejudice also ranges from hostile to benevolent, we theorize the
   concept of ``racial benevolence{''} and develop comparable measures of
   White voters' benevolent attitudes toward Indigenous peoples in Canada
   and Black Americans. Unlike hostile prejudicial attitudes, benevolent
   racial attitudes are motivated by an egalitarian impetus to help.
   However, benevolent racial attitudes still motivate political behavior
   that threatens to undermine racial equality more generally by
   reinforcing target group members' subordination through assimilation and
   surveillance. We discuss how hostile and benevolent racial attitudes
   work in tandem to reinforce racial inequalities.},
