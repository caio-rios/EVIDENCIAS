@article{ WOS:001621308200001,
Author = {Bech-Pedersen, Palle},
Title = {Defending Elections Against the Oligarchic Charge},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {2},
Pages = {826-838},
Month = {APR 1},
Abstract = {This article counters the claim, advanced by lottocrats, that elections
   are inherently oligarchic. I begin by examining the theory of elections
   that sees them as a superior mechanism for selecting candidates, showing
   that this implication fails to render elections as inherently oligarchic
   because superiority is context dependent. Next, I demonstrate that the
   advantage of wealth arising from the cost of disseminating information
   is empirically contingent and, thus, not attributable to the nature of
   elections. I then offer a pathway for the deoligarchization of
   elections, distinguishing between doxastic and structural obstacles to
   inclusion. I demonstrate how ideology critique and certain structural
   reforms offer solutions to these obstacles. I conclude by addressing the
   rebuttal that elections remain very likely to be oligarchic and that
   sortition fares comparatively better on this front. I argue that this
   line of argument overlooks the undemocratic implications and risks of
   oligarchization that would emerge from adopting sortition.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
