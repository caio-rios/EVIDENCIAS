@article{ WOS:001710428700001,
Author = {Willumsen, David M. and Otjes, Simon},
Title = {Coalition government formation and policy payoffs},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2026},
Volume = {65},
Number = {1},
Pages = {1-21},
Month = {FEB},
Abstract = {What determines the outcomes of negotiations is a central question in
   political science, and such negotiations are crucial in coalition
   systems where political parties distribute policy payoffs during
   coalition negotiations. In this paper, we argue that due to the
   combination of the non-separability of most public policies and the
   shared responsibility for policy outcomes under coalition governments,
   which policies a party manages to get included in a coalition agreement
   will reflect these policies' popularity among the other governing
   coalition parties, rather than policy payoffs being driven by
   proportionality or relative salience. Using a unique dataset containing
   novel data on the budgetary impact of every measure proposed in election
   manifestos and coalition agreements over five government formations, we
   can directly observe the policy payoffs extracted by each party for
   participating in government, using a measure that is directly comparable
   across parties, policy areas, and time. The results have substantial
   implications for our understanding of the formation process and
   functioning of coalition governments.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
Type = {Article},
Language = {English},
Affiliation = {Willumsen, DM (Corresponding Author), Univ Innsbruck, Dept Polit Sci, Innsbruck, Austria.
   Willumsen, David M., Univ Innsbruck, Dept Polit Sci, Innsbruck, Austria.
   Otjes, Simon, Leiden Univ, Inst Polit Sci, Leiden, Netherlands.},
DOI = {10.1017/S1475676525100005},
ISSN = {0304-4130},
EISSN = {1475-6765},
Keywords = {Coalition government; coalition agreement negotiations; policy payoffs;
   Gamson's Law; office payoffs; salience},
Keywords-Plus = {ELECTION PLEDGES; IDEOLOGICAL CONGRUENCE; PORTFOLIO ALLOCATION;
