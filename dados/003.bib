@article{ WOS:001676229000001,
Author = {Fernandez, Cristian Flores},
Title = {The spatial politics of green hydrogen: Speculative enactments,
   contested dynamics and alternative pathways in southern Chile},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {126},
Month = {APR},
Abstract = {This article examines the spatial politics of green hydrogen development
   in Chile's Magallanes region. In this southernmost
   territory-disconnected energetically and territorially from mainland
   Chile-export-oriented megaprojects advance despite growing global
   skepticism about the sector's viability. Studying this yet underexplored
   case and employing an adapted ``5Es{''} framework, the article captures
   the speculative, multidimensional, and contested political geographies
   surrounding this energy vector, offering empirical and theoretical
   contributions to debates on green hydrogen and new resource frontiers.
   The framework reveals mutually reinforcing processes where multilevel
   and transnational coalitions drive regional reconfigurations through
   technical projections and evolving governance arrangements. The analysis
   shows how, even amid profound uncertainties about their materialization,
   the green hydrogen hype is reshaping regional dynamics: enabling new
   forms of wind, land, coast, and maritime appropriation; exposing power
   asymmetries where scientific networks challenge environmental
   assessments; and intensifying debates about regional development
   trajectories. Magallanes' particular characteristics-history as a
   ``productive colony,{''} territorial isolation, and critical
   biodiversity corridors-generate particular tensions, while also
   comparable lessons for other peripheral regions. Understanding
   site-specific dynamics during the speculative window-the critical period
   between hype and materialization or failure-proves crucial for regions
   seeking to reconcile global climate goals with territorial justice and
   ecological integrity. The case illustrates how emerging hydrogen
   pathways remain contested, unsettled and fundamentally open, a condition
   reinforced by the sector's current loss of momentum.},
