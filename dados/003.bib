ISSN = {0022-3816},
EISSN = {1468-2508},
Keywords = {institutions; energy transition; compensation; insulation; climate
   change},
Keywords-Plus = {MAJORITARIAN ELECTORAL SYSTEMS; POLITICS; GOVERNMENT; POLICY; TRADE;
   POWER; OECD},
Research-Areas = {Government \& Law},
