@article{ WOS:000774657700001,
Author = {Beazer, Quintin H. and Crabtree, Charles D. and Fariss, Christopher J.
   and Kern, Holger L.},
Title = {When Do Private Actors Engage in Censorship? Evidence From a
   Correspondence Experiment with Russian Private Media Firms},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2022},
Volume = {52},
Number = {4},
Pages = {1790-1809},
Month = {OCT},
Abstract = {In authoritarian regimes, repression encourages private actors to censor
   not only themselves, but also other private actors-a behavior we call
   ``regime-induced private censorship.{''} We present the results of a
   correspondence experiment conducted in Russia that investigates the
   censorship behavior of private media firms. We find that such firms
   censor third-party advertisements that include anti-regime language,
   calls for political or non-political collective action, or both. Our
   results demonstrate the significance of other types of censorship
   besides state censorship in an important authoritarian regime and
   contribute to the rapidly growing literature on authoritarian
   information control.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Crabtree, CD (Corresponding Author), Dartmouth Coll, Dept Govt, Hanover, NH 03755 USA.
   Beazer, Quintin H.; Kern, Holger L., Florida State Univ, Dept Polit Sci, Tallahassee, FL 32306 USA.
   Crabtree, Charles D., Dartmouth Coll, Dept Govt, Hanover, NH 03755 USA.
   Fariss, Christopher J., Univ Michigan, Dept Polit Sci, Ann Arbor, MI 48109 USA.},
DOI = {10.1017/S0007123421000351},
EarlyAccessDate = {SEP 2021},
Article-Number = {PII S0007123421000351},
ISSN = {0007-1234},
