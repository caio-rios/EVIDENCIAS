@article{ WOS:000700550800001,
Author = {Ceva, Emanuela and Murphy, Colleen},
Title = {Interactive Justice in Transitional Justice: A Dynamic Framework},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2022},
Volume = {66},
Number = {3},
Pages = {762-774},
Month = {JUL},
Abstract = {This article develops a new dynamic framework for the normative
   evaluation of processes of transitional justice capable of integrating
   instrumental and noninstrumental justice-based assessments grounded on
   concerns of ``interactive justice.{''} Interactive justice is realized
   in or through institutional processes that treat people in ways
   appropriate to their status as institutional role occupants. Analyzing
   interactive justice in transitional justice is particularly important to
   pinpoint the distinct concerns of justice that might arise when
   employing a relational understanding of transitional justice. Our
   dynamic framework clarifies the distinct normative standards to meet
   when evaluating processes of transitional justice in virtue of the
   qualities of the relationship dynamics they themselves cause or
   constitute.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
