@article{ WOS:000688266100001,
Author = {Chen, Ling and Zhang, Hao},
Title = {Strategic Authoritarianism: The Political Cycles and Selectivity of
   China's Tax-Break Policy},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2021},
Volume = {65},
Number = {4},
Pages = {845-861},
Month = {OCT},
Abstract = {A rich literature has noted political business cycles in democracies. We
   argue that in an autocracy with strong bureaucratic institutions, the
   pressure of evaluation and promotion has also generated political cycles
   of tax-break policies. Furthermore, the timing and content of the
   evaluation have driven leaders to use tax breaks strategically to build
   economic performance, producing distributional consequences. Combining
   panel data of 1,510,153 firm-year observations, city-leader data from
   1995 to 2007, and field interviews, we find that the tax-break rates
   dropped for most firms during mayors' turnover years. In the first year
   of office, that is, the ``busy year,{''} mayors needed to prioritize
   large firms and especially large foreign firms. Small domestic private
   firms bore the cost of tenure cycles. In the last year of the mayors'
   tenure, that is, the ``dust-settled{''} year, there was little incentive
   to seek promotion, and even important firms could not gain the mayors'
   attention.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Chen, L (Corresponding Author), Johns Hopkins Univ, Sch Adv Int Studies, 1740 Massachusetts Ave NW, Washington, DC 20036 USA.
   Chen, Ling, Johns Hopkins Univ, Sch Adv Int Studies, 1740 Massachusetts Ave NW, Washington, DC 20036 USA.
   Zhang, Hao, MIT, Dept Polit Sci, 30 Wadsworth St E53, Cambridge, MA 02139 USA.},
DOI = {10.1111/ajps.12648},
EarlyAccessDate = {AUG 2021},
