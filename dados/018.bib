EISSN = {1540-5907},
Keywords-Plus = {BUDGET CYCLES; FISCAL DECENTRALIZATION; POST-MAO; CORRUPTION;
   PERFORMANCE; BUREAUCRACY; INCENTIVES; INVESTMENT; ELECTIONS; PARTY},
