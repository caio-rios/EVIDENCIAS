@article{ WOS:000655222000001,
Author = {Oskarsson, Sven and Dawes, Christopher T. and Lindgren, Karl-Oskar and
   Ohrvall, Richard},
Title = {Big Brother Sees You, but Does He Rule You? The Relationship between
   Birth Order and Political Candidacy},
Journal = {JOURNAL OF POLITICS},
Year = {2021},
Volume = {83},
Number = {3},
Pages = {1158-1162},
Month = {JUL 1},
Abstract = {While recent research finds strong evidence that birth order affects
   outcomes such as education, IQ scores, earnings, and health, the
   evidence for effects on political outcomes is more limited. Using
   population-wide data from Sweden, our within-family estimates show that
   firstborns are significantly more likely to run for and be elected to
   political office. In addition, for the males in our sample we test
   whether a number of potential mechanisms account for the relationship
   between birth order and political participation. Disconfirming our
   expectations, the birth order effects are only marginally smaller when
   controlling for occupational economic status, cognitive ability, and
   leadership skills. Our results suggest that big brother, or for that
   matter big sister, not only sees us; to a certain extent he or she also
   rules us.},
