@article{ WOS:000686505000001,
Author = {Zizumbo Colunga, Daniel and Meza, Oliver},
Title = {Flying Under the Radar: How Frames Influence Public Officials'
   Perceptions of Corruption},
Journal = {POLITICAL BEHAVIOR},
Year = {2023},
Volume = {45},
Number = {3},
Pages = {995-1014},
Month = {SEP},
Abstract = {The study of the forces that lead citizens and public officials to
   tolerate corruption has attracted scholarly attention for decades. We
   seek to contribute to this literature by arguing that -since corruption
   is an interpersonal process- public officials' perceptions of and
   dispositions toward it are influenced by how it is framed. To test this
   claim, we conduct an original experiment on a representative sample of
   civil servants working in a large urban municipal government in Mexico.
   We find that, even when evaluating clear examples of corruption, public
   officials are more likely to tolerate the illegal disregard for the
   bureaucratic procedure when it is framed not as a monetary exchange but
   as a way in which resources can be redistributed, institutions can be
   made more flexible, and organizations can be made more efficacious.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
