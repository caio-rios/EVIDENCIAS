@article{ WOS:001537296000001,
Author = {Ranji, Banafsheh and Selvik, Kjetil},
Title = {Emotions in the legitimation of repression: state framing during the
   Woman, Life, Freedom movement in Iran},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {47},
Number = {2},
Pages = {283-298},
Month = {MAR},
Abstract = {This article explores the role of emotions in legitimising repression in
   authoritarian states by analysing the state framing during the 2022
   Woman, Life, Freedom protest movement in Iran. While existing
   scholarship emphasises the argumentative aspects of authoritarian
   legitimation, this study underscores the crucial role of emotional
   manipulation. Conducting a framing analysis of conservative Iranian
   media coverage, we examine how the state employed discursive strategies
   to counter the revolts. The Islamic Republic conveyed narratives of
   pro-regime victims, or `martyrs' to evoke moral judgements and emotional
   responses, transforming its agents of repression into symbols of
   resistance, sacrifice, moral integrity and courage. The state framing
   justified repression not only as a necessary measure to restore order,
   but also as an act of justice for fallen regime loyalists. This helped
   strengthen the state's ability to unite its supporters and security
   forces behind its objectives, while facilitating the continued
   suppression of the oppositions.},
