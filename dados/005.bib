@article{ WOS:001566409800001,
Author = {Piccolino, Gianluca and Puleo, Leonardo},
Title = {Some Are More Equal than Others: Exploring Competition Among `Mirror
   Parties'},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {1},
Pages = {56-77},
Month = {MAR},
Abstract = {The literature has paid little attention to the interactions between
   parties belonging to the same party family operating in the same
   political system. We introduce a novel framework to study competition
   among these actors, which we label as `mirror parties'. We expect that
   these parties primarily engage in `ideologically peripheral
   competition', by aligning on core issues while differentiating on
   non-core ones. We test this framework on twenty-nine pairs of radical
   right and left parties in nineteen European countries. We also examine
   mutual attacks between party leaders, focusing on a prominent case:
   Fratelli d'Italia (FdI) and Lega in 2018 and 2022 General Elections. Our
   data supports the framework, as most mirror parties show ideological
   peripheral competition, although this is more frequent among radical
   right parties and is more expressed in terms of positioning rather than
   salience. Additionally, our case study on FdI and Lega reveals that
   mutual attacks tend to target non-core issues.
   Die Literatur hat der Untersuchung der Interaktionen zwischen Parteien,
   die derselben Parteifamilie angeh \& ouml;ren und im selben politischen
   System agieren, bislang nur wenig Aufmerksamkeit geschenkt. Wir stellen
   ein neuartiges Rahmenkonzept vor, um den Wettbewerb zwischen diesen
   Akteuren, die wir als ``Spiegelparteien{''} bezeichnen, zu analysieren.
   Wir gehen davon aus, dass diese Parteien haupts \& auml;chlich
   ``ideologisch peripheren{''} Wettbewerb betreiben, indem sie sich bez \&
   uuml;glich ihrer Kernthemen angleichen, sich jedoch bei zweitrangigen
   Themen unterscheiden. Wir testen dieses Rahmenkonzept anhand von
   neunundzwanzig Parteipaaren des radikalen rechten und linken Spektrums
   in neunzehn europ \& auml;ischen L \& auml;ndern. Zudem analysieren wir
   gegenseitige Angriffe zwischen Parteif \& uuml;hrern, wobei wir einen
   prominenten Fall betrachten: Fratelli d'Italia (FdI) und Lega bei den
   italienischen Parlamentswahlen 2018 und 2022. Unsere Daten st \&
   uuml;tzen das Rahmenkonzept: die meisten Spiegelparteien betreiben einen
   ideologisch peripheren Wettbewerb. Dies ist insbesondere bei radikal
   rechten Parteien und eher hinsichtlich der Positionierung als der
   Salienz der Fall. Dar \& uuml;ber hinaus zeigt unsere Fallstudie zu FdI
   und Lega, dass gegenseitige Angriffe vor allem auf nebens \&
   auml;chliche Themen abzielen.
   La litt \& eacute;rature a accord \& eacute; peu d'attention \& agrave;
   l'analyse des interactions entre partis appartenant \& agrave; une m \&
   ecirc;me famille politique et oe uvrant au sein d'un m \& ecirc;me syst
   \& egrave;me politique. Nous introduisons un nouveau cadre th \&
   eacute;orique pour analyser la comp \& eacute;tition entre ces acteurs,
   que nous d \& eacute;finissons comme des << partis miroirs >>. Nous nous
   attendons \& agrave; ce que ces partis soient principalement engag \&
   eacute;s dans une << comp \& eacute;tition id \& eacute;ologiquement p
   \& eacute;riph \& eacute;rique >>, c'est-\& agrave;-dire qu'ils tendent
   \& agrave; s'aligner sur leurs th \& eacute;matiques centrales, tout en
   se diff \& eacute;renciant sur des th \& eacute;matiques p \&
   eacute;riph \& eacute;riques. Nous testons ce cadre th \& eacute;orique
   par une analyse de vingt-neuf paires de partis de droite et de gauche
   radicales dans dix-neuf pays europ \& eacute;ens. Nous analysons \&
   eacute;galement les attaques r \& eacute;ciproques entre les dirigeants
   de partis, en nous concentrant sur un cas embl \& eacute;matique:
   Fratelli d'Italia (FdI) et la Lega lors des \& eacute;lections
   parlementaires italiennes de 2018 et 2022. Nos donn \& eacute;es
   confirment le cadre th \& eacute;orique propos \& eacute;, puisque la
   majorit \& eacute; des partis miroirs pr \& eacute;sentent une comp \&
   eacute;tition id \& eacute;ologiquement p \& eacute;riph \&
   eacute;rique, bien que cela soit plus fr \& eacute;quent parmi les
   partis de droite radicale et davantage en termes de positionnement que
   de saillance. En outre, notre \& eacute;tude de cas sur FdI et la Lega r
   \& eacute;v \& egrave;le que les attaques r \& eacute;ciproques tendent
   \& agrave; se concentrer sur les th \& eacute;matiques non centrales.
   La letteratura ha prestato scarsa attenzione all'analisi delle
   interazioni tra partiti appartenenti alla stessa famiglia politica
   operanti all'interno dello stesso sistema politico. In questo studio
   introduciamo un nuovo quadro teorico per analizzare la competizione tra
   questi attori, che definiamo come ``partiti specchio{''}. Ci aspettiamo
   che questi partiti siano principalmente coinvolti in una ``competizione
   ideologicamente periferica{''}, ovvero tendano ad allinearsi sulle loro
   tematiche centrali, differenziandosi invece sulle altre. Testiamo questo
   quadro teorico su ventinove coppie di partiti di destra e sinistra
   radicale in diciannove paesi europei. Analizziamo inoltre gli attacchi
   reciproci tra leader di partito, concentrandoci su un caso emblematico:
   FdI e Lega nelle elezioni politiche del 2018 e del 2022. I nostri dati
   confermano il quadro teorico proposto, poich \& eacute; la maggior parte
   dei partiti specchio mostra una competizione ideologicamente periferica,
   sebbene ci \& ograve; sia pi \& ugrave; frequente tra i partiti della
   destra radicale e in termini di posizionamento piuttosto che di
   salienza. Inoltre, il nostro studio di caso su FdI e Lega rivela che gli
   attacchi reciproci tendono a concentrarsi sulle tematiche non centrali.},
