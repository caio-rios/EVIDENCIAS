@article{ WOS:001527925800001,
Author = {Hsiao, Allan and Kuipers, Nicholas},
Title = {Climate crisis and policy inaction in Indonesia},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Volume = {70},
Number = {3},
Pages = {1213-1228},
Month = {JUL},
Abstract = {We surveyed voters and politicians in advance of the 2024 Indonesian
   election to measure preferences for environmental policy. We find that
   politicians underestimate voter concerns. We conducted an informational
   experiment with politicians to correct these misperceptions, and we
   document evidence of learning but no greater support for policy action.
   We explore three explanations for why voter preferences do not translate
   into policy. First, politicians only consider acting when their initial
   misperceptions are particularly large. Second, elite capture prevents
   politicians from implementing environmental protection. Third, voters
   prioritize progress in other domains. Our results underscore the
   multiplicity of challenges facing climate action.},
