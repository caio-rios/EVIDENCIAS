@article{ WOS:001566519200001,
Author = {Badas, Alex},
Title = {Judicial Ambition and the Crafting of Law: How Promotion Potential
   Shapes Appellate Opinions},
Journal = {POLITICAL RESEARCH QUARTERLY},
