@article{ WOS:001493075200001,
Author = {de Natris, Joes Gordon},
Title = {Which Factors Influence Issue Salience in Electoral Manifestos? New
   Insights From the Salience of Social Services in Dutch Local Elections},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {2},
Pages = {222-247},
Month = {JUN},
Abstract = {Issue salience - the attention a party devotes to an issue - in
   electoral manifestos remains understudied at the local level. This paper
   studies three potential determinants of issue salience: contextual
   responsiveness (parties emphasize topics important to voters),
   party-issue associations (parties emphasize the same issues across time
   and settings), and parties' expertise (parties emphasize complex issues
   only if they have sufficient expertise). This paper uses a dictionary
   approach to measure the salience of social services in the over 6,600
   available electoral manifestos for Dutch municipal elections between
   2014 and 2022. To operationalize voters' priorities, party-issue
   associations and parties' expertise, these data have been linked with
   data on demographic `indicators of need', party affiliation, the
   salience of social services in national party manifestos, and individual
   politicians. Mixed effects models show that contextual responsiveness
   and party-issue associations affect the salience of social services in
   electoral manifestos, while parties' expertise plays no role.
   Themensalienz - also die Aufmerksamkeit, die eine Partei einem
   bestimmten Thema widmet - ist in Wahlprogrammen auf kommunaler Ebene
   bislang wenig erforscht. Dieser Beitrag untersucht drei potenzielle
   Bestimmungsfaktoren von Themensalienz: kontextuelle Responsivit \&
   auml;t (Parteien betonen Themen, die f \& uuml;r W \& auml;hlerInnen
   wichtig sind), Partei-Thema-Assoziationen (Parteien betonen \& uuml;ber
   Zeit und Kontexte hinweg dieselben Themen) und die thematische Expertise
   von Parteien (Parteien betonen komplexe Themen nur, wenn sie \& uuml;ber
   ausreichende fachliche Kompetenz verf \& uuml;gen). Die vorliegende
   Studie wendet automatisierte Textanalyse anhand eines W \&
   ouml;rterbuch-Ansatzes an, um die Salienz sozialer Dienstleistungen in
   \& uuml;ber 6.600 verf \& uuml;gbaren Wahlprogrammen bei den niederl \&
   auml;ndischen Kommunalwahlen zwischen 2014 und 2022 zu messen. Zur
   Operationalisierung von W \& auml;hlerpriorit \& auml;ten,
   Partei-Thema-Assoziationen und Parteiexpertise wurden die Daten mit
   demografischen ,,Bedarfsindikatoren{''}, Parteizugeh \& ouml;rigkeiten,
   der Salienz sozialer Dienstleistungen in nationalen Parteiprogrammen
   sowie Informationen \& uuml;ber einzelne Politikerinnen verkn \&
   uuml;pft. Die Ergebnisse basierend auf mixed effects models zeigen, dass
   kontextuelle Responsivit \& auml;t und Partei-Thema-Assoziationen die
   Salienz sozialer Dienstleistungen in Wahlprogrammen beeinflussen, w \&
   auml;hrend die Expertise der Parteien keine Rolle spielt.
   La saillance des enjeux - c'est-\& agrave;-dire l'attention qu'un parti
   accorde \& agrave; un enjeu - dans les manifestes \& eacute;lectoraux
   reste peu \& eacute;tudi \& eacute;e au niveau local. Cet article
   examine trois d \& eacute;terminants potentiels de la saillance des
   enjeux: la r \& eacute;activit \& eacute; contextuelle (les partis
   mettent l'accent sur les th \& egrave;mes importants pour les \&
   eacute;lectrices et \& eacute;lecteurs), les associations parti-enjeu
   (les partis insistent sur les m \& ecirc;mes enjeux dans le temps et
   selon les contextes), et l'expertise des partis (les partis ne mettent
   en avant des enjeux complexes que s'ils poss \& egrave;dent une
   expertise suffisante). Cet article utilise une approche par dictionnaire
   pour mesurer la saillance des services sociaux dans plus de 6 600
   manifestes \& eacute;lectoraux disponibles pour les \& eacute;lections
   municipales n \& eacute;erlandaises entre 2014 et 2022. Pour op \&
   eacute;rationnaliser les priorit \& eacute;s des \& eacute;lectrices et
   \& eacute;lecteurs, les associations parti-enjeu et l'expertise des
   partis, ces donn \& eacute;es ont \& eacute;t \& eacute; mises en
   relation avec des donn \& eacute;es d \& eacute;mographiques sur les <<
   indicateurs de besoin >>, l'affiliation partisane, la saillance des
   services sociaux dans les manifestes nationaux des partis, et les caract
   \& eacute;ristiques individuelles des hommes et femmes politiques. Des
   mod \& egrave;les \& agrave; effets mixtes montrent que la r \&
   eacute;activit \& eacute; contextuelle et les associations parti-enjeu
   influencent la saillance des services sociaux dans les manifestes \&
   eacute;lectoraux, tandis que l'expertise des partis ne joue aucun r \&
   ocirc;le.
   La salienza tematica - ovvero l'attenzione che un partito dedica a una
   determinata questione - nei manifesti elettorali rimane un fenomeno
   ancora poco studiato a livello locale. Il presente articolo analizza tre
   potenziali determinanti della salienza: la reattivit \& agrave; al
   contesto (i partiti enfatizzano i temi ritenuti importanti dagli
   elettori), l'associazione partito-tema (i partiti mantengono un'enfasi
   costante sugli stessi temi nel tempo e nei diversi contesti) e la
   competenza dei partiti (i partiti enfatizzano temi complessi solo
   qualora possiedano una competenza adeguata). Il lavoro adotta un
   approccio basato su dizionario per misurare la salienza dei servizi
   sociali in oltre 6.600 manifesti elettorali relativi alle elezioni
   municipali olandesi tra il 2014 e il 2022. Per operazionalizzare le
   priorit \& agrave; degli elettori, le associazioni partito-tema e la
   competenza dei partiti, i dati testuali sono stati integrati con
   informazioni relative agli indicatori demografici di bisogno,
   all'affiliazione partitica, alla salienza dei servizi sociali nei
   manifesti elettorali nazionali e alle caratteristiche dei singoli
   politici. I modelli ad effetti misti mostrano che la reattivit \&
   agrave; al contesto e le associazioni partito-tema influenzano la
   salienza dei servizi sociali nei manifesti elettorali, mentre la
   competenza dei partiti non sembra rivestire un ruolo significativo.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {de Natris, JG (Corresponding Author), Univ Groningen, POB 800, NL-9700 AV Groningen, Netherlands.
   de Natris, Joes Gordon, Univ Groningen, POB 800, NL-9700 AV Groningen, Netherlands.},
DOI = {10.1111/spsr.12663},
EarlyAccessDate = {MAY 2025},
