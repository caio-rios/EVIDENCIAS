@article{ WOS:001521051600001,
Author = {Stiers, Dieter},
Title = {Electoral input and political legitimacy},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {6},
Pages = {1557-1585},
Month = {SEP 19},
Abstract = {Political legitimacy is of fundamental importance for democratic
   systems, as it ensures that citizens adhere to political rules and
   decisions peacefully and voluntarily. Recent research indicates an
   increasing pressure on the legitimacy of democracies worldwide. In this
   study, it is investigated how individual-level or perceived legitimacy
   can be fostered. The focus is on one of the most important
   input-mechanisms in representative democracies: elections. It is argued
   and tested whether the level of electoral participation, the congruence
   between the electorate and the parliament and government, and the
   reactiveness of the electoral result to past incumbent performance
   affect people's view of the legitimacy of their political system,
   measured using satisfaction with democracy. Using the data of the CSES
   Integrated Module Dataset spanning more than 100 elections in 41
   countries, the results offer support for all three hypotheses and hold
   important implications for the importance of regular free and fair
   elections for the stability and endurance of democracy.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
