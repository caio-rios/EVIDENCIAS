@article{ WOS:001503371600001,
Author = {Lemon, Edward and Antonov, Oleg},
Title = {Big Brothers United: The Influence of China and Russia in Strengthening
   Digital Authoritarianism in Tajikistan},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {3, SI},
Pages = {435-449},
Month = {SEP},
Abstract = {While, in recent years China, and to a lesser degree Russia, have been
   mooted as ``models{''} of authoritarian internet governance that other
   autocratic states can emulate, at present relatively little has been
   written on the transfer of internet technologies and policies within the
   framework of global authoritarianism. In this research note, we explore
   the deployment of digital authoritarianism in Tajikistan and the role
   played by state actors and businesses from Russia and China in
   supporting this. To examine how internet technologies and policies have
   been transferred, we draw on textual analysis and the comparison of
   twelve laws in China, Russia and Tajikistan related to the internet. Our
   analysis finds that cooperation has led to legal convergence, with
   Tajikistan adopting Russian, and to a lesser degree Chinese, information
   security laws and regulations. Russia, China and Tajikistan have shared
   understandings and have developed similar normative approaches to
   internet governance.
   W \& auml;hrend China und in geringerem Ma ss e Russland in den letzten
   Jahren als Vorbilder autorit \& auml;rer Internet-Governance f \& uuml;r
   andere autokratische Staaten gehandelt wurden, wurde bislang relativ
   wenig \& uuml;ber den Transfer von Internet-Technologien und -Politiken
   im Rahmen des globalen Autoritarismus geschrieben. In dieser Research
   Note untersuchen wir die Entwicklung des digitalen Autoritarismus in
   Tadschikistan und die unterst \& uuml;tzende Rolle staatlicher Akteure
   und Unternehmen aus Russland und China. Um den Transfer von
   Internet-Technologien und -Politiken zu untersuchen, st \& uuml;tzen wir
   uns auf eine Textanalyse und den Vergleich von zw \& ouml;lf
   internetbezogenen Gesetzen in China, Russland und Tadschikistan. Unsere
   Analyse zeigt, dass die Zusammenarbeit zu einer rechtlichen Konvergenz
   gef \& uuml;hrt hat, wobei Tadschikistan russische und in geringerem Ma
   ss e chinesische Gesetze und Vorschriften zur Informationssicherheit \&
   uuml;bernommen hat. Russland, China und Tadschikistan teilen ein
   gemeinsames Verst \& auml;ndnis und haben \& auml;hnliche normative Ans
   \& auml;tze zur Internet-Governance entwickelt.
   Si, ces derni \& egrave;res ann \& eacute;es, la Chine, et dans une
   moindre mesure la Russie, ont \& eacute;t \& eacute; pr \& eacute;sent
   \& eacute;es comme des << mod \& egrave;les >> de gouvernance
   autoritaire d'Internet susceptibles d'\& ecirc;tre imit \& eacute;s par
   d'autres \& Eacute;tats autocratiques, le transfert de technologies et
   de politiques Internet dans le cadre de l'autoritarisme mondial a \&
   eacute;t \& eacute; relativement peu \& eacute;tudi \& eacute;. Dans
   cette note de recherche, nous explorons le d \& eacute;ploiement de
   l'autoritarisme num \& eacute;rique au Tadjikistan et le r \& ocirc;le
   jou \& eacute; par les acteurs \& eacute;tatiques et les entreprises
   russes et chinoises. Pour examiner comment les technologies et les
   politiques Internet ont \& eacute;t \& eacute; transf \& eacute;r \&
   eacute;es, nous nous appuyons sur une analyse textuelle et une
   comparaison de douze lois chinoises, russes et tadjikes relatives \&
   agrave; Internet. Notre analyse r \& eacute;v \& egrave;le que la coop
   \& eacute;ration a conduit \& agrave; une convergence juridique, le
   Tadjikistan ayant adopt \& eacute; les lois et r \& eacute;glementations
   russes et, dans une moindre mesure, chinoises en mati \& egrave;re de s
   \& eacute;curit \& eacute; de l'information. La Russie, la Chine et le
   Tadjikistan partagent une compr \& eacute;hension commune et ont d \&
   eacute;velopp \& eacute; des approches normatives similaires en mati \&
   egrave;re de gouvernance d'Internet.
   Sebbene negli ultimi anni la Cina e, in misura minore, la Russia siano
   state indicate come ``modelli{''} di governance autoritaria di internet
   che altri stati autocratici potrebbero emulare, attualmente si \&
   egrave; scritto relativamente poco sul trasferimento di tecnologie e
   politiche di internet nel quadro dell'autoritarismo globale. In questo
   articolo, esploriamo l'implementazione dell'autoritarismo digitale in
   Tagikistan e il ruolo svolto da attori statali e aziende russe e cinesi
   nel sostenerlo. Per esaminare come le tecnologie e le politiche di
   internet siano state trasferite, ci basiamo sull'analisi testuale e sul
   confronto di dodici leggi di Cina, Russia e Tagikistan relative a
   internet. La nostra analisi rileva che la cooperazione ha portato a una
   convergenza giuridica, con il Tagikistan che ha adottato leggi e
   regolamenti sulla sicurezza informatica russi e, in misura minore,
   cinesi. Russia, Cina e Tagikistan hanno condiviso la comprensione e
   sviluppato approcci normativi simili alla governance di internet.},
