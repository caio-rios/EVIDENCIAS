@article{ WOS:001529733800001,
Author = {Stanko, John C.},
Title = {Dynamic Legitimation Theory and Populist Authoritarian Leaders: The
   Rhetorical Framing of International Status for Domestic Legitimacy},
Journal = {POLITICAL COMMUNICATION},
Year = {2025},
Volume = {42},
Number = {6},
Pages = {1059-1086},
Month = {NOV 2},
Abstract = {This article contributes to the literature on the use of strategic
   communication in authoritarian legitimacy by analyzing the rhetoric of
   populist authoritarian leaders. Dynamic legitimation theory (Del Sordi
   and Dalmasso 2018) argues that authoritarian leaders highlight
   international status recognition to enhance their regime's internal
   legitimacy. How this theory applies to populist rulers, who often adopt
   anti-globalist stances, remains unclear, but, as proposed, the tenets of
   DLT should hold in such contexts. This project extends the theory's
   logic to populist rulers, specifically in nascent small and middle power
   competitive authoritarian regimes. In the process, this project
   introduces more nuance to the analysis of dynamic legitimation,
   differentiating between 1) realized and aspirational status markers and
   2) claims to abstract versus concrete status. Deriving hypotheses from
   the logic of strategic communication, the expectations are that 1)
   populist authoritarians will also adopt DLT principles over time, 2)
   authoritarian leaders of middle powers will be able to make more
   reference to realized status, and 3) the nature of competitive
   authoritarian regimes will induce leaders in such countries to invoke
   international status more frequently. To test these propositions, the
   author conducts content analysis comparing the annual state of the
   nation addresses by Kazakhstan's Nursultan Nazarbayev with those of two
   populist leaders, Hungary's Viktor Orb \& aacute;n and South Africa's
   Jacob Zuma. Results show Orb \& aacute;n has made increasing use of
   international status markers, while Zuma rarely did so during his
   tenure. The findings indicate that dynamic legitimation theory can offer
   insights on populist authoritarian regimes but is not without its
   limits.},
