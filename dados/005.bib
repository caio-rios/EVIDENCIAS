@article{ WOS:001512136900001,
Author = {Garritzmann, Julian L.},
Title = {From educational conflicts to an educational cleavage? The multiple
   transformations of educational conflicts from medieval to
   post-industrial times},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {3, SI},
Pages = {617-635},
Month = {APR 16},
Abstract = {Major socio-economic transformations can create new cleavages, altering
   politics forever. The crucial contemporary transformation is the shift
   towards post-industrial knowledge economies, placing education at the
   heart of politics. A prominent claim is that an `educational cleavage'
   has emerged. This article reflects these dynamics against the politics
   of education literature. It argues: while the emerging educational
   cleavage is indeed new, there has always been political conflict between
   educational groups. What changed is the political importance of this
   conflict and the groups it separates. Educational conflicts have
   transformed multiple times: in the Middle Ages, conflict was between
   unskilled labourers and craft artisans. As mass schooling expanded,
   conflict shifted towards those with and without formal schooling. As
   mass higher education spread, conflict transformed again. It is in this
   period that the potential for an educational cleavage emerges, as
   education fundamentally structures politics. As higher education reaches
   mass levels, a fourth transformation may happen.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
