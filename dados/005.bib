@article{ WOS:001536086200001,
Author = {Allam, Nermin},
Title = {The mahram effect: gender politics and Saudi Arabia},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {6},
Pages = {1211-1236},
Month = {AUG 18},
Abstract = {How do state-led reform, that are designed to maintain control or
   bolster legitimacy inadvertently democratize social structures, such as
   gender norms? Using the case of women recipients of King Abdullah
   Scholarship Programme in Saudi Arabia, the study investigates how women,
   situated in between activism and patronage, challenge the gender logic
   that underpin state reforms and introduce shifts in gender norms within
   their families. The study is situated within the literature on
   authoritarianism and social nonmovements, and uses data from interviews,
   formal reports, media coverage, and official statements. The analysis
   shows that while the mahram requirement, which mandated male
   guardianship for women's participation, aimed to control women and
   uphold traditional norms, it led to renegotiations of gender dynamics.
   The findings demonstrate how the unintended actions by subaltern groups
   and state-empowered intermediaries can drive incremental reforms under
   autocratic regimes. The article contributes to the scholarship on
   authoritarianism, gender reform, and democratization. It offers new
   insights into how state-led initiatives can produce unintended changes
   and transformations.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {2-4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXON, ENGLAND},
