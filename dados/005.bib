@article{ WOS:001507347900001,
Author = {Hierro, Maria Jose and Monteiro, Jose Pedro and Grigoriadis, Ioannis N.},
Title = {Struggling against spectres of the past: democratisation and
   nation-building in Southern Europe},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2025},
Volume = {30},
Number = {4, SI},
Pages = {535-560},
Month = {OCT 2},
Abstract = {We explore the nexus between democratisation and nation-building by
   examining the boundaries that delimit membership. We argue that
   democratisation transforms these boundaries by reinterpreting the
   political community, the demos, and ascriptiveness. We illustrate these
   transformations in three countries from the third wave of
   democratisation. Confronting its historical legacies, each country
   produced dissimilar outcomes: post-imperial exclusion (Portugal),
   piecemeal democratic inclusion (Greece), and disputed views on the
   nation's ascriptiveness (Spain). While transitions expand the nation's
   boundaries through political inclusion, democratisation might also
   narrow the demos and the nation's ascriptive foundations. Our study
   enriches our understanding of how democratisation transforms the nation.},
