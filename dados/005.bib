@article{ WOS:001543110900001,
Author = {Koch, Elias},
Title = {Opposition parties seek more conflict with the government when losing
   electoral support},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {5},
Pages = {1336-1354},
Month = {JUL 29},
Abstract = {Opposition parties benefit electorally from engaging in conflict with
   the government. However, it remains unclear whether they adjust their
   rhetoric towards the executive in response to changes in their public
   support. This study argues that opposition parties seek more conflict
   with the government when losing in election polls. It tests the
   hypothesis using an original dataset comprising all major German
   parties' interjections - adversarial interruptions of legislative speech
   - during debates in the 16 German state parliaments (1998-2019). Based
   on 664,011 interruptions during 250,555 government speeches, it shows
   that opposition parties increasingly seek conflict with the government
   when their polling performance declines. This relationship between
   opposition parties' rhetoric and their public approval is particularly
   strong when they are polling below their previous election results.
   These findings contribute to our understanding of how public opinion in
   general, and election polls in particular, affect conflict between
   opposition and government in representative democracies.},
