@article{ WOS:001519263300001,
Author = {Hartvigsen, Melanie Sofia and Yauri-Miranda, Jaseff Raziel},
Title = {Civil society organizations in intelligence accountability: democratic
   ideals and practical limitations},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {4},
Pages = {799-822},
Month = {MAY 19},
Abstract = {This study addresses a gap in Intelligence Studies by conducting an
   empirical investigation into how various civil society actors perceive
   their role in promoting accountability within the intelligence services.
   Applying the theoretical frameworks of democratic agonism and
   institutional logics, the study explores how civil society actors
   perceive their role in ensuring intelligence accountability and
   rationalize their contributions as potential enhancers of intelligence
   legitimacy. Through in-depth interviews with seven civil society
   organizations in Denmark (NGOs, labour unions, interest groups, and
   member-funded associations), the research analyses their values,
   beliefs, and institutional rules concerning intelligence accountability.
   The findings reveal a tension in which actors advocate for deeper
   democratic values and contestation, but adapt to existing institutional
   oversight practices, leading to an imbalance between their ideals and
   the limited impact of their actions. To explain this imbalance, we
   discuss the institutional and symbolic dimensions that influence the
   role of civil society, addressing institutional design, power imbalance,
   symbolic performativity, and imaginaries of security. Ultimately, this
   research contributes to ongoing debates on democratic accountability and
   suggests paths for studying and enhancing civil society's impact on
   intelligence accountability and policy-making processes.},
