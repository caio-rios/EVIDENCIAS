@article{ WOS:001588777200001,
Author = {Gendzwill, Adam and Mazur, Stanislaw},
Title = {Women's descriptive representation in multi-level political systems:
   (almost) no pyramids found},
Journal = {WEST EUROPEAN POLITICS},
Year = {2025},
Month = {2025 SEP 15},
Abstract = {While cross-national differences in female descriptive representation
   are well documented, less attention has been paid to variations in
   women's presence within decision-making assemblies across different
   tiers of government in multi-level political systems. This research note
   examines the patterns of women's political representation in 38 European
   countries at national, regional, and local levels. The findings
   challenge the widely accepted notion that local politics is more
   inclusive of women than higher levels of government. The representation
   of women in regional assemblies closely mirrors that in national
   parliaments. Thus, the `pyramid pattern' - characterised by relatively
   high female representation at the local level and systematically lower
   representation at regional and national levels - is found to be
   extremely rare.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
