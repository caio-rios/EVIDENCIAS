@article{ WOS:001554695800001,
Author = {Good, Mirco and Wasserfallen, Fabio},
Title = {Swiss Euroscepticism from a Comparative Perspective},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {1},
Pages = {36-55},
Month = {MAR},
Abstract = {The relation between Switzerland and the European Union (EU) has been
   strongly politicized for more than three decades, and Euroscepticism in
   Switzerland remains high compared to other countries. What explains this
   elevated level of Euroscepticism, and how do its drivers differ from
   those in other countries? Leveraging the recent inclusion of Switzerland
   in the Eurobarometer, we conduct a comparative analysis of Swiss public
   opinion on the EU. The empirical findings show that national identity
   and right-leaning views are much stronger predictors of Euroscepticism
   in Switzerland compared to other European countries. The only similar
   case is the United Kingdom (UK). Additional comparative analyses of
   non-EU countries highlight that public opinion is distinctively
   different in Switzerland and the UK compared to Iceland and Norway. The
   analysis sheds light on the interplay between institutional models of
   integration, politicization, and Euroscepticism in non-EU countries,
   with important implications for Swiss politics and Euroscepticism
   research.
   Die Beziehungen zwischen der Schweiz und der Europ \& auml;ischen Union
   (EU) sind seit \& uuml;ber drei Jahrzehnten stark politisiert, und
   Euroskeptizismus in der Schweiz ist im internationalen Vergleich hoch.
   Was erkl \& auml;rt den hohen Euroskeptizismus, und wie unterscheiden
   sich seine Ursachen von jenen in anderen L \& auml;ndern? Die Aufnahme
   der Schweiz in den Eurobarometer macht die vergleichende Analyse der \&
   ouml;ffentlichen Meinung zur EU m \& ouml;glich. Die Ergebnisse zeigen,
   dass nationale Identit \& auml;t und rechtsgerichtete politische
   Einstellungen in der Schweiz deutlich st \& auml;rkere Erkl \&
   auml;rungsfaktoren f \& uuml;r Euroskeptizismus sind als in anderen
   europ \& auml;ischen L \& auml;ndern. Einzig das Vereinigte K \&
   ouml;nigreich weist ein \& auml;hnliches Muster auf. Zus \& auml;tzliche
   vergleichende Analysen mit Nicht-EU-Staaten zeigen, dass sich die \&
   ouml;ffentliche Meinung in der Schweiz und im Vereinigten K \&
   ouml;nigreich deutlich von jener in Island und Norwegen unterscheidet.
   Die Analyse beleuchtet das Zusammenspiel von institutionellen
   Integrationsmodellen, Politisierung und Euroskeptizismus in
   Nicht-EU-Staaten und ist f \& uuml;r die Schweizer Politik und Forschung
   bedeutsam.
   Les relations entre la Suisse et l'Union europ \& eacute;enne (UE) sont
   fortement politis \& eacute;es depuis plus de trois d \& eacute;cennies,
   et l'euroscepticisme en Suisse reste \& eacute;lev \& eacute; compar \&
   eacute; \& agrave; d'autres pays. Qu'est-ce qui explique ce niveau \&
   eacute;lev \& eacute; d'euroscepticisme, et en quoi ses causes diff \&
   egrave;rent-elles de celles observ \& eacute;es ailleurs? Notre analyse
   comparative de l'opinion publique sur l'UE montre que l'identit \&
   eacute; nationale et les opinions politiques de droite sont des pr \&
   eacute;dicteurs nettement plus puissants de l'euroscepticisme en Suisse
   que dans les autres pays europ \& eacute;ens. Seul le Royaume-Uni pr \&
   eacute;sente une configuration comparable. La comparaison avec des pays
   non membres de l'UE r \& eacute;v \& egrave;le que l'opinion publique en
   Suisse et au Royaume-Uni diff \& egrave;re nettement de celle en Islande
   et en Norv \& egrave;ge. Ces r \& eacute;sultats \& eacute;clairent
   l'interaction entre les mod \& egrave;les institutionnels d'int \&
   eacute;gration, la politisation et l'euroscepticisme dans les pays hors
   UE, avec d'importantes implications pour la politique suisse et la
   recherche.
   Le relazioni tra la Svizzera e l'Unione Europea (UE) sono fortemente
   politicizzate da oltre trent'anni, e l'euroscetticismo in Svizzera
   rimane elevato rispetto ad altri paesi. Cosa spiega questo alto livello
   di euroscetticismo e in che modo le sue determinanti differiscono da
   quelle di altri paesi? Sfruttando la recente inclusione della Svizzera
   nell'Eurobarometro, abbiamo condotto un'analisi comparativa
   dell'opinione pubblica svizzera sull'UE. I risultati empirici mostrano
   che l'identit \& agrave; nazionale e le opinioni politiche di destra
   costituiscono fattori predittivi dell'euroscetticismo molto pi \&
   ugrave; forti in Svizzera rispetto ad altri paesi europei. L'unico caso
   simile \& egrave; il Regno Unito. Ulteriori confronti con paesi non
   membri dell'UE evidenziano che l'opinione pubblica in Svizzera e nel
   Regno Unito si distingue nettamente da quella in Islanda e Norvegia.
   L'analisi mette in luce l'interazione tra modelli istituzionali
   d'integrazione, politicizzazione e euroscetticismo nei paesi extra-UE,
   offrendo importanti spunti per la politica svizzera e la ricerca
   sull'euroscetticismo.},
