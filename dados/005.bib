@article{ WOS:001550426600001,
Author = {Makarchev, Nikita and Tao, Xin and Shliakov, Lurii and Xiao, Chunwen and
   Pedron, Stephanie and Yao, Bohao and Chinh Dang, Trung and Le, Duy Anh
   and Park, Albert Sanghoon},
Title = {Authoritarian indoctrination in Putin's Russia: evidence from higher
   education staff},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {4},
Pages = {851-875},
Month = {MAY 19},
Abstract = {What are the patterns and predictors of support for authoritarianism in
   authoritarian regimes? Existing studies address this question primarily
   in relation to broad authoritarian tendencies, authoritarian political
   systems and/or authoritarian leaders. Furthermore, they typically
   examine general populations and model support as a function of a single
   predictor category. This article, using a survey of Russian university
   employees, shifts the focus to support for authoritarian indoctrination
   in both its passive and active forms. In addition, it reconceptualizes
   support as an expression of diverse individual and organization-level
   psychological needs. Subsequently, this article finds that, although
   support for active and passive authoritarian indoctrination is modest,
   it is (a) associated with individual and organizational predictors; and
   (b) mediated by four types of psychological justifications (i.e.
   palliative, existential, relational and ideational) corresponding to
   coping with powerlessness, sustaining predictability and order,
   maintaining social belonging and reputational safety, and upholding
   perceived moral or ideological legitimacy. Theoretically, the above
   extends relevant research by demonstrating the value of a more nuanced
   and refined explanatory mechanism (i.e. multi-type system
   justification). Empirically, it also advances understandings of Russia's
