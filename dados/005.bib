@article{ WOS:001545101400001,
Author = {Wolak, Jennifer and Stapleton, Carey E.},
Title = {The Effects of Voting by Mail on Correct Voting},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Volume = {48},
Number = {3},
Pages = {1251-1268},
Month = {SEP},
Abstract = {The share of Americans voting by mail surged in 2020. For those casting
   a mail-in ballot, their voting experience was different from those who
   voted in-person. When voting by mail, people can make their choices at
   their own pace at a time convenient to them, conducting additional
   research if they wish to do so. We propose that when people vote by
   mail, they are more likely to successfully identify the candidates that
   are best aligned with their preferences. Using cross-sectional and
   causal inference approaches, we show that people who voted by mail in
   2020 were more likely to vote correctly than those who cast their
   ballots in-person. Vote-by-mail was more than just a way to minimize
   health risks during the coronavirus pandemic - it also had civic
   dividends. When people vote by mail, they are more likely to choose
   candidates aligned with their stated preferences.},
