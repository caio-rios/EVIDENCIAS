@article{ WOS:001556800700001,
Author = {Morris, Kevin T. and Shapiro, Ian},
Title = {On Fertile Ground: How Racial Resentment Primes White Americans To
   Believe Fraud Accusations},
Journal = {POLITICAL BEHAVIOR},
Year = {2025},
Month = {2025 AUG 26},
Abstract = {White Americans face a democratic dilemma: remain committed to electoral
   democracy (which has been historically beneficial for them), or abandon
   it as non-White groups gain political stature. We argue ``fraud{''}
   narratives offer White Americans a solution: they can reject specific
   democratic outcomes, while remaining committed to democracy as an ideal.
   We thus expect - and demonstrate - that fraud beliefs have a
   specifically racial valence. In three studies, we show that Black cities
   were at the epicenter of fraud dialogue on Twitter; that electoral
   confidence deteriorated most for racially-resentful Whites post-election
   in 2020; and, in a survey experiment, that racially resentful White
   Americans are especially likely to believe accusations of fraud when
