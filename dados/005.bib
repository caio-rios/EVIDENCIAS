@article{ WOS:001540202800001,
Author = {Ovadek, Michal},
Title = {Judicial diversity and immigration appeals: evidence from the United
   Kingdom},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {6},
Pages = {1586-1601},
Month = {SEP 19},
Abstract = {Almost all studies of judicial behaviour and diversity conceptualise
   judges' race and gender as independent, additive variables.
   Specifically, black and female judges are often seen as more liberal
   than their white and male counterparts. Literature on intersectionality
   suggests, however, that minority women face particularly challenging
   perceptions liable to induce stereotype-avoidance. This article tests
   this hypothesis using a novel dataset of over 30,000 single-judge
   rulings in the Immigration and Asylum Chamber of the Upper Tribunal in
   the United Kingdom. The results show, first, that outcomes of
   immigration appeals hinge significantly on the identity of the deciding
   judge. Second, minority women are likelier than white women or minority
   men to side with the government in such disputes. The findings
   demonstrate the relevance of examining intersecting attributes in
   judicial contexts and have implications for normative debates about
   judicial decision making and equality before the law.},
