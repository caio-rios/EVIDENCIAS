@article{ WOS:001583430700001,
Author = {Dall'Agnola, Jasmin},
Title = {From Old to New Colonial Dependencies: Public Perceptions of Chinese
   Surveillance Cameras in Central Asia},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {3, SI},
Pages = {450-467},
Month = {SEP},
Abstract = {While a growing body of literature examines the role of Chinese
   surveillance cameras in the technological rivalry between China and the
   US, relatively little is known about how publics in the Global South
   perceive and respond to the growing presence of these technologies in
   their communities. This research note seeks to address this gap through
   an empirical analysis of 105 individual and 40 focus group interviews
   conducted with the wider Russian-speaking urban public in Almaty
   (Kazakhstan), Bishkek (Kyrgyzstan), Dushanbe (Tajikistan), and Tashkent
   (Uzbekistan) in 2022. The study asks, how do urban Central Asians
   perceive Chinese surveillance cameras in public spaces? The analysis of
   the interview data, supplemented by recent opinion polling data from the
   Central Asia Barometer (2022), reveals that Central Asians' support for
   Chinese technologies is shaped by two colonial factors: the legacy of
   Soviet-era collectivism and state monitoring, and the region's growing
   economic and technological dependencies on China.
   Eine wachsende Zahl an Studien untersucht die Rolle chinesischer \&
   Uuml;berwachungskameras im technologischen Wettstreit zwischen China und
   den USA. Allerdings wissen wir relativ wenig dar \& uuml;ber, wie die \&
   Ouml;ffentlichkeit im Globalen S \& uuml;den die zunehmende Pr \&
   auml;senz dieser Technologien in ihren Gemeinschaften wahrnimmt. Durch
   die empirische Analyse von 105 Einzel- und 40 Fokusgruppeninterviews,
   die im Jahr 2022 mit der russischsprachigen Bev \& ouml;lkerung in
   Almaty (Kasachstan), Bischkek (Kirgisistan), Duschanbe (Tadschikistan)
   und Taschkent (Usbekistan) durchgef \& uuml;hrt wurden, versucht dieser
   Artikel, diese Wissensl \& uuml;cke zu schlie ss en indem er fragt, wie
   die urbane Bev \& ouml;lkerung Zentralasiens chinesische \&
   Uuml;berwachungskameras im \& ouml;ffentlichen Raum wahrnimmt. Die
   Auswertung der Interviewdaten sowie der j \& uuml;ngsten Ergebnisse des
   Central Asia Barometer (2022) verdeutlicht, dass zwei koloniale
   Einflussfaktoren die Akzeptanz chinesischer Technologien in Zentralasien
   bedingen: zum einen das Erbe des sowjetischen Kollektivismus und
   staatlicher \& Uuml;berwachung; zum anderen die zunehmende
   wirtschaftliche und technologische Abh \& auml;ngigkeit der Region von
   China.
   La litt \& eacute;rature scientifique sur le r \& ocirc;le des cam \&
   eacute;ras de surveillance chinoises dans la rivalit \& eacute;
   technologique entre la Chine et les \& Eacute;tats-Unis devient de plus
   en plus riche. En revanche, la perception de la pr \& eacute;sence de
   ces technologies au sein de la population du sud global n'a \& eacute;t
   \& eacute; que tr \& egrave;s peu \& eacute;tudi \& eacute;e. Cette note
   de recherche comble cette lacune en interrogeant comment les urbains
   d'Asie centrale per \& ccedil;oivent les cam \& eacute;ras de
   surveillance chinoises dans l'espace public. Il est empiriquement fond
   \& eacute;e sur 105 entretiens individuels et 40 entretiens de groupe r
   \& eacute;alis \& eacute;s en 2022 aupr \& egrave;s de la population
   russophone \& agrave; Almaty (Kazakhstan), Bichkek (Kirghizistan),
   Douchanb \& eacute; (Tadjikistan) et Tachkent (Ouzb \& eacute;kistan).
   L'analyse combin \& eacute;e des entretiens et des sondages d'opinion r
   \& eacute;cents du Central Asia Barometer (2022) montre que l'opinion
   public est influenc \& eacute;e par deux facteurs coloniaux: l'h \&
   eacute;ritage du collectivisme et de la surveillance \& eacute;tatique
   de l'\& eacute;poque sovi \& eacute;tique, ainsi que les d \&
   eacute;pendances \& eacute;conomiques et technologiques croissantes de
   la r \& eacute;gion vis-\& agrave;-vis de la Chine.
   Nonostante un numero crescente di studi esamini il ruolo delle
   telecamere di sorveglianza cinesi nel contesto della rivalit \& agrave;
   tecnologica tra la Cina e gli Stati Uniti, si sa relativamente poco
   riguardo alla percezione e alle reazioni delle popolazioni del Sud del
   mondo di fronte alla crescente presenza di queste tecnologie nelle loro
   comunit \& agrave;. Il presente articolo cerca di colmare questa lacuna
   attraverso un'analisi empirica di interviste (105 individuali e 40 in
   focus groups) condotte con la popolazione urbana russofona di Almaty
   (Kazakistan), Bishkek (Kirghizistan), Dushanbe (Tagikistan) e Tashkent
   (Uzbekistan) nel 2022. Lo studio si interroga su come i cittadini
   dell'Asia Centrale percepiscano le telecamere di sorveglianza cinesi
   negli spazi pubblici. L'analisi dei dati delle interviste, integrata dai
   dati dei recenti sondaggi di opinione del Central Asia Barometer (2022),
   rivela che il sostegno delle popolazioni dell'Asia Centrale per le
   tecnologie cinesi \& egrave; influenzato da due fattori di tipo
   coloniale: l'eredit \& agrave; del collettivismo e del monitoraggio
   statale dell'era sovietica, e la crescente dipendenza economica e
   tecnologica della regione dalla Cina.},
