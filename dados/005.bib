@article{ WOS:001564735100001,
Author = {Corrales, Javier and Diaz, Ricardo Jose Salas},
Title = {Intentional polarization: How policy extremism and ideological overuse
   promote democratic backsliding},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {7},
Pages = {1619-1645},
Month = {OCT 3},
Abstract = {Executives engaging in democratic backsliding often adopt extreme
   policies and ideologized discourses. We argue that this is intentional.
   The aim is to exacerbate polarization, which itself is intended to help
   backsliding Executives bolster electoral support for power grabs. We
   first discuss the logic behind intentional polarization. We then use
   qualitative analysis to show that when Executives use policy extremism
   and ideological discourse to induce polarization, they often prompt the
   opposition to radicalize, collapse, or fragment. Any of these opposition
   responses help Executives proceed with backsliding. We then zoom in on
   government ideologization. We use V-Dem data to show that ideologization
   is often followed by autocratization. We also work with the Democratic
   Erosion Event Dataset and the Database of Political Institutions to
   gauge the relationship between government ideologization, opposition
   weakness, and democratic erosion. Our main conclusion is that extreme
   policies and ideological overuse are intentionally pursued by
   backsliding Executives as a strategy to weaken the opposition. And when
   the later outcome obtains, backsliding tends to reach far.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
