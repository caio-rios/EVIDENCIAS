@article{ WOS:001493370300001,
Author = {Nasr, Mohamed and Reinl, Ann-Kathrin},
Title = {United in Difficult Times? Investigating Party Communication on EU
   Solidarity},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Volume = {43},
Number = {1},
Pages = {18-42},
Month = {JAN 2},
Abstract = {This paper presents an investigation into the positions of political
   parties on European Union (EU) solidarity, a topic that has been the
   subject of intense political and social debate over the past 15 years.
   While prior literature has primarily focused on the demand side,
   exploring public support for EU solidarity, the role of political
   parties in shaping this discourse has received little attention. Our
   study seeks to address this gap by examining the dynamics of party
   communication on EU solidarity during times of crisis and relative calm.
   Specifically, we explore two dimensions of solidarity communication:
   when parties emphasize solidarity (solidarity when) and which parties
   are more likely to do so (solidarity by whom). To this end, we analyze a
   unique dataset of party press releases collected over the past decade in
   six EU member states. Our findings suggest that the nature of a crisis
   (symmetric vs. asymmetric) as well as a party's incumbency status
   (government vs. opposition) and sociocultural ideology (GAL vs. TAN)
   play a critical role in shaping party communication on EU solidarity.
   These findings are relevant retrospectively in terms of understanding
   policy decisions taken, but also with an eye on a potential path toward
   a more social union.},
