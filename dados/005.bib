@article{ WOS:001558937300001,
Author = {Mochtak, Michal},
Title = {Authoritarianism rising as polls loom: the authoritarian election
   countdown effect},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {7},
Pages = {1451-1475},
Month = {OCT 3},
Abstract = {This article examines how the perceived threat of electoral competition
   influences political parties to adopt more authoritarian rhetoric,
   potentially undermining democratic norms. Using Karen Stenner's theory
   of the authoritarian dynamic, the study analyses 30 years of
   parliamentary debates in Slovakia to assess whether electoral pressures
   increase authoritarian discourse among parliamentarians. The analysis
   focuses on two forms of threat: the proximity of elections and the
   impact of change of voter support as indicated by polling data. The
   findings reveal that the perceived threat drives parties to engage more
   in authoritarian discourse as elections approach. Similarly, declining
   poll numbers trigger a shift towards authoritarian language, while
   improved polling results reduce such rhetoric. This strategic adaptation
   highlights how the fear of losing power shapes party communication. The
   study suggests that by heightening a sense of threat, electoral
   competition can alter democratic discourse over time, incentivising
   authoritarian tendencies and potentially challenging the stability of
   democratic norms in the long run.},
