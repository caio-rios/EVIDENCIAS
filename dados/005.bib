@article{ WOS:001517298700001,
Author = {Alon-Barkat, Saar and Gilad, Sharon and Kosti, Nir and Shpaizman, Ilana},
Title = {Career Civil Servants' Socially Embedded Responses to Democratic
   Backsliding},
Journal = {PERSPECTIVES ON POLITICS},
Year = {2025},
Month = {2025 JUN 26},
Abstract = {Recent studies portray civil servants as potential guardians against
   populist attempts to undermine liberal democracy. However in polarized
   societies, bureaucrats, like citizens, tend to hold divergent
   perceptions of the threat that politicians' actions pose to democracy.
   This, in turn, likely shapes bureaucrats' responses. We examine this in
   the context of the attempt by Israel's extreme right-wing populist
   government to curtail the powers and independence of the Israeli Supreme
   Court and replace legal advisors with political appointees (hereafter
   the ``legal overhaul{''}). We employ a mixed-methods design, combining a
   survey, interviews, and a focus group with career civil servants,
   showing that those who perceive the legal overhaul as a threat to
   democracy are more inclined to exit government and less likely to voice
   and exert effort at work. These findings are attributed to respondents'
   views of the legal overhaul as leading to future politicization,
   curtailed influence, and a threat to their role as civil servants.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
