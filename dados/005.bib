@article{ WOS:001525959900001,
Author = {Wu, Ziyi},
Title = {Outsiders in the Media: How a Sense of ``Foreignness{''} Shapes Support
   for Censorship in China},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Volume = {43},
Number = {1},
Pages = {65-88},
Month = {JAN 2},
Abstract = {This paper investigates how a historical ``us versus them{''} mentality
   fuels Chinese citizens' support for government censorship. Cues of
   foreignness foster alienation from the sender and support for censorship
   by signaling that the message comes from out-group deviants. I conducted
   online survey experiments and found that explicit cues (IP addresses)
   significantly boost support for censorship, while implicit cues
   (language) have a weaker effect. Both types of cues make respondents
   more likely to label the sender a foreigner or a Chinese national prone
   to foreign manipulation. Study participants with stronger nationalist
   sentiments and system justification tendencies were more responsive to
   both cues, whereas pro-Western-democracy attitudes only mitigated the
   impact of foreign languages. I observed these moderation effects
   primarily for less politically sensitive topics.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
