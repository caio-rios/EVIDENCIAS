@article{ WOS:001501324100001,
Author = {Kumah-Abiwu, Felix},
Title = {Three decades of democratic rule in Ghana: progress, perils and promises
   of the Fourth Republic},
Journal = {DEMOCRATIZATION},
Year = {2026},
Volume = {33},
Number = {4},
Pages = {729-750},
Month = {MAY 19},
Abstract = {Ghana celebrated three decades of democratic rule in 2023 with mixed
   results of the country's state of democratic consolidation. For many
   scholars, three decades of a sustained Fourth Republic is not only
   distinctive in terms of the country's democratic gains, but the three
   decades have been the longest republic in Ghana's political history.
   Gains such as regular competitive multiparty elections, strengthening of
   state institutions, rule of law, vibrant media, and strong civil society
   groups deserve to be underscored. For other experts, however, the
   condition of Ghana's democracy appears to have hit a plateau or is
   backsliding. To better understand the dynamics of the condition of
   Ghana's democracy after three decades of experimentation, the article
   draws on theoretical ideas and critical discourses on democratic
   stagnation with works from the literature for the analysis. The article
   asserts that these conceptual ideas provide utility in understanding the
   current state or condition of Ghana's democracy. Further, it argues that
   the inability of the political class to balance their familiarity with
   the country's democratic values with the growing demands for
   constitutional reforms, appear to be affecting the country's democratic
   progress.},
