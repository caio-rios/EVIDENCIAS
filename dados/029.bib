   van Haute, Emilie, Univ Libre Bruxelles, Dept Polit Sci, Brussels, Belgium.
   Deschouwer, Kris, Vrije Univ Brussel, Dept Polit Sci, Brussels, Belgium.},
DOI = {10.1080/01402382.2017.1399320},
ISSN = {0140-2382},
EISSN = {1743-9655},
Keywords = {Representation; congruence; federalism; Belgium},
Keywords-Plus = {GOVERNMENT FORMATION; IDEOLOGICAL CONGRUENCE; MULTILEVEL SETTINGS;
   POLICY; DEMOCRACIES; PARTIES; RULES; SALIENCE; VOTERS},
