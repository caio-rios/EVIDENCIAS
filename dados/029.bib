@article{ WOS:000418267500019,
Author = {Sances, Michael W.},
Title = {Attribution Errors in Federalist Systems: When Voters Punish the
   President for Local Tax Increases},
Journal = {JOURNAL OF POLITICS},
Year = {2017},
Volume = {79},
Number = {4},
Pages = {1286-1301},
Month = {OCT},
Abstract = {How do voters attribute blame when policy responsibility is shared?
   While central to accountability, this question is difficult to answer
   because ``who does what{''} is often ambiguous. This article exploits a
   case where policy responsibility is unambiguous: local tax referendums.
   Although presidents have no control over property taxes or the decision
   to raise local rates, I find that voters punish the president's party
   for tax increases enacted via direct democracy. This effect is robust to
   adjusting for population-based measures of the local economy, as well as
   panel and discontinuity designs to account for unobserved factors. The
   effect varies with the magnitude of the tax increase but not with local
   economic performance, suggesting that voters react to the change in
   spending money, as opposed to being ``primed{''} to consider national
   issues. Thus, voters punish officials not only for events that no one
   controls but also for policies that voters themselves enact.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
