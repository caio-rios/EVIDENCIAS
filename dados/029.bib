@article{ WOS:000406600600006,
Author = {Maltby, Elizabeth},
Title = {The Political Origins of Racial Inequality},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2017},
Volume = {70},
Number = {3},
Pages = {535-548},
Month = {SEP},
Abstract = {Policy feedback theory argues that public policies shape mass political
   behavior by teaching citizens about their relationship to government. I
   reevaluate this argument by examining how criminal justice policy shapes
   the political orientations and participation of blacks and whites. I
   argue that, because these policies send different messages to blacks
   than to whites about the treatment they can expect from government,
   these groups have opposite reactions to criminal justice enforcement.
   Using data from a 2014 national survey and information on local criminal
   justice outcomes, I find that racially skewed criminal justice
   enforcement is associated with negative political orientations and lower
   rates of political participation for highly educated blacks. I also find
   that whites respond positively to similar criminal justice outcomes when
   they reside in areas with large black populations. The results show that
   unequal policy outcomes lead to political inequality.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
