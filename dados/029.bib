@article{ WOS:000409846300002,
Author = {Liberman, Peter and Skitka, Linda J.},
Title = {REVENGE IN US PUBLIC SUPPORT FOR WAR AGAINST IRAQ},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2017},
Volume = {81},
Number = {3},
Pages = {636-660},
Month = {FAL},
Abstract = {To better understand how desires to avenge the September 11 terror
   attacks affected US public support for the 2003 Iraq War, we integrate
   data from two uncoordinated surveys-one measuring revenge motivations
   and the other beliefs about Iraqi complicity-completed by overlapping
   samples drawn from the same online panel. Citizens who mistakenly blamed
   Iraq for 9/11 were more likely to say that going to war would satisfy
   their desires for revenge, which in turn predicted greater war support,
   controlling for political orientations and the perceived security
   incentives and costs of war. But a substantial proportion of those who
   said Iraq was not involved in 9/11 also expected war to satisfy desires
   for revenge, suggesting that a revenge ``spillover{''} effect also
   contributed to war support. These findings help explain how President
   George W. Bush was able to bring the nation to war against Iraq, testify
   to the importance of emotion and moral motivation in public opinion, and
   demonstrate the utility of integrating data from independent online
   panel surveys.},
Publisher = {OXFORD UNIV PRESS},
Address = {GREAT CLARENDON ST, OXFORD OX2 6DP, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Liberman, P (Corresponding Author), Queens Coll, Dept Polit Sci, Queens, NY 11367 USA.
   Liberman, Peter, CUNY Queens Coll, Polit Sci, New York, NY USA.
   Liberman, Peter, CUNY, Grad Ctr, New York, NY USA.
   Skitka, Linda J., Univ Illinois, Psychol, Chicago, IL USA.},
DOI = {10.1093/poq/nfx005},
ISSN = {0033-362X},
EISSN = {1537-5331},
Keywords-Plus = {PUNISHMENT; OSAMA; CONSEQUENCES; ATTRIBUTIONS; ATTRITION; EMOTIONS;
