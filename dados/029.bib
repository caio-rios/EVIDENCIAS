@article{ WOS:000405101900013,
Author = {Halpin, Darren R. and Fraussen, Bert},
Title = {Conceptualising the policy engagement of interest groups: Involvement,
   access and prominence},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2017},
Volume = {56},
Number = {3},
Pages = {723-732},
Month = {AUG},
Abstract = {While much progress has been made in empirically mapping and analysing a
   variety of interest group activities in the last decade, less attention
   has been devoted to conceptual work that clearly defines and
   distinguishes different forms of policy engagement. This article
   contributes to this endeavour by developing a theoretical framework that
   explicitly links currently available measures of the policy engagement
   of groups to the distinct concepts of group involvement, access and
   prominence. It argues that greater conceptual clarity will lead to
   better accumulation of knowledge in the sub-field and a better
   understanding of the role of interest groups in political systems.},
