@article{ WOS:000933153100001,
Author = {Milic, Thomas},
Title = {Der Effekt des Haushalts auf die Beteiligungsdisposition},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2023},
Volume = {29},
Number = {2},
Pages = {223-245},
Month = {JUN},
Abstract = {The influence of the primary environment on the willingness to
   participate in elections or votes is undisputed. However, previous
   research on this was mainly based on experimental or survey data that
   exhibit systematic measurement errors (overreporting) or refer only to
   individual election dates. The aim of this study is therefore to obtain
   a more precise estimate of the household's basic participation
   disposition that is unbiased by random or systematic errors. This is
   possible thanks to official complete survey data on 18 different ballots
   in about a dozen St. Gallen municipalities. The corresponding analysis
   shows that the lion's share of individual willingness to participate
   varies at the household level.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Milic, T (Corresponding Author), Liechtenstein Inst, St Luziweg 2, LI-9487 Gamprin, Bendern, Liechtenstein.
   Milic, Thomas, Liechtenstein Inst, St Luziweg 2, LI-9487 Gamprin, Bendern, Liechtenstein.},
DOI = {10.1111/spsr.12556},
EarlyAccessDate = {FEB 2023},
ISSN = {1424-7755},
EISSN = {1662-6370},
Keywords = {participation; multi-level analysis; household; register data},
Keywords-Plus = {VOTER TURNOUT; SOCIAL PRESSURE; PARTICIPATION; PERSPECTIVE; HOUSEHOLD;
