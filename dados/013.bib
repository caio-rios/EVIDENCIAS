   Park, Baekkwan, Univ Missouri, Truman Sch Govt \& Publ Affairs, 615 Locust St, Columbia, MO 65201 USA.},
DOI = {10.1007/s11109-023-09856-z},
EarlyAccessDate = {JAN 2023},
ISSN = {0190-9320},
