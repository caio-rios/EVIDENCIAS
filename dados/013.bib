@article{ WOS:000893709700001,
Author = {Cowley, Philip and Umit, Resul},
Title = {Legislator Dissent Does Not Affect Electoral Outcomes},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2023},
Volume = {53},
Number = {2},
Pages = {789-795},
Month = {APR},
Abstract = {Are there electoral consequences or benefits for legislators who deviate
   from the party line? We answer this question with data from
   individual-level vote choice and constituency-level electoral results in
   the UK for the last two decades. Exploring the variations in voting
   patterns over time with a panel-regression approach, we find results
   that are most compatible with the null hypothesis, that is, that dissent
   by legislators is neither rewarded nor punished in elections. These
   results call into question the degree to which voters know and/or care
   about legislative dissent in parliament.},
