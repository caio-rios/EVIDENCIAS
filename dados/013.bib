@article{ WOS:000884171800001,
Author = {Ruth-Lovell, Saskia Pauline and Grahn, Sandra},
Title = {Threat or corrective to democracy? The relationship between populism and
   different models of democracy},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2023},
Volume = {62},
Number = {3},
Pages = {677-698},
Month = {AUG},
Abstract = {The phenomenon of populism and its relationship with modern democracy
   has gained considerable attention in recent years. This article aims at
   advancing our understanding of how populism affects different models of
   democracy and tests the proposed arguments empirically. Building on a
   large scholarly literature on populism and democracy, we take stock of
   existing arguments and theorize which democratic models may be affected
   by populism in a positive or negative way. Moreover, we move beyond the
   normative debate and analyse the effect of populism in power on
   different models of democracy empirically. We do so by merging data on
   populist governments in Europe and Latin America from 1995 until today
   with the Varieties of Democracy dataset, which enables us to capture the
   relationship between populism and different democratic models in these
   regions. Despite mixed-theoretical expectations, our results suggest a
   rather negative impact of populism on the electoral, liberal and
   deliberative models of democracy.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
Type = {Article},
Language = {English},
Affiliation = {Ruth-Lovell, SP (Corresponding Author), Radboud Univ Nijmegen, Dept Polit Sci, Postbus 9108, NL-6500 HK Nijmegen, Netherlands.
