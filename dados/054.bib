@article{ WOS:000221666800001,
Author = {Benedicto, J},
Title = {Cultural structures and political life: The cultural matrix of democracy
   in Spain},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2004},
Volume = {43},
Number = {3},
Pages = {287-307},
Month = {MAY},
Abstract = {This article seeks to show empirically the importance of cultural
   aspects in the understanding of political events and the impact of
   cultural structures on the development of political life in contemporary
   societies. It uses as a case study the democratization process that has
   been taking place in Spain for the last 25 years. The Spanish case is
   especially interesting because of the powerful cultural framework
   established around the process of transition to democracy; a framework
   from which most political symbols and meanings of the new Spanish
   democracy emanate. After analyzing the basic categories of this cultural
   structure and the main consequences for the functioning of political
   life, the article goes on to argue that these cultural elements have
   shaped a special relationship between citizens and politics.},
