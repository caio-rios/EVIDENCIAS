@article{ WOS:000186127500015,
Author = {Hetherington, MJ and Larson, B and Globetti, S},
Title = {The redistricting cycle and strategic candidate decisions in US house
   races},
Journal = {JOURNAL OF POLITICS},
Year = {2003},
Volume = {65},
Number = {4},
Pages = {1221-1234},
Month = {NOV},
Note = {Annual Meeting of the American-Political-Science-Association,
   WASHINGTON, D.C., AUG 31-SEP 03, 2000},
Organization = {Amer Polit Sci Assoc},
Abstract = {We examine the impact of the ten-year redistricting cycle on strategic
   candidate behavior. First, we provide evidence that strategic candidate
   behavior is a function of an election's temporal proximity to a
   redistricting year, finding that quality challengers are less likely to
   emerge as the redistricting cycle progresses. Next, we show that
   strategic candidates interpret national and local political conditions
   through the lens of time. Specifically, national political conditions
   greatly encourage quality challengers early in the redistricting cycle
   but play a much reduced role later. In addition, incumbents who
   demonstrate moderate electoral vulnerability in the prior election are
   more likely to face quality challengers toward the beginning of the
   redistricting cycle than the end.},
Publisher = {BLACKWELL PUBLISHERS},
Address = {350 MAIN STREET, STE 6, MALDEN, MA 02148 USA},
Type = {Article; Proceedings Paper},
Language = {English},
Affiliation = {Hetherington, MJ (Corresponding Author), Bowdoin Coll, Brunswick, ME 04011 USA.
   Bowdoin Coll, Brunswick, ME 04011 USA.
   Fairleigh Dickinson Univ, Madison, NJ 07940 USA.},
DOI = {10.1111/1468-2508.t01-1-00134},
ISSN = {0022-3816},
Keywords-Plus = {STATES-SENATE ELECTIONS; CHALLENGER QUALITY; OF-REPRESENTATIVES;
   POLITICIANS; COMPETITION; INCUMBENCY},
Research-Areas = {Government \& Law},
