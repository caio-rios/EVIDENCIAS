@article{ WOS:000222401800006,
Author = {Widfeldt, A},
Title = {Elite collusion and public defiance: Sweden's Euro Referendum in 2003},
Journal = {WEST EUROPEAN POLITICS},
Year = {2004},
Volume = {27},
Number = {3},
Pages = {503-517},
Month = {MAY},
Abstract = {In a referendum held on Sunday, 14 September 2003, the Swedish
   electorate rejected membership of the third stage of the Economic and
   Monetary Union (EMU). After a campaign characterised as heated by
   Swedish standards, and the murder of Foreign Minister Anna Lindh, the
   referendum delivered a clear `No' majority. In this article, it is
   argued that while the 2003 EMU referendum may not have compromised the
   use of referendums as an occasional complement to representative
   democracy, it did indicate a substantial gap between citizens and the
   political elite.},
