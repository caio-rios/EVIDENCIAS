@article{ WOS:000221007100003,
Author = {Negash, G},
Title = {Art invoked: A mode of understanding and shaping the political},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2004},
Volume = {25},
Number = {2},
Pages = {185-201},
Month = {APR},
Note = {Symposium on Politics and the Arts - Making Connections in Theory and
   Praxis, Finnish Inst, Berlin, GERMANY, MAY 23-25, 2002},
Organization = {Polit \& Arts Grp},
Abstract = {There are several reasons why the arts, in all their forms and
   productions, provide a site from where we can observe and experience
   aspects of political life that we cannot possibly do in any other way
   First, art takes account of the intentions, motivations, and reasons for
   human action. Second, art is a privileged medium in the sense that it
   imparts knowledge about political life at both the abstract level and at
   a deeper Cultural level. Third, literary and other texts provide the
   site for political discourse because they are influenced by historical
   circumstances both temporally and spatially. Lastly, we seek the
   perspectives of art in informing politics because of the innovative role
   played by intellectuals and artists and their influence in the making of
   shared meanings. While this investigation is primarily theoretical, it
   will he informed by the novels of Biyi Bandele and the films of Gaston
   Kabore.},
