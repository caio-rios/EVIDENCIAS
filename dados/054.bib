   Yale Univ, Dept Polit Sci, New Haven, CT 06520 USA.},
DOI = {10.1111/1540-5907.00047},
ISSN = {0092-5853},
Keywords-Plus = {SYSTEM; GOVERNMENT; POLITICS; STATES; INSTITUTIONS; FACTIONS; POLICY;
