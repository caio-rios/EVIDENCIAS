@article{ WOS:000222401800003,
Author = {Safran, W},
Title = {Ethnoreligious politics in France: Jews and Muslims},
Journal = {WEST EUROPEAN POLITICS},
Year = {2004},
Volume = {27},
Number = {3},
Pages = {423-451},
Month = {MAY},
Note = {Annual Meeting of the American-Political-Science-Association,
   Philadelphia, PA, AUG 27-SEP 01, 2003},
Organization = {Amer Polit Sci Assoc},
Abstract = {This article focuses on the relationship between the two major
   ethnoreligious communities-the Jews and the Muslims-and the state in
   France, as reflected in lobbying, electoral behaviour, and public
   policies. It shows how the evolution of that relationship, an aspect of
   the politics of ethnicity, religion and multiculturalism, has been both
   a cause and a consequence of modifications in approaches to secularism,
   communitarianism and affirmative action. Finally, it deals with the
   question to what extent this development corresponds to a pluralist or
   corporatist model of politics and argues that changes in the
   relationship between state and society suggest an evolving
   accommodationist pattern increasingly similar to that of the United
   States.},
