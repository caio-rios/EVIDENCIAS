@article{ WOS:000188466700006,
Author = {Knutsen, O},
Title = {Religious denomination and party choice in western europe: a comparative
   longitudinal study from eight countries, 1970-97},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2004},
Volume = {25},
Number = {1},
Pages = {97-128},
Month = {JAN},
Abstract = {In this article, the impact of religious denomination on party choice is
   studied in eight western European countries from the early 1970s to the
   late 1990s. The research problems are (1) to examine the strength of the
   correlation between party choice and religious denomination over time,
   and (2) to analyze which political parties those who are affiliated and
   those who are unaffiliated to a religious community vote for, and how
   this has changed over time. The denominational cleavage varies
   considerably in strength in the eight countries. It is strongest in the
   Catholic and religiously mixed countries of Continental Europe. There is
   stability in the correlation between party choice and religious
   denomination in most countries. The main polarization involves, to a
   large degree, voters for parties on the left versus voters for parties
   on the right. It varies considerably, however, as to which parties on
   the left and the right have voters who contribute comparatively to
   polarization. Green parties are making inroads among the unaffiliated
   sections of the population. This changes the polarization caused by
   religious denomination in the sense that denominational differences
   become smaller for some other parties, first and foremost, the socialist
   and the communist parties.},
