@article{ WOS:000185842500002,
Author = {Bonoli, G},
Title = {Social policy through labor markets - Understanding national differences
   in the provision of economic security to wage earners},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2003},
Volume = {36},
Number = {9},
Pages = {1007-1030},
Month = {NOV},
Note = {13th Annual Meeting of the
   Society-for-the-Advancement-of-Socio-Economics, AMSTERDAM, NETHERLANDS,
   JUN 28-30, 2001},
Organization = {Soc Advancement Socio-Econ},
Abstract = {Recent work in comparative political economy has emphasized the
   existence of functional equivalents to the welfare state in the area of
   labor market policy. In many European countries, in Australia, and in
   New Zealand, labor laws, minimum wages, and collective agreements have
   traditionally played an important role in guaranteeing a certain level
   of economic security for workers and their families. This article tries
   to explain why different countries have developed different instruments
   for providing economic security to wage earners. It compares labor
   legislation and practices across several European countries and focuses
   on the detailed trajectory of France, Germany, and the United Kingdom.
   It finds that state-society relationships and ideological influences at
   key historical moments can help understand the original divergence,
   which is perpetuated through a typical path-dependent development.},
Publisher = {SAGE PUBLICATIONS INC},
