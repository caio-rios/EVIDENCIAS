@article{ WOS:000220922500004,
Author = {Mason, A},
Title = {Just constraints},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2004},
Volume = {34},
Number = {2},
Pages = {251-268},
Month = {APR},
Abstract = {Political theorists disagree about the extent to which issues of
   feasibility, stability, institutional design and human nature can be
   bracketed in analysing the concept of justice. At one end of the
   spectrum some argue that no analysis of justice can be adequate in the
   absence of an account of how it could be implemented, whereas at the
   other end there are those who argue that principles of justice are
   logically independent of issues of feasibility. Influenced by the work
   of John Rawls, many theorists occupy the middle ground, maintaining that
   analyses of justice must be realistic, that is, realizable under the
   best of foreseeable conditions. Against Rawls and others, this article
   argues that feasibility does not constrain what can count as an adequate
   principle of justice but nevertheless maintains that there are limits on
   such principles that derive in part from human nature, which divergent
   theories of justice must respect. It also distinguishes between
   different levels of analysis, some of which are governed by feasibility
   constraints.},
