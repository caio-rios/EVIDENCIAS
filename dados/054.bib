@article{ WOS:000220174500004,
Author = {Kanner, MD},
Title = {Framing and the role of the second actor: An application of prospect
   theory to bargaining},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2004},
Volume = {25},
Number = {2},
Pages = {213-239},
Month = {APR},
Abstract = {An actor's frame of reference significantly affects that actor's risk
   attitude. Although the frame of reference is often taken as a given,
   earlier work shows it to be the result of an actor's assumptions and
   beliefs, which can be manipulated by a second actor in a bargaining
   situation. As modeled here, confidence in selected assumptions can be
   manipulated by one of two means: changing the confidence of the actor
   about the future domain, and getting the actor to adopt a particular
   domain by discounting the utility of a course of action. Both methods
   force a change in the perceived domain and a shift in risk attitude. In
   addition to showing manipulation of an actor's frame, the model adds to
   our understanding of Kahneman and Tversky's original expression of
   prospect theory.},
Publisher = {BLACKWELL PUBLISHERS},
Address = {350 MAIN STREET, STE 6, MALDEN, MA 02148 USA},
Type = {Article},
Language = {English},
Affiliation = {Kanner, MD (Corresponding Author), Univ Colorado, Dept Polit Sci, Campus Box 333, Boulder, CO 80309 USA.
   Univ Colorado, Dept Polit Sci, Boulder, CO 80309 USA.},
DOI = {10.1111/j.1467-9221.2004.00369.x},
ISSN = {0162-895X},
Keywords = {bargaining; negotiations; framing; prospect theory},
Keywords-Plus = {INTERNATIONAL-RELATIONS; CHOICE; RISK; DECISIONS},
Research-Areas = {Government \& Law; Psychology},
