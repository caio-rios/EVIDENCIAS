@article{ WOS:000186961800002,
Author = {Golosov, GV},
Title = {The vicious circle of party underdevelopment in Russia: The regional
   connection},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2003},
Volume = {24},
Number = {4},
Pages = {427-443},
Month = {OCT},
Abstract = {This article explores the region-level impediments to the process of
   party formation in Russia during 1993-2002. The design of Russia's
   national electoral system produces parties because they are entitled to
   contest the proportional part of legislative elections. Once produced in
   this way, parties are motivated to penetrate into the regions. However,
   the article empirically demonstrates that the parties' attempts to
   penetrate the peripheries of the country have failed throughout the
   period. Region-level factors that impede the process of party formation
   include the dominant modes of separation of power, electoral systems,
   and the patterns of intra-elite conflict in the regions. In turn, the
   lack of territorial penetration makes national political parties
   unsustainable.},
Publisher = {SAGE PUBLICATIONS LTD},
Address = {6 BONHILL STREET, LONDON EC2A 4PU, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Golosov, GV (Corresponding Author), European Univ, Fac Social Sci \& Sociol, Gagarinskaya 3, St Petersburg, Russia.
   European Univ, Fac Social Sci \& Sociol, St Petersburg, Russia.},
DOI = {10.1177/01925121030244002},
ISSN = {0192-5121},
Keywords = {elections; political parties; regions; Russia},
Keywords-Plus = {ELECTIONS; EVOLUTION; ELITES},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
