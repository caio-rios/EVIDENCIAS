@article{ WOS:000186127500010,
Author = {Bali, VA},
Title = {Implementing popular initiatives: What matters for compliance?},
Journal = {JOURNAL OF POLITICS},
Year = {2003},
Volume = {65},
Number = {4},
Pages = {1130-1146},
Month = {NOV},
Abstract = {The purpose of this research is to understand what matters for
   compliance with a popular initiative. While scholars of policy
   implementation have identified many factors that play a role in
   explaining compliance with a new law, these explanatory variables have
   not been collectively tested, in particular, in the context of the
   initiative process. Focusing on an initiative in education, I examine
   compliance with California's Proposition 227 that aimed to dismantle
   bilingual programs for English learners in the state's public schools.
   The analysis confirms earlier research that the preferences of the
   agents of implementation are key to explain compliance, but other
   factors emerge as equally important. In particular, voter preferences,
   local demographics, and institutional capacity can also shape the level
   of implementation of an initiative. Since many local factors are jointly
   needed to understand implementation, full compliance with an initiative
   may be difficult to achieve.},
Publisher = {BLACKWELL PUBLISHERS},
