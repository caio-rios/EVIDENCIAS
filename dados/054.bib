@article{ WOS:000188228400010,
Author = {Jelen, TG and Wilcox, C},
Title = {Causes and consequences of public attitudes toward abortion: A review
   and research agenda},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2003},
Volume = {56},
Number = {4},
Pages = {489-500},
Month = {DEC},
Note = {Annual Meeting of the Western-Political-Science-Association, LONG BEACH,
   CA, MAR 22-24, 2002},
Organization = {Western Polit Sci Assoc},
Abstract = {This article provides a critical review of empirical research on
   attitudes toward abortion among mass publics in the United States, with
   a view toward suggesting promising avenues for future research. We
   identify three such themes: Accounting for pro-life movement among mass
   attitudes in recent years, when the composition of the U.S. population
   would seem to trend in a pro-choice direction; explaining the sources of
   party polarization of the abortion issue; and anticipating changes in
   abortion attitudes which might result from public debate over human
   cloning.},
