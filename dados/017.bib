@article{ WOS:000705031300001,
Author = {Bartels, Brandon L. and Horowitz, Jeremy and Kramon, Eric},
Title = {Can Democratic Principles Protect High Courts from Partisan Backlash?
   Public Reactions to the Kenyan Supreme Court's Role in the 2017 Election
   Crisis},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2023},
Volume = {67},
Number = {3},
Pages = {790-807},
Month = {JUL},
Abstract = {Public support is central to the emergence of judicial power.
   Conventional wisdom holds that citizen commitment to democracy and the
   rule of law sustains this support. An implication is that such
   commitments should protect courts from partisan backlash following
   contentious rulings. But this remains largely untested. The Kenyan
   Supreme Court's historic 2017 elections rulings provide an unusual
   opportunity to test this expectation. After annulling the incumbent
   president's victory, the Court upheld his controversial repeat-election
   win. With data from a national panel survey-conducted before and after
   the repeat election-we find important partisan-based
   withdrawals/increases in judicial-power support. There is no evidence
   that democratic principles attenuated partisan backlash; some were
   associated with its amplification. However, partisan losers maintain
   moderately high support despite backlash. Results advance debates about
   public support for judicial power and provide new evidence about public
   reactions to assertions of judicial authority in new democracies and
   electoral autocratic regimes.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Bartels, BL (Corresponding Author), George Washington Univ, Dept Polit Sci, 2115 G St NW,Suite 440, Washington, DC 20052 USA.
