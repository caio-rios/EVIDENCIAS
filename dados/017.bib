   Kramon, Eric, George Washington Univ, Elliott Sch Int Affairs, 2115 G St NW,Suite 440, Washington, DC 20052 USA.},
DOI = {10.1111/ajps.12666},
EarlyAccessDate = {OCT 2021},
ISSN = {0092-5853},
EISSN = {1540-5907},
Keywords-Plus = {INSTITUTIONAL LEGITIMACY; JUDICIAL RELATIONS; ACCEPTANCE; SUPPORT;
   POLARIZATION; JUSTICE; RULE},
Research-Areas = {Government \& Law},
