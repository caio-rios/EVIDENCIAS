   Harden, Jeffrey J., Univ Colorado, Dept Polit Sci, Boulder, CO 80309 USA.
   Boehmke, Frederick J., Univ Iowa, Dept Polit Sci, Iowa City, IA 52242 USA.
   Boehmke, Frederick J., Univ Iowa, Publ Policy Ctr, Social Sci Program, Iowa City, IA 52242 USA.},
DOI = {10.1017/S0003055415000040},
