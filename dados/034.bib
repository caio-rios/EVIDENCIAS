@article{ WOS:000360238600011,
Author = {Hennings, Valerie M. and Urbatsch, R.},
Title = {There Can Be Only One (Woman on the Ticket): Gender in Candidate
   Nominations},
Journal = {POLITICAL BEHAVIOR},
Year = {2015},
Volume = {37},
Number = {3},
Pages = {749-766},
Month = {SEP},
Abstract = {Party elites and voters are reluctant to cede multiple ballot positions
   to women simultaneously, so that men are able to have running mates of
   either gender but women tend to have male running mates. Evidence from
   American gubernatorial elections, state legislative caucuses, and
   presidential tickets from around the world confirms this: nominating a
   woman for the top position reduces a party's likelihood of nominating a
   woman for the second position by half or more.},
