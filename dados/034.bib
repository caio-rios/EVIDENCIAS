@article{ WOS:000360454200001,
Author = {Hochschild, Jennifer and Einstein, Katherine Levine},
Title = {`It Isn't What We Don't Know that Gives Us Trouble, It's What We Know
   that Ain't So': Misinformation and Democratic Politics},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2015},
Volume = {45},
Number = {3},
Pages = {467-475},
Month = {JUL},
Abstract = {This article explores the dangers to the quality of democratic
   governance of those who are informed but disengaged and, especially,
   those who are engaged but use false `knowledge'. Poll data show the
   extent of Americans' misinformation about, or disengagement with,
   climate change. The main responsibility for these problems lies with
   politicians, who have partisan incentives to help the disengaged become
   active, but also partisan incentives to keep the misinformed politically
   involved. Activity in accord with false `knowledge' can slow needed
   responses to global warming and lead to concrete harm to individuals,
   communities and nations.},
Publisher = {CAMBRIDGE UNIV PRESS},
