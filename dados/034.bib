@article{ WOS:000355288300011,
Author = {von Kulessa, Alexander and Wenzelburger, Georg},
Title = {Stronger Tax Competition- strong Reforms? A newer View on Corporate
   Tax Reform in 15 EU-Nations (1998-2011)},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2015},
Volume = {21},
Number = {2},
Pages = {302-332},
Month = {JUN},
Abstract = {Obwohl viele europaische Lander ihre Unternehmenssteuern in den
   vergangenen Jahren gesenkt haben, besteht weiterhin eine beachtliche
   Varianz im EU-15-Vergleich. Der vorliegende Beitrag nimmt diese
   Unterschiede zum Anlass, um die Frage nach den Bestimmungsgrunden der
   Unternehmenssteuerreformen und deren Ausma ss neu zu stellen. Neu
   deshalb, weil er eine logistische Panelregression mit einer fsQCA
   verbindet und damit die bisherigen Studien methodisch-konzeptionell
   erganzt. Und ebenfalls neu deshalb, weil er sich hinsichtlich des
   Untersuchungszeitraumes auf die Jahre 1998-2011 beschrankt und damit auf
   einen Zeitraum, in dem der verscharfte Steuerwettbewerbs in
   globalisierten Markten besonders relevant ist. Die Ergebnisse der
   empirischen Analysen bestatigen den uberaus starken Einfluss, welche die
   Position eines Landes im internationalen Steuerwettbewerb auf dessen
   Steuerreformtatigkeit ausubt. Sowohl in der fsQCA als auch in der
   logistischen Panelregression dominiert dieser Zusammenhang. Daneben
   erlauben die Ergebnisse auch eine Nuancierung bisheriger Befunde zum
   Einfluss von Vetospielern und Parteipolitik.
   Although many EU-countries have reduced corporate taxes in the recent
   years, there is still a substantial variance between the 12 oldest
   EU-member states. This contribution revisits this variation and analyses
   the determinants of corporate tax reforms and their magnitude from a
   perspective which is new in two respects: First, we combine logistic
   panel regression and fsQCA analysis allowing for an integration of
   qualitative assessments of tax reforms in the QCA analysis. This adds to
   the existing studies on tax reform which almost exclusively rely on
   regression techniques. Second, we focus on the time period 1998-2011
   where we expect tax competition to be especially intense. The results of
   our analyses confirm the major impact of tax competition on national
   corporate tax policies. This relationship dominates the regression
   analyses as well as the fsQCA. Furthermore, our findings allow nuancing
   the existing results on the influence of institutional constraints and
   partisan politics.},
