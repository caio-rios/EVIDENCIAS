Title = {Legislative Organisation and its Determinants in European Parliamentary
   Democracies},
Journal = {WEST EUROPEAN POLITICS},
Year = {2015},
Volume = {38},
Number = {5, SI},
Pages = {933-939},
Month = {SEP 3},
Abstract = {Questions regarding the origin and evolution of legislative institutions
   are at the heart of comparative legislative studies. Much research in
   this area focuses on the US Congress; in contrast, comparative studies
   of European democracies have been more limited. Addressing this
   imbalance, this special issue showcases newly emerging research on
   legislative organisation in Europe. In doing so, it brings together
   contributions that explore the rationales behind the emergence of, and
   variation in, national European voting practices, investiture rules,
   minority rights, committee power, agenda control, debating rules and
   individual MPs' rights.},
