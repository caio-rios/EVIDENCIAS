@article{ WOS:000355183000002,
Author = {Budge, Ian},
Title = {Issue Emphases, Saliency Theory and Issue Ownership: A Historical and
   Conceptual Analysis},
Journal = {WEST EUROPEAN POLITICS},
Year = {2015},
Volume = {38},
Number = {4, SI},
Pages = {761-777},
Month = {JUL 4},
Abstract = {Saliency approaches derive from the basic idea that political parties
   define their policies by emphasising certain topics more than others,
   particularly in public documents and debates. However, the approaches
   diverge on whether parties always emphasise the same `owned' issues or
   can emphasise different ones in different elections with a view to
   winning votes. The article explores the way these differences developed
   and summarises them in a typology of `issue ownerships', within which
   models linking `ownership' to election outcomes can be located.},
