@article{ WOS:000361039200006,
Author = {Renshon, Jonathan and Lee, Jooa Julia and Tingley, Dustin},
Title = {Physiological Arousal and Political Beliefs},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2015},
Volume = {36},
Number = {5},
Pages = {569-585},
Month = {OCT},
Abstract = {It is by now well known that political attitudes can be affected by
   emotions. Most earlier studies have focused on emotions generated by
   some political event (e.g., terrorism or increased immigration).
   However, the methods used in previous efforts have made it difficult to
   untangle the various causal pathways that might link emotions to
   political beliefs. In contrast, we focus on emotions incidental (i.e.,
   irrelevant) to the decision process, allowing us to cleanly trace and
   estimate the effect of experimentally induced anxiety on political
   beliefs. Further, we build upon innovative new work that links
   physiological reactivity (Hatemi, McDermott, Eaves, Kendler, \& Neale,
   2013; Oxley etal., 2008a) to attitudes by using skin conductance
   reactivity as a measure of emotional arousal. We found that
   anxietygenerated by a video stimulussignificantly affected physiological
   arousal as measured by tonic skin-conductance levels, and that higher
   physiological reactivity predicted more anti-immigration attitudes. We
   show that physiological reactivity mediated the relationship between
   anxiety and political attitudes.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Renshon, J (Corresponding Author), Univ Wisconsin, Dept Polit Sci, 110 North Hall,1050 Bascom Mall, Madison, WI 53706 USA.
   Renshon, Jonathan, Univ Wisconsin, Madison, WI 53706 USA.
   Lee, Jooa Julia; Tingley, Dustin, Harvard Univ, Cambridge, MA 02138 USA.},
DOI = {10.1111/pops.12173},
ISSN = {0162-895X},
EISSN = {1467-9221},
Keywords = {Experimental methods; emotions; anxiety; skin conductance; immigration;
   causal mediation; beliefs},
Keywords-Plus = {STEREOTYPIC THINKING; EMOTION; ANXIETY; MEDIATION; ANGER; FEAR;
   PREJUDICE; ATTITUDES; IMMIGRATION; TERRORISM},
Research-Areas = {Government \& Law; Psychology},
Web-of-Science-Categories  = {Political Science; Psychology, Social},
