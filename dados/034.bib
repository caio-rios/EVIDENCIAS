@article{ WOS:000357978200001,
Author = {Zohlnhoefer, Reimut and Herweg, Nicole and Rueb, Friedbert},
Title = {Theoretically refining the multiple streams framework: An introduction},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2015},
Volume = {54},
Number = {3},
Pages = {412-418},
Month = {AUG},
Abstract = {This introduction to the forum section on the Multiple Streams Framework
   (MSF) developed by John W. Kingdon argues that the conditions under
   which policy making takes place today increasingly resemble the
   assumptions upon which Kingdon built his lens. At the same time, while
   the framework is extremely successful with regard to citations and has
   been applied in various contexts that often differ remarkably from those
   for which the framework was originally developed, a systematic
   theoretical debate about the Multiple Streams Framework is still
   lacking. It is the intention to spark such a debate with this forum
   section.},
