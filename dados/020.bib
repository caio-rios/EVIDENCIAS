@article{ WOS:000611141900009,
Author = {Busemeyer, Marius R. and Abrassart, Aurelien and Nezi, Roula},
Title = {Beyond Positive and Negative: New Perspectives on Feedback Effects in
   Public Opinion on the Welfare State},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2021},
Volume = {51},
Number = {1},
Pages = {137-162},
Month = {JAN},
Abstract = {The study of policy feedback on public attitudes and policy preferences
   has become a growing area of research in recent years. Scholars in the
   tradition of Pierson usually argue that positive, self-reinforcing
   feedback effects dominate (that is, attitudes are commensurate with
   existing institutions), whereas the public thermostat model developed by
   Wlezien and Soroka expects negative, self-undermining feedback. Moving
   beyond the blunt distinction between positive and negative feedback,
   this article develops and proposes a more fine-grained typology of
   feedback effects that distinguishes between accelerating,
   self-reinforcing and self-undermining, specific and general, as well as
   long- and short-term dynamic feedback. The authors apply this typology
   in an analysis of public opinion on government spending in different
   areas of the welfare state for twenty-one OECD countries, employing a
   pseudo-panel approach. The empirical analysis confirms the usefulness of
   this typology since it shows that different types of feedback effects
   can be observed empirically.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Busemeyer, MR (Corresponding Author), Univ Konstanz, Dept Polit \& Publ Adm, Constance, Germany.
   Busemeyer, Marius R., Univ Konstanz, Dept Polit \& Publ Adm, Constance, Germany.
   Abrassart, Aurelien, Univ Bern, Dept Econ, Bern, Switzerland.
   Nezi, Roula, Univ Surrey, Dept Polit, Guildford, Surrey, England.},
DOI = {10.1017/S0007123418000534},
Article-Number = {PII S0007123418000534},
