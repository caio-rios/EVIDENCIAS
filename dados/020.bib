@article{ WOS:000595567900001,
Author = {Karpowitz, Christopher F. and King-Meadows, Tyson and Monson, J. Quin
   and Pope, Jeremy C.},
Title = {What Leads Racially Resentful Voters to Choose Black Candidates?},
Journal = {JOURNAL OF POLITICS},
Year = {2021},
Volume = {83},
Number = {1},
Pages = {103-121},
Month = {JAN 1},
Abstract = {In studies of voting behavior, racial resentment has consistently been
   associated with decreased support for black candidates. In this article
   we bring together a unique collection of observational data and survey
   experiments to show how, in the certain contexts, exactly the opposite
   occurs: racially resentful voters prefer to vote for a black candidate
   over a white competitor. Higher levels of racial resentment do not imply
   an unyielding opposition to black candidates because such voters respond
   to partisan and ideological cues about the preferences of black
   candidates. Because the traditional measure of racial resentment
   captures more than just racial animus, some black candidates-most
   notably, Republicans with an individualist message-benefit electorally
   from higher levels of racial resentment in the electorate. These results
   highlight the importance of campaign context in shaping how voters
   respond to racial, partisan, and ideological cues.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
Affiliation = {Karpowitz, CF (Corresponding Author), Brigham Young Univ, Polit Sci, Provo, UT 84602 USA.
   Karpowitz, CF (Corresponding Author), Brigham Young Univ, Ctr Study Elect \& Democracy, Provo, UT 84602 USA.
   Karpowitz, Christopher F.; Monson, J. Quin; Pope, Jeremy C., Brigham Young Univ, Polit Sci, Provo, UT 84602 USA.
   Karpowitz, Christopher F.; Pope, Jeremy C., Brigham Young Univ, Ctr Study Elect \& Democracy, Provo, UT 84602 USA.
