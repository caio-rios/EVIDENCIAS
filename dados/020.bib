@article{ WOS:000599560500001,
Author = {Tosun, Jale and Peters, B. Guy},
Title = {The politics of climate change: Domestic and international responses to
   a global challenge},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
