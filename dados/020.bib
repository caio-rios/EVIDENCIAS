@article{ WOS:000598774000001,
Author = {Berman, Chantal E.},
Title = {Policing the Organizational Threat in Morocco: Protest and Public
   Violence in Liberal Autocracies},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2021},
Volume = {65},
Number = {3},
Pages = {733-754},
Month = {JUL},
Abstract = {As a prominent form of state violence against civilians, protest
   policing represents the type of coercion that ``liberal{''} autocrats
   seek to minimize. Departing from aggregate notions of ``mass threat{''}
   that dominate studies of authoritarian response to contention, this
   article develops an event-level model of protest policing centering the
   role of social movement organizations in shaping elite threat
   perceptions and, hence, the likelihood that protests will face state
   violence. More than public protest per se, I argue that liberal
   autocrats fear the rise of autonomous, national-level organizations
   capable of providing unregulated channels for citizen claim-making.
   Having forsworn the ability to control which networks become active as
   social movement organizations, liberal autocrats use protest policing to
   dissuade citizens from mobilizing with autonomous organizations and to
   protect the near-monopoly of embedded organizations over contention. I
   illustrate these arguments with unique protest event data from Morocco.
   I draw implications for the durability of liberalized regimes.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Berman, CE (Corresponding Author), Georgetown Univ, Dept Govt, Washington, DC 20057 USA.
   Berman, Chantal E., Georgetown Univ, Dept Govt, Washington, DC 20057 USA.},
DOI = {10.1111/ajps.12565},
EarlyAccessDate = {DEC 2020},
ISSN = {0092-5853},
EISSN = {1540-5907},
Keywords-Plus = {STATE REPRESSION; POLITICAL PROTEST; HUMAN-RIGHTS; AUTHORITARIANISM;
   DETERRENCE; ESCALATION; INTEGRITY; MOVEMENTS; DYNAMICS; COERCION},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {chantal.berman@gmail.com},
Affiliations = {Georgetown University},
Funding-Acknowledgement = {National Science Foundation; Bobst Center for Peace and Justice},
Funding-Text = {I acknowledge funding from the National Science Foundation and the Bobst
   Center for Peace and Justice. I would like to thank Mark Beissinger,
   Steven Brooke, Melani Cammett, Killian Clarke, Amaney Jamal, and Daniel
   Tavana, the audience at Harvard Political Violence Workshop, and three
