Funding-Acknowledgement = {Harvard's Inequality and Social Policy Program; Institute for
   Quantitative Social Science},
Funding-Text = {This paper was previously titled ``Legislative Factions under Democratic
   One-Party Rule: Evidence from American Local Government.{''} For helpful
