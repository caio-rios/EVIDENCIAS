@article{ WOS:001840370200001,
Author = {Erhard, Lukas},
Title = {Anti-Elitism Gets the Views: Populist Communication and Popularity on
   German Political YouTube},
Journal = {INTERNATIONAL JOURNAL OF PRESS-POLITICS},
Year = {2026},
Month = {2026 AUG 4},
Abstract = {YouTube has become a central venue for political communication, but
   systematic evidence of how parties employ the platform remains limited.
   This article examines how German political parties use YouTube and how
   populist rhetoric shapes engagement. We distinguish between anti-elitism
   and people-centrism and analyze their prevalence in party videos
   alongside their effects on video performance. We compile a dataset of
   official YouTube channels from all major German parties (2017-2025),
   apply automated transcription, and use a transformer-based model
   (PopBERT) to detect populist language. Video performance is assessed
   primarily through views, modeled with quantile regression and hurdle
   approaches to capture the likelihood of videos reaching the top tier and
   conditional effects among successful content. Our results show that the
   Alternative for Germany (AfD) far surpasses other parties in
   subscribers, video production, and engagement. Content analysis reveals
   that AfD channels contain markedly higher levels of anti-elitist
   rhetoric, while people-centrism appears more evenly distributed across
   the party spectrum. Quantile regression models show that anti-elitism is
   positively associated with engagement in the upper tail of the view
   distribution for all parties except the Free Democratic Party (FDP).
   Hurdle models further indicate that anti-elitism is associated with a
   higher probability of entering the top performance tier not only for the
   AfD but also for the Christian Democratic Union / Christian Social Union
   (CDU/CSU), Left, and the Social Democratic Party (SPD). Results for
   people-centrism are weaker and less consistent. The study contributes to
   research on digital populism by showing that anti-elitist rhetoric, more
   than people-centrism, is associated with video success on YouTube across
   populist and nonpopulist parties.},
Publisher = {SAGE PUBLICATIONS INC},
