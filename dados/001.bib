@article{ WOS:001871132000001,
Author = {Soler-i-Marti, Roger and Revilla, Juan Carlos and Benedicto, Jorge},
Title = {Living Activism: Biographical Trajectories and the Reconfiguration of
   Youth Participation},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2026},
Volume = {61},
Month = {SEP 10},
Abstract = {Youth transitions to adulthood have become longer, more complex and
   diverse, yet these shifts are often overlooked in studies of political
   attitudes and behaviour, leading to contradictory conclusions. This
   article explores the evolving nature of youth political engagement
   through the concept of `engagement biographies', drawing on biographical
   interviews with young activists in Spain. It examines the extent to
   which young activists experience political involvement as a dynamic,
   context-dependent process shaped by their individualised and
   de-standardised paths to adulthood, interpersonal relationships and
   broader socio-political contexts. Adopting a biographical perspective
   enhances understanding of key trends identified in the literature on
   youth and politics, including the volatility of participation, a
   preference for direct and less institutionalised activism, the
   integration of activism into everyday life, and increasing disengagement
   from formal politics. These insights contribute to a more nuanced
   understanding of young people's patterns of political engagement and
   their broader implications for democracies.},
