@article{ WOS:001755275700001,
Author = {Sawler, Dot},
Title = {Who Benefits? How Gender Shapes the Perceived Deservingness of Welfare
   Claimants},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {4},
Pages = {1617-1628},
Month = {OCT 1},
Abstract = {This study examines how Americans allocate public benefits to men and
   women. While extant work shows that women's work is undervalued relative
   to men's, scholarly intuition is unclear if these patterns persist when
   men and women are in competition for scarce public aid resources. I find
   that, on average, male applicants receive less than female applicants
   with identical needs. Furthermore, I find the amount awarded to women,
   but not men, varies conditional on their work history. Women with
   excellent work histories are awarded significantly more than comparable
   men. The totality of these results suggests an important caveat to the
   established finding that women's hard work is valued less than
   men's-when competing for help, women's work is rewarded more than their
   male counterparts.},
