@article{ WOS:001864288700001,
Author = {Tabero, Katy and Khoban, Zohreh and Spada, Paolo and Mestre, Rafael and
   Ryan, Matt},
Title = {Get out to deliberate (GOTD): Door-to-door canvassing to improve civic
   engagement},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2026},
Month = {2026 SEP 1},
Abstract = {Several decades of experimentation have found that `Get-Out-the-Vote'
   (GOTV) campaigns can effectively increase voter turnout. Yet, little has
   been said about the ability of similar-style campaigns to encourage
   participation in other types of civic engagement, such as citizens'
   assemblies, which require much higher levels of commitment. Furthermore,
   although studies have found general support for citizens' assemblies,
   willingness to participate is higher amongst those already more
   politically engaged and with higher levels of education, presenting a
   challenge to claims surrounding legitimacy and representation. In this
   article, we conduct a GOTV-style field experiment, complemented by a
   doorstep survey, to increase and understand perspectives towards
   registration for the 2023 Southampton Citizens' Climate Assembly. We
   find that canvassing can be an effective method for increasing
   registration, including from under-represented groups. However, there
   are considerable barriers to participation, particularly the level of
   commitment, personal interest, and concerns about impact, which limit
   recruitment efforts.},
