@article{ WOS:001869124800001,
Author = {Solander, Nea},
Title = {The conditionality-corruption nexus: implications for democracy
   promotion in candidate and neighbourhood countries},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 SEP 9},
Abstract = {Despite the well-established link between corruption and
   democratization, studies on democracy promotion efforts often overlook
   how corruption may shape their effectiveness. This study examines
   whether corruption mediates the effect of EU political conditionality on
   democratization. Rather than treating positive and negative
   conditionality in isolation, this study offers a framework that examines
   both forms simultaneously, allowing direct comparison of how corruption
   mediates the effectiveness of each type of conditionality. Building on a
   cost-benefit framework of conditionality, this study theorizes that
   corruption alters the equilibrium of states, thereby impacting the
   likelihood of democratization. It asks two questions: To what extent
   does corruption mediate the impact of EU political conditionality? And
   how does this relationship vary by the type of conditionality employed?
   Drawing on a panel dataset of countries engaged with the EU through
   accession processes or the European Neighbourhood Policy (ENP) from 2000
   to 2020, the analysis focuses on the interaction between domestic
   corruption levels and the EU's use of positive and negative
   conditionality. The findings reveal a complex dynamic: while aid and
   sanctions maintain a relatively consistent impact across different
   corruption contexts, the democratizing effect of accession
   conditionality is contingent upon lower levels of corruption.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
