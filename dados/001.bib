@article{ WOS:001844526900001,
Author = {Dominioni, Goran and Kantorowicz, Jaroslaw and Quintavalla, Alberto},
Title = {Do Net-Zero Targets Embedded in (EU) Legislation Increase Public Support
   for Climate Policies?},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {3},
Pages = {592-605},
Month = {SEP},
Abstract = {Over 90 countries have committed to reaching net-zero greenhouse gas
   emissions by a specific year, and many include this commitment in
   legislation. Often, public authorities make these commitments before
   implementing a set of climate change mitigation policies aimed at
   meeting these commitments. This is the first study through a survey
   experiment on whether a legally binding net-zero commitment affects
   public support for climate policies compared to a non-legally binding
   one. We also analyse whether this effect varies depending on whether the
   commitment is made at the EU or national level. The survey experiment is
   carried out in France and Hungary, and we find no evidence that
   embedding a net-zero target in law increases public support compared to
   setting it solely in policy. Adopting a net-zero target in legislation
   and then rolling out climate policies may not provide advantages in
   terms of public acceptability compared to less politically onerous
   policy announcements.
   Mehr als 90 L \& auml;nder haben sich verpflichtet, bis zu einem
   bestimmten Jahr Netto-Null-Treibhausgasemissionen zu erreichen, und
   viele haben diese Zusage gesetzlich verankert. H \& auml;ufig gehen \&
   ouml;ffentliche Beh \& ouml;rden diese Verpflichtungen ein, bevor sie
   konkrete Massnahmen zur Eind \& auml;mmung des Klimawandels umsetzen, um
   diese Ziele zu erreichen. Dies ist die erste Studie, die im Rahmen eines
   Umfrageexperiments untersucht, ob sich eine rechtsverbindliche
   Netto-Null-Zusage im Vergleich zu einer nicht rechtsverbindlichen auf
   die \& ouml;ffentliche Unterst \& uuml;tzung f \& uuml;r Klimamassnahmen
   auswirkt. Wir analysieren ausserdem, ob dieser Effekt variiert, je
   nachdem, ob die Zusage auf EU- oder auf nationaler Ebene gemacht wird.
   Das Umfrageexperiment wurde in Frankreich und Ungarn durchgef \&
   uuml;hrt. Wir finden keine Evidenz daf \& uuml;r, dass die gesetzliche
   Verankerung eines Netto-Null-Ziels die \& ouml;ffentliche Unterst \&
   uuml;tzung im Vergleich zu einer reinen Festlegung in der
   Regierungspolitik erh \& ouml;ht. Ein Netto-Null-Ziel gesetzlich zu
   verabschieden und anschliessend Klimamassnahmen einzuf \& uuml;hren,
   bietet somit im Vergleich zu weniger aufwendigen politischen Ank \&
   uuml;ndigungen wom \& ouml;glich keine Vorteile hinsichtlich der
   gesellschaftlichen Akzeptanz.
   Plus de 90 pays se sont engag \& eacute;s \& agrave; atteindre un niveau
   d'\& eacute;missions de gaz \& agrave; effet de serre \& laquo; net z \&
   eacute;ro \& raquo; d'ici une ann \& eacute;e pr \& eacute;cise, et
   beaucoup inscrivent cet engagement dans leur l \& eacute;gislation.
   Souvent, les autorit \& eacute;s publiques prennent ces engagements
   avant de mettre en oe uvre un ensemble de politiques d'att \&
   eacute;nuation du changement climatique visant \& agrave; les respecter.
   Cette \& eacute;tude est la premi \& egrave;re \& agrave; analyser, au
   moyen d'une exp \& eacute;rience d'enqu \& ecirc;te, si un engagement
