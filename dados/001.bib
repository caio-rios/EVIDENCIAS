@article{ WOS:001881163200001,
Author = {Lu, Shuning and Mu, Haixin and Yang, Tian},
Title = {When Movement Widens the Gap: The Contingent Effect of the Chinese
   \#MeToo Movement on Feminist Attitudes},
Journal = {INTERNATIONAL JOURNAL OF PRESS-POLITICS},
Year = {2026},
Month = {2026 SEP 21},
Abstract = {Social movements are often associated with various cultural outcomes,
   including shifts in public opinion regarding movement-related attitudes
   and ideologies. This study examines the shift of feminist attitudes
   among the public following the Chinese \#MeToo movement. We develop a
   sociotechnical contingency framework that emphasizes how identity-based
   movement relevance and access to information channels shape the shifts
   in public opinion following social movements. Using nationally
   representative data from the Chinese General Social Survey (2010-2023),
   we find that the \#MeToo movement was significantly associated with an
   increase in pro-feminist attitudes. These changes were unevenly
   distributed across groups, revealing widening attitudinal gaps along
   gender identities and digital divides. Our findings contribute to a
   nuanced understanding of how contemporary digitally mediated movements
   catalyze cultural change and underscore the need to contextualize their
   impact as it interacts with structural dynamics.},
