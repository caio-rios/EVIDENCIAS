@article{ WOS:001861805800001,
Author = {Leon, Sandra and Garmendia Madariaga, Amuitz},
Title = {Crisis and centralisation: how the pandemic reshaped territorial
   preferences in Spain},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2026},
Month = {2026 AUG 28},
Abstract = {This article explores the impact of crises on territorial preferences of
   citizens, focusing on how crisis management drives shifts towards
   centralisation. While existing research has shown that territorial
   preferences can shift in response to elite mobilisation and political
   dynamics, we know comparatively little about whether external shocks can
   drive similar change. Using an online priming survey experiment
   conducted at different times of the COVID-19 pandemic in Spain, the
   research tests whether ineffective crisis coordination increases public
   support for centralisation. The findings reveal a robust centralisation
   shift, moderated by pre-existing preferences for decentralised
   governance and regional political alignments. These insights raise
   important questions about the resilience of decentralised governance
   structures in the face of external shocks.},
