@article{ WOS:001906644100001,
Author = {Vande Walle, Britt and Bruycker, Iskander De and Martinez-Bohme, Sandra
   and Eiselt, Susanna},
Title = {Friends of the far right? Interest group behaviour in the European
   Parliament},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 SEP 29},
Abstract = {The past decade has witnessed a notable surge of far-right parties in
   European legislatures. Yet, little is known about their interactions
   with interest groups. Traditionally, far-right parties tend to engage
   less frequently with interest groups than mainstream parties, in part
   due to a form of normative resistance grounded in prevailing social
   norms. However, as the far right becomes increasingly normalised, the
   dynamics of party-group relations may be shifting. This study explores
   under what conditions interest groups engage with the far right, and
   whether they have normalised far-right engagement or reflect continued
   resistance. An analysis of an original dataset of meetings between 686
   interest groups and far-right Members of the European Parliament (MEPs)
   shows that interest groups generally avoid engagement with far-right
   MEPs. However, this resistance is conditional: far-right MEPs who hold
   rapporteur positions are significantly more likely to be engaged, and
   national ties further increase the likelihood of interaction.},
