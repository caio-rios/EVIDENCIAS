@article{ WOS:001863360000001,
Author = {Castello, Pablo P.},
Title = {The territorial rights of wild animals: Justification},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Month = {2026 AUG 31},
Abstract = {Territorial rights (TR) have become foundational in normative political
   theory, addressing pressing questions about boundary drawing,
   governance, and resource use. Influential TR theorists Cara Nine and
   Margaret Moore justify humans' TR based on the functional, social, and
   identity-anchored normative significance of non-substitutable places.
   However, these arguments treat animals as resources, excluding them from
   normative consideration and political standing. This article analyzes
   Nine and Moore's arguments to assess whether their justificatory logic
   applies to wild animals. Using mule deers as a case study, I test
   whether they have sufficiently weighty interests in occupancy,
   residency, resource use, and control to ground duties on humans and
   whether TR theories should continue to treat animals as mere natural
   resources.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Castello, PP (Corresponding Author), Univ Denver, Sturm Coll Law, Off 472D,Frank H Ricketson Law Bldg,2255 E Evans A, Denver, CO 80208 USA.
   Castello, Pablo P., Univ Denver, Sturm Coll Law, Off 472D,Frank H Ricketson Law Bldg,2255 E Evans A, Denver, CO 80208 USA.},
DOI = {10.1111/ajps.70087},
EarlyAccessDate = {AUG 2026},
ISSN = {0092-5853},
EISSN = {1540-5907},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {castellopablop@gmail.com},
Affiliations = {University of Denver},
Funding-Acknowledgement = {Animal Law and Policy Program},
Funding-Text = {The author conducted this research as a research fellow at Harvard Law
   School's Brooks McCormick Jr. Animal Law and Policy Program (ALPP)
   during fall 2024. I am grateful to my colleagues Macarena Montes and Amy
   Fitzgerald, with whom I discussed the article's development on a weekly
   basis during our stimulating lunch breaks. I also thank Bonnie Nadzam
   and Kristen Stilt for their editorial guidance and mentorship,
   respectively, as well as Kelley McGill and Ann Linder for their helpful
   feedback during ALPP working-group sessions. I am especially indebted to
   Will Kymlicka for his generous feedback on earlier drafts of this
   manuscript. My gratitude also goes to Margaret Moore and Katie Jourdeil
   for insightful comments shared through correspondence and at the
   Political Philosophy Reading Group (PPRG) at Queen's University, where I
   had the opportunity to present a draft of this article in spring 2025.
   For their valuable comments at the PPRG, I thank Jackie Davies, Jordan
