@article{ WOS:001894842100001,
Author = {Tudor, Maya and Vaccaro, Andrea},
Title = {Why liberal rights define democracy},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 OCT 2},
Abstract = {Recent scholarly debates highlight conceptual confusion around the term
   ``illiberal democracy{''} - a term widely used by academics,
   policymakers, and democracy watchdogs alike. We substantiate the need
   for greater clarity by evidencing significant ambiguity around the
   concept ``illiberal democracy.{''} Analysing key definitions of both
   liberalism and democracy, we show that conceptual confusion underpins
   central scholarly debates around democratic backsliding and bedevils the
   labels used by democracy watchdogs. On conceptual terrain, we clarify
   that contemporary political regimes must have substantial liberal rights
   to qualify as a democracy. Clearly said, no liberal rights, no
   democracy.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
