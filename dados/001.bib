@article{ WOS:001855162300001,
Author = {Chae, Je Hoon and Groeling, Tim and Song, Hyunjin (Jin)},
Title = {Hold That Thought: Enhancing the Durability of Fact-Checking Effects
   Through Low-Cost Accuracy Reminders},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Month = {2026 AUG 23},
Abstract = {Prior evidence suggests that fact-checking can update beliefs regarding
   factually incorrect information in the short term but its effects often
   decay rapidly. Such decay raises normative concerns about its
   sustainability and real-world impact. Here, we examine whether a
   cognitively efficient, low-cost intervention - called an ``accuracy
   reminder{''} - can enhance the durability of fact-checking effects. In a
   large-scale pre-registered panel longitudinal experiment (N = 7,188),
   participants were randomly assigned to receive fact-checks and, under
   some conditions, follow-up prompts to reevaluate the same claim at
   interval-optimized time points. Across topical domains and partisan
   identities, reminder conditions produced durable belief correction
   effects lasting up to four weeks, more than doubling the persistence
   observed without reminders. Effects were robust across reminder
   frequency and timing, as well as against individual differences,
   suggesting implementation flexibility and theoretical generalizability.
   These findings identify retrieval-based reinforcement as a scalable
   means of sustaining factual belief correction and reinforcing shared
   factual baselines in spite of cognitive decay and partisan resistance.},
