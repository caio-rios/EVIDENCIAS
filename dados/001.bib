@article{ WOS:001889137900001,
Author = {Teliz, Silvia and Gonzalez-Bailon, Sandra},
Title = {Skin Tone as a Visual Cue in Political Campaigns: Evidence from
   Elections in Mexico},
Journal = {INTERNATIONAL JOURNAL OF PRESS-POLITICS},
Year = {2026},
Month = {2026 SEP 30},
Abstract = {Research has long established that physical appearance and phenotypical
   traits influence how people evaluate political candidates. Skin color is
   one of the visual cues the electorate perceives during campaigns and
   media coverage, and a possible source of prejudice and bias. Here we use
   computational visual analysis to investigate the association between
   skin tone and electoral success during the 2024 Mexican Federal
   Elections. Our analyses incorporate important correlates not considered
   in prior research, most prominently news coverage, political ads, and
   social media use. We also account for geographic differences in average
   skin tone, explicitly modeling a source of variation that is obscured
   when skin tone is analyzed disregarding contextual baselines. We use
   fixed effects generalized linear models to control for state and party
   variation as well as candidate-level demographics, political experience,
   incumbency status, and media presence (news coverage, political ads, and
   social media use). Consistent with past work, we find that as
   candidates' skin tone becomes darker, their predicted vote share
   declines. However, news coverage, political ads, and social media use
   are, together, more important predictors of electoral success than skin
   tone, indicating that this phenotypical trait is not as prominent a
   visual cue as earlier research suggested.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Téliz, S; González-Bailón, S (Corresponding Author), Univ Penn, Annenberg Sch Commun, 3620 Walnut St, Philadelphia, PA 19104 USA.
   Teliz, Silvia; Gonzalez-Bailon, Sandra, Univ Penn, Annenberg Sch Commun, 3620 Walnut St, Philadelphia, PA 19104 USA.},
DOI = {10.1177/19401612261484045},
EarlyAccessDate = {SEP 2026},
ISSN = {1940-1612},
