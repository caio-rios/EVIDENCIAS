@article{ WOS:001899562700001,
Author = {Lieberman, Evan and Lockwood, Sarah and Martin, Philip and Naidoo,
   Vinothan},
Title = {Can multi-dimensional descriptive representation increase policy
   priority alignment? Evidence from South African municipalities},
Journal = {EUROPEAN POLITICAL SCIENCE REVIEW},
Year = {2026},
Month = {2026 OCT 10},
Abstract = {Does an increase in the number of shared identity traits between
   citizens and their public representatives increase the likelihood that
   they will agree on policy priorities? The identities of citizens and
   politicians are complex and multi-dimensional, but we know little about
   how the combination of multiple shared identity traits affects the
   convergence of attitudes on government policy. In this paper, we analyze
   two waves of original survey data on local government councillors in
   conjunction with several surveys of citizens in South Africa. We find
   that both within and across political parties, greater degrees of trait
   similarity between citizens and politicians - even beyond the one or two
   traits considered in most studies of descriptive representation - are
   associated with modest but consistent increases in alignment on policy
   priorities, especially when citizens and councillors share traits that
   reinforce a historically marginalized identity. We also show that trait
   similarity increases policy priority alignment to a greater degree when
   politicians have roles that require frequent contact with constituents,
   suggesting that communication channels may strengthen the substantive
   impact of descriptive representation.},
