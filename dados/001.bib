@article{ WOS:001846391700001,
Author = {Feitosa, Fernando and Eck, Bjarn and Pilet, Jean-Benoit},
Title = {PRRP identity and sense of understanding for citizens who engage in
   political violence},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2026},
Month = {2026 AUG 12},
Abstract = {This research note extends existing knowledge on anti-pluralism among
   identifiers of a populist radical right party (PRRP) by investigating
   their sense of understanding for citizens who engage in two key forms of
   political violence: threatening and spreading false information about
   political opponents. Building on methodological advances in political
   science research, we estimate a series of Bayesian zero-inflated
   regression models using original Flemish data (N = 2,963). Results
   reveal a positive correlation between PRRP identity and sense of
   understanding. Results further indicate that this correlation diminishes
   with higher levels of education in the case of spreading false
   information, but remains equally strong in the case of threatening. This
   research note offers new insights into anti-pluralism among PRRP
   identifiers.},
