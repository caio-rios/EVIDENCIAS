@article{ WOS:001864897000001,
Author = {Danielak, Silvia and McKittrick, Meredith},
Title = {Imagining infrastructure, Encountering friction: Green hydrogen
   development in Morocco and Namibia},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {131},
Month = {DEC},
Abstract = {Green Hydrogen has been touted as central to achieving the energy
   transition and a green economy, frequently equated with an
   undifferentiated set of social, political, and economic benefits.
   Focusing on the infrastructure that is necessary to achieve this
   transition, this paper inquires into the sociotechnical, or
   infrastructural, narratives that drive Namibia and Morocco's pursuit of
   Green Hydrogen. Based on an extensive review of policy documents and a
   visual analysis, this paper identifies two co-existing infrastructure
   imaginaries that drive the pursuit of green hydrogen. Green hydrogen
   links, first, to the imaginary of a global, and just, green energy
   transition and, second, to sovereign national development. Both
   imaginaries reveal friction and conflict, which come with the
   aspirations for the energy transition for the countries studied.},
