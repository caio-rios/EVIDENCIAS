@article{ WOS:001824761100001,
Author = {Graddy-Lovelace, Garrett and Ranganathan, Malini},
Title = {Food as necropolitics: The starvation of Palestinian sovereignty and
   stakes of geopolitical ecology},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {130},
Month = {SEP},
Abstract = {This article theorizes the deliberate starvation of Gaza as
   ``food-as-necropolitics{''} and argues that this forced famine clarifies
   the analytical stakes of the emerging field of geopolitical ecology.
   Gaza's forced hunger and the weaponization of food aid over the past
   two-and-a-half years is not a region-specific humanitarian emergency but
   a geopolitical project of human and ecological destruction, territorial
   conquest, and racialized dehumanization that tests-and reveals the
   limits and hollowness of the so-called rules-based liberal international
   order. We review media, legal, and human-rights reporting on
   food-related deaths, deprivation, and humanitarian access in Gaza from
   January 2024 to August 2025, identifying two mutually reinforcing axes:
   (1) deliberate deprivation through siege, blockade, and the destruction
   of agrifood systems and ecologies; and (2) the weaponization of food aid
   through militarized distribution and repeated attacks on aid workers and
   starving aid seekers. Tracking these modalities enables a critique of
   the dominant liberal order as a racialized formation that not only fails
   to prevent starvation-as-war, but also supplies diplomatic, legal, and
   epistemic cover for settler-colonial land and resource capture and
   impunity. Finally, we foreground Palestinian and transnational
   agroecological and food sovereignty practices as counter-hegemonic
   geopolitical ecologies that persist and connect across scales, even as
   they are met with securitization and criminalization.},
Publisher = {ELSEVIER SCI LTD},
