@article{ WOS:001908406300001,
Author = {Borbath, Endre and Sebok, Miklos and Szabo, Andrea},
Title = {Changing the terms of conflict: electoral revolution in the 2026
   Hungarian parliamentary election},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 SEP 29},
Abstract = {The 2026 Hungarian parliamentary election ended sixteen years of
   uninterrupted Fidesz rule under Prime Minister Viktor Orb \& aacute;n.
   The Respect and Freedom Party (TISZA), led by P \& eacute;ter Magyar,
   won 53.18 per cent of the party-list vote and 141 of 199 seats at record
   post-1990 turnout. This outcome is interpreted as an electoral
   revolution produced through asymmetric agenda competition. TISZA did not
   primarily challenge Fidesz by taking opposing positions on the
   incumbent's preferred issues. It shifted attention from war,
   sovereignty, and Brussels towards government performance, corruption,
   public services, transport, territorial inequalities, and democratic
   renewal. Our analysis of party Facebook communication and press coverage
   documents this divergence, while survey evidence shows how the strategy
   united most of the former opposition, mobilised some previous
   non-voters, and attracted a smaller but consequential share of former
   Fidesz voters. This produced a socially and territorially broad
   coalition despite persistent age, education, occupation, and settlement
   gradients. The election transformed the government and party system,
   although it did not complete democratisation. TISZA's constitutional
   majority now places rapid institutional repair in tension with legal
   continuity and pluralist restraint.},
