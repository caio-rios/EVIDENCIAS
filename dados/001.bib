@article{ WOS:001914468100001,
Author = {Seeberg, Henrik Bech and Baekgaard, Martin},
Title = {Do Political Elites Evaluate Election Outcomes More Favourably than
   Citizens? Evidence from Parallel Surveys},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 OCT 25},
Abstract = {Research finds that citizens evaluate the election result of their
   preferred party more favourably than those of other parties. However,
   little is known about whether favourable electoral outcome assessments
   extend to political elites, or about how to reduce such favouritism. We
   hypothesize that incumbents and candidates for political office evaluate
   election outcomes even more favourably than citizens, and that such
   favouritism diminishes if people are asked to reflect on criteria for
   evaluating electoral success or receive information about the actual
   election outcome. Using large-scale data from parallel pre-registered
   surveys including experiments on representative samples of citizens and
   politicians/candidates running in the Danish 2021 local elections, we
   uncover substantial favouritism in election outcome evaluation among
   citizens and to an even greater extent among the elite. Our reflection
   treatment does not alter favouritism, while providing information to
   citizens about electoral outcomes reduces favouritism. These findings
   speak to important debates on polarisation and democratic support.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
