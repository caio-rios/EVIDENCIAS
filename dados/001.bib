@article{ WOS:001875454200001,
Author = {Vallejo, Agustin},
Title = {Left Behind or Left In? Party Ideology and the Gender Gap in Candidate
   Persistence},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 SEP 15},
Abstract = {Do parties matter in the gender differences in candidate resiliency
   after electoral defeat? I argue that they do. Party can shape whether a
   loss sidelines a woman or positions her for another run. Left-leaning
   parties-where gender inclusion is embedded in programmatic
   commitments-might also be more likely than their conservative
   counterparts to reinvest in defeated female candidates, increasing their
   likelihood of rerunning after loss. I present a cross-national analysis
   on this question by applying a consistent within-party
   regression-discontinuity design to open-list municipal elections in
   Chile and Brazil. The results are consistent with the expectations. A
   loss discourages women in right-leaning parties significantly more than
   it discourages men, while left-leaning parties exhibit a smaller gender
   gap. These results suggest that parties are an important gatekeeper in
   the female candidacy pipeline, and that decisions about rerunning are
   shaped not only by individual considerations but also by partisan
   environments.},
