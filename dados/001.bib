@article{ WOS:001821378500001,
Author = {Papp, Zsofia},
Title = {Inclusive representation and perceived democratic performance under
   democratic backsliding. Evidence from a full-factorial experiment in
   Hungary},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 JUL 11},
Abstract = {This study investigates how perceived political representation shapes
   evaluations of democratic performance in a polarized, backsliding
   context. Using a survey experiment in Hungary (n=1,005), the research
   moves beyond the traditional winner-loser framework to analyze how the
   representational status of both government and opposition voters jointly
   influences perceived democratic quality. The findings reveal that
   evaluations depend heavily on representational balance: respondents rate
   democracy highest when both blocs feel represented and lowest when
   neither does. Perceptions of opposition representation emerge as a
   primary driver of quality ratings, highlighting the salience of partisan
   inclusion for democratic assessments. While evaluations are filtered
   through in-group interests - with opposition supporters particularly
   sensitive to their own exclusion - pluralist benchmarks remain
   detectable across the partisan divide. These results indicate that even
   in a backsliding regime, citizens anchor evaluations of democracy in
   pluralistic criteria.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
