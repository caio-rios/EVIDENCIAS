@article{ WOS:001908388000001,
Author = {Vega-Mendez, Catalina and Visconti, Giancarlo},
Title = {Immigration and Nationalistic Attitudes: Panel Evidence from Chile},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 OCT 21},
Abstract = {Does rapid and large-scale migration fuel nationalism? Using
   administrative and panel survey data from Chile, we show that sudden,
   large-scale migration inflows increase identity-based nationalistic
   attitudes, such as national pride, among native-born citizens. These
   ``immigration shocks{''} appear to activate perceptions of identity
   threat, leading to stronger expressions of national pride and belonging.
   Supplementary evidence from surveys, media reports, social media, and
   crime records suggests that this nationalism is predominantly
   exclusionary: areas most affected by migration also experienced spikes
   in anti-migrant rhetoric, hate crimes, and support for a newly formed
   far-right party. These findings underscore how rapid demographic changes
   can reshape political attitudes and contribute to the rise of
   exclusionary forms of national identity.},
