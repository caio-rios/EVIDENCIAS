@article{ WOS:001872652800001,
Author = {Calvo-Rodriguez, Alvaro},
Title = {When does rejection of homosexuality matter? Gendered opportunity
   structures and radical-right support},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 AUG 18},
Abstract = {Why does rejection of homosexuality (RH) predict support for
   radical-right parties (RRPs) in some European countries but not in
   others? This article argues that RH becomes electorally consequential
   only under specific gendered opportunity structures: when gender
   conflict is politicised and when RRPs anchor gender and sexuality in
   religious-traditionalist frames. Conversely, when RRPs foreground Islam
   as the primary out-group, RH loses predictive power because the boundary
   of exclusion shifts from sexuality to civilisational identity. Evidence
   from 21 European countries (2017-2024) shows that increases in gender
   polarisation and religious traditionalism strengthen the RH-RRP link,
   whereas greater anti-Islam salience weakens it, especially where gender
   issues are weakly polarised. These findings show that the electoral
   relevance of attitudes towards homosexuality depends on how parties make
   such attitudes politically meaningful within specific competitive
   contexts.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
