@article{ WOS:001840327000001,
Author = {Krcmaric, Daniel},
Title = {Trump, the International Criminal Court, and the Future of Global
   Impunity},
Journal = {PERSPECTIVES ON POLITICS},
Year = {2026},
Month = {2026 AUG 5},
Abstract = {The US has traditionally played a key role in fighting global impunity
   for atrocity crimes, but the policies of Donald Trump's administration
   suggest that a dramatic shift in American priorities may be underway.
   This article examines America's commitment to addressing impunity in the
   context of US relations with the International Criminal Court (ICC). The
   Trump presidency, I argue, showcases a curious mix of continuity and
   change in America's relationship with one of the world's most prominent
   international institutions. In particular, Trump's general strategic
   approach to the ICC represents continuity with past American presidents,
   but the brazenness of the specific tactics Trump has used to oppose the
   ICC represents a notable change. The reverberations of recent American
   attacks on the ICC raise implications for the future of global impunity
   that will be felt in three distinct areas: in the US-ICC relationship,
   among ICC adversaries, and among ICC allies.},
Publisher = {CAMBRIDGE UNIV PRESS},
