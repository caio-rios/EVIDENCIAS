@article{ WOS:001825774200001,
Author = {Wack, Morgan and Duskin, Kayla and Hodel, Damian},
Title = {Political Fact-Checking Efforts are Constrained by Deficiencies in
   Coverage, Speed, and Reach},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Month = {2026 JUL 19},
Abstract = {Fact-checking has been promoted as a key method for combating political
   misinformation. Comparing the spread of election-related misinformation
   narratives along with their relevant political fact-checks, this study
   provides the most comprehensive assessment to date of the real-world
   limitations faced by political fact-checking efforts. In conceptualizing
   these barriers to impact, this study extends recent work from laboratory
   and experimental settings to the wider online information ecosystem
   present during the 2022 U.S. midterm elections. We find that fact-checks
   as currently developed and distributed are severely inhibited by
   constraints on their i. coverage, ii. speed, and iii. reach, which we
   link to fundamental challenges to the production economies and
   information asymmetries that differentiate corrections from
   misinformation. Specifically, we provide evidence that fewer than half
   of all prominent election-related misinformation narratives were
   fact-checked. Within the subset of fact-checked claims, we find that the
   median fact-check was released a full four days after the initial
   appearance of a narrative. Using network analysis to estimate user
   partisanship and dynamics of information spread, we find additional
   evidence that fact-checks make up less than 1.2\% of narrative
   conversations and that even when shared, fact-checks are nearly always
   shared within, rather than between, partisan communities. Finally, we
   provide empirical evidence which runs contrary to the assumption that
   fact-checking is politically biased. Through this assessment of the
   real-world influence of fact-checking efforts, our findings underscore
   how limitations in coverage, speed, and reach necessitate further
   examination of the use of fact-checks as the primary method for
   combating political misinformation.},
