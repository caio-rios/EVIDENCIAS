@article{ WOS:001903116100001,
Author = {Warner, Seth},
Title = {Partisan Wishful Thinking in Polarized Times},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 OCT 14},
Abstract = {Partisans engage in ``wishful thinking{''} ahead of elections, being
   more likely to expect their party to win than lose at the polls. This
   article asserts high expectations as endemic to the current polarized
   era in US politics. In today's presidential races, 90\% of voters expect
   their preferred candidate to triumph, a sharp increase from just two
   decades ago. Drawing on the American National Election Study's 2016-2024
   panel survey, I show that partisan animosity (or out-party hate) is
   robustly associated with high electoral hopes, and using surveys from
   1980 to the present, I show that it corresponds with a sizable share of
   the increase in these expectations over time. Finally, I explore
   reciprocity in this relationship. An analysis of ANES data from
   presidential elections between 1996 and 2024 finds that high
   expectations associate with greater post-election animosity among an
   election's losers, independently of their pre-election attitudes.},
