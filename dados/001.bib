@article{ WOS:001861415900001,
Author = {Lopez-Moctezuma, Gabriel and Johnson, Benjamin},
Title = {Social learning behind closed doors: evidence from seniority voting in
   the US Supreme Court},
Journal = {QUARTERLY JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Volume = {21},
Number = {4},
Pages = {313-338},
Month = {OCT 9},
Abstract = {We analyze the implications of seniority voting on Supreme Court
   decision-making. We provide reduced-form evidence consistent with
   justices learning from the votes of their senior colleagues as
   determined by the voting mechanism. To explain this evidence, we develop
   and estimate a model of sequential voting with social learning. In the
   model, justices weigh spatial payoffs against the appropriateness of
   their disposition and consider their preferences, private information
   and the choices of senior justices. We recover estimates of judicial
   preferences, expertise and learning and use them to assess the quality
   of Supreme Court dispositions relative to alternative voting mechanisms.
   We find that the quality of the Court's dispositions would have improved
   under an anti-seniority rule, in which junior justices are allowed to
   vote first.},
