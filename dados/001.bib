@article{ WOS:001855730700001,
Author = {Martinez, Andres Emiliano Sierra},
Title = {Defending water, defending place: Water insecurity and neighbour-based
   organising in Mexico City's popular neighbourhoods},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {130},
Month = {SEP},
Abstract = {This article examines what water defence means in a popular
   neighbourhood, produced through the labour of its residents. It
   conceptualises water insecurity as a force of displacement and examines
   how this unfolds in popular neighbourhoods. It focuses on the Water
   Defence Committee of Santo Domingo (WDC), a neighbour-based organisation
   in southern Mexico City that emerged in response to unreliable supply
   and the political manipulation of water distribution, and that
   campaigned for a new well connected to the pipe network. The analysis
   shows that water defence in this context involved reducing uncertainty,
   confronting clientelist forms of distribution, and shaping the
   neighbourhood's future. It argues that these are interrelated mechanisms
   through which water defence became a form of place defence. For WDC
   members, defending water meant defending their capacity to live and
   remain in their neighbourhood. By analysing water defence as place
   defence, the article contributes to debates on water insecurity, urban
   political ecology, infrastructural citizenship, and everyday
   environmentalism. Una version del texto en espanol esta disponible como
   material complementario.},
