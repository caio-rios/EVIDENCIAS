@article{ WOS:001917421300001,
Author = {Abuzaid, Motasem and Mazur, Kevin},
Title = {Incubating Revolution: How Social Networks and the Built Environment
   Sustain Mobilization},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2026},
Month = {2026 OCT 28},
Abstract = {How do challengers sustain mobilization under conditions of extreme
   repression? Social networks and the built environment are critical,
   interacting at two time scales. Settlement, chain migration, and
   everyday cooperation produce dense relational environments that shape
   motivations and constitute latent resources. When contention erupts,
   those dense social networks can be repurposed to sustain high-risk
   collective action, providing shelter, escape routes, information, and
   support. But their efficacy is limited without the organic built
   environment in which they form; its proximity, limited visibility, and
   constrained access amplify the effect of dense social ties in
   facilitating challenge under threat. We substantiate these claims using
   disaggregated data on protest in Damascus during the 2011 Syrian
   uprising, finding that neighbourhoods with both dense networks and
   organic built form exhibit significantly more frequent and
   confrontational mobilization. By analytically separating the social from
   the spatial, this article illuminates the mechanisms through which urban
   neighbourhoods become incubators of rebellion.},
