@article{ WOS:001898661800001,
Author = {Jan, Malo and Sattelmayer, Luis},
Title = {PartySOME II: a dataset on parties' issue agendas on social media},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 SEP 18},
Abstract = {Understanding how parties compete by shaping agendas and promoting issue
   priorities is central to the study of party competition. Existing
   research relies heavily on manifestos, limiting analyses to election
   periods and offline contexts, while newer datasets lack cross-national
   breadth, temporal depth, and conceptual harmonisation. This study
   introduces a comparative dataset of party issue agendas derived from
   4,600,000 social media posts for 219 parties across 18 European
   countries on Twitter, Facebook, and Instagram. Using supervised text
   classification aligned with the Comparative Agendas Project, monthly
   measures of salience over more than a decade are generated, providing
   conceptually standardised, cross-platform, and cross-nationally
   comparable indicators of issue attention. Our measures are validated
   through comparisons over time, across party families, major political
   shocks, and existing databases, and illustrate the dataset's leverage by
   showing how mainstream parties' immigration attention is associated with
   radical-right support gains. This dataset substantially expands the
   empirical infrastructure for studying dynamic issue competition.},
