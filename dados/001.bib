@article{ WOS:001844538500001,
Author = {Shieh, Marcy},
Title = {Examining the Influence of Media Coverage on Information-Seeking of
   Judicial Candidates},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Month = {2026 AUG 12},
Abstract = {Does news coverage stimulate curiosity in state high court candidates?
   Data compiled from the Associated Press and Google Trends from 2004 to
   2020 suggest that as media coverage increases on candidates, people are
   more likely to seek information about the candidates on Google.
   Furthermore, reports about the candidates' off-bench behavior are more
   likely to promote information-seeking behavior. State judicial selection
   method also plays a crucial role in information-seeking behavior, as
   coverage of nonpartisan justices motivates information-seeking
   regardless of the type of coverage. This study suggests that information
