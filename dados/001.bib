@article{ WOS:001845461500001,
Author = {Gilmore, Amy},
Title = {Pandemic (Im)mobilities: How humanitarian workers navigated evacuation
   and COVID-19},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {131},
Month = {DEC},
Abstract = {The construction of global South and global North geographies have long
   shaped and been shaped by the mobility of humanitarian staff toward
   crises (Lester \& Dussart, 2014). Less attention, however, is given to
   how these humanitarian geographies are also shaped by the evacuation of
   humanitarian staff from crises (Adey, 2024). Evacuation exposes the
   limits of humanitarian missions to address suffering amid and despite
   dire circumstances, as it also starkly illuminates existing hierarchies
   that value the lives of humanitarians over those they aim to help. Yet,
   there is little research on how humanitarians understand evacuations.
   This research addresses this gap by asking: How did humanitarian
   organizations and international staff navigate and understand evacuation
   during the COVID-19 pandemic and to what effects? This question emanates
   from mobility studies, which are attuned to how the humanitarian
   sector's practices of mobility and immobility reify raciocolonial
   geographies of the global North and global South. Based on 30 in-depth
   interviews with humanitarian workers, I argue that international
   humanitarian staff exercise evacuation refusals-choosing not to exercise
   South-North mobility at the start of the pandemic because of perceived
   inequities between themselves, their ``local{''} colleagues, and those
   they aim to help. However, I also demonstrate how evacuation refusals
   are co-constituted by racio-colonial mobility hierarchies, in that they
   are also understood by international humanitarian staff as facilitating
   a ``normal life{''} for them via their jobs and everyday lives in
   otherwise unprecedented circumstances. These findings have two major
   implications for humanitarian studies in political geography: (1) they
   reframe current literature on how COVID-19 (re) shaped they everyday
   practice and construction of humanitarian geographies and (2) they
   deepen and extend findings that show how humanitarian labor and (im)
   mobility both challenge and (re)produce global North-South hierarchies.},
Publisher = {ELSEVIER SCI LTD},
