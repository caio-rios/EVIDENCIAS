@article{ WOS:001920359800001,
Author = {Moore, Adam and Hong, Sujin and Pernet, Cyril R. and Morcom, Alexa M.
   and Roberts, Neil and Krasoulis, Agamemnon and Cram, Laura},
Title = {Partisan social cognition and biased experiences in a polarized world:
   The neural processing of identity-based group membership},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2026},
Volume = {47},
Number = {6},
Month = {NOV 2},
Abstract = {Pairing neuroimaging and behavioral testing, we offer new insights into
   affective polarization, hyper-partisanship, and their effects. Our
   findings introduce a temporal dimension to existing theoretical
   frameworks concerning the impact of social identity on political
   perceptions. We demonstrate that group-identity shapes in-the-moment
   neural processing of real-world experiences in a functional magnetic
   resonance imaging (fMRI) protocol and Cyberball game where participants
   experience varying levels of inclusion/exclusion from in/out-group
   members. In other words, people don't simply rely upon group membership
   (e.g., partisanship, national identity) to post-hoc rationalize an
   experience, but instead that group membership also actively biases
   neural processing of otherwise objectively identical experiences,
   shaping (and distorting) political perception, with significant
   behavioral effects.},
