@article{ WOS:001842378100001,
Author = {Herman, Lise Esther and Hoerner, Julian and Lacey, Joseph},
Title = {Shades of Negativity in European Parliament Debates: Exploring the
   Affective Dimension of Political Conflict in the EU's Rule of Law Crisis},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2026},
Volume = {61},
Month = {AUG 7},
Abstract = {This article seeks to explore the nature and determinants of political
   conflict in European Parliament (EP) debates within the unique context
   of the Rule of Law Crisis (RoLC). While previous research on this topic
   has mainly studied the ideological dimension of this conflict, we shift
   focus to the affective dimension, analysing the roles of negative
   sentiment and motive-based criticism through a quantitative analysis of
   53 hand-coded debates. We find that negativity dominates, and that this
   tone is adopted by Members of the EP (MEPs) irrespective of the
   ideological orientation or geographical origin of their national party.
   However, concerning levels of motive-based cynicism are primarily driven
   by MEPs from more right-wing, Eurosceptic and, to a lesser extent,
   Central and Eastern European parties. These findings suggest that the
   EP, an institution traditionally geared towards compromise-building, is
   becoming increasingly susceptible to the normative jeopardies of
   negative and attack politics when it comes to the RoLC.},
