Affiliations = {University of Fribourg},
Funding-Acknowledgement = {Research Foundation Flanders {[}1207623N]},
Funding-Text = {I would like to thank several ambitious women for inspiring me to write
   this piece: Teresa Bejan, whose incisive study of Astell on ambition led
   me to become fascinated with the topic in the first place; Mary Jo
   MacDonald, for reading multiple drafts and for countless exciting
   discussions on the topic while navigating the academic job market
   together; Elsa Kugelberg, for proving Lady Macbeth wrong, and showing
   that motherhood and ambition can flourish side by side; and finally, the
   early modern women I discuss in this article, for writing their
   fascinating, bold tracts that I do not think I will ever tire of writing
   about. I would also like to thank Jan Eijking and Shai Agmon for
   generous feedback on earlier drafts; audiences at UCLouvain, Nottingham,
   the Institute of Historical Research, ISIH at Aarhus, and APSA for their
   insightful comments and questions; and the Women in the History of
   Political Thought Network, whose community has been invaluable to this
   research. Lastly, I am grateful to the three anonymous reviewers and
   editors at AJPS for their constructive feedback and enthusiastic
   support. This research was supported by the FWO Research Foundation
   Flanders (Grant Number 1207623N).},
