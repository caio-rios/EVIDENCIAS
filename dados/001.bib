@article{ WOS:001785165100001,
Author = {Ferrin Pereira, Monica and Garcia-Albacete, Gema and Sanchez-Vitores,
   Irene},
Title = {Making Time to Be Informed: The Child Penalty in Political News
   Consumption},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {4},
Pages = {1354-1367},
Month = {OCT 1},
Abstract = {Women consume less media than men and are more likely to avoid political
   news. This gender gap in media consumption is frequently attributed to
   women's time constraints resulting from the combination of professional
   and caregiving responsibilities. One recent study documented the ``child
   penalty{''} for women, but the dynamics linking childcare to reduced
   news consumption remain unexplored. We propose four potential dynamics:
   a threshold effect, a short-term effect, an extra burden, and a
   ``building-up{''} effect. Fixed effects analysis of Dutch Longitudinal
   Internet Study for the Social Sciences panel data shows an immediate
   child penalty affecting women's political media use, with additional
   cumulative effects as infants grow. This ``building-up effect{''}
   appears for men only when children move toward their teens.
   Additionally, results suggest a shift in news consumption habits toward
   online sources, more evident for men. Finally, we find no support for
   the extra burden hypothesis, as the child penalty is independent of
   labor market participation.},
