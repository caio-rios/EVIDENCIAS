@article{ WOS:001840996800001,
Author = {Pratto, Felicia},
Title = {Social dominance orientation},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2026},
Volume = {47},
Number = {1},
Month = {AUG 5},
Abstract = {Social dominance orientation (SDO) refers to how much a person generally
   opposes group-based equality and supports group-based dominance. SDO is
   measured as an individual difference and pertains very broadly to
   people's socio-political attitudes and perceptions, to endorsement or
   rejection of political parties and candidates, and to behaviors that
   enforce organizational hierarchies. This paper reviews empirical
   evidence published from 2010 to 2024 concerning social dominance
   orientation, first presenting evidence of its stability over time and
   measurement integrity, next showing that, across numerous cultures and
   languages and ways of measuring group prejudice and stereotypes, SDO
   correlates with prejudice favoring people in dominant groups rather than
   people in subordinate groups, and that this effect is stronger within
   dominant groups than subordinate groups. Similarly, we review evidence
   that people higher on SDO are more anti-social and tend to take
   hierarchy-enhancing rather than hierarchy-attenuating roles. We then
   delve into the psychology of SDO and summarize the evidence for the
   relation of SDO and closed cognitive styles, low scores on
   humility-honesty, and low concern for other people rather than the self.
   Using existing adult and child development studies, we outline two
   processes by which higher SDO may develop: one based on learning to
   categorize and to rank categories as superior/inferior, and one based on
   parents' emphasis on obtaining high status to gain approval. We conclude
   by outlining the next questions that might be pursued.},
