@article{ WOS:001857431800001,
Author = {Fong, Christian and Lowande, Kenneth and Eldes, Ayse},
Title = {Checks, Balances, and Presidential Ambitions},
Journal = {QUARTERLY JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Volume = {21},
Number = {3},
Pages = {249-288},
Month = {SEP 8},
Abstract = {This study investigates the relationship between running for president
   and members' contributions to the core legislative functions that impact
   Congress's standing relative to the presidency. This study finds some
   evidence that ambitious legislators attend roll call votes and oversight
   hearings at lower rates, but at the same time, they are more
   legislatively productive, conduct just as much informal oversight and
   are equally informational in their public oversight. When Congress votes
   on an issue that affects the balance of power between Congress and the
   president, they are more likely to side with Congress than legislators
   without presidential ambitions are. These behavioral differences persist
   even after their presidential runs, which suggests they are not driven
   by a strategic effort to audition for the presidency.},
Publisher = {EMERALD GROUP PUBLISHING LTD},
Address = {Floor 5, Northspring 21-23 Wellington Street, Leeds, W YORKSHIRE,
   ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Fong, C (Corresponding Author), Univ Michigan, Dept Polit Sci, Ann Arbor, MI 48109 USA.
