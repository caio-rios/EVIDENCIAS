@article{ WOS:001851173800001,
Author = {Hariharan, Ananya and Barreto, Matt A. and Dunn, Chad W.},
Title = {Mapping racial voting patterns: Using RPV dispersion plots to measure
   and visualize voting rights evidence},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {130},
Month = {SEP},
Abstract = {Inferring individuals' vote choice based off of aggregate data often
   estimates candidate preference by racial group using Bayesian
   statistics. One context in which this happens often is in voting rights
   litigation, where plaintiffs must prove that minority voters have a
   clear candidate-of-choice and white voters consistently vote against
   this candidate. In small jurisdictions or jurisdictions with low
   turnout, even if racially polarized voting exists, EI models can produce
   large standard errors and overlapping confidence intervals to imply
   unclear voter preferences. Point estimates from EI models can also be
   substantively similar because EI RxC treats different racial groups
   symmetrically. This means that by design, EI models offer conservative
   estimates of heterogeneity in group preferences. Building on Hariharan
   et al., 2026, we offer an additional type of analysis to supplement
   assessments of candidate preference by race. Racially Polarized Voting
   (RPV) Dispersion Plots evaluate variations in candidate preference
   across precincts by plotting the deviation between a null standard -
   that candidate preference is distributed across precincts in proportion
   to the number of votes that cast within each precinct. The plots
   visually depict how those deviations correlate with within-jurisdiction
   variation in racial and ethnic demographics. We validate the RPV
   Dispersion Plots using higher-turnout elections in which federal courts
   have concluded that ecological inference models demonstrate racially
   polarized voting.},
