@article{ WOS:001851616000001,
Author = {Mujtahid, Insyirah and Rashid, Nurul Huda and Jaidka, Kokil},
Title = {Reclaiming Place Through Symbolic Geographies: Visual Resistance on
   Palestinian Instagram},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Month = {2026 AUG 17},
Abstract = {This study examines how Palestinian Instagram users deploy visual
   symbols to construct symbolic geographies, which are the visual and
   textual claims to space and belonging shaped by cultural memory,
   emotional connection, and political contestation. Drawing on 9,126 posts
   from 834 users, we analyze how visual storytelling operates as a means
   of simulating physical presence under conditions of occupation,
   censorship, and algorithmic suppression. Through multimodal analysis, we
   identify three overarching communicative goals: (1) claiming contested
   spaces through visual-textual pairings that assert spatial belonging;
   (2) coding resistance through strategic ambiguity that subverts
   moderation while maintaining narrative coherence; and (3) collective
   remembering through temporal anchoring and visual repetition that
   sustain national memory over time. We interpret these practices through
   the lens of countervisuality: affective and communicative
   infrastructures that, within our sample, sustain visibility against
   geopolitical and epistemic erasure. Our findings extend research on
   digital placemaking, memory activism, and visual politics by showing how
   ordinary users transform ephemeral posts into a networked archive of
   cultural survival, and by offering a conceptual framework for
   understanding symbolic geographies as a product of strategic, multimodal
   storytelling under structural marginalization.},
