@article{ WOS:001848368900001,
Author = {Dalle Mulle, Emmanuel and Abts, Koen and Froio, Caterina and Kessel,
   Stijn van},
Title = {A Joint Venture? The Ideological Foundations of the Populist Radical
   Right's Economic Agenda Beyond Welfare Policies},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {3},
Pages = {509-530},
Month = {SEP},
Abstract = {Recently, the socio-economic agenda of populist radical right parties
   (PRRPs) has attracted growing scholarly interest, yet many studies focus
   specifically on positions on welfare policies. It is often argued that
   economic issues are of secondary importance to PRRPs, or that their
   positions are deliberately blurred to maximize electoral appeal. This
   article qualifies these assumptions by showing that PRRPs' economic
   policies are underpinned by a more consistent ideological logic than is
   commonly acknowledged. Drawing on a longitudinal qualitative analysis of
   four established PRRPs in Belgium, France, Italy and the Netherlands, we
   examine party positions across five economic policy domains. We find
   that PRRPs combine pro-market commitments with nationalist-protectionist
   elements. These issue positions are rendered coherent through a
   recurring repertoire of interpretative frames - economic chauvinism,
   populism and producerism - which operate as higher-level justificatory
   schemata. These frames provide an enduring discursive structure through
   which PRRPs reconcile flexibility in policy content with ideological
   coherence.
   In j \& uuml;ngster Zeit st \& ouml;sst die sozio \& ouml;konomische
   Agenda rechtspopulistischer Parteien (PRRPs) in der Forschung auf
   wachsendes Interesse, doch viele Studien konzentrieren sich prim \&
   auml;r auf wohlfahrtspolitische Positionen. H \& auml;ufig wird
   argumentiert, dass \& ouml;konomische Fragen f \& uuml;r
   rechtspopulistische Parteien von sekund \& auml;rer Bedeutung seien oder
   dass ihre Positionen bewusst vage gehalten werden, um den Wahlerfolg zu
   maximieren. Dieser Artikel relativiert diese Annahmen und zeigt, dass
   die Wirtschaftspolitik von PRRPs von einer konsistenteren ideologischen
   Logik getragen wird als gemeinhin angenommen. Auf der Grundlage einer
   qualitativen L \& auml;ngsschnittanalyse von vier etablierten
   rechtspopulistischen Parteien in Belgien, Frankreich, Italien und den
   Niederlanden untersuchen wir die Parteipositionen in f \& uuml;nf
   wirtschaftspolitischen Bereichen. Die Ergebnisse zeigen, dass PRRPs
   pro-marktliche Verpflichtungen mit nationalistisch-protektionistischen
   Elementen verkn \& uuml;pfen. Koh \& auml;renz erhalten diese Positionen
   durch ein wiederkehrendes Repertoire interpretativer Rahmen (frames) -
   \& ouml;konomischer Chauvinismus, Populismus und Produzentismus (\&
   laquo; producerism \& raquo;) -, die als \& uuml;bergeordnete
   Rechtfertigungsschemata fungieren. Diese Frames bieten eine dauerhafte
   diskursive Struktur, mit der rechtspopulistische Parteien Flexibilit \&
   auml;t in den politischen Inhalten mit ideologischer Koh \& auml;renz
   vereinbaren.
   Derni \& egrave;rement, l'agenda socio-\& eacute;conomique des partis de
   la droite radicale populiste (PRRP) a suscit \& eacute; un int \&
   eacute;r \& ecirc;t croissant parmi les chercheur-euse-s. Toutefois,
   nombreuses \& eacute;tudes se focalisent en particulier sur les
   positions relatives aux politiques de protection sociale. Il est souvent
   avanc \& eacute; que les questions \& eacute;conomiques rev \&
   ecirc;tent une importance secondaire pour ces partis, ou que leurs
   positions sont d \& eacute;lib \& eacute;r \& eacute;ment floues afin de
   maximiser leur attrait \& eacute;lectoral. Cet article nuance ces hypoth
   \& egrave;ses en d \& eacute;montrant que les politiques \&
   eacute;conomiques des PRRP sous-tendent une logique id \&
   eacute;ologique plus coh \& eacute;rente qu'on ne le reconna \& icirc;t
   g \& eacute;n \& eacute;ralement. En nous appuyant sur une analyse
   qualitative longitudinale de quatre partis de la droite radicale
   populiste \& eacute;tablis en Belgique, en France, en Italie et aux
   Pays-Bas, nous examinons leurs positions \& agrave; travers cinq
   domaines de politique \& eacute;conomique. Nos r \& eacute;sultats
   indiquent que ces partis conjuguent des engagements pro-march \& eacute;
   avec des \& eacute;l \& eacute;ments nationalistes-protectionnistes. La
   coh \& eacute;rence de ces positions est assur \& eacute;e par un r \&
   eacute;pertoire r \& eacute;current de cadres interpr \& eacute;tatifs
   (frames) - le chauvinisme \& eacute;conomique, le populisme et le
   productivisme (\& laquo; producerism \& raquo;) - qui op \& egrave;rent
   comme des sch \& eacute;mas justificatifs de niveau sup \& eacute;rieur.
   Ces frames offrent une structure discursive durable permettant aux
   partis de la droite radicale populiste de concilier la flexibilit \&
   eacute; du contenu programmatique avec la coh \& eacute;rence id \&
   eacute;ologique.
   Negli ultimi anni, l'agenda socioeconomica dei partiti della destra
   radicale populista (PRRP) ha suscitato un interesse accademico
   crescente. Tuttavia, molti studi si concentrano prevalentemente sulle
   posizioni relative alle politiche di welfare. Si sostiene spesso che le
   questioni economiche siano di secondaria importanza per i PRRP, o che le
   loro posizioni siano deliberatamente ambigue per massimizzare il
   consenso elettorale. Questo articolo ridimensiona tali assunti,
   dimostrando che le politiche economiche dei PRRP sono sostenute da una
   logica ideologica pi \& ugrave; coerente di quanto comunemente
   riconosciuto. Basandoci su un'analisi qualitativa longitudinale di
   quattro PRRP storici in Belgio, Francia, Italia e Paesi Bassi,
   esaminiamo le posizioni di questi partiti in cinque ambiti di politica
   economica. I risultati evidenziano come i PRRP combinino impegni in
   favore del libero mercato con elementi nazionalisti-protezionistici.
   Tali posizioni sono rese coerenti attraverso un repertorio ricorrente di
   cornici interpretative (frames) - lo sciovinismo economico, il populismo
   e il produttivismo ({''}producerism{''}) - che operano come schemi
   giustificativi di livello superiore. Questi frames offrono una struttura
   discorsiva duratura attraverso la quale i PRRP riescono a conciliare la
   flessibilit \& agrave; dei contenuti programmatici con la coerenza
   ideologica.},
