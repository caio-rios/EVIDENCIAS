@article{ WOS:001849480100001,
Author = {Liu, Hanzhang and Yao, Linan},
Title = {Entertainment as Trojan Horse: Voluntary Consumption of Propaganda in
   China},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Month = {2026 AUG 15},
Abstract = {For authoritarian propaganda to change hearts and minds, it must first
   reach the masses and capture their attention. In an era of media
   proliferation, what can an authoritarian regime do to make ordinary
   citizens consume pro-regime propaganda voluntarily? How can it lower
   citizens' resistance to being indoctrinated? In this article, we answer
   these questions by studying a new generation of propaganda movies in
   contemporary China. Leveraging observational data and a pre-registered
   survey experiment, we find that entertainment elements in propaganda
   movies - both personality-based and narrative-based - play a key role in
   appealing to viewers and increasing consumption; this effect is
   especially pronounced among groups that are the least inclined to expose
   themselves to propaganda in the first place. Also, viewers are more
   receptive to political indoctrination when it is interwoven with
   entertainment, even when they recognize such content. Combined, these
   findings highlight the importance of entertainment in authoritarian
   propaganda: not only does it serve as a vehicle to disseminate political
   indoctrination, but it also functions as a source of appeal that renders
   such indoctrination more palatable to the masses.},
