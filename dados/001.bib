@article{ WOS:001866219300001,
Author = {Fenech, Dominic},
Title = {The 2026 Maltese general election: Labour's staying power},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 JUL 23},
Abstract = {A parliamentary election held in May 2026 in Malta returned the Labour
   Party (PL) for a record fourth consecutive victory over its Nationalist
   (PN) rival, with as usual only two parties gaining seats. The gap
   between the two parties narrowed by half, but remained considerable at 7
   per cent. Labour's strongest point was the enduring booming economy,
   even if this had its downside in terms of congestion, environmental
   threats and other common fallouts from rapid economic expansion. Apart
   from the expectation of government fatigue and the election of a new
   leader, the PN had little that was new in their arsenal, offering no
   real alternatives to ongoing economic or other policies, such as
   business friendliness and the environment, and only hoped to compete by
   outmatching the PL's promises of short-term largesse.},
