@article{ WOS:001839142700001,
Author = {Head, Naomi},
Title = {Affective regimes and ontological security: When empathy threatens the
   state},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2026},
Volume = {47},
Number = {5},
Month = {AUG 4},
Abstract = {The ontological security of states may be threatened by the politics of
   empathy. Empathy-as a contested affective-political field-has a capacity
   to both consolidate and unravel dominant understandings of identity,
   security, political subjectivity, and self-other relations. This article
   connects a politics of empathy to patterns of state violence and
   resistance in situations of conflict and authoritarian politics, arguing
   that the distribution of feeling that underpins a politics of empathy is
   structured by positionality, power, and social context. The article
   argues that states construct ``affective regimes{''} through which they
   seek to manage the legitimate subjects of empathy in order to maintain
   their ontological security, and focuses on empirical testimony from the
   Syrian uprising in 2011 and the Assad regime's strategies of violence to
   explore these affective dynamics. It reveals ways in which the state's
   efforts are always resisted and transgressed by citizens, generating
   counter-narratives of security-identity and affective relations. A
   politics of empathy offers analytical tools for understanding the
   construction and effectiveness of states' affective regimes to maintain
   ontological security as well as being normatively essential to the task
   of challenging forms of state power, political violence, and generating
   alternative imaginings of ontological security and subjectivity.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Head, N (Corresponding Author), Univ Glasgow, Sch Social \& Polit Sci, Glasgow City, Scotland.
   Head, Naomi, Univ Glasgow, Sch Social \& Polit Sci, Glasgow City, Scotland.},
DOI = {10.1111/pops.70183},
Article-Number = {e70183},
ISSN = {0162-895X},
EISSN = {1467-9221},
Keywords = {affective regimes; ontological security; political violence; politics of
