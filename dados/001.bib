@article{ WOS:001873816500001,
Author = {Crulli, Mirko and Piccolino, Gianluca},
Title = {Culture Trumps Class and Place: How the Populist Radical Right Thrives
   on Sociocultural Conflicts in Western Europe},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2026},
Volume = {61},
Month = {SEP 14},
Abstract = {Using original survey data from seven Western European countries, this
   article investigates which social conflicts populist radical right
   parties (PRRPs) represent. Methodologically, it innovates by measuring
   individuals' positions within conflicts combined with the importance
   they attach to them, capturing both attitudinal alignment and salience.
   The analysis tests whether traditional cleavages or new conflicts
   related to globalisation and cultural value change better explain PRRP
   voting. Findings show that PRRPs predominantly represent new conflicts -
   individuals opposing cosmopolitanism, LGBTQ+ rights and environmental
   sustainability - rather than class or territorial divides. While
   socio-structural traits such as being a production worker or rural
   resident predict PRRP voting, supporting these groups does not. This
   decoupling of structure and conflict positions suggests working-class
   and rural voters are motivated more by culturally reframed grievances
   than by class- or place-based solidarities. These results highlight the
   weak link between classic cleavages and PRRP voting, underscoring the
   centrality of cultural demarcation in today's political conflict.},
