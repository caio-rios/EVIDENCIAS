@article{ WOS:001866214600001,
Author = {Webb, Paul and Bale, Tim and Chrona, Stavroula},
Title = {Personality, populism and party: support for `dark triad' leaders in the
   UK},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 AUG 13},
Abstract = {This article examines whether political party members' personality
   traits shape their preferences for political leaders. This is of
   considerable significance given how many leaders are selected by party
   members today. Drawing on a post-2024 UK general election survey of over
   4,000 members of five British parties, the study investigates the
   relationship between members' Dark Triad traits - narcissism,
   Machiavellianism, and psychopathy - and their preferences for leaders
   exhibiting similar characteristics. The findings reveal that members of
   right-conservative parties (Reform UK and the Conservatives) score
   higher on Dark Triad measures than members of left-liberal parties
   (Labour, the Liberal Democrats, and the Greens). Moreover, individuals
   with stronger Dark Triad traits are more likely to favour leaders
   displaying those qualities. The results highlight the importance of
   psychological congruence between leaders and followers. The findings
   also suggest psychological convergence between mainstream and
   radical-right party memberships, thereby reinforcing an emerging
   consensus that the UK is characterised by two-bloc, rather than
   two-party, politics.},
