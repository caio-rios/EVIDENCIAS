@article{ WOS:001914359100001,
Author = {Green-Pedersen, Christoffer and Hjermitslev, Ida Baek and Tromborg,
   Mathias Wessel},
Title = {Learning from Coalition Politics: How Episodes of Increased Complexity
   Can Enhance Citizens' Political Efficacy},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 OCT 25},
Abstract = {Coalition politics presents a major challenge for citizens. Not only do
   they need to know the parties' policy profiles, but also who the parties
   are willing to collaborate with. This task is becoming increasingly
   difficult as new coalition patterns emerge across Western Europe.
   Coalition politics may therefore be a major source of frustration for
   citizens, leading to a sense that politics is too complex to understand,
   that is, a sense of limited internal political efficacy. Surprisingly,
   we know little about whether this is actually the case. We analyze this
   question using a four-wave panel survey during and after the Danish 2022
   general election, an unusually complex election where several parties
   defied traditional coalition structures. Despite this complexity, we
   demonstrate that Danish citizens gained more internal efficacy during
   this episode because they learned about the relevant facts. Yet, we find
   no evidence that people who learned similar facts in the post-government
   formation period felt more efficacious in response. This suggests that
   knowledge of coalition politics is critical for citizens' internal
   efficacy, but only when complex coalition dynamics are on the agenda.},
