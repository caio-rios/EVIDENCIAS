@article{ WOS:001905837700001,
Author = {Perez, Efren},
Title = {Solidarity between US people of color: Synthesizing evidence,
   highlighting challenges, and proposing actionable solutions},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2026},
Volume = {47},
Number = {1},
Month = {OCT 18},
Abstract = {Mounting research establishes that solidarity between U.S. people of
   color (PoC) is triggered when a racially stigmatized ingroup believes
   they are discriminated similarly to another outgroup based on their
   alleged inferiority or foreignness. This heightened solidarity then
   produces political opinions and behaviors that benefit stigmatized
   outgroups who are not one's own-for example, Black adults become more
   pro-Latino, Asian adults become more pro-Black, and Latino adults become
   more pro-Asian. This essay organizes, discusses, and synthesizes the
   overflowing evidence on this solidarity mechanism, paying special
   attention to its generality across stigmatized groups and political
   settings. The essay then highlights major pending challenges and
   opportunities to learn more about U.S. inter-minority solidarity,
   emphasizing rival explanations, complementary pathways, and
   methodological pluralism. In parallel, this latter discussion
   illustrates the advantages of creating greater conceptual and
   theoretical synergy with comparativist research on ethnic identities and
   political conflict in nations across sub-Saharan Africa, South Asia, and
   Western Europe. Finally, the article outlines new research agendas to
   deepen our understanding about U.S. inter-minority politics, paying
   special attention to intra-group processes that regulate solidarity's
   vitality in an uncertain, complex, and threatening polity.},
