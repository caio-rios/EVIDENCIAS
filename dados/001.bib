@article{ WOS:001842331500001,
Author = {Dawson, Mia Karisa},
Title = {Abolition and the everyday life of Sacramento's carceral housing crisis},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {131},
Month = {DEC},
Abstract = {Sacramento is home to an extensive system of prisons and policing and to
   a severe housing crisis. It is also home to a coalition of abolitionist
   organizations fighting to end incarceration and housing precarity. For
   these organizations, incarceration and housing precarity are approached
   simultaneously as they impact the same people, benefit the same capital
   interests, and produce overlapping conditions of life inside and outside
   of prison. In this paper, I conceptualize this situation as a carceral
   housing crisis. I identify the everyday mechanisms that drove this
   crisis through interviews with people experiencing homelessness,
   incarceration, and probation. I then contextualize these mechanisms with
   practices developed by abolitionist organizers in Sacramento to
   intervene. In doing so, I consider how abolitionist ideals are made
   material through local practices of non-capitalism and non-coercion.},
