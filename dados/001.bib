@article{ WOS:001764768200001,
Author = {Hassell, Hans J. G. and McCrain, Joshua and Miles, Matthew R.},
Title = {Gendered Barriers to Entry: Responses to Requests for State Legislative
   Internships},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {4},
Pages = {1650-1656},
Month = {OCT 1},
Abstract = {Underrepresented in positions of political leadership, women face higher
   barriers in recruitment and promotion for high-level positions in
   politics. We show that higher barriers to entry for women, compared to
   men, extend to the lowest positions in politics. Using a field
   experiment with state legislators, we find women receive less
   information and fewer opportunities when inquiring about state
   legislative internships and that these patterns are driven by
   Republicans. In addition, we show that women legislators are as
   discriminatory against women students inquiring about internships as are
   men legislators. Lastly, we also show differences in response rates
   disappear when students provide information about previous political
   volunteering experience with local and campus party organizations.
   Overall, our results shed light on the nature and origins of the
   barriers women face to enter the political arena.},
