@article{ WOS:001853321600001,
Author = {Abts, Koen and Priem, Guido and Galle, Jolien and Meeusen, Cecil and
   Meuleman, Bart},
Title = {The Dual Position of Established Outsiders: How Ethnic Identification
   and Discrimination Shape Welfare Chauvinism among Ethnic Minority Groups},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2026},
Volume = {32},
Number = {3},
Pages = {531-554},
Month = {SEP},
Abstract = {Research on welfare chauvinism often assumes a homogeneity of attitudes
   towards welfare state inclusiveness within both majority and minority
   populations, overlooking that certain minority subgroups may also oppose
   extending welfare benefits to other migrants. Using a probability sample
   of Belgians of Moroccan or Turkish descent (from Li \& egrave;ge and
   Antwerp), this study tests to what extent traditional explanations -
   self-interest and values - apply to established migrants similarly to
   how they do to the native population. In addition, we test two
   group-specific explanations - ethnic identification and perceived
   discrimination - that stem from their dual position within society. Our
   results show that identification with the ethnic community decreases
   welfare chauvinistic attitudes. However, the effect of perceived
   discrimination varies depending on the domain in which it is
   experienced: Discrimination in daily life tends to reduce welfare
   chauvinism, while perceived discrimination by government agencies and in
   the labor market is not related.
   Forschung zu Wohlfahrtschauvinismus geht h \& auml;ufig von homogenen
   Einstellungen zur Inklusivit \& auml;t des Sozialstaats sowohl innerhalb
   der Mehrheits- als auch der Minderheitenbev \& ouml;lkerung aus. Dabei
   wird \& uuml;bersehen, dass auch bestimmte Teilgruppen von Minderheiten
   die Ausweitung von Sozialleistungen auf andere Migrant:innen ablehnen k
   \& ouml;nnen. Basierend auf einer Zufallsstichprobe von Belgier:innen
   marokkanischer oder t \& uuml;rkischer Herkunft (aus L \& uuml;ttich und
   Antwerpen) untersucht diese Studie, inwiefern traditionelle Erkl \&
   auml;rungsans \& auml;tze - Eigennutz und Werte - auf etablierte
   Migrationsbiografien \& auml;hnlich zutreffen wie auf die einheimische
   Bev \& ouml;lkerung. Zudem testen wir zwei gruppenspezifische Erkl \&
   auml;rungsfaktoren - ethnische Identifikation und wahrgenommene
   Diskriminierung -, die sich aus deren dualer Position innerhalb der
   Gesellschaft ergeben. Unsere Ergebnisse zeigen, dass die Identifikation
   mit der ethnischen Gemeinschaft wohlfahrtschauvinistische Einstellungen
   verringert. Der Effekt wahrgenommener Diskriminierung variiert jedoch je
   nach Bereich, in dem sie erfahren wird: Diskriminierung im Alltag f \&
   uuml;hrt eher zu einer Reduzierung von Wohlfahrtschauvinismus, w \&
   auml;hrend wahrgenommene Diskriminierung durch Beh \& ouml;rden und auf
   dem Arbeitsmarkt in keinem Zusammenhang dazu steht.
   Les travaux sur le chauvinisme social (welfare chauvinism) reposent
   souvent sur l'hypoth \& egrave;se d'une homog \& eacute;n \& eacute;it
   \& eacute; des attitudes \& agrave; l'\& eacute;gard de l'inclusivit \&
   eacute; de l'\& Eacute;tat-providence au sein de la population
   majoritaire comme des minorit \& eacute;s, n \& eacute;gligeant le fait
   que certains sous-groupes minoritaires peuvent \& eacute;galement
   s'opposer \& agrave; l'extension des prestations sociales \& agrave;
   d'autres personnes immigr \& eacute;es. \& Agrave; partir d'un \&
   eacute;chantillon probabiliste de personnes belges d'origine marocaine
   ou turque (issues de Li \& egrave;ge et d'Anvers), cette \& eacute;tude
   examine dans quelle mesure les explications traditionnelles - l'int \&
   eacute;r \& ecirc;t personnel et les valeurs - s'appliquent aux
   personnes issues de l'immigration de la m \& ecirc;me mani \& egrave;re
   qu'\& agrave; la population autochtone. De plus, nous testons deux
   explications sp \& eacute;cifiques aux groupes - l'identification
   ethnique et la discrimination per \& ccedil;ue - qui d \& eacute;coulent
   de leur double positionnement au sein de la soci \& eacute;t \& eacute;.
   Nos r \& eacute;sultats montrent que l'identification \& agrave; la
   communaut \& eacute; ethnique r \& eacute;duit les attitudes chauvines
   en mati \& egrave;re de protection sociale. Toutefois, l'effet de la
   discrimination per \& ccedil;ue varie selon le domaine dans lequel elle
   est v \& eacute;cue: la discrimination au quotidien tend \& agrave; r \&
   eacute;duire le chauvinisme social, tandis que la discrimination per \&
   ccedil;ue \& eacute;manant des services publics ou pr \& eacute;sente
   sur le march \& eacute; du travail n'y est pas li \& eacute;e.
   La ricerca sul sciovinismo dello stato sociale (welfare chauvinism)
   presuppone spesso un'omogeneit \& agrave; di atteggiamenti nei confronti
   dell'inclusivit \& agrave; dello stato sociale sia all'interno della
   popolazione maggioritaria sia in quella minoritaria, trascurando il
   fatto che anche determinati sottogruppi di minoranze possono opporsi
   all'estensione delle prestazioni sociali ad altri gruppi di migranti.
   Utilizzando un campione probabilistico di cittadine e cittadini belgi di
   origine marocchina o turca (provenienti da Liegi e Anversa), questo
   studio verifica in che misura le spiegazioni tradizionali - interesse
   personale e valori - si applichino alle popolazioni di origine
   migratoria in modo analogo a quanto avviene per la popolazione
   autoctona. Inoltre, verifichiamo due fattori esplicativi specifici -
   l'identificazione etnica e la discriminazione percepita - derivanti
   dalla loro duplice posizione all'interno della societ \& agrave;. I
   nostri risultati dimostrano che l'identificazione con la comunit \&
   agrave; etnica riduce gli atteggiamenti di sciovinismo sociale.
   Tuttavia, l'effetto della discriminazione percepita varia a seconda
   dell'ambito in cui viene vissuta: la discriminazione nella vita
   quotidiana tende a ridurre lo sciovinismo sociale, mentre la
   discriminazione percepita da parte delle istituzioni pubbliche e sul
   mercato del lavoro non presenta alcuna associazione significativa.},
