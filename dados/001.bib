@article{ WOS:001873574300001,
Author = {Gamboa, Laura},
Title = {Drivers of opposition strategic choices against democratic backsliding},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 SEP 11},
Abstract = {Why do oppositions use different strategies against executive-led
   democratic backsliding? This article answers this question by focusing
   on party system institutionalization, opposition composition, and civil
   society strength. Countries with more institutionalized parties and
   party systems when the autocrat comes to power, I argue, are more likely
   to have oppositions led by experienced politicians who understand,
   value, and know how to use institutional strategies, and are thus more
   prone to use legislation, litigation or elections to prevent the erosion
   of democracy. Countries in which party systems collapse shortly after
   the autocrat comes to power, on the contrary, are more likely to have
   oppositions led by civil society groups that are less likely to
   understand, trust or know how to use institutional resources (and more
   likely to understand, trust and know how to use the streets). In these
   cases, I propose, oppositions will be more prone to use
   extra-institutional strategies. I develop this argument using an
   original dataset of episodes of democratic erosion in Latin America, to
   explore existing correlations between party system institutionalization,
   opposition composition, and strategic choice as well as five short case
   studies (Mexico, Colombia, Venezuela, Bolivia and El Salvador) to unpack
   the causal mechanisms of the argument.},
