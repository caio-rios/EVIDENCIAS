@article{ WOS:001904452700001,
Author = {Lu, Shenghua and Wang, Hui},
Title = {Culture Holds us Together: Confucian Clan Culture and Collective Actions
   in China's Land Expropriation},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 OCT 15},
Abstract = {In the face of property rights violation, why are some groups of people
   more likely to take collective actions than others? In this paper, we
   propose that culture is an important but not fully investigated factor
   accounting for this question. We examine the effect of Confucian clan
   culture, one of the most far-reaching traditional cultures inherited
   from ancient China, on collective struggle against land expropriation.
   We build a unique dataset combining the prefecture-level clan culture
   intensity and nationwide administrative litigations related to land
   expropriation between 2014 and 2019. Using the large cross-regional
   variation in the patterns of administrative litigation and a novel
   instrumental variable approach, this paper finds that prefectures with
   stronger clan culture have a significantly larger number of plaintiffs
   appearing in administrative lawsuit cases, implying that clan culture
   promotes more pervasive collective actions in confronting state power.
   Analysis based on individual-level survey data shows that the higher
   levels of trust between relatives and neighbors and stronger willingness
   for self-interest-related participation accompanied by stronger
   Confucian clan culture are the main mechanisms. Our findings underscore
   the pivotal role of cultural factors in shaping social stability and
   influencing local governance.},
