@article{ WOS:001873637900001,
Author = {Oklobdzija, Stan and Witko, Christopher},
Title = {Backlashes to Gender Equality and Authoritarian Populism in the US},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2026},
Month = {2026 SEP 10},
Abstract = {According to recent scholarship, backlash toward gender equality is
   fueling support for the authoritarian and populist right in many
   countries and, perhaps, the rise of Trumpism in the U.S. Yet, there are
   potentially different types of backlash to gender equality. We argue
   that the rising status of women over the past several decades may result
   in anti-feminist attitudes, not just among older men who yearn for the
   traditional gender arrangements of their youth as some scholars argue,
   but also among younger, single men lacking college degrees, who are less
   attractive partners for women. We call this ``mate-value backlash.{''}
   Using ANES data, we find that anti-feminist attitudes have long been
   associated with support for Republican presidential candidates, but only
   in recent years have these attitudes become more prominent among
   unmarried men, without college degrees.},
