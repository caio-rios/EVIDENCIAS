@article{ WOS:001897680000001,
Author = {Laufer, Luna and Gerstner, Laura and Kinzler, Pia and Stockwald, Julia
   and Sacher, Anna-Luisa and Reinemann, Carsten},
Title = {Powered by (discrete) emotions? The consequences of affective
   polarization for self-censorship and outgroup silencing},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2026},
Month = {2026 OCT 8},
Abstract = {Amid ongoing debates about political polarization in Western
   Democracies, this study investigates the role of affective polarization
   in the context of practices related to political discourse. In doing so,
   it moves beyond generalized affective polarization and delves into
   discrete negative emotions (fear, disgust, and anger), examining how
   they relate to the willingness to engage in self-censorship and the
   belief in the importance of silencing others, i.e., the respective
   political outgroup. Findings from a quota-based online survey conducted
   in autumn 2024 in Germany (N = 1,918) reveal that the effects of
   affective polarization vary depending on the underlying emotion: fear of
   the political outgroup is linked to an increased willingness to
   self-censor. In contrast, anger is associated with a reduced willingness
   to self-censor, while all three negative emotions are connected to a
   higher belief in the importance to silence the political outgroup. These
   results underscore the critical role of discrete emotions in affective
   polarization, offering nuanced insights that extend beyond generalized
   dislike. In addition, they provide valuable insights into how affective
   polarization may threaten democratic values.},
