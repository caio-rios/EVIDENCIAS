@article{ WOS:001845935900001,
Author = {Secen, Sefa and Kilinc, Ramazan},
Title = {The War on Universities: Illiberal Tactics in Turkey, Hungary, and the
   United States},
Journal = {PERSPECTIVES ON POLITICS},
Year = {2026},
Month = {2026 AUG 12},
Abstract = {Illiberal governments increasingly target universities as sites of
   political dissent and ideological opposition. This paper compares three
   illustrative cases-Bo \& gbreve;azi \& ccedil;i University under Recep
   Tayyip Erdo \& gbreve;an, Central European University under Viktor Orb
   \& aacute;n, and elite US universities under Donald Trump-to examine how
   illiberal governments deploy state power against autonomous,
   high-profile, liberal-aligned institutions of higher education, and how
   students and faculty respond. Although universities are not always
   bastions of pluralism, tolerance, and democracy, attacks on universities
   are often concurrent with illiberal governance. We argue that illiberal
   governments perceive universities as vanguards of hegemonic liberalism
   and as partisan opponents in certain contexts, and that state repression
   operates along a continuum of coercion, legal displacement, and
   discursive delegitimation. These attacks on academic autonomy trigger
   varied responses-from mobilization, to fragmentation, to
   withdrawal-shaped by domestic political opportunity structures, the
   intensity of state repression, and campus culture. By conceptualizing
   the university as a contested political institution rather than a
   neutral educational space, this article contributes to broader debates
   on democratic backsliding, populism, culture wars, and higher education.},
