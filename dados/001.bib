@article{ WOS:001885548000001,
Author = {Mierina, Inta and Bela, Baiba},
Title = {Diaspora diplomacy in the making: The Case of Latvian diaspora
   professionals working in international organisations},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2026},
Month = {2026 SEP 25},
Abstract = {Nationals living abroad are increasingly recognised as important, yet
   often overlooked, actors in international diplomacy. Unlike previous
   research - which has focused mainly on states and diasporas as singular
   entities - this study highlights the pivotal contributions of
   individuals. It introduces a new theoretical framework that emphasises
   the multifaceted roles of professionals in international organisations
   as resources for strengthening their home state's development,
   influence, and global visibility. The study examines the actors involved
   in diaspora diplomacy, how diplomatic work is conducted by, for, and
   through diasporas, and what motivates citizen diplomats. The analysis
   draws on a survey (N = 150), six focus groups (N = 18), and four
   interviews with highly skilled Latvian professionals in international
   organisations. Findings reveal the decentralised, networked nature of
   diaspora diplomacy, challenging the notion of the state or diaspora as a
   singular actor. Individual diaspora members play vital roles, advancing
   their home country's goals and visibility through their professional
   activities. All core functions of public diplomacy - communication,
   representation, listening, advocacy, and nation branding - are actively
   performed at the individual level by citizen diplomats. However, the
   degree to which states benefit from this resource depends on having a
   coordinated strategy for diaspora engagement.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
