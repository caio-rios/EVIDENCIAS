@article{ WOS:001916373500001,
Author = {Von Mohr, Mariana and Tsakiris, Manos},
Title = {Feeling the body politic: Interoception as a mechanism of political
   stress resilience},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2026},
Volume = {47},
Number = {6},
Month = {OCT 28},
Abstract = {Politics can substantially harm physical and mental health, especially
   in polarized contexts, making political polarization a major non-medical
   cause of disease and suffering. We examined whether citizens can protect
   their health without undermining civic engagement. Across three studies
   with over 2000 participants during the 2022 U.S. midterms and 2024
   presidential election, we show that interoceptive sensibility, that is,
   the ability to perceive and trust one's internal bodily signals,
   protects against politics' adverse health effects. Higher interoceptive
   sensibility consistently predicted lower emotional, physical,
   behavioral, and social health costs, controlling for political identity,
   demographics, and emotion regulation. During the charged 2024 election,
   it further predicted fewer negative emotions, more hope for the future,
   and less fear, particularly when their candidate lost. Interoceptive
   sensibility also correlated with political engagement and efficacy,
   suggesting it enhances rather than inhibits participation. Our findings
   highlight it as a promising trait for mitigating political stress
   without reducing civic involvement.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
