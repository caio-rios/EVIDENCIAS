@article{ WOS:001829755100001,
Author = {Rajadesingan, Ashwin},
Title = {Common Identities and Political Talk: Evaluating Cross-Cutting Political
   Discussions in Sports Communities on Reddit},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Month = {2026 JUL 25},
Abstract = {Research suggests that online nonpolitical communities may facilitate
   better cross-cutting political discussions than explicitly political
   communities as users' shared nonpolitical identities can offset partisan
   bias, in line with the Common Ingroup Identity Model. This study tests
   this idea through a large-scale computational analysis comparing the
   quantity, tone, and substance of political discussions on the same
   topics in political and sports communities on Reddit. Overall, we find
   that sports communities facilitate more cross-cutting political
   discussions than political communities, with the exception of soccer
   communities. These discussions use similar proportions of credible
   sources but use significantly fewer sources that are not credible
   compared to discussions in political communities. On the flip side, we
   do not find evidence of a meaningful difference in toxicity levels of
   cross-cutting political discussions in sports and political communities.
   Further, we find that political discussions in sports communities use
   fewer sources overall. These results advance a nuanced understanding of
   the promise of nonpolitical spaces for deliberative democracy and the
   role of common identities in political discussions.},
Publisher = {TAYLOR \& FRANCIS INC},
