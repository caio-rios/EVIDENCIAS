@article{ WOS:001879128000001,
Author = {Anderson, Sarah E. and Butler, Daniel M. and Harbridge-Yong, Laurel},
Title = {The primary premium: Why legislators are incentivized to side with
   primary voters over general election voters},
Journal = {QUARTERLY JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Volume = {21},
Number = {4},
Pages = {393-416},
Month = {OCT 9},
Abstract = {How are legislators incentivized to behave when their primary and
   general electorates disagree about an issue? We argue that primary
   electorates are generally more unified in their issue preferences and
   more sensitive to roll-call positions than general electorates,
   incentivizing legislators to prioritize primary voters when facing
   conflicting demands from the two groups. Using the 2016 Cooperative
   Election Study and an original survey experiment with over 13,000
   respondents, we show that primary voters are both more unified and more
   likely to adjust their vote choice based on policy alignment. When we
   combine electorate unity and voter sensitivity, we find that US senators
   had more to gain by siding with their primary electorate in 84\% of the
   votes where they were cross-pressured. This helps explain why
   politicians are incentivized to cater to their primary
   electorate-shaping patterns of representation and policy outcomes in
   American politics.},
Publisher = {EMERALD GROUP PUBLISHING LTD},
Address = {Floor 5, Northspring 21-23 Wellington Street, Leeds, W YORKSHIRE,
   ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Butler, DM (Corresponding Author), Washington Univ, Dept Polit Sci, St Louis, MO 63130 USA.
   Anderson, Sarah E., Univ Calif Santa Barbara, Bren Sch Environm Sci \& Management, Dept Polit Sci, Santa Barbara, CA USA.
   Butler, Daniel M., Washington Univ, Dept Polit Sci, St Louis, MO 63130 USA.
   Harbridge-Yong, Laurel, Northwestern Univ, Inst Policy Res, Dept Polit Sci, Evanston, IL USA.},
DOI = {10.1108/QJPS-08-2025-0124},
EarlyAccessDate = {SEP 2026},
