@article{ WOS:001902134700001,
Author = {Rodman, Emma},
Title = {King's Equality},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2026},
Month = {2026 OCT 13},
Abstract = {In a 1962 speech, Martin Luther King Jr. distinguished between a
   ``stagnant equality of sameness{''} and a ``constructive equality of
   oneness.{''} Scholars have rarely paused over this distinction,
   presuming King's equality to be a mere extension of liberal or Christian
   moral equality. This article argues instead that King advances a
   distinctive idea of equality, one that refigures his understanding of
   politics. His equality begins not with future-focused reforms that seek
   to equalize various forms of power but instead with acknowledging
   specific realities that already equally bind us: our dependence on
   others to make sense of who we are, our inescapable historical
   indebtedness, and the tragic and limited nature of human understanding
   and action. To acknowledge these facts is not resignation; it is
   political work. King's equality reorients politics away from power
   understood as mastery and control, and toward a practice of humility and
   awareness, constructively making different forms of political relation
   and action possible. Recovering this neglected strand of King's thought
   offers a new way to understand equality-as an ongoing relation to
   reality-as well as a new image of King as a political realist.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article; Early Access},
Language = {English},
