@article{ WOS:001885118200001,
Author = {Green-Pedersen, Christoffer and Mortensen, Peter Bjerre and Seeberg,
   Henrik Bech},
Title = {Two sides of governments: comparing inside and outside executive agendas
   in Denmark},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Month = {2026 AUG 31},
Abstract = {Governments have two agendas: a public account of their issue priorities
   and a non-public prioritisation of issues within the executive. Existing
   research relies almost exclusively on outside, public indicators -
   speeches, press releases, and coalition agreements - leaving the inside
   of governments unstudied. Drawing on unique access to the meeting
   agendas of the Coordination Committee of the Danish Government from 2001
   to 2019, this article introduces and analyzes the inside government
   agenda as a distinct object of study. Inside and outside agendas differ
   substantially in their issue profiles, and the inside agenda influences
   the outside but not vice versa, suggesting that decisions are typically
   prepared internally before becoming public. Electoral mandates shape the
   outside agenda but not the inside - except for the prime minister party,
   whose mandate is distinctively reflected internally. Media attention,
   meanwhile, is a stronger predictor of the inside than the outside
   agenda. These findings reveal important limitations in existing research
   and open a new agenda for studying the internal workings of coalition
   governments.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
