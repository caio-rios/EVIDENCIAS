@article{ WOS:001873563600001,
Author = {Farkas, Xenia and Lindgren, Simon},
Title = {The Language of Democratic Resilience and Decline: A Comparative Study
   of Politicians' Communication on Facebook in Sweden and Hungary},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Month = {2026 SEP 13},
Abstract = {While most research on democratic resilience and decline focuses on
   institutional erosion, less is known about how these shifts manifest in
   elite political communication. We examine how democratic resilience and
   decline are articulated on Facebook by political leaders, comparing
   Hungary, an archetype of informational autocracy, and Sweden, a case of
   resilient democracy. Drawing on 9,737 Facebook posts from 10 Swedish and
   9 Hungarian party leaders between 2022 and 2024, we use computational
   text analysis to identify linguistic, rhetorical, and emotional
   patterns. We address three research questions: (1) What dimensions of
   democracy do politicians emphasize, and how do these emphases differ
   between resilient and backsliding contexts? (2) How do populism and
   government/opposition dynamics shape these patterns? (3) How do patterns
   vary across campaigns, crises, and routine communication? Our results
   show that democracy is not only institutional but also communicatively
   produced through distinct discursive logics. Disaggregating by actor
   affiliation and populist orientation reveals that actors in the
   Hungarian government frame democracy in populist, performance-based
   terms. In contrast, in Sweden, both populists and non-populists
   communicate within a shared, deliberative repertoire. Temporal analysis
   highlights that Hungary's discourse on democracy is event-driven and
   affirmatively neutral, while Sweden's is sustained and critically
   self-reflective. We advance the concept of elite communicative
   resilience, finding that patterns of democratic discourse differ
   markedly between resilient and backsliding contexts in ways that
   parallel institutional differences.},
