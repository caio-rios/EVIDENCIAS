@article{ WOS:001907875400001,
Author = {Kyrkopoulou, Eleni and Sambanis, Nicholas},
Title = {O Xenos: Racial Difference, Colorism, and Attitudes Toward
   Immigrants in Greece},
Journal = {POLITICAL BEHAVIOR},
Year = {2026},
Month = {2026 OCT 6},
Abstract = {Does racial difference contribute to anti-immigrant bias? A large
   literature has analyzed the impact of religious difference on negative
   assessments of immigrants in European countries, but less is known about
   the effects of racial difference. We explore mechanisms of racial bias
   as components of xenophobic attitudes in Greece - one of the most
   anti-immigrant countries in Europe. We present results from several
   experiments designed to identify effects of racial difference proxied by
   skin color. We find evidence of a complex pattern of anti-Blackness that
   is a small part of xenophobic attitudes toward immigrant groups that are
   otherwise more racially proximate to the Greek population.
   Anti-Blackness in Greece reflects a ``taste{''} for discrimination and
   is not rooted in more negative stereotypes of darker immigrants.},
