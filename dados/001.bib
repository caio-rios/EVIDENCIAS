@article{ WOS:001902138700001,
Author = {Lizzio-Wilson, Morgana and Thomas, Emma F. and Quarisa, Cassandra M. and
   Barron, Anna C. and Osborne, Danny},
Title = {From misogyny to mobilization: Hostile sexism and conflictual online
   discussions indirectly predict men's rights activism via heightened
   identification as a men's rights supporter},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2026},
Volume = {47},
Number = {6},
Month = {OCT 14},
Abstract = {Although sexism may serve as a gateway into the men's rights movement,
   few studies have examined group processes in online environments that
   fuel this reactionary movement. We address this gap by examining whether
   interacting with like-minded others fosters an emergent social identity
   as a ``men's rights supporter{''} among sexist men; and whether
   identification predicts willingness to engage in reactionary actions
   undermining gender equality. Across two studies (Ns = 443, 755), men
   completed a hostile sexism measure and read about the perceived impacts
   of feminism on men. Participants then either discussed whether feminism
   negatively impacts men in an online chatroom (group deliberation) or
   reflected individually (individual deliberation). Hostile sexism
   predicted identification as a men's rights supporter, and this link was
   stronger in the group deliberation condition. In turn, identification
   predicted greater reactionary action intentions. Unexpectedly, these
   effects emerged only among men who indicated that their group was unsure
   about the impact of feminism after the discussion. A post-hoc content
   analysis of the pooled chat logs revealed that these men engaged in
   discussions marked by conflict and disagreement, suggesting that
   identification with the movement emerged through dissent rather than
   consensus. These findings highlight complex social dynamics underpinning
   engagement with the men's rights movement.},
