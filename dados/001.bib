@article{ WOS:001832760000001,
Author = {Golosov, Grigorii V.},
Title = {Simulating election results and party systems},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2026},
Month = {2026 JUL 28},
Abstract = {Simulated data sets are widely used in sciences, natural and social
   alike, because of their ability to overcome constraints inherent in the
   real-world data. In political science, particularly in such important
   subfields as electoral systems and their effects upon party systems,
   districting and gerrymandering and coalition politics, simulated data
   sets are often employed to address specific research questions. This
   study introduces a new method for generating simulated election
   results/party system configurations. Starting with formulating general
   requirements to this kind of data, the study develops an algorithm that
   is suitable for the purpose, and then validates the new method
