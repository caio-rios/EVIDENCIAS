@article{ WOS:001770509300001,
Author = {Rosenzweig, Leah R. and Offer-Westort, Molly},
Title = {Conversations with a Concern-Addressing Chatbot Increased COVID-19
   Vaccination Intentions Among Social Media Users in Kenya and Nigeria},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {4},
Pages = {1668-1673},
Month = {OCT 1},
Abstract = {This study leverages a two-stage response-adaptive experimental design
   to explore how tailored digital messaging can influence public attitudes
   toward health interventions, with broader implications for political
   communication. In public health settings, quickly scaling effective
   communication is critical; adaptive designs enable efficient learning of
   relevant treatments. For this study, we recruited 22,052 Facebook users
   in Kenya and Nigeria to engage in conversations on Messenger about their
   concerns regarding COVID-19 vaccines. We optimized messaging using an
   adaptive algorithm, then experimentally evaluated the concern-addressing
   messaging. We found that the tailored messaging increased COVID-19
   vaccine intentions and willingness by 4\% to 5\% compared to a control
   condition, and by 3\% to 4\% compared to a public service announcement.
   We observed the largest effects among those most vaccine hesitant at
   baseline. Personalized digital messaging interventions offer a scalable
   communication tool to encourage compliance with public health programs.},
