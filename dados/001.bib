@article{ WOS:001810210300001,
Author = {Bechmann, Anja},
Title = {Platform Collective Behavior as Democratic Infrastructure: Beyond Causal
   Effects in the DSA Era},
Journal = {POLITICAL COMMUNICATION},
Year = {2026},
Volume = {43},
Number = {4, SI},
Pages = {692-699},
Month = {JUL 4},
Abstract = {Online platforms have become infrastructural to democratic life, yet
   their influence is often examined through narrow causal-effect models
   that overlook systemic socio-technical dynamics. This Forum contribution
   introduces the concept of platform collective behavior to conceptualize
   how intertwined human-AI agency generates population-level patterns with
   systemic risk implications for democracy and citizen well-being. Rather
   than focusing on isolated persuasion effects, platform collective
   behavior captures emergent socio-algorithmic patterns such as unequal
   political participation, differential exposure to misinformation, bot
   amplification, and subgroup information segregation. The article
   evaluates whether Article 40 of the European Digital Services Act (DSA),
   which grants vetted researchers access to platform data, enables robust
   investigation of such systemic risks. While the DSA represents an
   unprecedented regulatory intervention in research data access, its scope
   is limited to systemic risks and depends on platform-provided datasets.
   The analysis identifies blind spots, including infrastructural and
   economic power asymmetries, offline behavioral consequences, and data
   integrity concerns. The article concludes that DSA access is necessary
   but insufficient for fully assessing platform influence on democracy.},
