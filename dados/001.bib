@article{ WOS:001771697400001,
Author = {Edwards, Nico},
Title = {The military green transition: Decarbonisation as warfighting
   opportunity},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {129},
Month = {AUG},
Abstract = {Amid rising concern for the operational implications of climate change
   and industrial decarbonisation, European military sectors are preparing
   for a military green transition. Rather than constitute a meaningful
   form of ecological stewardship, this article argues that said transition
   is best understood as militarism's greening through which war making,
   preparation and profiteering are normalised and facilitated in the name
   of climate action and environmental sustainability. The article unfolds
   over three sections. First, I identify military and green technological
   supply chains' entangled geopolitical ecologies, connecting the people
   and places implicated in both war's violence and ecological
   modernisation. Second, drawing on policy analysis, interviews and visits
   to military trade shows, I demonstrate how the military green transition
   materialises through the electric, digital, lower carbon and alternative
   fuel transformation of war-initiatives that warp socio-ecological care
   into a battlefield and business opportunity. Third, I trace the
   socio-ecological harms that the greening of European military
   capabilities risk exacerbating-linking weapons production and use with
   the toxic geographies of `renewable' energy infrastructure, mineral
   extraction, e-waste processing, data centre expansion, nuclear
   proliferation, biofuel development and beyond. Together, the three
   sections disclose the military green transition as continuation of
   militarist, extractivist and imperial socio-ecological relations.
   Promising the lower-carbon enhancement of military power, militarism's
   greening reinforces military sectors' predatory appropriation and
   application of resources and their reliance on opaque supply chains that
   externalise harm while consolidating state and corporate power and
   capital. I conclude with a call for further transdisciplinary research
   into the drivers and implications of the integration of military and
   socio-ecological governance.},
Publisher = {ELSEVIER SCI LTD},
