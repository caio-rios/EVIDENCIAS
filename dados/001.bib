@article{ WOS:001881463700001,
Author = {Balderacchi, Claudio and Tomini, Luca},
Title = {A risky business: navigating autocratization through ideological
   legitimation claims},
Journal = {EUROPEAN POLITICAL SCIENCE REVIEW},
Year = {2026},
Month = {2026 SEP 22},
Abstract = {Autocratization typically results from measures aiming at seizing,
   strengthening, and consolidating political power. However, it is not
   without risks: it may produce adverse reactions from multiple actors and
   possibly lead to the fall of its perpetrators from power. What makes
   autocratizing incumbents more capable of surviving during such a
   perilous process? We argue that the adoption of ideological legitimation
   strategies makes incumbents more capable of surviving during
   autocratization in democratic and electoral authoritarian regimes. We
   test our argument through survival analysis of incumbents in power
   during processes of autocratization from 1900 to 2024. Though relatively
   understudied in the context of autocratization, our study highlights
   ideology as a key factor in the process of transformation of a political
   regime toward autocracy.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
