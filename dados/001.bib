@article{ WOS:001921477400001,
Author = {Bol, Geertje J.},
Title = {Women and the double standard of ambition},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2026},
Month = {2026 NOV 3},
Abstract = {Few human qualities are as morally unstable as ambition: We seem unable
   to decide whether to admire or condemn the desire for self-advancement.
   This instability guarantees double standards-and none has been more
   enduring than that of women's ambition. This article traces the
   emergence of this double standard in early modern England, when ambition
   came to be widely accepted as natural and even virtuous in men, yet
   remained unnatural and vicious in women. It then turns to four
   seventeenth-century feminists-Rachel Speght, Margaret Cavendish, Mary
   Astell, and Judith Drake-who challenged this emerging double standard.
   They reimagined ambition as a feminist tool, using it to argue for
   women's equality and even superiority. Unearthing this neglected strand
   of ambitious feminism not only contributes to the history of political
   thought but also points the way to a reconciliation between feminism and
   ambition that avoids the pitfalls identified by feminist theorists
   today.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article; Early Access},
Language = {English},
Affiliation = {Bol, GJ (Corresponding Author), Univ Fribourg, Hist Dept, Fribourg, Switzerland.
   Bol, Geertje J., Univ Fribourg, Hist Dept, Fribourg, Switzerland.},
DOI = {10.1111/ajps.70091},
EarlyAccessDate = {NOV 2026},
ISSN = {0092-5853},
EISSN = {1540-5907},
