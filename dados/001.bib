@article{ WOS:001880714300001,
Author = {Hatungimana, William},
Title = {Friends like us? Support for democracy and the perception of great power},
Journal = {DEMOCRATIZATION},
Year = {2026},
Month = {2026 SEP 17},
Abstract = {Amid democratic backsliding, the resurgence of authoritarianism in
   Africa, and the expanding influence of authoritarian great powers, this
   study examines how pro-democracy citizens perceive the United States,
   the European Union, China, and Russia. Rather than focusing on how great
   powers shape democratic trajectories in the Global South, it shifts
   attention to how pro-democracy publics evaluate these external actors.
   The findings show that pro-democracy citizens in South Africa view the
   influence of Russia and China negatively, while viewing the United
   States and the European Union more positively. Notably, the European
   Union is perceived more favourably than the United States. In contrast,
   citizens more receptive to authoritarianism tend to view Russia and
   China positively, though these patterns are more nuanced. More broadly,
   pro-democracy citizens appear less receptive to authoritarian external
   influence than their counterparts who are receptive to authoritarianism
   and may actively contest such influence through domestic political
   discourse. When authoritarian powers are viewed negatively by
   pro-democracy publics, these perceptions shape not only bilateral
   relations but also the broader resilience of democracy.},
