@article{ WOS:001834849000001,
Author = {Bijleveld, Sophie and van Meeteren, Michiel},
Title = {Inscribing the Dutch imperial geopolitical order: The colonial geography
   of Louis van Vuuren (1873-1951)},
Journal = {POLITICAL GEOGRAPHY},
Year = {2026},
Volume = {131},
Month = {DEC},
Abstract = {This paper traces the overlooked Dutch colonial geopolitics of the Dutch
   East Indies (present-day Indonesia) through a biobibliographical reading
   of Louis van Vuuren's (1873-1951) work. Born in the Dutch East Indies,
   Van Vuuren's lifespan aligns almost perfectly with the era of
   inter-imperial rivalry (1875-1945). Over that period, Van Vuuren
   consecutively became a military veteran, colonial administrator and
   lecturer before occupying the Human Geography chair at Utrecht
   University from 1927 to 1945. Because of his proximity to powerful
   colonial circles, Van Vuuren's geographical scholarship articulates an
   important conservative strand of Dutch geopolitical thought. In the
   paper we analyze Van Vuuren's colonial geography writings from a
   critical geopolitics perspective. Enriching Agnew's (2003) concept of
   the modern geopolitical imagination, we trace the civilizational,
   naturalized and ideological dimensions of Dutch conservative antebellum
   geopolitics, including its alignment with German geopolitics. Van Vuuren
   conjures a geopolitical imagination intended to justify and secure Dutch
   colonial control over the Indonesian archipelago. In unearthing this
   legacy, we inscribe a neglected strand of colonial geography and
   geopolitics in the history of Dutch geography. The sobering result is a
   loss of innocence in Dutch geographic historiography, as a colonial past
   that matches those of other European imperial ventures comes into focus.},
