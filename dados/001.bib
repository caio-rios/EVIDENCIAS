@article{ WOS:001770509200001,
Author = {Jackson, Jenn M.},
Title = {Intersectional Threat: How Race, Gender, and Sexuality Shape Black
   Americans' Perspectives on Policing},
Journal = {JOURNAL OF POLITICS},
Year = {2026},
Volume = {88},
Number = {4},
Pages = {1542-1554},
Month = {OCT 1},
Abstract = {In the mass public, the threat of police violence is often classified
   and framed as a concern facing Black men. Yet, the anecdotal accounts of
   Black Americans who experience the threat of policing suggest that there
   are heterogeneous patterns that shape their lived experiences with
   police in the United States. To examine the nature of these
   heterogeneous effects, I introduce a new theory of threat:
   intersectional threat. It refers to those threats to marginalized groups
   that occur across gender, sexuality, and class lines based on varying
   orientations to power. From my subset of 50 in-depth interviews with
   young Black Americans in Chicago, I find that young Black Americans are
   socialized to employ diverse tactics and strategies to cope with and
   avert threat linked directly to their interlocking identities at the
   intersections of race, gender, class, and sexuality. These encounters
   are dualistic in nature and vary drastically from white Americans.},
