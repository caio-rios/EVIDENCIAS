DOI = {10.1016/j.polgeo.2016.04.002},
ISSN = {0962-6298},
EISSN = {1873-5096},
Keywords = {Low carbon transitions; Community transitions; Transition towns; Prosaic
   state; Number governance},
Keywords-Plus = {CLIMATE-CHANGE; POLITICS; GEOGRAPHIES; ENERGY; POLICY; URBAN},
Research-Areas = {Geography; Government \& Law},
