@article{ WOS:000384884200042,
Author = {Cox, Gary W. and Fiva, Jon H. and Smith, Daniel M.},
Title = {The Contraction Effect: How Proportional Representation Affects
   Mobilization and Turnout},
Journal = {JOURNAL OF POLITICS},
Year = {2016},
Volume = {78},
Number = {4},
Pages = {1249-1263},
Month = {OCT},
Abstract = {A substantial body of research examines whether increasing the
   proportionality of an electoral system increases turnout, mostly based
   on cross-national comparisons. In this study, we offer two main
   contributions to the previous literature. First, we show that moving
   from a single-member district system to proportional representation in
   multimember districts should, according to recent theories of elite
   mobilization, produce a contraction in the distribution of
   mobilizational effort across districts and, hence, a contraction in the
   distribution of turnout rates. Second, we exploit a within-country panel
   data set based on stable subnational geographic units before and after
   Norway's historic 1919 electoral reform in order to test various
   implications stemming from the contraction hypothesis. We find
   significant support for the predictions of the elite mobilization
   models.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
