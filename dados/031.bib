@article{ WOS:000384884200035,
Author = {Krainin, Colin and Wiseman, Thomas},
Title = {War and Stability in Dynamic International Systems},
Journal = {JOURNAL OF POLITICS},
Year = {2016},
Volume = {78},
Number = {4},
Pages = {1139-1152},
Month = {OCT},
Abstract = {We present a dynamic, complete-information bargaining model of war with
   N countries. The analysis of a network with more than two countries
   significantly generalizes previous work. We consider an environment
   where a country's military strength varies stochastically over time as a
   function of endogenous consumption. If countries are sufficiently
   patient, then war is inevitable and will quickly spread throughout the
   network. We leverage insights from the limiting case to identify two key
   factors that promote peace among countries with limited patience: peace
   is easier to sustain when countries have equal military strength or when
   mechanisms exist to preserve any existing inequalities. Varying the
   number of countries does not have a consistent effect.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
