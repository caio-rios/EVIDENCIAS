@article{ WOS:000401434100001,
Author = {Hallin, Daniel C. and Mancini, Paolo},
Title = {Ten Years After Comparing Media Systems: What Have We Learned?},
Journal = {POLITICAL COMMUNICATION},
Year = {2017},
Volume = {34},
Number = {2},
Pages = {155-171},
Abstract = {In this article we review research published since the publication of
   Comparing Media Systems which seeks to operationalize concepts discussed
   in that work and to test the framework proposed there or to put forward
   alternatives or revisions. We focus on works that deal with the original
   18 countries covered in Comparing Media Systems, and consider the
   progress made in developing quantitative measures across these cases for
   key variables, research testing the grouping of cases in Comparing Media
   Systems, research extending the comparative analysis of Western media
   systems to new media, and research on convergence toward the Liberal
   Model. In the final section, we focus on limitations of the research
   produced during the 10years following the publication of Comparing Media
