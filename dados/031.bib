@article{ WOS:000386853700004,
Author = {Huff, Connor and Kruszewska, Dominika},
Title = {Banners, Barricades, and Bombs: The Tactical Choices of Social Movements
   and Public Opinion},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2016},
Volume = {49},
Number = {13, SI},
Pages = {1774-1808},
Month = {NOV},
Abstract = {In this article, we use an experimental survey design to explore how the
   tactical choices of social movements affect public opinion about whether
   the government should negotiate with the movement and the bargains that
   should be struck once negotiations begin. In doing so, we test competing
   theories about how we should expect the use of tactics with varying
   degrees of extremenessincluding demonstrations, occupations, and
   bombingsto influence public opinion. We find that respondents are less
   likely to think the government should negotiate with organizations that
   use the tactic of bombing when compared with demonstrations or
   occupations. However, depending on the outcome variable and baseline
   category used in the analysis, we find mixed support for whether
   respondents think organizations that use bombings should receive less
   once negotiations begin. The results of this article are generally
   consistent with the theoretical and policy-based arguments centering
   around how governments should not negotiate with organizations that
   engage in violent activity commonly associated with terrorist
   organizations.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Kruszewska, D (Corresponding Author), Harvard Univ, Ctr European Studies, 27 Kirkland St, Cambridge, MA 02138 USA.
   Huff, Connor; Kruszewska, Dominika, Harvard Univ, Dept Govt, Cambridge, MA 02138 USA.},
DOI = {10.1177/0010414015621072},
ISSN = {0010-4140},
EISSN = {1552-3829},
Keywords = {social movements; experimental research; terrorism; protest},
Keywords-Plus = {STRATEGIC LOGIC; TOPIC MODELS; TERRORISM; DEMONSTRATIONS; CONSEQUENCES;
   POLITICS; PROTEST; COSTS; WAR},
