@article{ WOS:000392495900020,
Author = {Mummolo, Jonathan and Nall, Clayton},
Title = {Why Partisans Do Not Sort: The Constraints on Political Segregation},
Journal = {JOURNAL OF POLITICS},
Year = {2017},
Volume = {79},
Number = {1},
Pages = {45-59},
Month = {JAN},
Abstract = {Social divisions between American partisans are growing, with
   Republicans and Democrats exhibiting homophily in a range of seemingly
   nonpolitical domains. It has been widely claimed that this partisan
   social divide extends to Americans' decisions about where to live. In
   two original survey experiments, we confirm that Democrats are, in fact,
   more likely than Republicans to prefer living in more Democratic, dense,
   and racially diverse places. However, improving on previous studies, we
   test respondents' stated preferences against their actual moving
   behavior. While partisans differ in their residential preferences, on
   average they are not migrating to more politically distinct communities.
   Using zip-codelevel census and partisanship data on the places where
   respondents live, we provide one explanation for this contradiction: by
   prioritizing common concerns when deciding where to live, Americans
   forgo the opportunity to move to more politically compatible
   communities.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
Affiliation = {Nall, C (Corresponding Author), Stanford Univ, Dept Polit Sci, 616 Serra St,Room 100, Stanford, CA 94305 USA.
   Mummolo, Jonathan; Nall, Clayton, Stanford Univ, Dept Polit Sci, 616 Serra St,Room 100, Stanford, CA 94305 USA.},
DOI = {10.1086/687569},
ISSN = {0022-3816},
EISSN = {1468-2508},
Keywords-Plus = {RESIDENTIAL PREFERENCES; BIG SORT; MIGRATION; SUPPORT; MODELS},
Research-Areas = {Government \& Law},
