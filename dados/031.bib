   Pace, Roderick, Univ Malta, Inst European Studies, European Studies \& Int Relat, Msida, Malta.},
DOI = {10.1080/13608746.2017.1410274},
ISSN = {1360-8746},
EISSN = {1743-9612},
Keywords = {Malta; Southern Europe; social democracy; pure two-party system; small
   parties; corruption; Panama Papers; women candidates},
