EISSN = {1537-5331},
Keywords-Plus = {PARTISAN BIAS; WEB SURVEYS; CONSEQUENCES; TELEPHONE; RESPONSES;
   INTERNET; WORKERS; IMPACT},
Research-Areas = {Communication; Government \& Law; Social Sciences - Other Topics},
Web-of-Science-Categories  = {Communication; Political Science; Social Sciences, Interdisciplinary},
Author-Email = {sclifford@uh.edu},
Affiliations = {University of Houston System; University of Houston; State University of
   New York (SUNY) System; Stony Brook University},
Funding-Acknowledgement = {College of Arts and Sciences at Stony Brook University; Division of
   Research at the University of Houston},
Funding-Text = {SCOTT CLIFFORD is an assistant professor in the Department of Political
   Science at the University of Houston, Houston, TX, USA. JENNIFER JERIT
   is a professor in the Department of Political Science at Stony Brook
