   Madsen, Kenneth D.; Ruderman, D. B., Ohio State Univ, 1179 Univ Dr, Newark, OH 43055 USA.},
DOI = {10.1016/j.polgeo.2016.06.003},
ISSN = {0962-6298},
EISSN = {1873-5096},
Keywords = {Boundaries; Bordering; Robert Frost; Poetry; Psychoanalysis; Ambivalence},
Keywords-Plus = {GEOGRAPHY; FENCES; NEIGHBORS},
