@article{ WOS:000394162600005,
Author = {Jensen, Carsten and Petersen, Michael Bang},
Title = {The Deservingness Heuristic and the Politics of Health Care},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2017},
Volume = {61},
Number = {1},
Pages = {68-83},
Month = {JAN},
Abstract = {Citizens' social policy opinions are strongly influenced by a simple
   heuristic: Are the recipients of social benefits deserving or not?
   Adding to this growing literature, we provide evidence that the
   deservingness heuristic does not treat all social benefits alike.
   Already at the level of preconscious processing, the heuristic displays
   a bias toward tagging the recipients of health carethat is, sick
   individualsas deserving. This powerful, implicit effect overrides other
   opinion factors and produces broad-based support among the public for
   health careacross levels of self-interest, media frames, ideological
   divides, and national cultures. In contrast, when the deservingness
   heuristic is utilized for reasoning about unemployment benefits,
   implicit psychological constraints are fewer and political conflict
   erupts depending on differences in interest and worldviews. Using a
   variety of methodologies, we track this fundamental difference between
   the politics of health care and unemployment benefits from the level of
   implicit processing to the level of political attitudes.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Jensen, C (Corresponding Author), Aarhus Univ, Dept Polit Sci, Bartholins Alle 7, DK-8000 Aarhus C, Denmark.
   Jensen, Carsten; Petersen, Michael Bang, Aarhus Univ, Dept Polit Sci, Bartholins Alle 7, DK-8000 Aarhus C, Denmark.},
DOI = {10.1111/ajps.12251},
ISSN = {0092-5853},
EISSN = {1540-5907},
Keywords-Plus = {HELP EVOLUTIONARY PSYCHOLOGY; PUBLIC-OPINION; SOCIAL-WELFARE; VALUES;
   ATTITUDES; CULTURE; SUPPORT},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {CarstenJ@ps.au.dk
   michael@ps.au.dk},
Affiliations = {Aarhus University},
ResearcherID-Numbers = {Petersen, Michael Bang/JOZ-2626-2023
   },
ORCID-Numbers = {Petersen, Michael Bang/0000-0002-6782-5635
   Jensen, Carsten/0000-0002-4346-031X},
Funding-Acknowledgement = {Danish Council for Independent Research; Velux Foundation},
Funding-Text = {The research reported in this article has been funded by the Danish
   Council for Independent Research and the Velux Foundation. Previous
   versions have been presented at several conferences and workshops: Lund
   University (November 2012), a NESCent Catalysis Meeting (April 2013),
   the annual meeting of the Midwest Political Science Association (April
   2013), Aarhus University (April 2013), University of Heidelberg
   (February 2014), the annual meeting of the Danish Political Science
   Association (October 2014), and European Centre Vienna (November 2014).
   Apart from many helpful comments at these events, we have received
   valuable comments and suggestions from Troels Boggild, Stanley Feldman,
   Lasse Laustsen, Dan Nguyen, and Magnus Rasmussen, as well as the
