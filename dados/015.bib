@article{ WOS:000777037200001,
Author = {Lister, Andrew},
Title = {Theology, Desert, and Egalitarianism},
Journal = {JOURNAL OF POLITICS},
Year = {2022},
Volume = {84},
Number = {3},
Pages = {1528-1538},
Month = {JUL 1},
Abstract = {This article assesses Eric Nelson's claims that the young Rawls's
   endorsement of an illiberal doctrine of original sin led to his later
   denial that desert is relevant to social justice and that the mature
   Rawls's egalitarianism still depends on the theologically contestable
   assumption that the distribution of natural talents is morally
   arbitrary. The article defends Rawlsian egalitarianism without endorsing
   Rawls's more general skepticism about desert.},
