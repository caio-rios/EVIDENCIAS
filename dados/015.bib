@article{ WOS:000775709100001,
Author = {Mayne, Quinton and Katsanidou, Alexia},
Title = {Subnational economic conditions and the changing geography of mass
   Euroscepticism: A longitudinal analysis},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2023},
Volume = {62},
Number = {3},
Pages = {742-760},
Month = {AUG},
Abstract = {Existing research mainly analyzes mass attitudes towards the European
   Union (EU) from the national and individual-level perspective. This
   paper adds to this literature by focusing on the relationship between EU
   support and subnational economic conditions, using harmonized survey
   data covering 40 years and 1.1 million respondents in 197 European
   regions. We first describe Europe's changing subnational conditions in
   terms of catch-up, wealthy, declining and glass-ceiling regions. The
   paper then develops and tests a set of hypotheses regarding the
   temporally dynamic relationship between EU attitudes and regions' long-
   and short-term economic conditions. Our analyses reveal important
   longitudinal variations in this relationship with low levels of
   geographic differentiation in public opinion giving way to clear spatial
   differences in recent years. Our findings are consistent with the idea
   that the Great Recession and Brexit have generated a new geography of
   both Euroscepticism in Europe's declining regions and EU support in its
   wealthy and catch-up regions.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Mayne, Q (Corresponding Author), Harvard Univ, Harvard Kennedy Sch, Cambridge, MA 02138 USA.
   Mayne, Quinton, Harvard Univ, Harvard Kennedy Sch, Cambridge, MA 02138 USA.
   Katsanidou, Alexia, Univ Cologne, Cologne, Germany.
   Katsanidou, Alexia, GESIS Leibniz Inst Social Sci, Cologne, Germany.},
DOI = {10.1111/1475-6765.12528},
