@article{ WOS:000819747500001,
Author = {Ridge, Hannah M.},
Title = {Dismantling new democracies: the case of Tunisia1},
Journal = {DEMOCRATIZATION},
Year = {2022},
Volume = {29},
Number = {8},
Pages = {1539-1556},
Month = {NOV 17},
Abstract = {After a decade as the stand-out democracy of the Middle East, Tunisia
   took an anti-democratic turn in July 2021 with President Kais Saied's
   self-coup. Using a survey fielded in the weeks after these reforms, this
   article documents the substantial support for liberal institutions and
   civil rights in Tunisia. Democracy itself, on the other hand, is not so
   strongly supported. The study thus identifies potential for democratic
   backsliding in Tunisia through the strategic implementation liberal but
   anti-democratic actions. Other would-be authoritarians could follow
   Saied's model of strategic regression to autocratize their regimes.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
