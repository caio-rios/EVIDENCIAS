@article{ WOS:000788701900002,
Author = {Eggers, Andrew C. and Rubenson, Daniel and Loewen, Peter J.},
Title = {Who Votes More Strategically? Evidence from Canada},
Journal = {JOURNAL OF POLITICS},
Year = {2022},
Volume = {84},
Number = {3},
Pages = {1862-1868},
Month = {JUL 1},
Abstract = {Do some types of voters vote more strategically than others? We examine
   this question using a large survey in Canada that asked respondents to
   rate not just parties and party leaders but also local candidates. Using
   a new technique for combining multiple preference measures into a single
   utility estimate, we find that better educated voters and richer voters
   vote more strategically, as do women and older voters (although the
   latter two differences are smaller). Together with recent evidence from
   the United Kingdom, these results suggest that (at least in
   multicandidate first-past-the-post elections) the same types of voters
   who are more likely to turn out are also more likely to make their votes
   count.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
