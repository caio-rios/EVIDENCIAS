@article{ WOS:000177350000004,
Author = {Steinmo, S},
Title = {Globalization and taxation - Challenges to the Swedish welfare state},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2002},
Volume = {35},
Number = {7},
Pages = {839-862},
Month = {SEP},
Abstract = {Many have argued that the increased international mobility of both
   capital and labor witnessed in recent years will force advanced
   capitalist democracies to cut taxes and, thus, ultimately roll back
   their welfare states. This analysis tests this hypothesis through an
   examination of policy developments in Sweden, the country with the
   world's heaviest tax burden and largest social welfare state. The
   analysis focuses on the history and structure of taxation, policy (the
   policy arena predicted to be most directly affected by globalization).
   The findings reveal that there have been very important changes in the
   Swedish welfare state: The tax and spending regimes have been changed
   less than the globalization thesis predicts. This analysis argues that
   Sweden has indeed adapted and changed in recent years but finds little
   support for the more dire thesis that countries like Sweden must abandon
   their high-tax regimes and/or their generous social welfare systems.},
