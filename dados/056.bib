@article{ WOS:000177223300002,
Author = {King, A},
Title = {The outsider as political leader: The case of Margaret Thatcher},
Journal = {BRITISH JOURNAL OF POLITICAL SCIENCE},
Year = {2002},
Volume = {32},
Number = {3},
Pages = {435-454},
Month = {JUL},
Abstract = {Outsiders are familiar figures in literature but feature scarcely at all
   in political analysis. This is despite the fact that some of the most
   significant political leaders of recent decades have been outsiders,
   including Britain's Margaret Thatcher. She was certainly a social
   outsider. She was almost certainly a psychological outsider. Not least,
   she chose to operate politically as an outsider. Her career points to
   both the strengths and the weaknesses of the role of the outsider as
   political leader.},
