@article{ WOS:000179543300004,
Author = {Christin, T and Hug, S and Sciarini, P},
Title = {Interests and information in referendum voting: An analysis of Swiss
   voters},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2002},
Volume = {41},
Number = {6},
Pages = {759-776},
Month = {OCT},
Abstract = {Referendums impose considerable informational demands on voters. Recent
   theoretical and empirical research has emphasized the different
   shortcuts and heuristics they may employ in deciding how to vote.
   Relying on a substantial series of votes at the national level in
   Switzerland, we provide empirical tests on how Swiss voters cope with
   the informational demands in referendum voting. We combine simple
   heuristics, like partisan cues and endorsements, with indicators of
   instrumental interests to explain citizens' choices in a series of
   votes.},
