@article{ WOS:000175155100011,
Author = {McLaren, LM},
Title = {Public support for the European Union: Cost/benefit analysis or
   perceived cultural threat?},
Journal = {JOURNAL OF POLITICS},
Year = {2002},
Volume = {64},
Number = {2},
Pages = {551-566},
Month = {MAY},
Abstract = {This research note argues that much of the literature on support for
   European integration misses the heart of the nature of opposition to
   this process by ignoring the notion of perceived threat. Essentially,
   people are hostile toward the European project in great part because of
   their perceptions of threats posed by other cultures. I analyze this
   hypothesis by replicating a piece of research that previously appeared
   in this journal. adding measures of perceived threat to that model. The
   results support the main contention, which is that perceived cultural
   threat is an important factor that has been mistakenly ignored in
   explanations of hostility toward the European Union.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
Affiliation = {McLaren, LM (Corresponding Author), Univ Oxford, Dept Polit \& Int Relat, George St, Oxford OX1 2RL, England.
   Univ Oxford, Dept Polit \& Int Relat, Oxford OX1 2RL, England.},
DOI = {10.1111/1468-2508.00139},
