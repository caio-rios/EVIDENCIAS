@article{ WOS:000173616700002,
Author = {Brown, RA and Shaw, TC},
Title = {Separate nations: Two attitudinal dimensions of black nationalism},
Journal = {JOURNAL OF POLITICS},
Year = {2002},
Volume = {64},
Number = {1},
Pages = {22-44},
Month = {FEB},
Abstract = {Previous research has often treated the ideology of Black Nationalism as
   a singular, uniform set of beliefs. We explore the attitudinal
   complexity of African-American support for Black Nationalism and
   discover two distinct dimensions of Black Nationalism, which we label
   community nationalism and separatist nationalism. While the former
   dimension enjoys support among several black subgroups, including more
   affluent blacks, the latter dimension is distinctly supported by blacks
   who are either younger, male, or less affluent. Furthermore, community
   and separatist nationalists generally agree upon a core set of
   nationalist tenets, although they diverge on the definition and breadth
   of the black struggle.},
Publisher = {BLACKWELL PUBLISHERS},
