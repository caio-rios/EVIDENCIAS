@article{ WOS:000174708800009,
Author = {Chataway, CJ},
Title = {The problem of transfer from confidential interactive problem-solving:
   What is the role of the facilitator?},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2002},
Volume = {23},
Number = {1},
Pages = {165-189},
Month = {MAR},
Abstract = {Interactive problem-solving work-shops provide a relatively confidential
   atmosphere in which members of societies engaged in protracted social
   conflict call examine and share their assumptions and perceptions about
   the conflict and think creatively about the possibilities for
   de-escalation. Two sorts of work-shop goals have generally been
   articulated: (1) creating change in participants' understanding, and (2)
   transferring participants' new, ideas to political decision-making and
   public discussion. Although facilitators have tended to emphasize the
   role of the participants in generating and transferring new, learning,
   this article expands our conceptions of change and transfer to include
   both participants and facilitators. A basic complementarity is
   postulated between the strengths and weaknesses of these two agents of
   transfer. If considered this way, the integrity of this confidential
   process-and thus of its potentially unique contributions to a peace
   process-call be maintained while increasing the opportunities for
   transfer.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Chataway, CJ (Corresponding Author), York Univ, Dept Psychol, 4700 Keele St, N York, ON M3J 1P3, Canada.
   York Univ, Dept Psychol, N York, ON M3J 1P3, Canada.},
DOI = {10.1111/0162-895X.00276},
ISSN = {0162-895X},
EISSN = {1467-9221},
Keywords = {protracted conflict; scholar-practitioner; interactive problem-solving;
   transfer; peace; track I; track II},
Keywords-Plus = {CONFLICT-RESOLUTION; CONSTRUCTIVE CONFLICT; CONSULTATION},
