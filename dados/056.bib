@article{ WOS:000177266900003,
Author = {Grabbe, H},
Title = {European Union conditionality and the Acquis communautaire},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2002},
Volume = {23},
Number = {3},
Pages = {249-268},
Month = {JUL},
Abstract = {The EU's conditions for the central and cast European applicants look
   deceptively straightforward: they comprise stable democracy, a
   competitive market economy, and the capacity to implement EU laws and
   policies (the so called acquis communautaire). However, they arc very
   general and not amenable to quantitative assessment, leaving ambiguity
   about exactly when they have been met. This ambiguity increases the EU's
   power in accession negotiations, but the accompanying uncertainty
   diffuses its influence in shaping institutional and policy choices. This
   article examines the EU's accession conditionality levers and the
   constraints on their use. It concludes that readiness for membership
   depends not only on technical progress in negotiations, but also on when
   the current member-states are politically ready for enlargement.},
