@article{ WOS:000175155100006,
Author = {Steinberger, PJ},
Title = {Political obligations and derivative duties},
Journal = {JOURNAL OF POLITICS},
Year = {2002},
Volume = {64},
Number = {2},
Pages = {449-465},
Month = {MAY},
Abstract = {The idea of tacit consent has long been regarded as indispensable in
   accounting for the political obligations of all but a handful of
   citizens. If we have such obligations, they must be rooted not in the
   act of signing however metaphorically) a social contract but in
   something quite different, namely, the fact that we have accepted and
   enjoyed the benefits that political society provides. Acceptance and
   enjoyment are thought to constitute a kind of consent-tacit
   consent-hence, to provide moral grounds for claiming that an obligation
   to the state has been freely undertaken. But the prevailing view among
   political philosophers today is that such an approach is seriously
   flawed and that in Rawls's words, ``there is... no political obligation,
   strictly speaking, for citizens generally.{''} My purpose here is to
   revisit some of the relevant arguments about tacit consent-involving
   notions of ``obligation,{''} ``ought,{''} and ``duty{''}-and to defend
   an account of political obligation based on a distinction between what I
   shall call primary and derivative duties.},
