@article{ WOS:000173101400007,
Author = {Archer, JC},
Title = {The geography of an interminable election: Bush v. Gore, 2000},
Journal = {POLITICAL GEOGRAPHY},
Year = {2002},
Volume = {21},
Number = {1},
Pages = {71-77},
Month = {JAN},
Abstract = {Republican Bush trailed Democrat Gore by over 500,000 popular votes in
   the 2000 presidential election. But Bush narrowly edged Gore in the
   Electoral College to win the U.S. presidency. Several states, including
   Florida, were decided by less than 2.5\% of popular votes. Maps of
   popular votes at county level and electoral votes at state level show
   greater support for Bush in the South and West, and greater support for
   Gore in metropolitan centres. (C) 2001 Elsevier Science Ltd. All rights
   reserved.},
Publisher = {ELSEVIER SCI LTD},
Address = {THE BOULEVARD, LANGFORD LANE, KIDLINGTON, OXFORD OX5 1GB, OXON, ENGLAND},
Type = {Article},
