@article{ WOS:000174708800002,
Author = {Brewer, PR and Steenbergen, MR},
Title = {All against all: How beliefs about human nature shape foreign policy
   opinions},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2002},
Volume = {23},
Number = {1},
Pages = {39-58},
Month = {MAR},
Abstract = {Although the American public's increasingly cynical views about human
   nature have drawn considerable attention from scholars, existing
   research says little about hoot, interpersonal trust shapes mass foreign
   policy opinions. This study analyzes survey data to test the claim that
   citizens use their beliefs about human. nature to reason about
   international affairs. The results indicate that cynical citizens are
   more likely than trusting citizens to endorse the principle of
   isolationism and to oppose cooperative forms of intervention in other
   nations' problems. Citizens' use of interpersonal trust as an
   information shortcut helps them to make inferences regarding a topic
   about which they typically know little, but such inferences are not
   necessarily realistic ones.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Brewer, PR (Corresponding Author), George Washington Univ, Dept Polit Sci, 2201 G St NW,Suite 524, Washington, DC 20052 USA.
   George Washington Univ, Dept Polit Sci, Washington, DC 20052 USA.
