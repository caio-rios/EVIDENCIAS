   SEATTLE, WASHINGTON, JUL 01-04, 2000},
Organization = {Int Soc Polit Psychol},
Abstract = {Two challenges are posed for social scientists, one substantive and the
   other disciplinaiy. First, scholars and practitioners should together
   find ways to transform fragmented and conflictual relationships into
   relationships capable of building peaceful societies where human dignity
   is respected. Second, to achieve this goal, they should work to develop
   non-disciplinary spaces where people from different disciplines can
   collie together to create the requisite conceptual and methodological
   frameworks.},
