@article{ WOS:000177132300005,
Author = {Roederer-Rynning, C},
Title = {Farm conflict in France and the Europeanisation of agricultural policy},
Journal = {WEST EUROPEAN POLITICS},
Year = {2002},
Volume = {25},
Number = {3},
Pages = {105-124},
Month = {JUL},
Note = {Conference of the European-Community-Studies-Association, MADISON, WI,
   MAY 31-JUN 02, 2001},
Organization = {European Community Studies Assoc},
Abstract = {This article investigates farm conflict in France from 1958 to the
   present in relation to the dynamics of Europeanisation. The framework
   emphasises how institutions shape farm conflict by mediating market
   forces, structuring the political opportunities of contending groups and
   shaping their world views. The analysis investigates the relationship
   between institutional politics and contentious politics at three
   junctures of the development of the CAP: its formation (1958-69),
   consolidation (1970-87), and reform (1988 to present). The findings
   suggest that European institutions have played a significant role in the
   production and transformation of farm conflict in France.},
