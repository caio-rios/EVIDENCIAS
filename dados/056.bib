@article{ WOS:000178113700008,
Author = {Redhead, M},
Title = {Making the past useful for a pluralistic present: Taylor, Arendt, and a
   problem for historical reasoning},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2002},
Volume = {46},
Number = {4},
Pages = {803-818},
Month = {OCT},
Abstract = {This article focuses on Taylor's confrontation with political
   fragmentation and the insights an Arendtian model of storytelling can
   provide for it. To address political fragmentation is to address the
   tension between accommodating narrowly defined identities and promoting
   allegiance to a larger polity.
   I argue that in his quest to discern the moral terrain upon which to
   develop viable responses to political problems such as fragmentation,
   Taylor generates an ontological reading of western modernity that in
   turn compels him to put forth an unduly restrictive view of what values
   a modern democracy can accommodate and what potentially unifying forms
   of community it can promote. I then offer an Arendtian solution that
   relies on a more partial reading of history which in turn can help to
   cultivate a politics that is at once more contestatory yet more
   inclusive than what Taylor's model is able to promote.},
