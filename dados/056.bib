@article{ WOS:000176761200002,
Author = {Goldstein, K and Freedman, P},
Title = {Campaign advertising and voter turnout: New evidence for a stimulation
   effect},
Journal = {JOURNAL OF POLITICS},
Year = {2002},
Volume = {64},
Number = {3},
Pages = {721-740},
Month = {AUG},
Abstract = {Recent controversy over campaign advertising has focused on the effects
   of negative ads on voters. Proponents of the demobilization hypothesis
   have argued that negative ads turn off voters and shrink the size of the
   electorate. We argue that negative campaign charges are just as likely
   to engage potential voters, leading to a stimulation effect when it
   comes to turnout. Drawing on a new source of ad-tracking data from the
   1996 presidential election, combined with the 1996 National Election
   Study, we generate estimates of the probability that voters were exposed
   to positive and negative political advertising. With this new, more
   precise approach, we find unambiguous evidence that exposure to negative
   campaign ads actually stimulates voter turnout.},
