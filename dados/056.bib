@article{ WOS:000179543300008,
Author = {Denver, D},
Title = {Voting in the 1997 Scottish and Welsh devolution referendums:
   Information, interests and opinions},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2002},
Volume = {41},
Number = {6},
Pages = {827-843},
Month = {OCT},
Abstract = {The rarity of referendums in the United Kingdom makes them unusual
   events for voters, parties and students of voting behaviour. The 1997
   devolution referendums in Scotland and Wales were highly significant
   since they led to major constitutional changes. In the novel
   circumstances of a referendum, political parties and the media played an
   important role in providing voters with information to guide their
   voting decisions. Longstanding identities and opinions relating to the
   pros and cons of the issue involved and attitudes towards the government
   influenced voting. Reassuringly, opinions about the effects of
   devolution were highly influential.},
