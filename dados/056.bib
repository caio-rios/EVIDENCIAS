@article{ WOS:000179104700002,
Author = {Seeleib-Kaiser, M},
Title = {A dual transformation of the German welfare state?},
Journal = {WEST EUROPEAN POLITICS},
Year = {2002},
Volume = {25},
Number = {4},
Pages = {25-48},
Month = {OCT},
Note = {Conference on Euroland and Eastern Europe - Assessing the New
   Integration Processes, UNIV PENN, PHILADELPHIA, PA, MAR 22-24, 2002},
Abstract = {Contrary to the notion of a political blockade making comprehensive
   reform impossible, this article argues that we have, in fact, witnessed
   a dual transformation of the German welfare state during the past 25
   years. Increasingly, the state reduces its commitment to securing the
   living standard of former wage earners, which had been the key normative
   principle of the German welfare state in the post-war era. At the same
   time, the state is expanding its role in providing public support and
   services for families. This dual transformation has been caused by the
   emergence of new interpretative patterns among the political elite.},
