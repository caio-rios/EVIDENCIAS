Volume = {23},
Number = {3},
Pages = {235-248},
Month = {JUL},
Abstract = {The coming Eastern enlargement of the European Union is seen by
   governments of the present member states, and by EU institutions, as
   threatening the EU institutional system's capacity to act, more so than
   any of the preceding enlargements. This article explores the origins of
   this concern, examines the way the EU states have sought to address it
   by means of treaty reforms (the last of which was agreed by the Nice
   European Council of December 2000), and addresses some other
   institutional challenges that should be dealt with before enlargement
   occurs.},
