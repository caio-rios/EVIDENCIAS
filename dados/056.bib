@article{ WOS:000180576800005,
Author = {White, A},
Title = {Geographies of asylum, legal knowledge and legal practices},
Journal = {POLITICAL GEOGRAPHY},
Year = {2002},
Volume = {21},
Number = {8},
Pages = {1055-1073},
Month = {NOV},
Abstract = {Law and legal discourses are an integral part of social life, a central
   means of producing social identities and exercising social power in day
   to day life. Critically informed geographical perspectives on law have
   illustrated in a number of ways how the legal and social (and therefore
   the spatial) are mutually constitutive. This paper argues that
   perspectives from critical legal geography can offer insights into the
   operation of asylum and immigration law in the UK in the late 1990s.
   This paper argues that legal practices and relations are organised in
   hegemonic and counter-hegemonic ways in different places and
   institutional contexts in London. In addition law and legal practices
   comprise a particularly important way in which `community' can be
   constructed simultaneously across a variety of different scales in ways
   that can marginalise and exclude relatively powerless groups like asylum
   seekers. Thus refugee identities offer a particularly clear example of
   how social realities are constituted by law and legal practice. (C) 2002
   Elsevier Science Ltd. All rights reserved.},
Publisher = {ELSEVIER SCI LTD},
