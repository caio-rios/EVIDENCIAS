Year = {2002},
Volume = {46},
Number = {3},
Pages = {642-655},
Month = {JUL},
Note = {Annual Meeting of the Midwest-Political-Science-Association, CHICAGO,
   ILLINOIS, APR 27-30, 2000},
Organization = {Midwest Polit Sci Assoc},
Abstract = {We articulate and test an explanation for the remarkable change and
   continuity in contemporary tax policy in capitalist democracies, We
   argue that internationalization, domestic economic change, and budgetary
   pressures each prompt significant changes in tax policy; yet, together,
   them create a system of constraints on altering the level and
   distribution of tax burdens, We utilize 1981 to 1995 data from fourteen
   developed demo mocracles to analyze the determinants of taxation, We
   find that capital mobility and trade are associated with, cuts in
   statutory corporate tax rates but not with reductions in effective
   average tax rates on capital income, Moreover, we find that capital
   mobility I is negatively associated with,the tax components of labor
   costs. Domestically, structural unemployment leads to reductions in
   labor and men Capital taxes while public sector debt and societal needs
   raise taxes. We conclude with a summary of the new political economy of
   taxation in capitalist democracies.},
