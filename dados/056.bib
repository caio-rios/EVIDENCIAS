@article{ WOS:000177868900005,
Author = {Hooghe, L and Marks, G and Wilson, CJ},
Title = {Does left/right structure party positions on European integration?},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2002},
Volume = {35},
Number = {8},
Pages = {965-989},
Month = {OCT},
Note = {Meeting of the Research Group on Contestation in the European Union,
   CHAPEL HILL, NC, APR, 2000},
Abstract = {How is contestation on European integration structured among national
   political parties? Are issues arising from European integration
   assimilated into existing dimensions of domestic contestation? We show
   that there is a strong relationship between the conventional left/right
   dimension and party positioning on European integration. However, the
   most powerful source of variation in party support is the new politics
   dimension, ranging from Grem/alternative/libertarian to
   Traditionat/authoritarian/nationalist.},
