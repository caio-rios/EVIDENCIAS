@article{ WOS:000285058000003,
Author = {Friedman, Elisabeth Jay},
Title = {Re(gion)alizing Women's Human Rights in Latin America},
Journal = {POLITICS \& GENDER},
Year = {2009},
Volume = {5},
Number = {3},
Pages = {349-375},
Month = {SEP},
Abstract = {Between 1993 and 2000, nearly every democracy in Latin America passed a
   law prohibiting domestic violence. Between 2001 and 2006, five countries
   strengthened their legislation, and Brazil passed its first law. What
   explains these advances with respect to women's rights? While other work
   has focused on domestic or international factors, this article brings to
   light the role of the region. It reveals that the two inter-American
   women's rights organizations have been active in both establishing
   regional norms and promoting their national adoption and implementation.
   While this suggests that regional governance can promote women's social
   rights, there is no automatic institutionalization of these norms. Case
   studies on Chile and Brazil illustrate the impact of national context.},
