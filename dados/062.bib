Volume = {1},
Number = {2},
Pages = {265-296},
Month = {JUN},
Abstract = {Dominant psychoanalytic paradigms locate the breast or penis/phallus as
   the touchstone for gender/sex/sexual development. This essay offers a
   critique of these accounts and an alternative theory of sexed forms of
   being: pregnancy envy and the kinship rules that result from this. The
   essay also provides an intellectual history of how previous efforts to
   theorize pregnancy envy, especially work by Ida Macalpine, were
   suppressed.},
