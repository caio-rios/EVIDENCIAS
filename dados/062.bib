@article{ WOS:000417061600003,
Author = {Barakso, Maryann},
Title = {Is There a ``Woman's Way{''} of Governing? Assessing the Organizational
   Structures of Women's Membership Associations},
Journal = {POLITICS \& GENDER},
Year = {2007},
Volume = {3},
Number = {2},
Pages = {201-227},
Month = {JUN},
Abstract = {To what extent do women's organizations share a common commitment to
   organizational participatory democracy? Research suggests that women
   appear more likely than men to prefer democratic decision-making
   processes, yet these studies generally compare women's and men's
   behavior in organizations that are not only numerically dominated by men
   but that were also initially formed by men. I examine the electoral and
   policymaking rules of 37 membership-based women's associations in order
   to determine the extent to which the bylaws of women's groups exhibit
   the high levels of democracy predicted by the theoretical and empirical
   literature. I find that levels of democracy in women's associations vary
   more than research on women's governance would suggest. I then explore
   factors that influence the observed variation in women's groups. I find
   that the extent to which a women's group relies on membership dues, the
   year it was founded, and, to a lesser extent, its size affect how
   democratically it is structured. I conclude by considering the
   implications of these findings for the representation of women's diverse
   political and economic interests.},
