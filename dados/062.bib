@article{ WOS:000417060600003,
Author = {Ondercin, Heather L. and Bernstein, Jeffrey L.},
Title = {Context Matters: The Influence of State and Campaign Factors on the
   Gender Gap In Senate Elections, 1988-2000},
Journal = {POLITICS \& GENDER},
Year = {2007},
Volume = {3},
Number = {1},
Pages = {33-53},
Month = {MAR},
Abstract = {Since the 1980s, we have witnessed how the gender gap grows and shrinks
   in various elections; we address how the context in which the election
   takes place influences the size of the divide. Studying the gender gap
   in Senate elections allows us to look al multiple elections across time
   and space to determine when significant electoral gender gaps arise and
   when they do not. This contrasts with more traditional approaches that
   focus either on a single presidential election or on a single year's
   House or Senate elections. We demonstrate that electoral gender gaps
   arise from campaign-level factors (such as candidate sex, the presence
   of an incumbent, and the issues raised in the campaign), state-level
   factors (demographics and politics of the states), and the complex
   interaction of these factors.},
Publisher = {CAMBRIDGE UNIV PRESS},
