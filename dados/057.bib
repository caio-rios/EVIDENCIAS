@article{ WOS:000171214300006,
Author = {Goodliffe, J},
Title = {The effect of war chests on challenger entry in US House elections},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2001},
Volume = {45},
Number = {4},
Pages = {830-844},
Month = {OCT},
Note = {Annual Meeting of the Midwest-Political-Science-Association, CHICAGO,
   IL, APR 23-25, 1998},
Organization = {Midwest Polit Sci Assoc},
Abstract = {This article examines whether a War chest deters potential challengers
   from entering a congressional race. I discuss theoretical arguments for
   and against deterrence. I find that previous analyses of war chests have
   omitted important variables, and thus, their conclusions are suspect.
   Using data from the 1984-1998 U.S. House elections, I employ a bivariate
   probit model with sample selection to test whether large war chests
   deter high or low-quality challengers from entering a race. Once
   previously omitted variables are included, I find that war chests do not
   deter challengers.},
