@article{ WOS:000172085500005,
Author = {Hall, MG},
Title = {Voluntary retirements front state supreme courts: Assessing democratic
   pressures to relinquish the bench},
Journal = {JOURNAL OF POLITICS},
Year = {2001},
Volume = {63},
Number = {4},
Pages = {1112-1140},
Month = {NOV},
Abstract = {This article assesses whether electoral vulnerability promotes strategic
   retirements in state supreme courts and, more generally, whether
   elections are more effective in promoting democratic control of the
   bench than believed. Results indicate that voluntary retirements are
   influenced by electoral considerations, but only when justices are
   retained in partisan or retention elections. With nonpartisan elections,
   these effects are absent. Through the lens of judicial reform, these
   findings suggest that some arguments for abandoning partisan elections
   and adopting the Missouri Plan may lack merit and that the premises
   underlying institutional design should be reconsidered. Moreover,
   studies of judicial choice must be attentive both to strategy and
   context.},
Publisher = {BLACKWELL PUBLISHERS},
Address = {350 MAIN STREET, STE 6, MALDEN, MA 02148 USA},
