@article{ WOS:000168163100004,
Author = {Newton, K},
Title = {Trust, social capital, civil society, and democracy},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2001},
Volume = {22},
Number = {2},
Pages = {201-214},
Month = {APR},
Abstract = {The importance of trust has long been emphasised by social and political
   theorists from Locke and Tocqueville to Putnam and civil society
   theorists. However, individual survey data casts substantial doubt on
   this powerful tradition of thought. There is little evidence of (1) an
   overlap between social and political trust, (2) a syndrome of trust and
   membership of voluntary organizations, and (3) the existence of
   trusting/distrusting dispositions among individuals. However, at the
   aggregate national level there is evidence to support the theory, and
   the author concludes that the classic theory is correct but needs
   modification and qualification.},
