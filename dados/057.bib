EISSN = {1468-2508},
Keywords-Plus = {CROSS-CLASS ALLIANCES; WELFARE-STATE; POLITICAL SUPPORT; UNITED-STATES;
   OUTCOMES; PRESIDENTS; EXPANSION; DYNAMICS; BRITAIN; CONTEXT},
