@article{ WOS:000169584500003,
Author = {Keys, MM},
Title = {Aquinas's two pedagogies: A reconsideration of the relation between law
   and moral virtue},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2001},
Volume = {45},
Number = {3},
Pages = {519-531},
Month = {JUL},
Abstract = {The preoccupation of modern political theory with coercive force, its
   legitimate uses and principled limitations, has colored most recent
   treatments of the relationship between the law of a political society
   and the moral virtue of its citizens. The same is true of contemporary
   considerations of Thomas Aquinas's position on this issue, including the
   most thorough such discussion in Robert P. George's Making Men Moral
   (1993). In this article, I argue that the ``legal enforcement of
   morals{''} paradigm conduces to an exaggerated focus on Aquinas's
   negative pedagogy: law as ``restraining and taming{''} the viciously
   inclined human. I argue that Aquinas's political theory also comprises a
   positive pedagogy: law as assisting the well-intentioned person to grasp
   and develop the ``social and civic{''} dimensions of the ethical
   virtues. I then consider what relevance this aspect of Aquinas's theory
   might hold for contemporary liberal democracy, focusing on the
   institution of the ``legal holiday.{''}},
