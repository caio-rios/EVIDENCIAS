@article{ WOS:000171849300003,
Author = {Isaksson, GE},
Title = {Parliamentary government in different shapes},
Journal = {WEST EUROPEAN POLITICS},
Year = {2001},
Volume = {24},
Number = {4},
Pages = {40-54},
Month = {OCT},
Abstract = {This article focuses on the principles of parliamentary government and
   the implementation of these principles. Empirically, the study includes
   239 cabinet formations in Europe after World Mar II. The results show
   that the party structure significantly affects the way the principles of
   majority; plurality, and responsiveness are pert into practice. In
   two-pain, systems, institutional arrangements guarantee that the
   principles are implemented. III consensual multi-party systems, the
   principles are largely implemented as well. However; in non-consensual
   multi-party systems, often including one dominant party, it is notch
   more difficult to fulfil the ideals of parliamentary government. The
   study also shows that the majority element greatly increases government
   stability.},
