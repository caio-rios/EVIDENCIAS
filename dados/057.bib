@article{ WOS:000172958300004,
Author = {Lane, JH},
Title = {The Stark regime and American democracy:: A political interpretation of
   Robert Penn!Warren's All the King's Men},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2001},
Volume = {95},
Number = {4},
Pages = {811-828},
Month = {DEC},
Note = {APSA Annual Meeting, ATLANTA, GEORGIA, SEP 02-05, 1999},
Organization = {APSA},
Abstract = {Robert Penn Warren's All the King's Men is a political novel that
   deserves the serious study of political scientists interested in
   understanding the formative effects of American democracy. A careful
   reading of the novel that is informed by the classical approach to the
   analysis of regimes reveals the close connection between the politics of
   Willie Stark and the politics of modem American democracy. Furthermore,
   by viewing Stark's actions through the eyes of Jack Burden, a perceptive
   narrator who is moving toward self-knowledge, we can gain insight into
   both why modem democracies encourage the formation of a debilitating
   nihilism among their citizens and the prospects for countering these
   effects.},
