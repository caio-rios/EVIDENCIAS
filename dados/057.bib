@article{ WOS:000168810500001,
Author = {de Vreese, CH and Peter, J and Semetko, HA},
Title = {Framing politics at the launch of the euro: A cross-national comparative
   study of frames in the news},
Journal = {POLITICAL COMMUNICATION},
Year = {2001},
Volume = {18},
Number = {2},
Pages = {107-122},
Month = {APR-JUN},
Note = {50th Annual Meeting of the International-Communication-Association,
   ACAPULCO, MEXICO, JUN 01-05, 2000},
Organization = {Int Commun Assoc},
Abstract = {This study of the main evening television news programs in four European
   countries focuses on the framing of news surrounding a major European
   event, the January 1, 1999, introduction of the common European
   currency, the euro. We investigated the visibility of political and
   economic news in general and of the launch of the euro in particular. We
   found variations across countries in the emphasis on political and
   economic news, with the proportion of the newscast normally devoted to
   these subjects ranging from 45\% to 60\%. Journalists in all countries
   were more likely to emphasize conflict (rather than economic
   consequences) in framing general political and economic news. In the
   coverage of the launch of the euro, there was a greater emphasis on
   framing the news in terms of economic consequences. The findings are
   discussed in terms of influences on framing practices internal and
   external to journalism and the value of the cross-national comparative
   approach.},
