@article{ WOS:000168898300001,
Author = {Barnett, C},
Title = {Culture, policy, and subsidiarity in the European Union: from symbolic
   identity to the governmentalisation of culture},
Journal = {POLITICAL GEOGRAPHY},
Year = {2001},
Volume = {20},
Number = {4},
Pages = {405-426},
Month = {MAY},
Abstract = {This paper critically assesses the discourse of cultural policy
   initiatives of the European Union (EU) during the 1990s. It focuses upon
   the formulation of so-called `cultural action' following the recognition
   of culture in the Treaty on European Union in 1992. It explores the
   multiple instrumentalities ascribed to culture as a medium for the
   management of European integration, and suggests that the evolution of
   policies to promote cultural co-operation is indicative of a progressive
   `governmentalisation' of culture at the EU level. The paper argues that
   the focus of critical evaluation of EU cultural policy should be upon
   practices of citizenship participation in emergent network polities. (C)
   2001 Elsevier Science Ltd. All rights reserved.},
Publisher = {ELSEVIER SCI LTD},
Address = {125 London Wall, London, ENGLAND},
Type = {Article},
Language = {English},
Affiliation = {Barnett, C (Corresponding Author), Univ Bristol, Sch Geol Sci, Univ Rd, Bristol BS8 1SS, Avon, England.
   Univ Bristol, Sch Geol Sci, Bristol BS8 1SS, Avon, England.},
DOI = {10.1016/S0962-6298(01)00002-6},
ISSN = {0962-6298},
EISSN = {1873-5096},
