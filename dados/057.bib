@article{ WOS:000169993900001,
Author = {Lake, DA and Baum, MA},
Title = {The invisible hand of democracy - Political control and the provision of
   public services},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2001},
Volume = {34},
Number = {6},
Pages = {587-621},
Month = {AUG},
Note = {Annual Meeting of the American-Political-Science-Association, UNIV CALIF
   LOS ANGELES, LOS ANGELES, CALIFORNIA, 1998},
Organization = {Amer Polit Sci Assoc},
Abstract = {Despite considerable normative support, analysts have failed to identify
   any systematic effects of democracy on domestic policy outputs. Building
   on a theory of the state as a monopoly producer of public services and
   establishing a common foundation for studying variations in regimes and
   their policy consequences, the authors hypothesize that democratic
   states will earn fewer monopoly rents and produce a higher level of
   services than autocracies. They test this hypothesis both
   cross-sectionally and over time for a variety of public health and
   education indicators. The statistical results strongly support their
   hypotheses. The authors conclude that democracy has real, substantively
   important effects on the daily lives and well-being of individuals
   around the globe.},
