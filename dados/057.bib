@article{ WOS:000175501100004,
Author = {Weissberg, R},
Title = {Democratic political competence: Clearing the underbrush and a
   controversial proposal},
Journal = {POLITICAL BEHAVIOR},
Year = {2001},
Volume = {23},
Number = {3},
Pages = {257-284},
Month = {SEP},
Abstract = {Though the link between democracy, and an appropriately trained citizen
   is obvious, the theoretical and empirical nature of this association is
   murky, despite mountains of scholarship addressing this topic. Part of
   this problem is that the term ``democratic competence{''} has been
   stretched almost to the point of uselessness. This constant adding of
   desired trails-many of which are ideologically driven-misdirects effort
   away from such complex problems as the relationship between individual
   attributes and collective capacities. Moreover, recent research has
   often been guilty of using data of uncertain relevance to demonstrate a
   competence that seems largely an analytical artifact. We conclude by
   offering an approach that stresses ``old-fashioned{''} traits such as
   patriotism that seem necessary, to the existing, and quite democratic,
   status quo.},
