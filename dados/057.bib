@article{ WOS:000172085500007,
Author = {McKeown, TJ},
Title = {Plans and routines, bureaucratic bargaining, and the Cuban missile
   crisis},
Journal = {JOURNAL OF POLITICS},
Year = {2001},
Volume = {63},
Number = {4},
Pages = {1163-1190},
Month = {NOV},
Abstract = {Recent disclosures about the Cuban missile crisis suggest that
   organizational routines and plans did not significantly constrain U.S.
   government choices. Rather than constituting fixed barriers to
   innovation, routines and plans can be relatively plastic and subject to
   strategic alterations or misrepresentations. Although this can be partly
   understood in terms of organizational processes, plans and routines are
   both a response to and the context for strategic interaction by
   organizational participants. I present evidence of this and suggest why
   decision makers may not plan even when planning is possible and why
   plans may not be implemented even when they already exist.},
Publisher = {BLACKWELL PUBLISHERS},
