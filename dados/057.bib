@article{ WOS:000172085500001,
Author = {Golebiowska, EA},
Title = {Individual-targeted tolerance and timing of group membership disclosure},
Journal = {JOURNAL OF POLITICS},
Year = {2001},
Volume = {63},
Number = {4},
Pages = {1017-1040},
Month = {NOV},
Abstract = {Willingness to allow political outgroups to exercise First Amendment
   freedoms (group-targeted tolerance) is not always predictive of
   attitudes toward individual group members (individual-targeted
   tolerance). Taking research on individual-targeted tolerance as a point
   of departure, I test the general applicability of the distinction
   between group- and individual-targeted tolerance and examine the
   influence of information irrelevant to group-related beliefs and timing
   of group membership disclosure on judgments of individual group members.
   I find that individual members of unpopular groups are tolerated more
   than the group when individuated with a large amount of information and
   when their group membership precedes rather than follows individuating
   information.},
