@article{ WOS:000172085500010,
Author = {Hart, DM},
Title = {Why do some firms give? Why do some give a lot?: High-tech PACs,
   1977-1996},
Journal = {JOURNAL OF POLITICS},
Year = {2001},
Volume = {63},
Number = {4},
Pages = {1230-1249},
Month = {NOV},
Abstract = {This article employs Heckman selection models to explore the
   determinants of corporate PAC formation and PAC size and how these
   determinants have changed over time. While the findings suggest that
   high-tech firms use PACs to seek rents from government, internal
   organizational politics influence their behavior as well. I also find
   that the effect of some independent variables, including firm size,
   susceptibility to regulation, and R\&D spending, changed significantly
   over the mo-decade span encompassed in the data, peaking in influence in
   the mid-1980s. The quantitative analysis is supplemented by interview
   data that point to the existence of a political ``arms control{''}
   process among some market competitors.},
Publisher = {BLACKWELL PUBLISHERS},
