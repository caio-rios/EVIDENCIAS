@article{ WOS:000169584500002,
Author = {Manzer, RA},
Title = {A science of politics: Hume, the federalist, and the politics of
   constitutional attachment},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2001},
Volume = {45},
Number = {3},
Pages = {508-518},
Month = {JUL},
Abstract = {The point of departure for this article is the recognition that the
   modern science of politics was once used as a tool not only for
   developing new political institutions, but also for shaping opinion
   about a constitution. After indicating the need to seek additional
   resources within the American constitutional tradition to support a
   reflective constitutional attachment, this article explores the science
   of politics' approach to a constitution by looking at the writings of
   David Hume and The Federalist. Focusing on explaining the wisdom of
   constitutional arrangements, these writers seek to cultivate an
   enlightened, scientific public opinion as the pivot of a people's
   relationship to their constitution. Attending first to Hume's effort to
   establish an ``enlarged, enlightened{''} attachment to a constitution,
   and then to The Federalist's effort to found a constitution on the
   people's ``reflection and choice,{''} this article helps us understand
   the possibilities and limits of this kind of refection as a source of
   attachment to a constitution.},
