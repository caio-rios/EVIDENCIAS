@article{ WOS:000173376200009,
Author = {Frendreis, J and Tatalovich, R and Schaff, J},
Title = {Predicting legislative output in the first one-hundred days, 1897-1995},
Journal = {POLITICAL RESEARCH QUARTERLY},
