@article{ WOS:000172085500006,
Author = {Hellwig, TT},
Title = {Interdependence, government constraints, and economic voting},
Journal = {JOURNAL OF POLITICS},
Year = {2001},
Volume = {63},
Number = {4},
Pages = {1141-1162},
Month = {NOV},
Abstract = {This article examines the role of global economic interdependence in
   constraining citizens' responses to domestic economic performance. While
   recent work in economic voting has made strides in accounting for the
   contextual mediators of support, analyses have not gone beyond domestic
   political structures. At the same time, students of globalization
   highlight the constraints governments face from the world economy but do
   not extend their analyses to examine the role of mass political
   behavior. This article brings these two research agendas together. Using
   cross-sectional individual-level data, it is found that accounting for
   exposure to the world economy dampens the strength of domestic economic
   bases of popular support. Additional analyses show that the
   susceptibility of different groups in society to the global economy's
   mediating influences is not uniform but contingent on occupational
   differences.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
Affiliation = {Hellwig, TT (Corresponding Author), Univ Minnesota, Minneapolis, MN 55455 USA.
