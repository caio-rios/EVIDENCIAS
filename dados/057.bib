@article{ WOS:000172288900003,
Author = {Thies, CG},
Title = {A social psychological approach to enduring rivalries},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2001},
Volume = {22},
Number = {4},
Pages = {693-725},
Month = {DEC},
Note = {Annual Meeting of the Southwestern-Political-Science-Association,
   ANTONIO, TX, 1999},
Organization = {SW Polit Sci Assoc},
Abstract = {The recent scholarly work on the concept of enduring rivalries offers a
   promising way to, examine strategic interaction among dyads of states
   over extended periods of time. A focus on rivalry, and on the mechanisms
   that provide for such interaction, may, offer a way, to bridge existing
   theories of international relations that rely exclusively on structure
   or process. Unfortunately, the potential for theory-building has not
   been fully, realized because research into rivalry has tended to be
   inductive. This paper seeks to rectify, that problem by situating the
   rivalry, concept within a social psychological approach to international
   relations. The rivalry, concept is appropriately located in a
   theoretical approach that views the international system as a social
   system where actors are conditioned by mechanisms of competition and
   socialization.},
