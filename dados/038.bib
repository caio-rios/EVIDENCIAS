Web-of-Science-Categories  = {Social Sciences, Mathematical Methods; Political Science},
Author-Email = {monogan@uga.edu},
Affiliations = {University System of Georgia; University of Georgia},
Cited-References = {Abramowitz Alan., 1992, SENATE ELECTIONS.
