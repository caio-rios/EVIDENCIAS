@article{ WOS:000322322800005,
Author = {Reh, Christine and Heritier, Adrienne and Bressanelli, Edoardo and Koop,
   Christel},
Title = {The Informal Politics of Legislation: Explaining Secluded Decision
   Making in the European Union},
Journal = {COMPARATIVE POLITICAL STUDIES},
