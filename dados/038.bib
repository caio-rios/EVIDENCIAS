@article{ WOS:000318265500015,
Author = {McGuire, Kevin T.},
Title = {The Psychological Origins of a Constitutional Revolution: The Supreme
   Court, Birth Order, and Nationalizing the Bill of Rights},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2013},
Volume = {66},
Number = {2},
Pages = {441-453},
Month = {JUN},
Abstract = {One of the most significant changes in American law was the application
   of the Bill of Rights to the states. Some members of the U.S. Supreme
   Court enthusiastically supported the doctrine of incorporation, while
   others actively opposed it. Why? Evolutionary psychology posits that
   birth order can explain support for radical change; older siblings
   identify with authority and resist changes in the rules, while
   laterborns defy authority and are willing to alter the status quo.
   Applying the birth order hypothesis to the Court, the author finds that
   the incorporation revolution was led by laterborns, even after taking
   account of justices' political preferences.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
