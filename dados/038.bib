@article{ WOS:000330516100017,
Author = {Gershon, Sarah Allen},
Title = {Media Coverage of Minority Congresswomen and Voter Evaluations: Evidence
   from an Online Experimental Study},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2013},
Volume = {66},
Number = {3},
Pages = {702-714},
Month = {SEP},
Abstract = {Scholars of gender and race politics have long drawn links between the
   media's less than favorable treatment of women and minorities, and these
   candidates' struggles to curry favor with voters. However, few have
   examined minority women's coverage. This multimethodological study
   examines the nature and implications of the media's treatment of Anglo,
   Latina, and African American congresswomen. The results indicate
   significant differences in the content of these women's media coverage
   and its influence on voters' attitudes. The implications of these
   findings for Anglo and minority women campaigning for and holding
   elective office are discussed.},
