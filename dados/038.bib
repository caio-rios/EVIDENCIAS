@article{ WOS:000318265500016,
Author = {Black, Ryan C. and Owens, Ryan J.},
Title = {A Built-In Advantage: The Office of the Solicitor General and the US
   Supreme Court},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2013},
Volume = {66},
Number = {2},
Pages = {454-466},
Month = {JUN},
Abstract = {The Office of the Solicitor General wins the vast majority of Supreme
   Court cases in which it participates. Does it enjoy a built-in
   advantage, or does it win because it employs experienced litigators,
   enjoys resource advantages, or carries the executive's sword? To answer
   these questions, we employ cutting edge matching methods. After matching
   OSG lawyers with nearly identical non-OSG lawyers in nearly identical
   cases, we find that OSG attorneys still are more likely to win their
   cases. We discuss possible reasons for this built-in advantage along
   with some practical implications of our findings.},
