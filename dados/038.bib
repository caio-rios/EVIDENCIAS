@article{ WOS:000327797100004,
Author = {Rohlfing, Ingo and Starke, Peter},
Title = {Building on Solid Ground: Robust Case Selection in Multi-Method Research},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2013},
Volume = {19},
Number = {4},
Pages = {492-512},
Month = {DEC},
Abstract = {The social sciences are currently witnessing a trend toward multi-method
   research (MMR). However, many important issues have not been
   sufficiently addressed so far. The focus of this paper is case selection
   for process tracing on the basis of regression results, which is the
   main point of intersection between the two methods. Based on a review,
   we first show that the current empirical and methodological literature
   does not fully appreciate the implications of modeling uncertainty and
   non-robust quantitative results. The major problem is that non-robust
   regression results may lead to invalid choices and faulty inferences. We
   develop a novel selection procedure that takes these issues into account
   and improves causal inference in MMR.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Rohlfing, I (Corresponding Author), Univ Bremen, BIGSSS, Wiener Str Ecke Celsiusstr, D-28359 Bremen, Germany.
   Rohlfing, Ingo, Univ Bremen, BIGSSS, D-28359 Bremen, Germany.
   Rohlfing, Ingo; Starke, Peter, Jacobs Univ Bremen, D-28759 Bremen, Germany.
   Starke, Peter, Univ Southern Denmark, Ctr Welf State Res, Odense, Denmark.},
DOI = {10.1111/spsr.12052},
ISSN = {1424-7755},
EISSN = {1662-6370},
