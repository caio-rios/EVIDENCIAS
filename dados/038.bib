@article{ WOS:000330516100014,
Author = {Smith, Glen and Searles, Kathleen},
Title = {Fair and Balanced News or a Difference of Opinion? Why Opinion Shows
   Matter for Media Effects},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2013},
Volume = {66},
Number = {3},
Pages = {671-684},
Month = {SEP},
Abstract = {In this article, we examine both the content and effects of opinion
   shows during the 2008 presidential election. First, a content analysis
   shows that opinion shows devote most of their attention to attacking the
   opposition candidate, rather than praising the like-minded candidate.
   Second, analyses of panel data show that exposure to opinion shows made
   viewers less (more) favorable toward the opposition (like-minded)
   candidate. Finally, we use overtime analyses to show that coverage of
   the opposition candidate affects attitudes toward both candidates,
   whereas coverage of the like-minded candidate has negligible effects on
   attitudes toward either candidate.},
