   Univ Reading, Dept Polit \& Int Relat, Reading, Berks, England.},
DOI = {10.1080/13510347.2012.683662},
ISSN = {1351-0347},
EISSN = {1743-890X},
Keywords = {regime type; hybrid regimes; occupation; state-building;
   internationalization},
Keywords-Plus = {OCCUPATION; DEMOCRACY; LINKAGE; RISE},
