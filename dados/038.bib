@article{ WOS:000330464600014,
Author = {Patten, Alan},
Title = {Cultural Preservation and Liberal Values: A Reply to William James Booth},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2013},
Volume = {107},
Number = {4},
Pages = {875-882},
Month = {NOV},
Abstract = {William James Booth elaborates three main challenges to my social
   lineage account (Patten 2011). Conceptually, he finds the proposal to be
   question-beginning. Normatively, he thinks that it has objectionable
   implications. And, substantively, he claims that the proposal is
   unhelpful, in that it fails to explain a case of theoretical importance
   for multiculturalism. In this reply, I argue that each of these
   challenges misses the target. The social lineage account continues to
   offer a promising, nonessentialist basis for normative multiculturalism.},
