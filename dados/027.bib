@article{ WOS:000446999100007,
Author = {Krasa, Stefan and Polborn, Mattias K.},
Title = {Political Competition in Legislative Elections},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2018},
Volume = {112},
Number = {4},
Pages = {809-825},
Month = {NOV},
Abstract = {We develop a theory of electoral competition in multidistrict
   legislative elections when nomination decisions are made by local
   policy-motivated party members, and voters care about both local and
   national positions. We show that the asymmetry generated by different
   national party positions reduces or even entirely removes the
   competitive pressure to nominate moderate candidates. The model has
   important implications for our understanding of policy divergence and,
   in particular, of the effects of gerrymandering.},
