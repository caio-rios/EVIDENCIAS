@article{ WOS:000436308500031,
Author = {van der Windt, Peter},
Title = {Can Development Aid Empower Women? Evidence from a Field Experiment in
   the Congo},
Journal = {JOURNAL OF POLITICS},
Year = {2018},
Volume = {80},
Number = {3},
Pages = {1039-1044},
Month = {JUL},
Abstract = {Can development aid empower women? We randomly assigned 1,250 Congolese
   communities to a development program that distributed development funds
   and included women in project selection and implementation, with the
   goal of empowering women. In 2010 and 2011, we revisited 816 treatment
   and control communities to collect survey data. Furthermore, in 413
   communities we implemented a \$1,000 unconditional cash transfer program
   to assess behavioral change. We find only weak evidence that the program
   influenced the role of women in the community and policy outcomes and no
   evidence that the program had an impact on the role of women within the
   household or attitudes toward them.},
