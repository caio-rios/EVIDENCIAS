@article{ WOS:000439606000002,
Author = {Gell-Redman, Micah and Visalvanich, Neil and Crabtree, Charles and
   Fariss, Christopher J.},
Title = {It's All about Race: How State Legislators Respond to Immigrant
   Constituents},
Journal = {POLITICAL RESEARCH QUARTERLY},
