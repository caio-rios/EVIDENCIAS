@article{ WOS:000436308500039,
Author = {Monroe, Nathan and Patty, John W. and Penn, Elizabeth Maggie},
Title = {What Is Pivotal Politics (and What Else Can It Be)?},
Journal = {JOURNAL OF POLITICS},
Year = {2018},
Volume = {80},
Number = {3},
Pages = {1088-1099},
Month = {JUL},
Abstract = {In this article, we discuss what Krehbiel's Pivotal Politics theory does
   (and does not) imply and then turn to ways that this parsimonious and
   highly influential theory of lawmaking can and should be extended. An
   overarching theme is that Pivotal Politics continues to teach us much
   about lawmaking. While (like all theories) it may be critiqued and
   interrogated, it remains true that ``you can't beat something with
   nothing.{''}},
