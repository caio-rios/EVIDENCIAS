@article{ WOS:000439606000010,
Author = {Redman, Shane M.},
Title = {Effects of Same-Sex Legislation on Attitudes toward Homosexuality},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2018},
Volume = {71},
Number = {3},
Pages = {628-641},
Month = {SEP},
Abstract = {Despite the long historical battle of members of the gay and lesbian
   community to gain equal rights as their heterosexual counterparts, the
   adoption of public policies at the national level that recognize
   same-sex partnerships and marriages is a relatively recent political
   development across the globe. Consequently, we know little about
   whether, and how, this type of legislation affects public attitudes
   toward homosexuality. This study examines the relationship between
   same-sex couple legislation and public opinion using data from the World
   Values Survey from the years 1989 to 2014. While previous studies
   examining this relationship in the European context have found a
   positive relationship, the results presented in this paper paint a less
   optimistic picture of the impacts that same-sex couple legislation has
   on attitudes toward homosexuality. Specifically, I find that instead of
   same-sex partnership legislation increasing favorable attitudes across
   the entire population, it only affects individuals who are already
   generally supportive of homosexuality. Implications for gay and lesbian
   rights are discussed.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Redman, SM (Corresponding Author), Univ Pittsburgh, Dept Polit Sci, 4600 Wesley W Posvar Hall, Pittsburgh, PA 15260 USA.
   Redman, Shane M., Univ Pittsburgh, Pittsburgh, PA USA.},
DOI = {10.1177/1065912917753077},
ISSN = {1065-9129},
EISSN = {1938-274X},
Keywords = {public opinion; public policy; sexuality politics; same-sex marriage;
   LGBT rights},
Keywords-Plus = {GAY MEN; HETEROSEXUALS ATTITUDES; PUBLIC-OPINION; UNITED-STATES;
   HOMOPHOBIA; LESBIANS; CONTACT; PERSPECTIVE; EDUCATION; RIGHTS},
