@article{ WOS:000243150200006,
Author = {Baird, Barbara},
Title = {Sexual citizenship in `the New Tasmania'},
Journal = {POLITICAL GEOGRAPHY},
Year = {2006},
Volume = {25},
Number = {8},
Pages = {964-987},
Month = {NOV},
Abstract = {The state of Tasmania, the smallest in the Commonwealth of Australia,
   has recently reformed its law relating to relationships by amending over
   100 pieces of legislation to include a range of relationships, including
   lesbian and gay partnerships, among those given recognition and legal
   entitlement. This government-sponsored legislation is represented as
   central to the program of economic revival, social reform and branding
   described as `the New Tasmania'. This article locates the relationship
   reform in this discourse of Tasmania's newness and in the context of
   neo-liberal approaches to globalisation. It argues that sexual
   citizenship takes a multitude of forms and its value, like the value of
   relationship reforrn legislation, cannot be easily determined. Indeed,
   it asks whether sexual citizenship as a form of belonging can ever be
   disentangled from the various contexts where it is performed. It
   concludes by privileging the desires and performances of sexual
   citizenship over the constitution of sexual citizenship in rights or
   recognition. (c) 2006 Elsevier Ltd. All rights reserved.},
