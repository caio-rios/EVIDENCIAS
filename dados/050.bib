@article{ WOS:000254059300002,
Author = {Ipperciel, Donald},
Title = {Switzerland: An exception in nationalism?},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2007},
Volume = {13},
Number = {1},
Pages = {39-67},
Abstract = {In debates on nation and nationalism, Switzerland is often portrayed as
   an exception by those defending a subjectivist brand of nationalism,
   especially when it comes to opposing a linguistic conception of the
   nation. By contrast, the present article would like to contribute to the
   thesis of the linguistic basis of the nation by refuting the exceptional
   nature of Switzerland. It is argued that Switzerland is subject to the
   same communicative - thus linguistic - logic underlying the modem nation
   as is any other great nation. Against this background, Switzerland
   appears to be a multinational state following a communicative logic
   peculiar to democratic states. Our approach will be theoretical and
   historical.},
