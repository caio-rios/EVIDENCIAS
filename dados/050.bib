@article{ WOS:000243635400002,
Author = {Kam, Cindy D.},
Title = {When duty calls, do citizens answer?},
Journal = {JOURNAL OF POLITICS},
Year = {2007},
Volume = {69},
Number = {1},
Pages = {17-29},
Month = {FEB},
Abstract = {This article proposes that campaigns can serve a social function by
   drawing citizens into thinking about politics. Through an analysis of
   experimental data, the article reports that when subtle reminders of
   citizen duty appear in campaign discourse, citizens respond. Individuals
   who are reminded of citizen duty are more likely to learn where the
   candidates stand on issues, to think more about the candidates, and to
   search for information in an open-minded way. The results suggest that
   how citizens think about politics is flexible, rather than fixed, and
   can be shaped in consequential ways by the nature of elite appeals
   during election campaigns.},
