@article{ WOS:000254059500002,
Author = {Obinger, Herbert and Zohlnhoefer, Reimut},
Title = {Retreat of the intervention state?: The changes in government subsidy
   expenditure in the OECD since 1980},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2007},
Volume = {13},
Number = {2},
Pages = {203-236},
Abstract = {The paper analyses the changes in the subsidy expenditures of OECD
   countries in the past 25 years. On the one hand almost all OECD members
   have reduced subsidies substantially; on the other hand subsidy
   expenditure levels have converged. An empirical analysis of the
   cross-national differences in the levels and changes of subsidy
   expenditure reveals a status quo bias of institutional pluralism and a
   declining importance of political parties and interest groups for
   shaping subsidy policies since the 1990s. The explanatory power of
   socio-economic problem pressure is limited, while European integration
   and globalization are not directly responsible for the decline of
   subsidy expenditures in advanced OECD countries either.},
Publisher = {WILEY},
