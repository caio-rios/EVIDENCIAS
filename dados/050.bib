@article{ WOS:000242852600005,
Author = {De Winter, Lieven and Swyngedouw, Marc and Dumont, Patrick},
Title = {Party system(s) and electoral behaviour in Belgium: From stability to
   balkanisation},
Journal = {WEST EUROPEAN POLITICS},
Year = {2006},
Volume = {29},
Number = {5},
Pages = {933-956},
Month = {NOV},
Abstract = {Belgium has one of the most fragmented party systems of any modern
   democracy. This article asks the following questions: is party
   fragmentation linked to the importance of the ethno-regionalist vote or
   to the rules of the electoral system? Has party fragmentation also
   produced centrifugal or polarised multipartyism (between the regions,
   but also within Flanders, given the spectacular rise of the Vlaams
   Blok)? What explains the difference in party fragmentation between
   Flanders and Wallonia? What are the dimensions of party competition in
   each community and what are the socio-demographic and attitudinal
   characteristics of the different electorates? Which steps have the
   political elites taken to cope with the increasing fragmentation of the
   party landscape and growing voter volatility? To what extent has the
   increasing divergence between the regional party systems led to the
   building of asymmetrical coalitions at the federal and regional levels
   of government? The splitting of the Belgian party system into two,
   albeit still fragmented, party systems has further complicated the
   problems of coordination within a polarised, multicleavage and
   multilevel system that seriously undermines the stability of the entire
   political system.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
