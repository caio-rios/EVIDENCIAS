@article{ WOS:000243635400011,
Author = {Blanton, Shannon Lindsey and Blanton, Robert G.},
Title = {What attracts foreign investors? An examination of human rights and
   foreign direct investment},
Journal = {JOURNAL OF POLITICS},
Year = {2007},
Volume = {69},
Number = {1},
Pages = {143-155},
Month = {FEB},
Abstract = {Though the prospective relationship between foreign direct investment
   (FDI) and human rights has long been a prominent issue within the global
   political economy, the linkage is empirically underdeveloped. Rather,
   the conventional wisdom that FDI and respect for human rights are
   inherently contradictory has persisted. Instead, we posit that respect
   for human rights may encourage FDI. To examine this issue, we assess the
   direct effects of human rights upon FDI as well as the extent to which
   human rights indirectly affects FDI through its impact upon human
   capital. Using a system of simultaneous equations, we find respect for
   human rights to have a positive impact upon FDI.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
