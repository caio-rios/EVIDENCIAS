@article{ WOS:000254059600004,
Author = {Widmer, Frederic},
Title = {New strategies and elites of trade unions: The Swiss Workers' Federation
   during the crisis of the 1900s)},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2007},
Volume = {13},
Number = {3},
Pages = {395-431},
Abstract = {Drawing from the case of the Swiss Workers' Federation between 1970 and
   2004, this article analyses how trade unions adapted to their weakened
   position in the 1990s. It is argued that the weakening of the unions in
   the economic realm engendered a shift of their activities towards the
   political sphere. Two aspects of the strategic change can be identified.
   Firstly, the ``traditional elites{''} were replaced by new cadres,
   typically members of the Social Democratic Party (SP) who held a
   university diploma. This change contributed, secondly, to a renewed,
   more favourable attitude towards the state and to a diversification of
   the union's activities. Along with the collective bargaining, strategies
   of politicisation, mobilisation and mediatisation were increasingly
   used. These developments attest to the union's rapprochement with the
   SR.},
Publisher = {VERLAG RUEGGER},
Address = {POSTFACH 1470, ZUERICH, 8040, SWITZERLAND},
