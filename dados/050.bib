@article{ WOS:000257769800007,
Author = {Christophorou, Christophoros},
Title = {An old cleavage causes new divisions: Parliamentary elections in the
   Republic of Cyprus, 21 May 2006},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2007},
Volume = {12},
Number = {1},
Pages = {111-128},
Month = {MAR},
Abstract = {The change of government in 2003 and the 2004 referendum on the Annan
   Plan influenced the outcome of the 2006 parliamentary elections. A
   long-standing cleavage based on choices for a solution to the Cyprus
   issue surfaced in 2004 and caused deep divisions and a large swing vote,
   triggering realignment of the electorate. However, resistance by the two
   major parties, which countered by promoting the left-right cleavage and
   party loyalty, curtailed the impact of the new divisions. This election,
   marking a crystallization of the post-referendum electoral realignment,
   showed that urban centres emerged more fragmented, while highly
