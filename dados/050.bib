@article{ WOS:000241990300005,
Author = {Kim, Yong-Chan and Jung, Joo-Young and Ball-Rokeach, Sandra J.},
Title = {``Geo-ethnicity{''} and neighborhood engagement: A communication
   infrastructure perspective},
Journal = {POLITICAL COMMUNICATION},
Year = {2006},
Volume = {23},
Number = {4},
Pages = {421-441},
Month = {OCT-DEC},
Abstract = {This article introduces the concept of ``geo-ethnicity{''} -ethnically
   articulated attitudes and behaviors grounded in a specific temporal and
   spatial situation. Based upon survey data gathered in seven
   ``geo-ethnic{''} communities, we demonstrate a unique effect of
   geo-ethnicity on individuals' neighborhood engagement. We analyze two
   types of cross-sectional comparisons: a comparison of different ethnic
   groups in the same Los Angeles area and comparisons of the same ethnic
   group across different locations in Los Angeles County. To highlight the
   unique effect of geo-ethnicity, socioeconomic status, immigration
   history, residential tenure, and home ownership are held constant for
   all analyses. The implications of the results are discussed from a
   communication infrastructure perspective.},
