@article{ WOS:000257769800002,
Author = {Joao Silveirinha, Maria},
Title = {Organizing experience: The launch of the European currency in the
   Portuguese press},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2007},
Volume = {12},
Number = {1},
Pages = {23-38},
Month = {MAR},
Abstract = {This article analyses press discourse in organizing the experience of
   social life through a case study of reports and comments on the
   construction of Europe. The research is grounded in the concept of
   `frame' proposed by Goffman and developed by other authors including
   Entman. The coverage of the first days of the single currency in the
   opinion and news discourse of two Portuguese newspapers is analysed,
   combining insights from these authors. The article shows how collective
   social life was organized differently, according to related issues and
   layers for which different keys were given.},
