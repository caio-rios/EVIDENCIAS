@article{ WOS:000246445400003,
Author = {Marquis, Lionel},
Title = {Moderators of priming effects: A theory and preliminary evidence from an
   experiment on Swiss European policy},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2007},
Volume = {28},
Number = {2},
Pages = {185-224},
Month = {MAR},
Abstract = {This article proposes an extended model of how ``media priming
   effects{''} come about, distinguishing between several mediators and
   moderators of priming. The model is tested using data from an experiment
   on Swiss foreign policy in which undergraduate students were provided
   with different types of biased information about the relationships
   between Switzerland and the European Union. The empirical analysis
   suggests that cross-sectional and cross-temporal effects are facilitated
   by quite different moderators, and that very few variables moderate
   priming according to both perspectives. In that respect, political
   knowledge, the level of recall of the experimental message, and
   awareness of the persuasive intent of the message appear central to the
   priming mechanism.},
Publisher = {SAGE PUBLICATIONS LTD},
