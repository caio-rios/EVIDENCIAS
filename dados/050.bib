   CANDIDATE; IDEOLOGY; DYNAMICS},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {tavitsm@missouri.edu},
Affiliations = {University of Missouri System; University of Missouri Columbia},
Cited-References = {Adams J, 2005, EUR J POLIT RES, V44, P899, DOI 10.1111/j.1475-6765.2005.00252.x.
