@article{ WOS:000245675400009,
Author = {Nelson, Thomas E. and Sanbonmatsu, Kira and McClerking, Harwood K.},
Title = {Playing a different race card: Examining the limits of elite influence
   on perceptions of racism},
Journal = {JOURNAL OF POLITICS},
Year = {2007},
Volume = {69},
Number = {2},
Pages = {416-429},
Month = {MAY},
Abstract = {There is much debate about the reach and seriousness of racial prejudice
   today. We ask: How do ordinary people come to view events as racist?
   Using an experiment, we investigate the effects of elite charges of
   racism on public perceptions of police conduct. We test several
   hypotheses, including discounting, expertise, and ingroup bias,
   pertaining to how public stereotypes moderate elite influence. We find
   that stereotypes matter, and that Democrats, Republicans, blacks, and
   whites cannot make claims about racism with equal success.},
