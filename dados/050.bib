@article{ WOS:000245099000003,
Author = {Cho, Wendy K. Tam and Gimpel, James G.},
Title = {Prospecting for (campaign) gold},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2007},
Volume = {51},
Number = {2},
Pages = {255-268},
Month = {APR},
Abstract = {Campaigns and political parties are faced with the immensely important
   practical challenge of financing their efforts. Raising money is
   instrumental to all other aims. In recent years, this task has been
   complicated by the need to enlist ever greater numbers of contributors
   to raise ever larger sums of money. At the same time, fundraising
   burdens are eased a bit because contributors flock together. That is,
   campaign contributing is a spatially dependent phenomenon, associated
   with affluence and the presence of networks. Accordingly, geospatial
   tools provide a helpful method for understanding and predicting where
   contributions can be most successfully mined.},
