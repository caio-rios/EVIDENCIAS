@article{ WOS:000254059600005,
Author = {Tauxe, Lionel},
Title = {Legislative concretization of federal popular initiatives: A process
   with uncertain outcomes},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2007},
Volume = {13},
Number = {3},
Pages = {433-458},
Abstract = {The process of legislative concretization of the rare federal popular
   initiatives adopted by vote has been neglected by academic research. In
   this exploratory study based on an analysis of the initiative ``For
   Lifelong Detention{''}, the ``Alps{''} initiative and the
   ``Rothenthurm{''} initiative, the content of the respective
   constitutional provisions is compared to its legislative implementation.
   The results highlight how difficult it is to predict the outcome of such
   processes, and that the resulting bills do not always correspond with
   the initial goals as fixed in the Constitution. Paradoxically, whereas
   the majority of the National Council is generally opposed to the popular
   initiatives, that same parliament is responsible for their legislative
   implementation.},
