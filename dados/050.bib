@article{ WOS:000243635400014,
Author = {Ezrow, Lawrence},
Title = {The variance matters: How party systems represent the preferences of
   voters},
Journal = {JOURNAL OF POLITICS},
Year = {2007},
Volume = {69},
Number = {1},
Pages = {182-192},
Month = {FEB},
Abstract = {Cross-national analyses are presented that suggest that changes in the
   variance of voters' policy preferences-in 12 Western European
   democracies from 1976 to 1998-are associated with corresponding changes
   in the variance of policy choices on offer in these party systems. This
   finding is labeled the Voter Distribution Effects Result. There is also
   evidence to support a second major finding, the Electoral Laws Result,
   which states that voter distribution effects, i.e., the effects
   associated with changes in the variance of voters' policy preferences,
   are stronger in political systems that feature less proportional
   electoral rules (e.g., plurality voting systems). These findings have
   implications for party strategies and for our general understanding of
   political representation.},
