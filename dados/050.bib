@article{ WOS:000246445400002,
Author = {Collignon, Stefan},
Title = {The three sources of legitimacy for European fiscal policy},
Journal = {INTERNATIONAL POLITICAL SCIENCE REVIEW},
Year = {2007},
Volume = {28},
Number = {2},
Pages = {155-184},
Month = {MAR},
Abstract = {Fiscal policy has remained under the authority of national governments
   in ``Enroland,{''} while monetary policy is unified in the hands of the
   European Central Bank. This arrangement does not produce optimal
   results. This article looks at the normative foundations of fiscal
   policy in the European Union, by mapping the allocative function,
   stabilization, and redistribution policies onto three models of
   legitimacy: the problem-solving European Union, the communitarian model,
   and the European Republic.},
