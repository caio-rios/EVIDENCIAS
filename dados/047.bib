@article{ WOS:000255156300003,
Author = {Bas, Muhammet Ali and Signorino, Curtis S. and Walker, Robert W.},
Title = {Statistical backwards induction: A simple method for estimating
   recursive strategic models},
Journal = {POLITICAL ANALYSIS},
Year = {2008},
Volume = {16},
Number = {1},
Pages = {21-40},
Month = {WIN},
Abstract = {We present a simple method for estimating regressions based on recursive
   extensive-form games. Our procedure, which can be implemented in most
   standard statistical packages, involves sequentially estimating standard
   logits (or probits) in a manner analogous to backwards induction. We
   demonstrate that the technique produces consistent parameter estimates
   and show how to calculate consistent standard errors. To illustrate the
   method, we replicate Leblang's (2003) study of speculative attacks by
   financial markets and government responses to these attacks.},
