Pages = {464-477},
Month = {FAL},
Abstract = {This article describes a new machine-coded event data set specifically
   designed to study the spatially, temporally, and tactically
   disaggregated actions of multiple state and nonstate actors in a
   systematic fashion. The project develops an extensive set of
   dictionaries for multiple actors and employs a new coding scheme to
   organize information on such actors and their behavior. The author
   describes the machine content-analysis methods used to collect the data
   and the newly developed coding scheme.},
