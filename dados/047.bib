@article{ WOS:000258906100005,
Author = {Doherty, David},
Title = {Presidential rhetoric, candidate evaluations, and party identification -
   Can parties ``own{''} values?},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2008},
Volume = {61},
Number = {3},
Pages = {419-433},
Month = {SEP},
Abstract = {By embedding value cues in their rhetoric, presidential candidates hope
   to present themselves and their parties as stewards of those values.
   This article examines the effects of this rhetoric by testing two
   hypotheses. The first hypothesis is that this rhetoric educates the
   public about the values of the candidates and their parties. The second
   suggests that this rhetoric primes existing perceptions of party
   ``ownership{''} of values. The author's findings suggest that candidates
   are successful at using value rhetoric to modify public perceptions of
   their values as individuals. However, this rhetoric does not affect
   perceptions of party labels and individual candidates identically.},
