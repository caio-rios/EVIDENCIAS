@article{ WOS:000261462900008,
Author = {Martinez, Michael D. and Wald, Kenneth D. and Craig, Stephen C.},
Title = {Homophobic Innumeracy?},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2008},
Volume = {72},
Number = {4},
Pages = {753-767},
Month = {WIN},
Note = {Annual Meeting of the American-Political-Science-Association,
   Philadelphia, PA, AUG 31-SEP 03, 2006},
Organization = {Amer Polit Sci Assoc},
Abstract = {Previous research has shown that mass perceptions about the sizes of
   minority populations are influenced by sociodemographic, threat, and
   context variables. This paper extends the analysis to a population group
   that has thus far received only limited attention, gays and lesbians.
   Our analysis of a statewide survey of Florida residents in 2002 shows
   that people in sociodemographic groups associated with low levels of
   political knowledge were more likely to report higher estimates of the
   gay population. Threat variables and objective context had relatively
   little impact, but estimates also were higher among individuals who
   reported personal contact with gays and lesbians.},
Publisher = {OXFORD UNIV PRESS},
