@article{ WOS:000259238800004,
Author = {Coppedge, Michael and Alvarez, Angel and Maldonado, Claudia},
Title = {Two persistent dimensions of democracy: Contestation and inclusiveness},
Journal = {JOURNAL OF POLITICS},
Year = {2008},
Volume = {70},
Number = {3},
Pages = {632-647},
Month = {JUL},
Abstract = {Because democracy is central to much comparative and international
   political research, it is crucial for political scientists to measure it
   validly. We challenge the common assumption that most existing
   indicators of democracy measure the same single dimension. We present I
   I different streams of evidence to show that about three-quarters of
   what Polity, Freedom House, and other indicators of democracy have been
   measuring consists of variation on the two dimensions of democracy that
   Robert Dahl proposed in Polyarchy-contestation and inclusiveness. These
   two dimensions were consistently fundamental to the most commonly used
   indicators of democracy from 1950 to 2000. Our analysis produces new
   indicators of contestations and inclusiveness for most countries from
   1950 to 2000.},
