@article{ WOS:000259613500001,
Author = {Debus, Marc},
Title = {Party competition and government formation in multilevel settings:
   Evidence from Germany},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2008},
Volume = {43},
Number = {4},
Pages = {505-538},
Month = {OCT},
Note = {1st European-Consortium-for-Political-Research Graduate Conference, Univ
   Essex, Colchester, ENGLAND, SEP 07-09, 2006},
Organization = {European Consortium Polit Res},
Abstract = {GOVERNING IN MULTILEVEL SETTINGS HAS BECOME A PROMINENT research field
   in comparative political science.(2) While one approach focuses on the
   impact of European integration on policy implementation in subnational
   areas,(3) another aspect in that research field concentrates on patterns
   of electoral and party politics in federally structured states.(4) In
   this article, I concentrate on the latter and ask whether political
   parties in the German federal states adopt similar programmatic
   positions and coalition formation strategies to those of their national
   counterparts. As quantitative studies on party competition on the
   subnational level in the United Kingdom and Belgium have revealed, there
   is empirical evidence that parties on the subnational level indeed adopt
   different programmatic positions as well as more diverse coalition
   strategies than the federal-level parties.(5) In the case of Germany, a
   number of studies use the programmatic positions of the federal parties
   to analyse patterns of legislative activity or coalition formation at
   the state level.(6) More qualitatively oriented studies show, by
   contrast, that long-standing political-cultural constraints have
   considerable influence on party competition at the regional level.(7) A
   second perspective focuses on coalition formation at the subnational
   level. Downs, for instance, argues that parties have been choosing the
   same coalition strategy in the states as they do on the national level
   since the consolidation of the German party system in the 1960s.(8) In
   doing so, the federal government or the federal opposition parties can
   strengthen their assertion potential in legislative policy-making by
   installing compliant coalition governments in the German federal
   states.(9).},
