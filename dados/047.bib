@article{ WOS:000259613500004,
Author = {Scherlis, Gerardo},
Title = {Machine politics and democracy: The deinstitutionalization of the
   Argentine party system},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2008},
Volume = {43},
Number = {4},
Pages = {579-598},
Month = {OCT},
Abstract = {THE LITERATURE ON POLITICAL ORGANIZATIONS SUGGESTS THAT THE incentives
   used to make a party work affect its degree of flexibility and
   adaptation capacity. Although political participation is rarely induced
   by a single motivator, it is commonly accepted that political
   organizations in which participation is primarily based on material
   incentives are more flexible than those in which activists are attracted
   by ideological incentives. Ideologically motivated activists introduce
   rigidity into the organizations by insisting on remaining committed to
   fixed policy goals. Conversely, a `depoliticized' rank and file,
   mobilized by the supply of material rewards, does not make its
   participation contingent on the party stance, and thus guarantees
   vote-seeking leaders considerable latitude to define and modify goals
   and strategies in a pragmatic way. This organizational flexibility is
   seen as a critical asset that makes it possible for the parties to adapt
   to changing conditions, modifying programmatic commitments and switching
   policy programmes when they see it fit to do so, without risking
   internal crises.(2).},
