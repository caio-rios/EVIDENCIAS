@article{ WOS:000258906100007,
Author = {Meinke, Scott R.},
Title = {Institutional change and the electoral connection in the Senate -
   Revisiting the effects of direct election},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2008},
Volume = {61},
Number = {3},
Pages = {445-457},
Month = {SEP},
Abstract = {The author argues that direct election intensified existing electoral
   incentives in the early-twentieth-century Senate, shifting the audience
   for senators' reelection efforts with measurable behavioral
   consequences. The author examines patterns of bill sponsorship,
   roll-call participation, and party voting in the decades surrounding the
   Seventeenth Amendment's ratification, a time when originally elected and
   originally selected senators served side by side. The author finds
   evidence of increased sponsorship and participation among originally
   elected senators. Comparing behavioral patterns before and after the
   constitutional amendment also reveals other important behavioral shifts
   toward a mass audience in the post-amendment period, including a
   tendency to increase constituency bill sponsorship immediately before
   reelection and a strengthening of the link between state partisanship
   and senators' party support voting.},
Publisher = {SAGE PUBLICATIONS INC},
