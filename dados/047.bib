@article{ WOS:000276724300003,
Author = {Rincker, Meg E. and Ortbals, Candice D.},
Title = {Leaders or Laggards: engendering sub-national governance through women's
   policy machineries in Spain and Poland},
Journal = {DEMOCRATIZATION},
Year = {2009},
Volume = {16},
Number = {2},
Pages = {269-297},
Abstract = {More than three decades of international best practice and a rich body
   of scholarship demonstrate that women's policy machinery ( WPM) is a
   crucial tool for promoting feminist policymaking. A new and unstudied
   form of WPM is emerging at the sub-national level. In this paper, we
   examine the effects of ( 1) regional leftist party governance and ( 2)
   sub-state durability on feminist policymaking. We employ Stetson and
   Mazur's model of effective, feminist WPM and operationalize policy
   Influence and Access provided to feminist groups. Drawing on four
   regional cases within Spain and Poland, we use field research,
   interviews, and party documents to examine whether regional leftist
   party governance and federalized state structure are associated with WPM
   `Leaders' in feminist policymaking. We find that regional leftist
   governance is associated with WPMs that offer feminist policy and
   empower feminist groups; however, sub-state durability modifies the
   impact of party governance. We conclude with suggestions for further
   research.},
