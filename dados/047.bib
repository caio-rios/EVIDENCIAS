Month = {WIN},
Note = {Annual Meeting of the American-Association-for-Public-Opinion-Research,
   Garden Grove, CA, MAY, 2007},
Organization = {Amer Assoc Public Opin Res},
Abstract = {Fifty years after the Korean War (1950-1953), sometimes called the
   Forgotten War, the Koreas had receded into the back of the American
   mind. But the Axis of Evil address and the revelation of North Korea's
   nuclear weapons program have reeducated Americans to see the South as an
   ally and the North as a menacing regime. Despite an overwhelming
   antipathy to North Korea and a heightened sense of vulnerability, few
   Americans support a course of action more aggressive than diplomatic
   negotiations.},
