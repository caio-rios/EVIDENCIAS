@article{ WOS:000261899800003,
Author = {Stauffer, Dana Jalbert},
Title = {Aristotle's Account of the Subjection of Women},
Journal = {JOURNAL OF POLITICS},
Year = {2008},
Volume = {70},
Number = {4},
Pages = {929-941},
Month = {OCT},
Abstract = {In recent years, several studies have argued that Aristotle saw the
   associations of the household as voluntary, mutually beneficial, and
   directed toward lofty aims. These studies have brought out genuine
   complexities in Aristotle's understanding of the relationship between
   the public and private spheres. But, in their characterization of
   Aristotle's view of the household, they miss the mark. While Aristotle
   discusses marriage and family in other places, he examines the
   hierarchical aspect of the relationship between men and women most fully
   in Politics I. Close examination of Politics I reveals that Aristotle
   thought that the subjection of women in the household was rooted in
   force.},
