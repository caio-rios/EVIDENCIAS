@article{ WOS:000257170300006,
Author = {de Vreese, Claes H. and Elenbaas, Matthijs},
Title = {Media in the game of politics: Effects of strategic metacoverage on
   political cynicism},
Journal = {INTERNATIONAL JOURNAL OF PRESS-POLITICS},
Year = {2008},
Volume = {13},
Number = {3},
Pages = {285-309},
Month = {JUL},
Abstract = {This study examines the effects of generic strategy news,
   self-referential press news, and ``spin{''} spotlighting publicity
   coverage on political cynicism, against the backdrop of governance and
   policy. Drawing on data from two experiments allowing for replication
   within a single study, the authors demonstrate that exposure to both
   generic and publicity strategy news aroused political cynicism relative
   to issue-based news. In addition, the authors found positive
   interactions between political knowledge and strategic press and
   publicity news exposure, showing that more knowledgeable individuals
   were more strongly affected by these frames. The findings are discussed
   in the light of extant knowledge about framing effects and the media's
   increasing use of metareporting.},
