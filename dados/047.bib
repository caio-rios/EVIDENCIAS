@article{ WOS:000260620900001,
Author = {Oliver, Rebecca},
Title = {Diverging Developments in Wage Inequality Which Institutions Matter?},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2008},
Volume = {41},
Number = {12},
Pages = {1551-1582},
Month = {DEC},
Abstract = {This article investigates how a particular wage-bargaining institution
   mitigates pressures from growing international competition and new
   production techniques and affects the degree of wage inequality growth.
   The extent to which industry-wide wage minima (wage scales) cover both
   higher and lower skilled workers affects developments in inequality. A
   series of cross-sectional time-series analyses are conducted using data
   from a recent unpublished data set from the Organisation for Economic
   Co-operation and Development (OECD), which covers 14 OECD countries from
   1980 to 2002. The results strongly indicate that the presence of
   industry-wide wage scales is a key factor in the evolution of wage
   inequality across OECD countries.},
