@article{ WOS:000259886000004,
Author = {VonDoepp, Peter},
Title = {Context-Sensitive Inquiry in Comparative Judicial Research Lessons From
   the Namibian Judiciary},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2008},
Volume = {41},
Number = {11},
Pages = {1515-1540},
Month = {NOV},
Note = {Annual Meeting of the African-Studies-Association, San Francisco, CA,
   NOV 16-19, 2006},
Organization = {African Studies Assoc},
Abstract = {Research on the behavior of the Namibian judiciary highlights the
   importance of context-sensitivity in comparative Courts research. D
   awing from strategic C understandings of judicial behavior, the analysis
   examines the extent to which political influences are affecting the
   behavior of judges in Namibia. The findings indicate that, for the most
   part, Namibia's judges have exercised high levels of independence in
   their decision making. Yet deference to other branches has been apparent
   among certain expatriate judges who have faced unique vulnerabilities in
   the Namibian political system. Context sensitivity proved critical to
   the study, as it enabled more effective operationalization of concepts
   and generation of variables to test existing theory. Beyond this, such
   awareness enhanced the ability to interpret the findings about judicial
   behavior in Namibia and generate new insights to inform inquiry.},
