@article{ WOS:000268280000002,
Author = {Sutton, David and Vournelis, Leonidas},
Title = {Vefa or Mamalakis: Cooking Up Nostalgia in Contemporary Greece},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2009},
Volume = {14},
Number = {2},
Pages = {147-166},
Abstract = {The relatively new, yet extremely popular, TV cooking shows in
   contemporary Greece provide a public forum for the negotiation of
   national identity, the articulation of nostalgia for an idealised past,
   and the expression of anxieties over an uncertain future. This article
   examines the different ways urban and rural viewing audiences
   participate in those debates through their relationship to old and new
   cooking practices. Rather than assuming the role of the passive viewer,
   a surprisingly large section of the population actively debates current
   socio-political concerns through these cooking shows, providing a
   stimulating setting for the expression of questions of authenticity,
   tradition, and change.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
Address = {4 PARK SQUARE, MILTON PARK, ABINGDON OX14 4RN, OXFORDSHIRE, ENGLAND},
