@article{ WOS:000276725100011,
Author = {Haynes, Jeffrey},
Title = {Conclusion: religion, democratization and secularization},
Journal = {DEMOCRATIZATION},
Year = {2009},
Volume = {16},
Number = {6, SI},
Pages = {1282-1291},
Abstract = {The overarching theme of this special issue was the attempts by various
   religious actors - Christian, Muslim, and Jewish - to try to assert
   their values and pursue their goals in variable political circumstances.
   We saw that they sought to do this in contexts characterized not only by
   secularization and political changes, some of which emanate from within
   countries, but also as a result of external pressures, often a
   consequence of globalization.},
