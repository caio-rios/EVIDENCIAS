@article{ WOS:000252396300005,
Author = {Bell, Daniel A.},
Title = {Being confucian: Why confucians needn't be old, serious and conservative},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2008},
Volume = {43},
Number = {1},
Pages = {111-129},
Month = {WIN},
Abstract = {It is difficult, arguably, for modern leftist thinkers to sympathize
   with Confucian values that seem best suited to old, boring and deadly
   serious defenders of conservative traditions. But this stereotypical
   image may be mistaken. Drawing on his own experience, the author argues
   that Confucians can and should have a sense of humour and engage in
   social and political criticism. He also questions the idea that
   Confucians need to be elderly gentlemen. The article ends with some
   reflections on Chineseness and Confucianism.},
