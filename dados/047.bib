@article{ WOS:000261238300005,
Author = {Mahoney, James and Kimball, Erin and Koivu, Kendra L.},
Title = {The Logic of Historical Explanation in the Social Sciences},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2009},
Volume = {42},
Number = {1},
Pages = {114-146},
Month = {JAN},
Abstract = {Historical explanations seek to identify the causes of outcomes in
   particular cases. Although social scientists commonly develop historical
   explanations, they lack criteria for distinguishing different types of
   causes and for evaluating the relative importance of alternative causes
   of the same outcome. This article first provides an inventory of the
   five types of causes that are normally used in historical explanations:
   (1) necessary but not sufficient, (2) sufficient but not necessary, (3)
   necessary and sufficient, (4) INUS, and (5) SUIN causes. It then
   introduces a new method-sequence elaboration-for evaluating the relative
   importance of causes. Sequence elaboration assesses the importance of
   causes through consideration of their position within a sequence and
   through consideration of the types of causes that make up the sequence
   as a whole. Throughout the article, methodological points are
   illustrated with substantive examples from the field of international
   and comparative studies.},
