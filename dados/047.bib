@article{ WOS:000261899800005,
Author = {Penn, Elizabeth Maggie},
Title = {Citizenship versus Ethnicity: The Role of Institutions in Shaping
   Identity Choice},
Journal = {JOURNAL OF POLITICS},
Year = {2008},
Volume = {70},
Number = {4},
Pages = {956-973},
Month = {OCT},
Abstract = {This paper examines the role that political institutions play in
   inducing or subduing ethnic identification. 1 provide a formal model of
   ethnic identification as a function of institutional design and social
   context that focuses on one question: what kinds of institutions twill
   induce individuals to identify with the state rather than along ethnic
   lines? Among other things, the model offers predictions about when
   political institutions are capable of inducing a national identity. I
   conclude with an application of the model to the question of
   institutional design in Iraq. The model provides one explanation for why
   a period of low Sunni representation in Iraqi government would increase
   sectarianism, and why a more proportional Iraqi parliament may not
   remedy the problem.},
