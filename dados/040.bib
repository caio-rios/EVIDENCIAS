@article{ WOS:000305904100002,
Author = {Selb, Peter},
Title = {Strategic adaptation to new electoral systems},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2012},
Volume = {51},
Number = {5},
Pages = {583-606},
Month = {AUG},
Abstract = {How quickly, to what extent and under what conditions do voters and
   elites adapt to new electoral institutions in order to not waste their
   votes and effort on hopeless competitors? A latent-curve model of
   strategic adaptation is developed and fitted to district-level election
   data from Spain. The extent of strategic adaptation is generally found
   to vary with the strength of the electoral system. However, grave ethnic
   tensions are demonstrated to seriously retard adaptation even under
   favourable institutional conditions.},
