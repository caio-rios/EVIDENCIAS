Research-Areas = {Mathematical Methods In Social Sciences; Government \& Law},
Web-of-Science-Categories  = {Social Sciences, Mathematical Methods; Political Science},
Author-Email = {justin@justinesarey.com
   awpierc@emory.edu},
Affiliations = {Rice University; Emory University},
