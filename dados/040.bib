@article{ WOS:000303448800006,
Author = {Fulton, Sarah A.},
Title = {Running Backwards and in High Heels: The Gendered Quality Gap and
   Incumbent Electoral Success},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2012},
Volume = {65},
Number = {2},
Pages = {303-314},
Month = {JUN},
Abstract = {The question of whether voter bias exists toward female politicians
   remains unsettled. Although anecdotal accounts of gender inequality
   abound, systematic research demonstrates that women ``do as well as
   men{''} when they run. Previous work suggests that these conflicting
   observations result from an omitted variables problem. Specifically, if
   women are higher quality than men, and if quality is omitted from models
   of vote-share, then voter bias may be concealed. Using a unique measure
   of incumbents' political quality, the author's research documents a
   sex-based quality gap and importantly, is the first to link the quality
   gap to the gender parity in electoral success.},
Publisher = {SAGE PUBLICATIONS INC},
