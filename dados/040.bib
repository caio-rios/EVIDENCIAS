@article{ WOS:000307111900010,
Author = {Matsubayashi, Tetsuya and Rocha, Rene R.},
Title = {Racial Diversity and Public Policy in the States},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2012},
Volume = {65},
Number = {3},
Pages = {600-614},
Month = {SEP},
Abstract = {How does racial diversity affect public policy outcomes in the states?
   The policy backlash hypothesis suggests that the presence of blacks
   increases antagonistic attitudes toward minorities among whites and thus
   produces racially conservative policies. The electoral constraint
   hypothesis argues that the presence of blacks increases the size of
   population that supports policy liberalism and thus results in more
   liberal policies. The authors reconcile these competing explanations by
   arguing that the hypothesized negative impact of minority group size on
   policy liberalism varies across states in accordance with socioeconomic
   and institutional conditions that strengthen or weaken the impacts of
   electoral constraint or backlash.},
