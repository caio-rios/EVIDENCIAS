   Moore, Ryan T., Washington Univ, Dept Polit Sci, St Louis, MO 63130 USA.},
DOI = {10.1093/pan/mps025},
ISSN = {1047-1987},
EISSN = {1476-4989},
Keywords-Plus = {COMMUNITY INTERVENTION TRIAL; RANDOMIZED EXPERIMENTS; CAUSAL INFERENCE;
   FIELD EXPERIMENT; PERRY PRESCHOOL; DESIGN; OBSERVERS; BEHAVIOR; BALANCE;
