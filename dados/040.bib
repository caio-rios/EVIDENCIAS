@article{ WOS:000301137900002,
Author = {Barrington, Lowell W.},
Title = {Fragile Snapshot or Stable Relationships? What the Orange and Rose
   Revolutions Reveal About the Stability of Cross-Sectional Survey Data},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2012},
Volume = {45},
Number = {3},
Pages = {312-340},
Month = {MAR},
Abstract = {One of the long-standing criticisms of cross-sectional survey data is
   that they provide only a contextually driven ``snapshot{''} of
   attitudes. These attitudes are, the ``snapshot critique{''} contends,
   highly fragile-subject to significant fluctuation based on events that
   arise domestically and globally. Although it makes sense that a major
   event can alter the percentage of people who respond to a given survey
   question in a particular way, it is less obvious that such an event
   jeopardizes the validity of multivariate analyses of survey data
   collected prior to the event. Given the prevalent use of cross-sectional
   survey data in quantitative political research, this question has
   significant implications for comparative politics. This study employs
   survey data from Ukraine before and after the ``Orange Revolution{''}
   and from Georgia before and after the ``Rose Revolution.{''} Its
   findings challenge the snapshot critique and support the idea that, even
   in the wake of a dramatic political event, the underlying relationships
   among variables measured by survey data can remain quite stable.},
Publisher = {SAGE PUBLICATIONS INC},
Address = {2455 TELLER RD, THOUSAND OAKS, CA 91320 USA},
Type = {Article},
Language = {English},
Affiliation = {Barrington, LW (Corresponding Author), Marquette Univ, Dept Polit Sci, 478 William Wehr Bldg, Milwaukee, WI 53201 USA.
