@article{ WOS:000305904100005,
Author = {Hanretty, Chris},
Title = {Dissent in Iberia: The ideal points of justices on the Spanish and
   Portuguese Constitutional Tribunals},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2012},
Volume = {51},
Number = {5},
Pages = {671-692},
Month = {AUG},
Abstract = {In this article, the non-unanimous decisions of the Portuguese and
   Spanish Constitutional Tribunals for the periods 19892009 and 20002009
   are analysed. It is shown that judicial dissent can be predicted
   moderately well on the basis of judicial ideal points along a single
   dimension. This dimension is equivalent to the leftright cleavage in
   both Portugal and Spain. The characteristics of the recovered dimension
   are demonstrated by analysing both the properties of the cases and the
   properties of the justices who decided them.},
