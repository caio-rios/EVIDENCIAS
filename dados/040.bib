@article{ WOS:000302360800002,
Author = {Fueglister, Katharina},
Title = {Where does learning take place? The role of intergovernmental
   cooperation in policy diffusion},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2012},
Volume = {51},
Number = {3},
Pages = {316-349},
Month = {MAY},
Abstract = {Although it is widely accepted that a decentralised system can enhance
   policy learning and the spread of best practices, an under-researched
   question is where that learning process takes place. Using data on the
   diffusion of health care policies in Switzerland, this article analyses
   the role of institutionalised intergovernmental cooperation and its
   impact on the spread of successful policies. The results show that joint
   membership of policy makers in health policy specific intergovernmental
   bodies is related to the diffusion of best practices.},
