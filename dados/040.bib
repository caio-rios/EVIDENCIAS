   Peytchev, Andy, RTI Int, Res Triangle Pk, NC 27709 USA.
   Peytchev, Andy, Univ N Carolina, Odum Inst, Chapel Hill, NC USA.},
DOI = {10.1093/poq/nfr065},
ISSN = {0033-362X},
