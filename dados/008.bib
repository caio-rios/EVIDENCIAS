@article{ WOS:001334034900001,
Author = {Buta, Oana and Farcas, Raluca},
Title = {Clientelism and digitalisation of Roma parties' electoral campaigns: a
   case study},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {1, SI},
Pages = {34-52},
Month = {MAR},
Abstract = {Contrary to recent developments within party politics, Roma political
   parties in Romania fail to incorporate digital technology into their
   activities, although they face a continuously decreasing level of
   support from their voters. To explain this phenomenon, this article
   argues that elections governed by non-programmatic strategies create not
   only different incentives towards digitalization, but also pose more
   challenges for certain ethnic parties, which also face internal
   shortcomings. It looks at the 2020 local elections in Romania and
   focuses on the two largest Roma political parties. The qualitative
   analysis, based on interviews with county Roma party leaders, confirms
   that the lack of digitalization is influenced by local clientelism,
   which affects the Roma electorate because of their socioeconomic
   situation. Besides, internal shortcomings further constrain such an
   option.
   Im Gegensatz zu den j \& uuml;ngsten Entwicklungen in der Parteipolitik
   integrieren Roma-Parteien in Rum \& auml;nien digitale Technologien
   nicht in ihre Aktivit \& auml;ten, obwohl sie von ihren W \& auml;hlern
   immer weniger Unterst \& uuml;tzung erhalten. Um dieses Ph \& auml;nomen
   zu erkl \& auml;ren, argumentiert dieser Artikel, dass Wahlen, die von
   nicht-programmatischen Strategien gesteuert werden, nicht nur andere
   Anreize zur Digitalisierung schaffen; sie stellen zudem bestimmte
   ethnische Parteien, die auch mit internen Defiziten konfrontiert sind,
   vor gr \& ouml;ss ere Herausforderungen. Der Artikel befasst sich mit
   den Kommunalwahlen 2020 in Rum \& auml;nien und konzentriert sich auf
   die beiden gr \& ouml;ss ten politischen Roma-Parteien. Die qualitative
   Analyse basiert auf Interviews mit Roma-Parteif \& uuml;hrern auf Ebene
   der Landkreise und best \& auml;tigt, dass der Mangel an Digitalisierung
   durch lokalen Klientelismus beeinflusst wird, der die Roma-W \&
   auml;hlerschaft aufgrund ihrer sozio \& ouml;konomischen Situation
   beeintr \& auml;chtigt. Dar \& uuml;ber hinaus schr \& auml;nken interne
   M \& auml;ngel eine solche Option zus \& auml;tzlich ein.
   Contrairement aux \& eacute;volutions r \& eacute;centes au sein des
   partis politiques, les partis politiques roms en Roumanie ne parviennent
   pas \& agrave; int \& eacute;grer la technologie num \& eacute;rique
   dans leurs activit \& eacute;s, bien qu'ils soient confront \& eacute;s
   \& agrave; un niveau de soutien en constante diminution de la part de
   leurs \& eacute;lecteurs. Pour expliquer ce ph \& eacute;nom \&
   egrave;ne, cet article soutient que les \& eacute;lections r \&
   eacute;gies par des strat \& eacute;gies non programmatiques cr \&
   eacute;ent non seulement des incitations diff \& eacute;rentes \&
   agrave; la num \& eacute;risation, mais posent \& eacute;galement
   davantage de d \& eacute;fis \& agrave; certains partis ethniques, ces
   derniers \& eacute;tant \& eacute;galement confront \& eacute;s \&
   agrave; des lacunes internes. L'article examine les \& eacute;lections
   locales de 2020 en Roumanie en se concentrant sur les deux plus grands
   partis politiques roms. L'analyse qualitative, bas \& eacute;e sur des
   entretiens avec les dirigeants de branches locales des partis roms,
   confirme que le manque de num \& eacute;risation est. influenc \&
   eacute; par le client \& eacute;lisme local, qui affecte l'\&
   eacute;lectorat rom en raison de sa situation socio-\& eacute;conomique.
   En outre, des lacunes internes limitent encore davantage une telle
   option.
   Contrariamente ai recenti sviluppi all'interno della politica dei
   partiti, i partiti politici rom in Romania non riescono a incorporare la
   tecnologia digitale nelle loro attivit \& agrave;, sebbene debbano far
   fronte a un livello di sostegno in continua diminuzione da parte dei
   loro elettori. Per spiegare tale fenomeno, questo articolo sostiene che
   le elezioni gestite con strategie non programmatiche creano non solo
   diversi incentivi verso la digitalizzazione, ma pongono anche maggiori
   sfide per alcuni partiti etnici, che inoltre devono affrontare certe
   carenze interne. Lo studio analizza le elezioni locali del 2020 in
   Romania e si concentra sui due maggiori partiti politici rom. L'analisi
   qualitativa, basata su interviste con i leader dei partiti rom locali,
   conferma che la mancanza di digitalizzazione \& egrave; influenzata dal
   clientelismo locale, che colpisce l'elettorato rom a causa della sua
   situazione socioeconomica. Inoltre, le carenze interne limitano
   ulteriormente l'uso di strumenti digitali.},
