@article{ WOS:001309734500001,
Author = {Gross, Martin and Nyhuis, Dominic and Block, Sebastian and Velimsky, Jan
   A.},
Title = {The Impact of Institutional and Financial Constraints on Party Behaviour
   in Local Politics},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {2},
Pages = {287-306},
Month = {JUN},
Abstract = {Political parties are not free to choose which issues to focus on in
   parliament. At the national level, it is mostly economic and societal
   problem pressures which impact parties' issue attention. In this paper,
   we argue that at lower levels of multilevel governance systems, parties
   are additionally limited by institutional and financial constraints
   beyond their decision-making competencies, which should impact their
   issue attention. Based on a novel dataset of local parties'
   parliamentary questions regarding 19 policy areas in 35 German local
   councils between 2011 and 2020, we demonstrate the constraining effect
   of institutional and economic conditions on party behaviour: parties are
   aware of the institutional constraints and devote more attention to
   issues where municipalities have more legal leeway, but this effect is
   moderated by the financial constraints that local communities face.
   Politische Parteien k \& ouml;nnen nicht komplett frei entscheiden,
   welche Themen sie im Parlament ansprechen m \& ouml;chten. Auf
   nationaler Ebene sind es haupts \& auml;chlich wirtschaftliche und
   gesellschaftliche Problemlagen, die die Themenaufmerksamkeit der
   Parteien beeinflussen. Mit Blick auf die politischen Ebenen unterhalb
   der nationalen Ebene argumentieren wir, dass Parteien in
   Mehrebenensystemen zus \& auml;tzlich durch institutionelle und
   finanzielle Beschr \& auml;nkungen, die \& uuml;ber ihre
   Entscheidungskompetenzen hinausgehen, eingeschr \& auml;nkt werden, was
   ihre Themenaufmerksamkeit beeinflussen sollte. Basierend auf einem
   neuartigen Datensatz zu parlamentarischen Anfragen lokaler Parteien in
   Bezug auf 19 Politikbereiche in 35 deutschen Gro ss st \& auml;dten
   zwischen 2011 und 2020 demonstrieren wir den einschr \& auml;nkenden
   Effekt von institutionellen und wirtschaftlichen Bedingungen auf das
   Verhalten der Parteien: Parteien sind sich der institutionellen Einschr
   \& auml;nkungen bewusst und widmen denjenigen Themen mehr
   Aufmerksamkeit, bei denen die Kommunen rechtlich \& uuml;ber einen gr \&
   ouml;ss eren Spielraum verf \& uuml;gen. Dieser Effekt wird jedoch durch
   die finanziellen Einschr \& auml;nkungen, denen sich Kommunen gegen \&
   uuml;bersehen, moderiert.
   Les partis politiques ne sont pas libres de choisir les sujets sur
   lesquels se concentrer au parlement. Au niveau national, ce sont
   principalement les pressions \& eacute;conomiques et sociales qui
   influencent le choix des sujets vers lesquels les partis tournent leur
   attention. Dans cet article, nous soutenons qu'\& agrave; des niveaux
   inf \& eacute;rieurs des syst \& egrave;mes de gouvernance multiniveaux,
   les partis sont en outre limit \& eacute;s par des contraintes
   institutionnelles et financi \& egrave;res d \& eacute;passant leurs
   comp \& eacute;tences d \& eacute;cisionnelles, ce qui devrait affecter
   leur attention aux enjeux. Sur la base d'un nouveau jeu de donn \&
   eacute;es concernant les questions parlementaires des partis locaux dans
   19 domaines politiques dans 35 conseils municipaux allemands entre 2011
   et 2020, nous d \& eacute;montrons l'effet contraignant des conditions
   institutionnelles et \& eacute;conomiques sur le comportement des
   partis: les partis sont conscients des contraintes institutionnelles et
   accordent plus d'attention aux sujets o \& ugrave; les municipalit \&
   eacute;s ont plus de marge de man oe uvre juridique, mais cet effet est
   mod \& eacute;r \& eacute; par les contraintes financi \& egrave;res
   auxquelles les communaut \& eacute;s locales sont confront \& eacute;es.
   I partiti politici non sono liberi di scegliere su quali questioni
   concentrarsi in parlamento. A livello nazionale, sono principalmente le
   pressioni economiche e sociali a influenzare l'attenzione dei partiti
   sui temi. In questo articolo, sosteniamo che, a livelli inferiori dei
   sistemi di governance multilivello, i partiti siano ulteriormente
   limitati da vincoli istituzionali e finanziari che vanno oltre le loro
   competenze decisionali, il che dovrebbe influire sulla loro attenzione
   ai temi. Basandoci su un nuovo set di dati riguardanti le interrogazioni
   parlamentari dei partiti locali su 19 aree politiche in 35 consigli
   comunali tedeschi tra il 2011 e il 2020, dimostriamo l'effetto
   vincolante delle condizioni istituzionali ed economiche sul
   comportamento dei partiti: i partiti sono consapevoli dei vincoli
   istituzionali e dedicano pi \& ugrave; attenzione alle questioni in cui
   i comuni hanno maggiore margine di manovra legale, ma questo effetto \&
   egrave; moderato dai vincoli finanziari che le comunit \& agrave; locali
   devono affrontare.},
