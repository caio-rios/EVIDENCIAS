@article{ WOS:001285392600001,
Author = {Dovi, Suzanne},
Title = {On Political Misogyny},
Journal = {AMERICAN POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {119},
Number = {2},
Pages = {1054-1067},
Month = {MAY},
Abstract = {Many political scientists hold that vitriolic speech against
   high-profile women has only negligible effects on other women in
   politics. They also contend that the prevalence of such vitriol is
   consistent with gender bias having no significant negative impact on
   most women in politics. This article argues that these sanguine
   positions rest on inadequate and untested assumptions regarding
   misogyny, and the role it plays in politics. In the service of putting
   us in a position to test the relationship between gendered discourse in
   particular elections and the structural obstacles faced by women in
   politics, this article develops a conceptualization of political
   misogyny: nasty claim-making that instills repugnant connotations into
   women's collective political identities (e.g., their partisan
   identities). Attention is also paid to how political misogyny can
   distribute hatred burdens disproportionately among different groups of
   women.},
Publisher = {CAMBRIDGE UNIV PRESS},
