@article{ WOS:001312911400001,
Author = {Lutolf, Meret},
Title = {Caring breadwinners? A comparative analysis of parental leave policies
   to promote fathers' care work},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2024},
Volume = {30},
Number = {4},
Pages = {385-406},
Month = {DEC},
Abstract = {The question which policy measures facilitate greater paternal
   participation in childcare and promote the universal caregiver model (as
   opposed to the universal breadwinner model) remains a prominent topic of
   debate. Determining the extent to which states implement such policies
   is equally crucial. This paper analyzes which policies differentiate
   these two family models and foster the paternal shift from breadwinning
   to caregiving. To this end, an analytical grid is developed to identify
   a parental leave policy that is genuinely egalitarian in design. Two
   newly created indices within this grid distinguish between the
   egalitarian policy potential and a traditional uptake of leave. The
   analysis grid is then empirically tested on twenty countries. This
   qualitative, case-specific assessment approach identifies examples of
   egalitarianism-enhancing policies. However, as the differences between
   the two indices suggest, the flexibility in leave take-up between
   parents leaves the potential of these policies largely untapped.
   Die Frage, welche politischen Massnahmen eine st \& auml;rkere
   Beteiligung von V \& auml;tern an der Kinderbetreuung und damit das
   universelle Betreuungsmodell (im Gegensatz zum universellen Ern \&
   auml;hrermodell) beg \& uuml;nstigen, bleibt ein wichtiges
   Diskussionsthema. Dar \& uuml;ber hinaus ist es von entscheidender
   Bedeutung zu ermitteln, inwieweit Staaten diese Massnahmen umsetzen. In
   diesem Beitrag soll untersucht werden, welche politischen Massnahmen den
   Wechsel des Vaters vom Ern \& auml;hrer zum Betreuer unterst \&
   uuml;tzen. Zu diesem Zweck wird ein Analyseraster entwickelt, um eine
   wirklich egalit \& auml;r gestaltete Elternzeit-Policy zu
   identifizieren. Zwei neu geschaffene Indizes innerhalb dieses Rasters
   unterscheiden zwischen dem egalit \& auml;ren Policypotenzial und einer
   traditionellen Inanspruchnahme der Elternzeit. Das Analyseraster wird
   anschliessend an zwanzig L \& auml;ndern empirisch getestet. Mit diesem
   qualitativen, fallspezifischen Bewertungsansatz werden Beispiele f \&
   uuml;r egalit \& auml;tsf \& ouml;rdernde Politiken identifiziert. Wie
   die Unterschiede zwischen den beiden Indizes zeigen, l \& auml;sst die
   Flexibilit \& auml;t bei der Inanspruchnahme von Elternzeit das
   Potenzial dieser Massnahmen jedoch weitgehend ungenutzt.
   Cet article analyse les politiques visant \& agrave; accro \& icirc;tre
   la participation des p \& egrave;res \& agrave; la garde des enfants,
   favorisant ainsi le mod \& egrave;le de l'aidant plut \& ocirc;t que
   celui du soutien de famille. L'\& eacute;tude \& eacute;value
   l'application de ces politiques par les \& Eacute;tats, en d \&
   eacute;veloppant une grille d'analyse pour identifier les politiques de
   cong \& eacute; parental v \& eacute;ritablement \& eacute;galitaires.
   Deux indices distincts sont introduits dans cette grille pour diff \&
   eacute;rencier le potentiel \& eacute;galitaire d'une politique d'un c
   \& ocirc;t \& eacute; d'un usage traditionnel du cong \& eacute;
   parental de l'autre c \& ocirc;t \& eacute;. Cette grille d'analyse est
   ensuite appliqu \& eacute;e \& agrave; vingt pays, permettant
   d'identifier des exemples de politiques favorisant l'\& eacute;galit \&
   eacute; entre les parents. Cependant, les r \& eacute;sultats montrent
   que, malgr \& eacute; l'existence de politiques \& eacute;galitaires, la
   flexibilit \& eacute; dans la r \& eacute;partition du cong \& eacute;
   entre les parents laisse le potentiel de ces politiques largement
   inexploit \& eacute;, sugg \& eacute;rant des limites dans leur mise en
   oe uvre.
   La questione di quali misure politiche facilitino una maggiore
   partecipazione dei padri alla cura dei figli e promuovano il modello
   universale di ``caregiver{''} (in contrapposizione al modello universale
   di ``breadwinner{''}) rimane un tema importante. Altrettanto cruciale \&
   egrave; capire in quale misura gli Stati attuano tali politiche. Questo
   studio analizza le politiche che differenziano questi due modelli
   familiari e favoriscono il passaggio dall'uno all'altro. A tal fine,
   viene sviluppata una griglia analitica per identificare una politica di
   congedo parentale che sia realmente egualitaria. Due nuovi indici
   all'interno di questa griglia distinguono tra il potenziale della
   politica egualitaria e il tradizionale utilizzo del congedo. La griglia
   di analisi \& egrave; testata empiricamente su venti Paesi. Questo
   approccio di valutazione qualitativo e specifico per ogni caso
   identifica esempi di politiche che favoriscono l'egualitarismo.
   Tuttavia, come suggeriscono le differenze tra i due indici, la
   flessibilit \& agrave; nella fruizione dei congedi da parte dei genitori
   lascia il potenziale di queste politiche in gran parte inutilizzato.},
