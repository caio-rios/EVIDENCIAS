@article{ WOS:001309794300001,
Author = {Levis, Alessio and Smith, E. Keith},
Title = {Trust in Implementing Institutions, Ecological Behavior and
   Decentralized Environmental Governance: The Case of Switzerland},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2024},
Volume = {30},
Number = {4},
Pages = {357-384},
Month = {DEC},
Abstract = {Trust in political institutions has been found to shape individual
   ecological behaviors and attitudes. In this paper, we investigate trust
   in implementing government institutions (e.g., public administration).
   Heightened trust in implementing institutions is theorized to support
   overcoming environmental social dilemmas, enabling concerned individuals
   to engage in ecological behaviors. Further, as environmental policies
   are implemented across levels of government, decomposing trust
   perceptions in local, regional, and national agencies is crucial.
   Utilizing survey data from Switzerland, we find that trust in
   implementing institutions increases ecological behaviors and
   pro-environmental attitudes. Further, trusting implementing institutions
   can help overcome barriers to action, particularly amongst individuals
   with lower levels of concern. Lastly, we find that the role of trust can
   differ by level of government and ecological behaviors and attitudes.
   These findings support research on the moderating role of trust in the
   concern-behavior gap, exploring new conceptualizations across levels of
   government and measures of policy support.
   Die Forschung hat gezeigt, dass Vertrauen in politische Institutionen \&
   ouml;kologische Verhaltensweisen und Einstellungen beeinflusst. Diese
   Studie untersucht das Vertrauen in ausf \& uuml;hrende
   Regierungsinstitutionen (z.B. \& ouml;ffentliche Verwaltung). Wir
   argumentieren, dass Vertrauen in diese Institutionen die \&
   Uuml;berwindung sozialer Umweltdilemmata unterst \& uuml;tzt und es
   Personen mit Umweltbedenken erm \& ouml;glicht, sich \& ouml;kologisch
   zu verhalten. Da umweltpolitische Massnahmen auf verschiedenen
   Regierungsebenen umgesetzt werden, schl \& uuml;sseln wir die
   Vertrauenswahrnehmung in lokale, regionale und nationale Beh \&
   ouml;rden auf. Anhand von Schweizer Umfragedaten zeigen wir, dass das
   Vertrauen in ausf \& uuml;hrende Institutionen \& ouml;kologisches
   Verhalten und umweltfreundliche Einstellungen f \& ouml;rdert. Dar \&
   uuml;ber tr \& auml;gt es dazu bei, Handlungsbarrieren zu \&
   uuml;berwinden, insbesondere bei Personen mit wenig Umweltbedenken. Wir
   stellen fest, dass die Rolle des Vertrauens je nach Regierungsebene und
   \& ouml;kologischen Verhaltensweisen und Einstellungen variiert. Diese
   Ergebnisse tragen zur Forschung \& uuml;ber die Rolle von Vertrauen als
   Moderator zwischen Umweltbedenken und Verhalten bei, indem neue
   Konzeptualisierungen f \& uuml;r verschiedene Regierungsebenen und
   verschiedene Messungen der Unterst \& uuml;tzung politischer Massnahmen
   erforscht werden.
   La confiance dans les institutions politiques a \& eacute;t \& eacute;
   identifi \& eacute;e comme influen \& ccedil;ant les comportements et
   les attitudes \& eacute;cologiques. Nous \& eacute;tudions la confiance
   dans les institutions gouvernementales charg \& eacute;es de la mise en
   oe uvre des politiques (par exemple, l'administration publique). Nous
   montrons que la confiance envers les institutions gouvernementales
   locales, r \& eacute;gionales et nationales aide les individus \&
   agrave; surmonter les dilemmes sociaux environnementaux et \& agrave;
   adopter des comportements \& eacute;cologiques. Utilisant des donn \&
   eacute;es d'une enqu \& ecirc;te en Suisse, nous constatons que cette
   confiance encourage les comportements \& eacute;cologiques et les
   attitudes pro-environnementales, particuli \& egrave;rement chez les
   personnes moins pr \& eacute;occup \& eacute;es par l'environnement. Le
   r \& ocirc;le de la confiance varie selon l'agence gouvernementale et
   les comportements \& eacute;cologiques concern \& eacute;s, et confirme
   l'importance de la confiance pour r \& eacute;duire l'\& eacute;cart
   entre pr \& eacute;occupations et comportements. Nous soulignons le r \&
   ocirc;le mod \& eacute;rateur de la confiance dans les institutions pour
   promouvoir des comportements \& eacute;cologiques, soulignant la n \&
   eacute;cessit \& eacute; de consid \& eacute;rer le soutien politique et
   la confiance envers diverses institutions gouvernementales dans la mise
   en oe uvre des politiques environnementales.
   \& Egrave; stato dimostrato che la fiducia nelle istituzioni politiche
   influenza i comportamenti e gli atteggiamenti ecologici degli individui.
