@article{ WOS:001315676300001,
Author = {Steinecke, David and Heermann, Max},
Title = {West Lothians in the European Parliament? Diverging Vote Choices in
   Cases of Differentiated Integration},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2024},
Volume = {30},
Number = {4},
Pages = {472-485},
Month = {DEC},
Abstract = {Territorial differentiation entails challenges for legitimate
   representation as legislators may be empowered to vote on legislation
   that does not affect their constituencies. A typical example of this
   democratic dilemma is the ``West Lothian question{''} in the United
   Kingdom, where all members of the House of Commons can vote on bills
   that only affect England. The European Union faces a similar dilemma
   when members of the European Parliament vote on bills from which their
   member states are exempted. We analyse EU legislators' voting behaviour
   on differentiated policies to provide the missing empirical evidence for
   an informed debate about the institutional design of legislative rules
   under differentiation. We show that legislators abstain more frequently
   than their party group colleagues when their constituency is not subject
   to a bill due to sovereignty concerns. This practice of abstention
   resembles an existing norm in the United Kingdom and mitigates the
   democratic dilemma associated with differentiation.
   Die territoriale Differenzierung politischer Systeme stellt die legitime
   Repr \& auml;sentation der B \& uuml;rger{*}innen vor Herausforderungen,
   da Abgeordnete dazu befugt sein k \& ouml;nnen, \& uuml;ber Gesetze
   abzustimmen, die ihre Wahlkreise nicht betreffen. Ein typisches Beispiel
   f \& uuml;r dieses demokratische Dilemma ist die ,,West Lothian Question
   ``im Vereinigten K \& ouml;nigreich, wo alle Mitglieder des Unterhauses
   \& uuml;ber Gesetzesvorlagen abstimmen k \& ouml;nnen, die nur England
   betreffen. Die Europ \& auml;ische Union steht vor einem \&
   auml;hnlichen Dilemma, wenn Mitglieder des Europ \& auml;ischen
   Parlaments \& uuml;ber Gesetzesvorlagen abstimmen, von denen ihre
   Mitgliedstaaten ausgenommen sind. Wir analysieren das
   Abstimmungsverhalten der EU-Abgeordneten zu differenzierten Rechtsakten
   und tragen mit neuen empirischen Belegen zur Debatte \& uuml;ber die
   institutionelle Ausgestaltung von Gesetzgebungsregeln im Fall
   territorialer Differenzierung bei. Wir zeigen, dass sich Abgeordnete h
   \& auml;ufiger der Stimme enthalten als ihre Parteikollegen wenn ihr
   Wahlkreis aufgrund von Souver \& auml;nit \& auml;tsbedenken nicht von
   einem Gesetzentwurf betroffen ist. Diese Praxis der Enthaltung \&
   auml;hnelt einer bestehenden Norm im Vereinigten K \& ouml;nigreich und
   mildert das mit der Differenzierung verbundene demokratische Dilemma.
   La diff \& eacute;renciation territoriale pose des probl \& egrave;mes
   de repr \& eacute;sentation d \& eacute;mocratique, car les l \&
   eacute;gislateurs peuvent voter des lois qui ne concernent pas leur
   circonscription. Un exemple de ce dilemme est. la ``West Lothian
   question{''} au Royaume-Uni, o \& ugrave; tous les membres de la Chambre
   des Communes peuvent voter sur des projets de loi concernant uniquement
   l'Angleterre. L'Union europ \& eacute;enne fait face \& agrave; un
   dilemme similaire lorsque les eurod \& eacute;put \& eacute;s votent sur
   des projets de loi dont leurs \& Eacute;tats membres sont exempt \&
   eacute;s. Nous analysons le comportement de vote des l \&
   eacute;gislateurs de l'UE sur les politiques diff \& eacute;renci \&
   eacute;es pour fournir les preuves empiriques au d \& eacute;bat sur les
   r \& egrave;gles l \& eacute;gislatives en cas de diff \&
   eacute;renciation. Nous montrons que les l \& eacute;gislateurs
   s'abstiennent plus fr \& eacute;quemment que leurs coll \& egrave;gues
   du groupe parlementaire lorsque leur circonscription n'est. pas concern
   \& eacute;e par une loi pour des raisons de souverainet \& eacute;.
   Cette abstention ressemble \& agrave; une norme existant au Royaume-Uni
   et att \& eacute;nue le dilemme d \& eacute;mocratique associ \& eacute;
   \& agrave; la diff \& eacute;renciation.
   La differenziazione territoriale pone sfide alla democrazia
   rappresentativa, poich \& eacute; i legislatori possono votare leggi non
   riguardanti le rispettive circoscrizioni. Un esempio tipico di questo
   dilemma democratico \& egrave; la ``West Lothian question{''} nel Regno
   Unito, in cui tutti i membri della Camera dei Comuni possono votare
   leggi che riguardano solo l'Inghilterra. L'Unione Europea si trova ad
   affrontare un dilemma simile quando gli europarlamentari votano su
   progetti di legge da cui i rispettive Stati membri sono esentati.
   Analizziamo il comportamento di voto dei legislatori dell'UE sulle
   politiche differenziate per fornire la prova empirica mancante circa al
   dibattito sulle regole legislative in regime di differenziazione.
   Dimostriamo che, per preoccupazioni legate alla sovranit \& agrave;, i
   legislatori si astengono pi \& ugrave; frequentemente dei loro colleghi
   di gruppo parlamentare quando la loro circoscrizione non \& egrave;
   soggetta a un progetto di legge. Tale astensionismo assomiglia a una
   norma esistente nel Regno Unito e attenua il dilemma democratico
   associato alla differenziazione.},
