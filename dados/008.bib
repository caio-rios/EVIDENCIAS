@article{ WOS:001321060000001,
Author = {Poljak, Zeljko},
Title = {From Speech to Feed: How Parliamentary Debates Shape Party Agendas on
   Social Media},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {1, SI},
Pages = {102-121},
Month = {MAR},
Abstract = {Social media has become an increasingly important tool for parties to
   set issues on the political agenda. However, its rapid rise raises
   questions about the role of traditional venues such as parliaments. This
   study hypothesizes that parties strategically choose to initiate issues
   in parliamentary debates instead of on social media to establish
   dominance through real-time discussions. Consequently, only after these
   issues are introduced and debated in parliament do parties use digital
   platforms like social media to reinforce them on the political agenda.
   Analyzing over 430,000 parliamentary speeches and 240,000 Facebook posts
   by parties in Australia, Belgium, Canada, Croatia, and the UK, from 2010
   to 2022, the study reveals that issues discussed in parliamentary
   debates-primarily those raised by opposition parties-typically do not
   initially emerge on social media but only attract online attention after
   being introduced in parliament. These findings offer new insights into
   the strategic decisions of parties in agenda-setting.
   Soziale Medien sind f \& uuml;r Parteien zunehmend wichtig geworden, um
   Themen auf die politische Agenda zu setzen. Ihr schneller Aufstieg wirft
   jedoch Fragen \& uuml;ber die Rolle traditioneller Kan \& auml;le wie
   z.B. Parlamente auf. Diese Studie geht davon aus, dass Parteien
   strategisch vorgehen, indem sie Themen in parlamentarischen Debatten
   anstatt in sozialen Medien einf \& uuml;hren, um durch die Diskussionen
   in Echtzeit Dominanz zu etablieren. Erst wenn ein Thema im Parlament
   eingef \& uuml;hrt und debattiert wurde, nutzen Parteien digitale
   Plattformen um das Thema auf der politischen Agenda zu verst \&
   auml;rken. Die Analyse von \& uuml;ber 430.000 parlamentarischen Reden
   und 240.000 Facebook-Beitr \& auml;gen aus den Jahren 2010 bis 2022 von
   Parteien in Australien, Belgien, Kanada, Kroatien und dem Vereinigten K
   \& ouml;nigreich zeigt, dass Themen, die in parlamentarischen Debatten
   (haupts \& auml;chlich von Oppositionsparteien) besprochen werden, zun
   \& auml;chst nicht in sozialen Medien auftauchen, sondern erst nach der
   Einf \& uuml;hrung im Parlament auch online Aufmerksamkeit erregen.
   Diese Ergebnisse bieten neue Einblicke in die strategischen
   Entscheidungen von Parteien bei der Agenda-Setzung.
   Les m \& eacute;dias sociaux sont devenus un outil important pour les
   partis pour mettre des enjeux \& agrave; l'ordre du jour politique. Leur
   mont \& eacute;e rapide soul \& egrave;ve des questions sur le r \&
   ocirc;le des sites traditionnels, tels que les parlements. Cette \&
   eacute;tude suppose que les partis choisissent strat \& eacute;giquement
   d'introduire les sujets dans les d \& eacute;bats parlementaires plut \&
   ocirc;t que sur les m \& eacute;dias sociaux pour \& eacute;tablir une
   domination \& agrave; travers des discussions en temps r \& eacute;el.
   En cons \& eacute;quence, les partis utilisent les plateformes num \&
   eacute;riques uniquement apr \& egrave;s que ces sujets ont \& eacute;t
   \& eacute; introduits et d \& eacute;battus au parlement pour les
   renforcer sur l'agenda politique. En analysant plus de 430 000 discours
   parlementaires et 240 000 publications Facebook de partis en Australie,
   en Belgique, au Canada, en Croatie et au Royaume-Uni de 2010 \& agrave;
   2022, l'\& eacute;tude r \& eacute;v \& egrave;le que les sujets d \&
   eacute;battus au parlement - principalement ceux des partis d'opposition
   - g \& eacute;n \& eacute;ralement attirent une attention en ligne
   seulement apr \& egrave;s leur introduction au parlement. Ces r \&
   eacute;sultats offrent de nouvelles perspectives sur les d \&
   eacute;cisions strat \& eacute;giques des partis en mati \& egrave;re de
   d \& eacute;finition de l'agenda.
   I social media sono diventati uno strumento sempre pi \& ugrave;
   importante per i partiti al fine di inserire temi nell'agenda politica.
   Tuttavia, il loro rapido sviluppo solleva interrogativi sul ruolo dei
   luoghi tradizionali come i parlamenti. Questo studio ipotizza che i
   partiti scelgano strategicamente di avviare i temi nei dibattiti
   parlamentari anzich \& eacute; sui social media per ottenere una
   posizione dominante attraverso discussioni in tempo reale. Di
   conseguenza, i partiti utilizzano le piattaforme digitali come i social
   media solo dopo che questi temi sono stati avviati e dibattuti in
   parlamento, per rafforzarli nell'agenda politica. Analizzando oltre
   430.000 discorsi parlamentari e 240.000 post su Facebook dei partiti dal
   2010 al 2022 in Australia, Belgio, Canada, Croazia e Regno Unito,
   l'indagine rivela che i temi discussi nei dibattiti parlamentari -
   principalmente quelli dei partiti di opposizione - solitamente non
   emergono inizialmente sui social media, ma attirano attenzione online
   solo dopo essere stati avviati in parlamento. Questi risultati offrono
   nuovi spunti di riflessione sulle decisioni strategiche dei partiti
   nella definizione dell'agenda.},
