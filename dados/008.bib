@article{ WOS:001357439400001,
Author = {Tromborg, Mathias and Larsen, Martin Vinaes},
Title = {Exploring the connection between electoral systems and personalized
   behaviour among politicians and voters},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2025},
Volume = {64},
Number = {3},
Pages = {1480-1491},
Month = {AUG},
Abstract = {The personalization of politics includes electoral reforms that give
   voters more opportunity to select individual representatives as well as
   behavioural personalization among voters and politicians. Institutional
   research suggests that the latter is a function of the former, but it
   remains unclear whether the association between the two types of
   personalization is actually causal. In order to get empirical leverage
   on this question, we analyze local elections in Denmark, which feature
   within-district and within-party variation in the openness of party
   lists. Using detailed information on the behaviour of politicians and
   voters, we find that, once we take differences between districts and
   parties into account, the personalization of electoral rules has a
   negligible effect on behavioural personalization.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
