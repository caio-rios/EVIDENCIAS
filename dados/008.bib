@article{ WOS:001341338300001,
Author = {Wuest, Reto and Helfer, Luzia and Varone, Frederic},
Title = {Shared Class, Shared Opinion? Policy Preference Congruence Between
   Citizens and Legislators},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2024},
Volume = {30},
Number = {4},
Pages = {428-445},
Month = {DEC},
Abstract = {Recent studies have shown that policymakers and policy outcomes in
   advanced democracies are biased against the preferences of less affluent
   and working-class citizens. One reason for this inequality in
   substantive representation might be that most policymakers are well-off
   themselves. In this paper, we explore the effect of shared class
   background on the congruence between legislators' and citizens' policy
   preferences. To do so, we rely on original data from surveys conducted
   among citizens and active legislators in Switzerland. We focus on six
   economic and welfare policy proposals where we find differences in
   opinion between social classes. When we match legislators' and citizens'
   opinion in a one-to-many relationship, we find that social class matters
   more for lower social classes than for the more affluent, at least for
   some policy proposals.
   J \& uuml;ngste Studien haben gezeigt, dass die politischen
   Entscheidungstr \& auml;gerInnen und die Ergebnisse \& ouml;ffentlicher
   Politiken in fortgeschrittenen Demokratien die Pr \& auml;ferenzen der
   weniger wohlhabenden und arbeitenden B \& uuml;rgerInnen weniger bzw.
   nicht ber \& uuml;cksichtigen. Ein Grund f \& uuml;r diese Ungleichheit
   in der inhaltlichen politischen Vertretung k \& ouml;nnte darin liegen,
   dass die meisten PolitikerInnen selbst sehr wohlhabend sind. Unsere
   Studie untersucht die Auswirkungen des gemeinsamen Klassenhintergrunds
   auf die \& Uuml;bereinstimmung zwischen den politischen Pr \&
   auml;ferenzen der PolitikerInnen und der B \& uuml;rgerInnen. Dabei st
   \& uuml;tzen wir uns auf Originaldaten aus Umfragen, die unter B \&
   uuml;rgerInnen und aktiven ParlamentarierInnen in der Schweiz durchgef
   \& uuml;hrt wurden. Wir konzentrieren uns auf sechs wirtschafts- und
   sozialpolitische Vorschl \& auml;ge, bei denen wir Meinungsunterschiede
   zwischen den sozialen Schichten feststellen. Wenn wir die Meinungen von
   PolitikerInnen und B \& uuml;rgerInnen in einer Eins-zu-Viel-Beziehung
   abgleichen, stellen wir fest, dass die soziale Schicht f \& uuml;r
   untere soziale Schichten eine gr \& ouml;ss ere Rolle spielt als f \&
   uuml;r wohlhabendere, zumindest bei einigen politischen Vorschl \&
   auml;gen.
   Dans les d \& eacute;mocraties avanc \& eacute;es, les d \&
   eacute;cideurs et les politiques publiques repr \& eacute;sentent de
   mani \& egrave;re biais \& eacute;e les pr \& eacute;f \& eacute;rences
   des citoyens moins ais \& eacute;s de la classe ouvri \& egrave;re. Une
   raison de cette in \& eacute;galit \& eacute; dans la repr \&
   eacute;sentation substantielle serait que la plupart des \& eacute;lus
   politiques sont eux-m \& ecirc;mes bien lotis. Notre \& eacute;tude
   analyse si l'appartenance \& agrave; la m \& ecirc;me classe sociale
   influence la congruence entre les pr \& eacute;f \& eacute;rences
   politiques des parlementaires et celles des citoyens. Nous utilisons des
   donn \& eacute;es originales provenant d'enqu \& ecirc;tes men \&
   eacute;es aupr \& egrave;s de citoyens et de parlementaires actifs en
   Suisse. Nous nous concentrons sur six politiques \& eacute;conomiques et
   sociales pour lesquelles nous constatons des diff \& eacute;rences
   d'opinion entre les classes sociales. En faisant correspondre les
   opinions des parlementaires et des citoyens dans une relation de type <<
   un pour plusieurs >>, nous constatons que la classe sociale a plus
   d'influence sur la congruence pour les classes sociales inf \&
   eacute;rieures que pour les classes plus ais \& eacute;es.
   Studi recenti hanno dimostrato che i politici e i risultati delle
   politiche pubbliche nelle democrazie avanzate hanno un bias contrario
   alle preferenze dei cittadini meno abbienti e della classe operaia. Una
   delle ragioni di questa disuguaglianza nella rappresentanza sostanziale
   potrebbe essere che la maggior parte dei politici sono essi stessi
   benestanti. In questo articolo esploriamo l'effetto della condivisione
   del background di classe sulla congruenza tra le preferenze politiche
   dei legislatori e dei cittadini. Per farlo, ci basiamo su dati originali
   provenienti da sondaggi condotti tra cittadini e legislatori attivi in
   Svizzera. Ci concentriamo su sei proposte di politica economica e di
   welfare per le quali riscontriamo differenze di opinione tra le classi
   sociali. Quando abbiniamo le opinioni dei legislatori e dei cittadini in
   una relazione uno-a-molti, scopriamo che la classe sociale conta di pi
   \& ugrave; per le classi sociali pi \& ugrave; basse che per quelle pi
   \& ugrave; agiate, almeno per alcune proposte politiche.},
