@article{ WOS:000466816500005,
Author = {Sozen, Ahmet and Sonan, Sertac},
Title = {Yet Another Case of Electoral and Government Epidemic? The Turkish
   Cypriot Legislative Election of January 2018},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2019},
Volume = {24},
Number = {1},
Pages = {129-154},
Month = {JAN 2},
Abstract = {Following Bosco and Verney's analyses of `electoral' and `government
   epidemics', the 2018 Turkish Cypriot legislative election is examined in
   the context of the impact of the economic crisis on elections and
   government formation in southern Europe. Despite its obvious
   idiosyncrasies as a self-declared state with 335,000 inhabitants, in the
   last decade of economic crisis and austerity policies, the Turkish
   Cypriot case has followed a largely similar pattern to other southern
   European countries: declining turnout; emergence of start-up parties;
   three consecutive early elections; a more fragmented parliament;
   sidelining of the biggest party in government formation; the first ever
   grand coalition; and, finally, an unprecedented four-party coalition
   bringing together parties from left, right, and centre.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
