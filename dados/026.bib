@article{ WOS:000463809000007,
Author = {Peled, Yael and Bonotti, Matteo},
Title = {Sound Reasoning: Why Accent Bias Matters for Democratic Theory},
Journal = {JOURNAL OF POLITICS},
Year = {2019},
Volume = {81},
Number = {2},
Pages = {411-425},
Month = {APR 1},
Abstract = {Accent bias, namely, an unwarranted prejudice toward interlocutors based
   on the sound of their speech, is a subtle yet powerful feature in the
   political life of language. This is especially so in democratic polities
   characterized by a diverse soundscape. The powerful and often covert
   nature of accent bias, and its capacity to generate significant
   epistemic injustice, poses a critical challenge to democratic theory and
   praxis, by challenging its commitment to liberty, equality, inclusivity,
   and reciprocity, and the very process of democratic reasoning. This
   article offers a comprehensive and empirically supported analysis of the
   political life of accent and advocates the cultivation of a sense of
   metalinguistic awareness among political actors, professional and
   otherwise, in order to counter the considerable risk of accent bias in
   democratic life. This cultivation draws on a conception of language that
   is socially embedded and dialogic and that can contribute to a more
   informed democratic theory of language.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
