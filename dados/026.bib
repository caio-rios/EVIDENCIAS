@article{ WOS:000463809000017,
Author = {Niou, Emerson M. S. and Zeigler, Sean M.},
Title = {External Threat, Internal Rivalry, and Alliance Formation},
Journal = {JOURNAL OF POLITICS},
Year = {2019},
Volume = {81},
Number = {2},
Pages = {571-584},
Month = {APR 1},
Abstract = {History reveals enemies often ally to confront a common threat. In such
   competitive coalitions actors must balance the simultaneous risk of
   distrust of their ally against external danger. We model this
   interactive relationship and generate several novel outcomes.
   Intra-alliance rivalry forces allying players to preemptively commit
   more resources to conflict and to free ride less. Consequently, their
   likelihood of conflict success increases. However, intra-alliance
   instability forces weaker players to commit a higher proportion of
   resources to fighting than do their stronger allies. This outcome runs
   contrary to Mancur Olson's classic collective action result that the
   ``small exploit the great.{''} Furthermore, allies do not demonstrate a
   uniform preference for bandwagoning or balancing. In general, it is
   preferable to bandwagon with friends but to balance with enemies.
   Finally, because rivalry can raise alliance payoffs, actors may
   rationally seek out risky partnerships with so-called enemies rather
   than molding more certain alliances with friends.},
Publisher = {UNIV CHICAGO PRESS},
Address = {1427 E 60TH ST, CHICAGO, IL 60637-2954 USA},
Type = {Article},
Language = {English},
Affiliation = {Niou, EMS (Corresponding Author), Duke Univ, Polit Sci, Durham, NC 27708 USA.
   Niou, Emerson M. S., Duke Univ, Polit Sci, Durham, NC 27708 USA.
   Zeigler, Sean M., RAND Corp, Washington, DC USA.},
DOI = {10.1086/701724},
ISSN = {0022-3816},
EISSN = {1468-2508},
Keywords = {alliances; coalitions; free riding; collective action; rivalry;
   international conflict; civil wars},
Keywords-Plus = {ECONOMIC-THEORY; CONFLICT; COOPERATION; PUNISHMENT; PROVISION; MODELS;
   POWER},
Research-Areas = {Government \& Law},
