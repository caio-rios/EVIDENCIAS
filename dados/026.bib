ISSN = {0162-895X},
EISSN = {1467-9221},
Keywords = {competence; ingroup identification; morality; sociability; social
   comparison},
Keywords-Plus = {SOCIAL IDENTITY; LINGUISTIC DISCRIMINATION; STEREOTYPE CONTENT;
