@article{ WOS:000449298800005,
Author = {Higashijima, Masaaki and Houle, Christian},
Title = {Ethnic Inequality and the Strength of Ethnic Identities in Sub-Saharan
   Africa},
Journal = {POLITICAL BEHAVIOR},
Year = {2018},
Volume = {40},
Number = {4},
Pages = {909-932},
Month = {DEC},
Abstract = {Ethnic inequality has been argued to have numerous pernicious effects.
   Among other things, scholars have argued that it breeds political
   violence, destabilizes democracy, and impedes economic development.
   While the arguments developed by these literatures implicitly assume
   that ethnic inequality increases the degree to which individuals
   identify with their ethnicity, this assumption has yet to be tested
   empirically at the individual-level. This paper argues and empirically
   demonstrates that between-ethnic group inequality does strengthen ethnic
   identities. However, we also find that the magnitude of its effect
   weakens as inequality within ethnic groups increases. That is,
   individuals identify most strongly with their ethnic identity when
   ethnicity is reinforced by economic inequality. Using the Afrobarometer,
   we provide the first cross-national empirical test of the effect of
   ethnic inequality on the strength of ethnic identities at the
   individual-level. Our dataset covers 21 sub-Saharan African countries
   and 85 ethnic groups. Results strongly support our hypothesis.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
