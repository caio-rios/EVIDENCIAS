Author = {Marks, Danny},
Title = {Assembling the 2011 Thailand floods: Protecting farmers and inundating
   high-value industrial estates in a fragmented hydro-social territory},
Journal = {POLITICAL GEOGRAPHY},
Year = {2019},
Volume = {68},
Pages = {66-76},
Month = {JAN},
Abstract = {A number of political ecologists have argued that if flooding arises and
   choices have to be made in terms of protection and sacrifice, state
   actors will protect economically-valuable assets of the elite while
   sacrificing assets and lives of the masses. However, during the 2011
   floods in Thailand, one of the costliest disasters ever, the opposite
   occurred in the Chao Phraya River Basin: state actors protected farmland
   of the rural masses and their actions significantly contributed to the
   flooding of the high-value industrial estates of the elite in Central
   Thailand. I argue that to better explain what happened we should
   conceive of floods as assemblages, both human and non-human, as well as
   examine the development of the hydro-social territory in which flooding
   occurs. My analysis takes into account several factors which affected
   vulnerability to the floods: the three-dimensional geography of the
   basin, water's unruliness, the history of infrastructure development,
   the politics of scale, and state fragmentation. To show the importance
   of these variables, I analyse the history of water infrastructure and
   governance in the Chao Phraya River Basin, showing how changes in
   Thailand's political economy and the configuration of institutions made
   it possible for state actors to protect framers. Next, I show how state
   actions in 2011 enabled farmers to be protected and contributed to the
   flooding of the industrial estates. My findings suggest that approaches
   to flooding should move beyond mere analyses of state power and
   socioeconomic status and take more fully into account the embedded
   nature of the socio-political and physical geographies shaping flood
   governance.},
