@article{ WOS:000454914700008,
Author = {Berger, Lars},
Title = {ShariModified Letter Turned Commaa, Islamism and Arab support for
   democracy},
Journal = {DEMOCRATIZATION},
Year = {2019},
Volume = {26},
Number = {2},
Pages = {309-326},
Month = {FEB 17},
Abstract = {The Arab Spring and its aftermath reignited the debate over the
   relationship between Islamism and democracy. This analysis improves upon
   previous research by demonstrating the crucial contribution which a more
   precise understanding of the multiple meanings of the concept of
   ShariModified Letter Turned Commaa can have on our assessment of the
   future of democracy in the Arab world. While support for the
   ShariModified Letter Turned Commaa-conformity of laws has a positive
   impact on the preference for democracy, the insistence that
   ShariModified Letter Turned Commaa represents the word of God as opposed
   to the human attempt to interpret it reduces support for democracy.
   These findings are of considerable significance for academics and
   policy-makers interested in the future of democracy in the Arab world as
   it suggests that generic expressions of support for ShariModified Letter
   Turned Commaa are less relevant in explaining support for democracy than
   what Arab women and men consider to be its essence.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
