@article{ WOS:000365515200002,
Author = {McCrudden, Christopher and McGarry, John and O'Leary, Brendan and
   Schwartz, Alex},
Title = {Why Northern Ireland's Institutions Need Stability},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2016},
Volume = {51},
