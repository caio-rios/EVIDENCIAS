@article{ WOS:000362174200005,
Author = {Pospieszna, Paulina},
Title = {Democracy assistance and women's political empowerment in post-conflict
   countries},
Journal = {DEMOCRATIZATION},
Year = {2015},
Volume = {22},
Number = {7},
Pages = {1250-1272},
Month = {NOV 10},
Abstract = {Democracy promoters around the world cling to the hope that assistance
   given to civil society organizations decreases the risk of civil war and
   will lead to democracy in post-conflict societies. A particularly
   promising segment of civil society in peacebuilding is women. Inspired
   by Welzel and Inglehart's human empowerment: path to democracy this
   study places democracy assistance to women in a broader mechanism which
   forms a theoretical foundation of this study. The case of Bosnia and
   Herzegovina and the author's insights from the fieldwork demonstrate
   that in order to assess the impact of democracy assistance on women's
   political empowerment the comprehensive women's political empowerment
   mechanism should be employed. The statistical examination, however,
   reveals that women's political activism is largely the function of legal
   empowerment and a country's political and socio-economic
   characteristics. The study also shows the limitations of current impact
   evaluation methodologies, and suggests better evaluation tools.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
