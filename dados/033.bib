@article{ WOS:000367842600015,
Author = {Weidmann, Nils B.},
Title = {A Closer Look at Reporting Bias in Conflict Event Data},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2016},
Volume = {60},
Number = {1},
Pages = {206-218},
Month = {JAN},
Abstract = {Recent data collections about political violence are frequently based on
   media reports, which can lead to reporting bias. This is an issue in
   particular for the emergent literature on communication technology and
   conflict, since this technology may not only affect violence, but also
   the reporting about it. Using the effect of cellphones on violence as an
   example, this article presents a quantitative assessment of reporting
   bias in a micro-level analysis. Comparing media-based event reports and
   those from military sources, the results show that the purported
   violence-increasing effect of cellphone coverage is partly due to higher
   reporting rates of violence in cellphone-covered areas. A simple
   diagnostic procedure for this problem is implemented. Applied to the
   analysis of cellphones and violence in Africa, it produces a pattern
   that is consistent with reporting bias driving much of the effect found
   in the Pierskalla and Hollenbach (2013) study about this topic.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Weidmann, NB (Corresponding Author), Univ Konstanz, Dept Polit \& Publ Adm, Polit Sci, D-78457 Constance, Germany.
   Weidmann, Nils B., Univ Konstanz, Dept Polit \& Publ Adm, Polit Sci, D-78457 Constance, Germany.},
DOI = {10.1111/ajps.12196},
ISSN = {0092-5853},
EISSN = {1540-5907},
Keywords-Plus = {COLLECTIVE ACTION; VIOLENCE; INSURGENCY; COVERAGE; AFRICA},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
Author-Email = {nils.weidmann@uni-konstanz.de},
Affiliations = {University of Konstanz},
ResearcherID-Numbers = {Weidmann, Nils B/P-8172-2016},
ORCID-Numbers = {Weidmann, Nils B/0000-0002-4791-4913},
Funding-Acknowledgement = {Alexander von Humboldt Foundation (Sofja Kovalevskaja Award); EU FP7
   Marie Curie Zukunftskolleg Incoming Fellowship Program {[}291784]},
Funding-Text = {Thanks to Sabine Otto for excellent coding assistance. I am grateful to
   Allan Dafoe, Simon Hug, Philipp Hunziker, and Peter Selb as well as
   workshop participants at Rutgers, Yale, Konstanz, and the Graduate
   Institute Geneva for constructive comments. The author acknowledges
   support from the UCDP by making an early version of its Geo-referenced
