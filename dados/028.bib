   Flores, Alejandro, Univ Chicago, Dept Polit Sci, Chicago, IL 60637 USA.
   Coppock, Alexander, Yale Univ, Polit Sci, New Haven, CT 06520 USA.},
DOI = {10.1080/10584609.2018.1426663},
ISSN = {1058-4609},
