@article{ WOS:000453856200005,
Author = {Flores, Alejandro and Coppock, Alexander},
Title = {Do Bilinguals Respond More Favorably to Candidate Advertisements in
   English or in Spanish?},
Journal = {POLITICAL COMMUNICATION},
Year = {2018},
Volume = {35},
Number = {4},
Pages = {612-633},
Abstract = {Candidates for political office in the United States can appeal to
   constituents in either English or in Spanish. We investigate the
   consequences of this choice in a series of survey experiments conducted
   on large, diverse samples of both monolingual and bilingual Americans.
   We take advantage of parallel advertisements produced in both English
   and Spanish by real candidates for national officeone presidential and
   two congressional. Because our design holds constant candidates' policy
   positions, we can attribute the effects on vote choice directly to the
   choice of language over and above other candidate attributes. In two of
   our three experiments, the Spanish-language advertisements increased
   candidates' electoral support by 5 percentage points among bilinguals.
   We find the opposite pattern of results among English-speaking
   monolingual Americans, who respond very negatively to Spanish-language
   advertisements. Our results shed light on the strategic calculus of
   candidates who must appeal to multiple linguistic communities at once.},
Publisher = {TAYLOR \& FRANCIS INC},
Address = {530 WALNUT STREET, STE 850, PHILADELPHIA, PA 19106 USA},
Type = {Article},
Language = {English},
