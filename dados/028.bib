@article{ WOS:000427952100008,
Author = {Caponio, Tiziana and Cappiali, Teresa M.},
Title = {Italian Migration Policies in Times of Crisis: The Policy Gap
   Reconsidered},
Journal = {SOUTH EUROPEAN SOCIETY AND POLITICS},
Year = {2018},
Volume = {23},
Number = {1, SI},
Pages = {115-132},
Abstract = {Numerous studies have shown that there is a structural gap between
   restrictive migration policies and expansive inflows in democratic
   countries; yet scholars have not sufficiently reflected on how this gap
   is shaped in times of crisis. Focusing on the case of Italy in the
   decade between 2007 and 2017, this article assesses the extent to which
   the different challenges triggered by the economic and humanitarian
   crises have affected the structural gap, and which actors have mostly
   contributed to shape it. Our analysis of the Italian case shows how in
   the decade of the economic crisis the migration policy gap has not been
   the result of pressure by actors in the economic and liberal norm
   spheres, but rather reflects conflictual relationships within the
   political-institutional sphere between Italian governments and EU
   institutions.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
