@article{ WOS:000419062900009,
Author = {Castater, Eric Graig and Han, Kyung Joon},
Title = {Trying not to lose: The electoral consequences of unilateral reform
   efforts and the social pact formation process},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2018},
Volume = {57},
Number = {1},
Pages = {171-193},
Month = {FEB},
Abstract = {The existing social pact literature claims that governing parties offer
   social pact proposals because they anticipate they will receive an
   electoral benefit from social pact agreements. Yet the available data on
   social pacts inform us that in a substantial minority of cases social
   pact proposals fail to become social pact agreements. In an effort to
   better determine the political calculations made by governments before
   they propose a social pact, this article examines the effect of
   implementing reform legislation unilaterally, social pact proposals,
   social pact proposal failures and social pact agreements on the vote
   share of government parties in 15 Western European countries between
   1981 and 2006. It is found that social pact proposals do not have any
   electoral consequences for governing parties, unilateral legislation and
   social pact proposal failures reduce the vote share of governing
   parties, and social pact agreements provide an electoral benefit to
   parties in minority governments only. These findings suggest that
   governing parties propose social pacts in a good faith effort to
   complete a social pact agreement; and that such an agreement is not a
   way for these parties to gain votes, but to avoid the electoral
   punishment associated with enacting unpopular reforms unilaterally.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
