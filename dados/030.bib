@article{ WOS:000400003800004,
Author = {Bowler, Shaun},
Title = {Trustees, Delegates, and Responsiveness in Comparative Perspective},
Journal = {COMPARATIVE POLITICAL STUDIES},
Year = {2017},
Volume = {50},
Number = {6},
Pages = {766-793},
Month = {MAY},
Abstract = {A large body of aggregate-level work shows that government policies do
   indeed respond to citizen preferences. But whether citizens recognize
   that government is responsive is another question entirely. Indeed, a
   prior question is whether or not citizens value responsiveness in the
   way that academic research assumes they should in the first place. Using
   comparative data from the European Social Survey, this article examines
   how citizens see government responsiveness. We show that several key
   assumptions of the aggregate-level literature are met at the individual
   level. But we also present results that show that attitudes toward
   representation and responsiveness are colored, sometimes in quite
   surprising ways, by winner-loser effects. In a finding that stands in
   some contrast to the normative literature on the topic, we show that
   these sorts of short-term attitudes help shape preferences for models of
   representation. In particular, we show that the distinction between
   delegates and trustees is a conceptual distinction that has limits in
   helping us to understand citizen preferences for representation.},
