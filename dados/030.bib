ResearcherID-Numbers = {Szostek, Joanna/AAP-9417-2020},
ORCID-Numbers = {Szostek, Joanna/0000-0002-7230-894X},
Funding-Acknowledgement = {European Commission's Marie Sklodowska-Curie Programme},
Funding-Text = {Joanna Szostek is a Marie Skl odowska-Curie Research Fellow at Royal
   Holloway, University of London (Joanna.Szostek@rhul.ac.uk). Her research
   interests revolve around the role of mass media in relations between
   states, particularly in the post-Soviet region. She received her
   doctorate from the University of Oxford in 2013 and has previously held
   a postdoctoral fellowship at the UCL School of Slavonic and East
   European Studies. Further information about her background and research
   can be found at www.stratnarra.eu. She tweets under the name of her
