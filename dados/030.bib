@article{ WOS:000398582100001,
Author = {Monogan, III, James E. and Konisky, David M. and Woods, Neal D.},
Title = {Gone with the Wind: Federalism and the Strategic Location of Air
   Polluters},
Journal = {AMERICAN JOURNAL OF POLITICAL SCIENCE},
Year = {2017},
Volume = {61},
Number = {2},
Pages = {257-270},
Month = {APR},
Abstract = {In federal systems, both state governments and firms have incentives to
   strategically locate polluting facilities where the environmental and
   health consequences will be borne as much as possible by residents of
   other jurisdictions. We analyze air polluter location in the United
   States using a spatial point pattern model, which models where events
   occur in latitude and longitude. Our analyses indicate that major air
   polluters are significantly more likely to be located near a state's
   downwind border than a control group of other industrial facilities,
   results that are robust to a wide variety of model specifications and
   measurement strategies. This effect is particularly pronounced for
   facilities with toxic air emissions. The observed pattern of polluter
   location varies systematically across states and time in ways that
   suggest it is responsive to public policy at both the national and state
   levels.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
