@article{ WOS:000400968500009,
Author = {Hassell, Hans J. G. and Settle, Jaime E.},
Title = {The Differential Effects of Stress on Voter Turnout},
Journal = {POLITICAL PSYCHOLOGY},
Year = {2017},
Volume = {38},
Number = {3},
Pages = {533-550},
Month = {JUN},
Abstract = {While everyone deals with stressful situations on a daily basis,
   individuals have different behavioral reactions to that stress. We argue
   that life stress also affects individuals' political behavior, but this
   effect is contingent on their past political involvement. While
   individuals familiar with and engaged in the political process are
   unaffected when confronted with stress in life, individuals who are not
   routinely involved in the electoral process are more likely to disengage
   from politics. To test the differential effects of stress on the
   likelihood of political involvement, we fielded two experiments, one
   preceding the U.S. presidential election of 2012 and the second
   preceding the 2013 municipal election in a small Midwestern American
   town. We find that when triggered to consider life stressors unrelated
   to politics, individuals without a history of past participation in
   politics are less likely to vote while individuals who are habitual
   voters are unaffected.},
