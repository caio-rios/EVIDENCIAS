@article{ WOS:000397991600007,
Author = {Simonovits, Gabor},
Title = {Centrist by Comparison: Extremism and the Expansion of the Political
   Spectrum},
Journal = {POLITICAL BEHAVIOR},
Year = {2017},
Volume = {39},
Number = {1},
Pages = {157-175},
Month = {MAR},
Abstract = {While it is well understood that policy suggestions outside the range of
   mainstream debate are prevalent in various policy domains of American
   politics, their effects remain unexplored. In this paper, we suggest
   that proposing policies far from the political mainstream can
   re-structure voter perceptions of where alternatives lie in the
   ideological space. We provide support for this hypothesis using results
   from six survey experiments. We find that the introduction of extreme
   alternatives into the public discourse makes mainstream policies on the
   same side of the spectrum look more centrist in the public eye, thus
   increasing support for these moderate alternatives.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Simonovits, G (Corresponding Author), NYU, Dept Polit, New York, NY 10012 USA.
   Simonovits, Gabor, NYU, Dept Polit, New York, NY 10012 USA.},
DOI = {10.1007/s11109-016-9351-y},
ISSN = {0190-9320},
EISSN = {1573-6687},
