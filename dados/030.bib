@article{ WOS:000397991600004,
Author = {Ahler, Douglas J. and Citrin, Jack and Dougal, Michael C. and Lenz,
   Gabriel S.},
Title = {Face Value? Experimental Evidence that Candidate Appearance Influences
   Electoral Choice},
Journal = {POLITICAL BEHAVIOR},
Year = {2017},
Volume = {39},
Number = {1},
Pages = {77-102},
Month = {MAR},
Abstract = {According to numerous studies, candidates' looks predict voters'
   choices-a finding that raises concerns about voter competence and about
   the quality of elected officials. This potentially worrisome finding,
   however, is observational and therefore vulnerable to alternative
   explanations. To better test the appearance effect, we conducted two
   experiments. Just before primary and general elections for various
   offices, we randomly assigned voters to receive ballots with and without
   candidate photos. Simply showing voters these pictures increased the
   vote for appearance-advantaged candidates. Experimental evidence
   therefore supports the view that candidates' looks could influence some
   voters. In general elections, we find that high-knowledge voters appear
   immune to this influence, while low-knowledge voters use appearance as a
   low-information heuristic. In primaries, however, candidate appearance
   influences even high-knowledge and strongly partisan voters.},
Publisher = {SPRINGER/PLENUM PUBLISHERS},
Address = {233 SPRING ST, NEW YORK, NY 10013 USA},
Type = {Article},
Language = {English},
Affiliation = {Lenz, GS (Corresponding Author), Univ Calif Berkeley, Charles \& Louise Travers Dept Polit Sci, 210 Barrows Hall 1950, Berkeley, CA 94720 USA.
   Ahler, Douglas J.; Citrin, Jack; Dougal, Michael C.; Lenz, Gabriel S., Univ Calif Berkeley, Charles \& Louise Travers Dept Polit Sci, 210 Barrows Hall 1950, Berkeley, CA 94720 USA.},
DOI = {10.1007/s11109-016-9348-6},
ISSN = {0190-9320},
EISSN = {1573-6687},
Keywords = {Elections; Candidate appearance; Congressional elections; Primary
   elections; Heuristics},
Keywords-Plus = {PHYSICAL ATTRACTIVENESS; ELECTION OUTCOMES; BEAUTY; LOOKING;
   INFORMATION; SUCCESS; VOTE; INFERENCES; GENDER; CUES},
