@article{ WOS:000398677500013,
Author = {Hayward, Clarissa Rile},
Title = {Responsibility and Ignorance: On Dismantling Structural Injustice},
Journal = {JOURNAL OF POLITICS},
Year = {2017},
Volume = {79},
Number = {2},
Pages = {396-408},
Month = {APR},
Abstract = {This essay tackles the thorny question of how to dismantle structural
   racial injustice. It engages Iris Marion Young's work on responsibility
   for structural justice. But it also draws on Charles Mills's work on
   what Mills calls white epistemologies of ignorance to challenge Young's
   emphasis on changing how racially privileged people understand their
   responsibilities. It makes the case that disruptive politics play a
   crucial role in dismantling structural injustice. Because they interrupt
   privileged people's motivated ignorance, disruptive politics create a
   political opening to institutionalize structural change.},
