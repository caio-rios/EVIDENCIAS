@article{ WOS:000399328200006,
Author = {Otjes, Simon and Katsanidou, Alexia},
Title = {Beyond Kriesiland: EU integration as a super issue after the Eurocrisis},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2017},
Volume = {56},
Number = {2},
Pages = {301-319},
Month = {MAY},
Abstract = {Where some researchers have seen only a limited impact of
   Europeanisation on national party politics, others have added a separate
   European Union dimension to the pre-existing economic left-right
   dimension to model the national political space. This article examines
   the effects of the European crisis on the national political space
   across the EU utilising data from the 2014 European Election Survey. It
   analyses the effect of a country's economic development on the coherence
   between attitudes towards the EU and economic issues using multilevel
   regression. Strong evidence is found that in the Southern European
   debtor states economic and European issues are merging as a result of
   strong European interference in their economic policy. In the Northern
   European creditor states a second relevant dimension focuses on cultural
   issues. These results offer the next step in theorising Europeanisation.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {32 AVENUE OF THE AMERICAS, NEW YORK, NY 10013-2473 USA},
Type = {Article},
Language = {English},
Affiliation = {Otjes, S (Corresponding Author), Univ Groningen, Broerstr 4, NL-9712 CP Groningen, Netherlands.
   Otjes, Simon, Univ Groningen, Broerstr 4, NL-9712 CP Groningen, Netherlands.
   Katsanidou, Alexia, Gesis Leibniz Inst Social Sci, Cologne, Germany.},
DOI = {10.1111/1475-6765.12177},
