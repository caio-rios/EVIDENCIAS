   Schon, Justin, Univ Florida, Dept Anthropol, Gainesville, FL 32611 USA.
   Baldwin, Elizabeth, Univ Arizona, Sch Govt \& Publ Policy, Tucson, AZ 85721 USA.
   MacLean, Lauren M., Indiana Univ, Dept Polit Sci, Bloomington, IN 47405 USA.},
DOI = {10.1016/j.polgeo.2019.102087},
Article-Number = {102087},
ISSN = {0962-6298},
EISSN = {1873-5096},
Keywords = {Civil servants; Bureaucrats; Distributive politics; Political capture;
