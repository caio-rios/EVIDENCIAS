@article{ WOS:000507300100030,
Author = {Frantz, Erica and Kendall-Taylor, Andrea and Wright, Joseph and Xu, Xu},
Title = {Personalization of Power and Repression in Dictatorships},
Journal = {JOURNAL OF POLITICS},
Year = {2020},
Volume = {82},
Number = {1},
Pages = {372-377},
Month = {JAN 1},
Abstract = {This article uses new data measuring gradations of personalism in
   authoritarian regimes to evaluate the relationship between concentration
   of power and patterns of repression. It shows that the personalization
   of power in dictatorships leads to an increase in repression and, thus,
   a decrease in respect for human rights. Given the rise in personalism we
   are witnessing globally, the findings of this study imply that
   repression is likely to become more prevalent in dictatorships as a
   consequence.},
