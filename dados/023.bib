   longitudinal; structural equation model; ideological partisanship},
Keywords-Plus = {RESIDENTIAL-MOBILITY; RESPONSE VALIDITY; AMERICAN; REGISTRATION;
   FAILURE; TURNOUT; COSTS; PARTY; AGE},
