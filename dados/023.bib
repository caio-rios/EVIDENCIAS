   Bale, Tim; Poletti, Monica, Queen Mary Univ London, Polit, London, England.},
DOI = {10.1177/0192512118820691},
ISSN = {0192-5121},
EISSN = {1460-373X},
Keywords = {Political party members; election campaigns; political activism;
   political participation; incentives theory},
