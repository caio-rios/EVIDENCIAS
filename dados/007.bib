@article{ WOS:001462085700001,
Author = {Gonthier, Frederic},
Title = {How Populists Rally Around the People: Evidence from the Yellow Vests
   Movement Using an Embedding Regression Model},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {3, SI},
Pages = {557-573},
Month = {SEP},
Abstract = {This research bridges populism and populist social movement studies to
   address the question of how left- and right-wing populists unite in a
   common social movement. Using the novel ``\& agrave; la carte{''} (ALC)
   embedding regression model, it analyzes a unique dataset of 5,342
   protesters and supporters from the Yellow Vests movement in France,
   capturing their understandings of the People from responses to
   open-ended questions. Findings reveal that while left- and right-wing
   populists diverge in their understandings of the People, differences are
   not politically divisive and do not preclude common vocabularies
   allowing for identification with the movement. This study contributes to
   the literature by showcasing the innovative application of the embedding
   regression method to textual data collected during social movements.
   Whereas research on the subject is predominantly qualitative, this study
   employs quantitative techniques to demonstrate that identification with
   the People fosters a unified movement despite divergent political
   beliefs and contrasting social identity frames.
   Dieser Forschungsbeitrag schl \& auml;gt eine Br \& uuml;cke zwischen
   Studien zu Populismus einerseits und sozialen Bewegungen andererseits
   und fragt, wie links- und rechtsgerichtete Populisten in einer
   gemeinsamen sozialen Bewegung zusammenkommen. Mithilfe des neuartigen
   ``\& agrave; la carte{''} (ALC) Embedded Regression Modells wird ein
   Datensatz von 5.342 DemonstrantInnen und Unterst \& uuml;tzerInnen der
   Gelbwesten-Proteste in Frankreich analysiert. Ziel ist, aus Antworten
   auf offene Fragen Verst \& auml;ndnisse des Begriffs ,,Volk{''}
   abzuleiten. Obwohl sich linke und rechte Populisten in ihrem Verst \&
   auml;ndnis des Volks unterscheiden, bedingen diese Unterschiede keine
   politische Spaltung und schliessen gemeinsame Vokabulare, die eine
   Identifikation mit der Bewegung erm \& ouml;glichen, nicht aus. Durch
   eine innovative Anwendung der ,,Embedding{''} Regressionsmethode auf
   Textdaten, die bei sozialen Demonstrationen gesammelt wurden, zeigt
   diese Studie somit, dass die Identifikation mit dem Volk eine
   einheitliche Bewegung trotz divergierender politischer \&
   Uuml;berzeugungen und kontrastierender Logiken der sozialen Identit \&
   auml;t beg \& uuml;nstigt.
   Cette recherche mobilise les \& eacute;tudes sur les attitudes et les
   mouvements sociaux populistes pour aborder la question de savoir comment
   les populistes de gauche et de droite peuvent s'unir dans un m \&
   ecirc;me mouvement social. En utilisant le mod \& egrave;le de r \&
   eacute;gression sur les plongements de mots ``\& agrave; la carte{''}
   (ALC), elle analyse un jeu de donn \& eacute;es unique de 5 342
   manifestants et sympathisants du mouvement des Gilets Jaunes en France.
   Bien que les populistes de gauche et de droite divergent dans leurs
   compr \& eacute;hensions du peuple, ces diff \& eacute;rences ne sont
   pas politiquement clivantes et n'excluent nullement des vocabulaires
   communs permettant une identification au mouvement. Par une application
   innovante de la m \& eacute;thode de r \& eacute;gression sur des
   plongements de mots \& agrave; des donn \& eacute;es textuelles collect
   \& eacute;es lors de manifestations sociales, cette \& eacute;tude d \&
   eacute;montre ainsi que l'identification au peuple favorise un mouvement
   unifi \& eacute; malgr \& eacute; des croyances politiques divergentes
   et des logiques d'identit \& eacute; sociale contrast \& eacute;es.
   Questa ricerca collega gli studi sul populismo e quelli sui movimenti
   sociali per affrontare la questione intrigante di come i populisti di
   sinistra e di destra si uniscano in un movimento sociale comune.
   Utilizzando un nuovo modello di regressione ``\& agrave; la carte{''}
   (ALC), l'articolo analizza un dataset unico di 5342 manifestanti e
   sostenitori del movimento dei gilet gialli in Francia, deducendo la loro
   comprensione della nozione di ``popolo{''} dalle risposte a domande
   aperte. I risultati rivelano che, mentre i populisti di sinistra e di
   destra divergono nelle loro interpretazioni di ``popolo{''}, le
   differenze non sono politicamente divisive e non precludono vocabolari
   comuni che permettono l'identificazione con il movimento. Questo studio
   contribuisce alla letteratura mostrando l'applicazione innovativa del
   metodo di ``embedding regression{''} ai dati testuali raccolti durante
   le proteste sociali. Mentre la ricerca sul tema \& egrave;
   prevalentemente qualitativa, questo studio impiega tecniche quantitative
   per dimostrare che l'identificazione con il popolo favorisce un
   movimento unificato nonostante le credenze politiche divergenti e i
   contrasti nei quadri di identit \& agrave; sociale.},
