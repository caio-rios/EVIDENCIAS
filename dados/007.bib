@article{ WOS:001462088900001,
Author = {Gremler, Frederik and Haiges, Lea},
Title = {Ethnicity and Elections: Electoral Context Affects Parties' Use of
   Ethnic References},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {3, SI},
Pages = {533-556},
Month = {SEP},
Abstract = {Links to specific ethnic groups constitute a defining feature of ethnic
   parties. Yet, whether and how references to ethnic identities appear in
   ethnic parties' political communication often remains unstudied despite
   the promise it carries. This paper investigates to what extent the
   electoral cycle and ethnic competition influence ethnic parties' usage
   of ethnic references on social media. Analyzing 1.3 million social media
   posts by 112 ethnic parties in 38 countries, we find that the number of
   ethnic references by a party increases as election day approaches.
   Moreover, a higher number of competing ethnic parties in elections is
   also associated with higher usage of ethnic references. This research
   contributes to our understanding of when and why parties address
   ethnicity on social media.
   Verbindungen zu spezifischen ethnischen Gruppen sind ein
   Bestimmungsmerkmal ethnischer Parteien. Doch die Forschung zu ethnischer
   Kommunikation fokussiert sich bislang auf den Vergleich einzelner
   Parteien in einigen wenigen Regionen. Dieser Artikel untersucht,
   inwieweit der Wahlzyklus und Parteienwettbewerb beeinflussen, wie h \&
   auml;ufig ethnische Parteien ethnische Referenzen in den sozialen Medien
   nutzen. Er wertet \& uuml;ber 1,3 Millionen Social-Media-Posts von 112
   ethnischen Parteien in 38 L \& auml;ndern aus und stellt fest, dass die
   Anzahl der ethnischen Referenzen einer Partei zunimmt, je n \& auml;her
   eine Wahl r \& uuml;ckt. Dar \& uuml;ber hinaus ist eine h \& ouml;here
   Anzahl konkurrierender ethnischer Parteien bei Wahlen mit einer h \&
   ouml;heren Verwendung ethnischer Referenzen verbunden. Dieser Artikel tr
   \& auml;gt zu unserem Verst \& auml;ndnis bei, wann und warum Parteien
   ethnische Referenzen in sozialen Medien verwenden.
   Les liens avec des groupes ethniques sp \& eacute;cifiques constituent
   la caract \& eacute;ristique principale des partis ethniques. Cependant,
   la question de savoir si et comment les r \& eacute;f \& eacute;rences
   aux identit \& eacute;s ethniques apparaissent dans la communication
   politique de ces partis reste inexplor \& eacute;e, malgr \& eacute; les
   promesses qu'elle comporte. Cet article \& eacute;tudie dans quelle
   mesure le cycle \& eacute;lectoral et la concurrence ethnique
   influencent l'utilisation par les partis ethniques de r \& eacute;f \&
   eacute;rences ethniques sur les m \& eacute;dias sociaux. En analysant
   1,3 million de posts sur les m \& eacute;dias sociaux de 112 partis
   ethniques dans 38 pays, nous constatons que le nombre de r \& eacute;f
   \& eacute;rences ethniques d'un parti augmente \& agrave; l'approche du
   jour de l'\& eacute;lection. En outre, un plus grand nombre de partis
   ethniques en comp \& eacute;tition lors des \& eacute;lections est. \&
   eacute;galement associ \& eacute; \& agrave; une plus grande utilisation
   des r \& eacute;f \& eacute;rences ethniques. Cette \& eacute;tude nous
   permet de mieux comprendre quand et pourquoi les partis abordent la
   question de l'ethnicit \& eacute; sur les m \& eacute;dias sociaux.
   La caratteristica distintiva dei partiti etnici \& egrave; di avere i
   legami con i relativi gruppi etnici. Tuttavia, se e come i riferimenti
   alle identit \& agrave; etniche compaiano nella comunicazione politica
   dei partiti etnici \& egrave; una questione molto promettente ma poco
   studiata. Questo lavoro indaga in che misura il ciclo elettorale e la
   competizione etnica influenzino l'uso dei riferimenti etnici da parte
   dei partiti etnici sui social media. Analizzando 1,3 milioni di post sui
   social media di 112 partiti etnici in 38 Paesi, scopriamo che il numero
   di riferimenti etnici da parte di un partito aumenta con l'avvicinarsi
   del giorno delle elezioni. Inoltre, un numero maggiore di partiti etnici
   in competizione alle elezioni \& egrave; anche associato a un uso pi \&
   ugrave; elevato di riferimenti etnici. Questa ricerca contribuisce alla
   comprensione di quando e perch \& eacute; i partiti fanno riferimento
   all'etnicit \& agrave; sui social media.},
