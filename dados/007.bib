EISSN = {1573-6687},
Keywords = {Elections; Voting; Health politics; Rural politics},
Keywords-Plus = {EMERGENCY MEDICAL-TREATMENT; HILL-BURTON ACT; HEALTH-CARE; ELECTORAL
   ACCOUNTABILITY; PUBLIC-OPINION; LABOR ACT; EXPANSION; POLICY; ELECTIONS;
   PRESIDENT},
