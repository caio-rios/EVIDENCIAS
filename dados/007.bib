@article{ WOS:001397781600005,
Author = {Beiser-McGrath, Janina},
Title = {Ethnic Coalitions and Media Freedom in African Autocracies},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {1},
Pages = {85-98},
Month = {JAN 1},
Abstract = {Media freedom can threaten autocrats' political survival. But autocrats
   also have incentives to tolerate more media freedom. This article argues
   that when autocratic regime survival depends on the support of large
   multiethnic government coalitions with politicians from groups that are
   considerably smaller than the leader's group, freer media can serve as a
   commitment device to reassure smaller groups. Testing this argument in a
   sample on African autocracies, the article finds that autocratic leaders
   censor print and broadcast media less when the government relies on an
   ethnically inclusive coalition that includes groups that are
   considerably smaller than the leader's group. It also finds some, albeit
   less, evidence suggesting that the proportion of the coalition that is
   made up of small groups is relevant. The findings suggest that
   autocratic leaders that rely on ethnic inclusiveness as a source of
   legitimacy use media freedom to win the support from ethnic minority
   groups.},
