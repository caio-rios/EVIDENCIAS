@article{ WOS:001414999500001,
Author = {Braga, Giuliano Guidi and Ferreira-Pereira, Laura C.},
Title = {The European Parliament's democracy promotion activities in the face of
   autocratization in South America: the cases of Bolivia and Venezuela},
Journal = {DEMOCRATIZATION},
Year = {2025},
Volume = {32},
Number = {7, SI},
Pages = {1752-1773},
Month = {OCT 3},
Abstract = {The European Parliament's (EP) developing participation in the Common
   Foreign and Security Policy has generated several democracy promotion
   activities towards countries in South America. While intersecting
   studies on both parliamentary diplomacy and democracy promotion vis-\&
   agrave;-vis processes of autocratization, this article aims to analyse
   how the EP has reacted to autocratization in Bolivia and Venezuela. The
   analysis spans from 2009 to 2024 to take the EP electoral terms as
   reference points; and relies largely on a content analysis of the
   instruments used by the EP, such as diplomatic pressure, sanction,
   electoral observation missions, and the Sakharov Prize for Freedom of
   Thought. This study concludes that the EP has used and adapted its
   instruments to promote democracy, while adjusting them to the
   idiosyncratic circumstances of each country. The Bolivian case was
   marked by ambiguities about who had violated democratic norms, leading
   to polarization and political division within the EP, which eventually
   showed reluctance in getting involved. In stark contrast, as regards
   Venezuela, a clear-cut case of continuing autocratization, the EP
   reacted more decisively, providing clear support for the opposing
   interim president, Juan Guaid \& oacute;.},
Publisher = {ROUTLEDGE JOURNALS, TAYLOR \& FRANCIS LTD},
