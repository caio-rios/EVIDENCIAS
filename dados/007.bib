@article{ WOS:001421432300001,
Author = {Lindsay, Spencer C. and Melcher, Cody R.},
Title = {Investigating the Origins of Status Threat among White Americans},
Journal = {PUBLIC OPINION QUARTERLY},
Year = {2024},
Volume = {88},
Number = {4},
Month = {WIN},
Abstract = {In the last decade and a half, the United States has seen a rise in
   right-wing nationalism. Status threat provides a compelling explanation
   as to why. As white Americans see changing demographics, more diverse
   imagery in American leadership, and increased interdependence globally,
   they fear that they are losing ``their{''} country. Scholars, however,
   often see status threat as primarily symbolic rather than material. We
   argue that material concerns are also instrumental in shaping whites'
   perception of status threat. We test this hypothesis using an original
   survey experiment in which some respondents are primed to think about
   symbolic or material aspects of status threat. Relative to the control,
   both groups express heightened levels of perceived threat from other
   groups, indicating that both material and symbolic concerns are
   instrumental in shaping perceptions of status threat. We additionally
   test whether Republican whites respond to this perceived threat by
   becoming more likely to endorse far-right, restrictionist immigration
   policies. Our findings on the latter question are mixed.},
