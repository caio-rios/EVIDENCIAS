@article{ WOS:001420810100001,
Author = {Mundy, Ryan},
Title = {A Bigger Tent? Nonwhite Republican Candidates and Their Uphill Paths to
   Office},
Journal = {POLITICAL RESEARCH QUARTERLY},
Year = {2025},
Volume = {78},
Number = {2},
Pages = {738-752},
Month = {JUN},
Abstract = {Black, Latino, and Asian-American candidates have disproportionately ran
   as Democrats in the modern political era. Yet the number of nonwhite
   Republican candidates for U.S. Congress reached a record high of 260 in
   2022, nearly tripling the number who ran in 2016. I utilize a
   candidate-level dataset to provide the first account of who these
   nonwhite Republican candidates for Congress are, where they run, and how
   they fare both electorally and financially. I find that despite
   increases in the number of nonwhite Republicans who run for office,
   these candidates are not well positioned to win. In comparison to their
   white counterparts, nonwhite Republicans are less experienced candidates
   who run in unfavorable districts and raise less money. Additionally, I
   employ an original survey of 2022 congressional candidates and find that
   nonwhite Republicans report facing greater institutional and electoral
   hurdles than white Republicans. Overall, these findings further our
   understanding of how the barriers to political representation may differ
   across social groups, while highlighting the enduring limitations that
   the Republican Party faces in broadening its electoral tent.},
