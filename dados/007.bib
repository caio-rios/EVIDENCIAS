@article{ WOS:001401645300001,
Author = {Folke, Olle and Rickne, Johanna and Szulkin, Jan},
Title = {Politicians' Labor Market Experiences Across Party Families},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {1},
Pages = {15-30},
Month = {JAN 1},
Abstract = {We use detailed Swedish data to compare patterns of labor market
   experiences between political candidates from four party families. These
   pattens align with Kitschelt's (1994) theory on how labor market
   experiences shape political ideology. Candidates in traditional left and
   right parties differ in experiences predicted to drive left-right
   ideology: Social Democrats own less capital and work in the public
   sector, whereas Conservatives are more likely to own or manage private
   businesses. The new left and right parties differ mainly in experiences
   predicted to drive authoritarian-libertarian ideology: Green Party
   politicians more often hold human-interactive jobs (e.g., teachers,
   nurses, and other health professionals) and are more likely to be women
   with tertiary education, whereas Sweden Democrat politicians are more
   likely to hold object-manipulating, routine jobs with little autonomy
   (e.g., machine and vehicle operators). These patterns of common
   experiences within parties have implications for policy platforms, party
   stability, and ideological cohesion.},
