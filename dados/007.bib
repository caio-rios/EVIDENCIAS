@article{ WOS:001423209200001,
Author = {Kosiara-Pedersen, Karina and van Haute, Emilie and Scarrow, Susan E.},
Title = {Social media partisans vs. party members: political affiliation in a
   digital age},
Journal = {WEST EUROPEAN POLITICS},
Year = {2026},
Volume = {49},
Number = {2},
Pages = {435-456},
Month = {FEB 23},
Abstract = {Recently political parties have diversified their affiliation options,
   including by developing social media followings, but so far there is
   little evidence about who is exploiting these new options. A unique
   Danish survey enables this type of political engagement to be observed.
   First, this study analyses political parties' social media followers
   (SMFs) and shows that this type of activity is a sizeable form of
   political engagement that follows the logics of non-institutionalised
   participation. Second, it identifies a subset of SMFs, social media
   partisans (SMPs), who are monogamous in their online following, thus
   resembling a distinct form of party affiliation. These SMPs are
   demographically more like party voters than are parties' traditional
   members, thereby offsetting some of the inequalities of membership as an
   institutionalised form of participation. SMPs are also more willing than
   party voters to amplify party messages online, but are not functionally
   equivalent to party members when it comes to activism levels. By
   providing some of the first evidence of who parties' social media
   followers are, and how they resemble (and differ from) other party
   supporters, this study gives a first glimpse of the ways in which
   parties could benefit from cultivating SMPs as a distinct supporter
   base.},
