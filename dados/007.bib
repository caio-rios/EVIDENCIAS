@article{ WOS:001356915600001,
Author = {Reuse, Raf},
Title = {Does the left-right cleavage matter in local politics? An analysis of
   local party manifestos across municipal sizes},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {2},
Pages = {200-221},
Month = {JUN},
Abstract = {In comparative political science the question whether the local
   political space can be structured along a left-right dimension is being
   strongly debated. A growing body of research underpins the relevance of
   left and right in local politics, but these studies are often conducted
   from the perspective of voters and, above all, in large cities. In order
   to close these gaps in the literature, this paper addresses the shape of
   the local political space and the role of municipal size by analysing
   257 local party manifestos in the context of Flanders (Belgium). With
   the help of Wordscores, local parties' policy positions on the general,
   economic and cultural left-right dimension in small, medium-sized and
   large municipalities are analysed. The findings show a strong
   ideological resemblance between local branches of the same party and
   between local branches and their national party, but this relationship
   is not affected by municipal size.
   In der vergleichenden Politikwissenschaft wird die Frage, ob der lokale
   politische Raum entlang einer Links-Rechts-Achse strukturiert werden
   kann, heftig diskutiert. Eine wachsende Zahl von Forschungsarbeiten
   untermauert die Relevanz von links und rechts in der Kommunalpolitik,
   aber diese Studien werden h \& auml;ufig aus der Perspektive der W \&
   auml;hlerschaft und vor allem in Gro ss st \& auml;dten durchgef \&
   uuml;hrt. Um diese L \& uuml;cken in der Literatur zu schlie ss en,
   befasst sich dieser Beitrag mit der Form des lokalen politischen Raums
   und der Rolle der Gemeindegr \& ouml;ss e, indem er 257 lokale
   Wahlprogramme im Kontext von Flandern (Belgien) analysiert. Mit Hilfe
   von Wordscores werden die politischen Positionen der lokalen Parteien
   zur allgemeinen, wirtschaftlichen und gesellschaftlichen
   Links-Rechts-Achse in kleinen, mittleren und gro ss en Gemeinden
   analysiert. Die Ergebnisse zeigen eine starke ideologische \&
   Auml;hnlichkeit zwischen Ortsverb \& auml;nden der gleichen Partei und
   zwischen den Ortsverb \& auml;nden und ihrer nationalen Partei, wobei
   diese Beziehung nicht von der Gemeindegr \& ouml;ss e abh \& auml;ngt.
   En politique compar \& eacute;e, la question de savoir si l'espace
   politique local peut \& ecirc;tre structur \& eacute; sur l'axe
   gauche-droite fait l'objet d'un vif d \& eacute;bat. De plus en plus
   d'\& eacute;tudes confirment l'importance de la gauche et de la droite
   en politique locale, mais ces \& eacute;tudes prennent souvent le point
   de vue des \& eacute;lecteurs.trices et, surtout, sont men \& eacute;es
   dans les grandes villes. Afin de combler ces lacunes dans la litt \&
   eacute;rature, cet article aborde l'agencement de l'espace politique
   local et le r \& ocirc;le de la taille de la commune en analysant 257
   programmes de partis locaux en Flandre (Belgique). A l'aide de
   Wordscores, les positions politiques des partis locaux sur l'axe
   gauche-droite g \& eacute;n \& eacute;ral, \& eacute;conomique et
   culturel, dans les petites, moyennes et grandes communes sont analys \&
   eacute;es. Les r \& eacute;sultats montrent une forte ressemblance id \&
   eacute;ologique entre les sections locales d'un m \& ecirc;me parti et
   entre les sections locales et leur parti national, mais cette relation
   n'est. pas affect \& eacute;e par la taille de la commune.
   La questione se lo spazio politico locale possa essere strutturato lungo
   una dimensione destra-sinistra \& egrave; ampiamente dibattuta nella
   scienza politica comparata. Un numero crescente di ricerche evidenzia la
   rilevanza di questa dicotomia anche nella politica locale, tuttavia,
   tali studi si concentrano prevalentemente sugli elettori e sulle grandi
   citt \& agrave;. Per colmare queste lacune, il presente lavoro esamina
   la natura del conflitto politico a livello locale e il ruolo della
   dimensione comunale, analizzando 257 manifesti di partiti locali nelle
   Fiandre (Belgio). Attraverso l'uso di Wordscores, vengono investigate le
   posizioni politiche dei partiti locali lungo la dimensione
   destra-sinistra, sia a livello generale che nelle sfere economica e
   culturale, nei comuni di diverse dimensioni (piccoli, medi e grandi). I
   risultati rivelano una forte somiglianza ideologica tra le sezioni
   locali dello stesso partito e tra queste ultime e i rispettivi partiti
   nazionali, indipendentemente dalle dimensioni del comune.},
