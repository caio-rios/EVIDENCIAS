@article{ WOS:001393544000002,
Author = {Castillo-Quintana, Martin},
Title = {Violence, Peace, and Government Intervention in Illicit Drug Markets},
Journal = {JOURNAL OF POLITICS},
Year = {2025},
Volume = {87},
Number = {1},
Pages = {128-142},
Month = {JAN 1},
Abstract = {Can governments indirectly control drug trafficking-related violence?
   Recent work has shown how governments can reduce violence by
   implementing conditional policies. In this article, I study the
   conditions under which governments would be able to implement such
   policies. I present a dynamic game with endogenous discounting that
   captures the core strategic interaction between a government and two
   rival drug lords. The model illustrates that only far-sighted, patient
   governments can commit to conditional policies. Finally, I develop a
   series of applications of the model to include anticorruption, foreign
   aid, and legalization policies and find that these counteract the
   violence-reducing effects of conditional policies frustrating the
   prospects for peace.},
