@article{ WOS:001380349000001,
Author = {Walkenhorst, Janina and Schuppert, Fabian},
Title = {What is the normative added value of deliberative mini publics in the
   context of climate policy making?},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2025},
Volume = {31},
Number = {3, SI},
Pages = {490-510},
Month = {SEP},
Abstract = {This paper contributes to the debate on the normative value(s) of
   deliberative mini publics (DMPs) in climate policy-making. We discuss
   different conceptions of the objectives of DMPs, such as increasing
   democratic legitimacy, effectiveness, and social acceptance. Following,
   we critically assess the plausibility of each conception and argue why
   meaningful and independent participation is crucial for increasing
   democratic legitimacy. We also show that even if the instrumental
   perspective of climate policy effectiveness seems necessary against the
   background of the advancing climate crisis, it cannot be produced
   through deliberative formats without central democratic principles being
   ignored. Furthermore, we highlight that social acceptance as a primary
   objective is highly problematic because it threatens to lead to
   manipulation and sham participation.
   Die Studie tr \& auml;gt zur Debatte \& uuml;ber den normativen Wert
   deliberativer Mini-Publics (DMPs) in der Klimapolitik bei. Wir er \&
   ouml;rtern verschiedene Perspektiven auf die Ziele von DMPs, wie etwa
   die St \& auml;rkung demokratischer Legitimit \& auml;t, Effektivit \&
   auml;t und sozialer Akzeptanz. Anschlie ss end bewerten wir die
   Plausibilit \& auml;t der vorgestellten Konzepte kritisch und
   argumentieren, warum bedeutungsvolle und unabh \& auml;ngige
   Partizipation entscheidend f \& uuml;r die Steigerung der demokratischen
   Legitimit \& auml;t ist. Gleichzeitig zeigen wir, dass die
   instrumentelle Perspektive einer effektiven Klimapolitik zwar angesichts
   der fortschreitenden Klimakrise notwendig erscheint, aber nicht alleinig
   durch deliberative Formate erzeugt werden kann, ohne zentrale
   demokratische Prinzipien zu vernachl \& auml;ssigen. Dar \& uuml;ber
   hinaus heben wir hervor, dass soziale Akzeptanz als prim \& auml;res
   Ziel \& auml;u ss erst problematisch ist, da es die Gefahr der
   Manipulation und Scheinbeteiligung birgt.
   Ce papier contribue au d \& eacute;bat sur la valeur normative des
   mini-publics d \& eacute;lib \& eacute;ratifs (MPD) dans la politique
   climatique. Nous discutons diff \& eacute;rents objectifs des MPD, parmi
   lesquels l'augmentation de la l \& eacute;gitimit \& eacute; d \&
   eacute;mocratique, de l'efficacit \& eacute; et de l'acceptation
   sociale. Ensuite, nous \& eacute;valuons la plausibilit \& eacute; de
   chaque conception et argumentons pourquoi une participation
   significative et ind \& eacute;pendante est. cruciale pour accro \&
   icirc;tre la l \& eacute;gitimit \& eacute; d \& eacute;mocratique. En m
   \& ecirc;me temps, nous montrons que, m \& ecirc;me si la perspective
   instrumentale d'une politique climatique efficace semble n \&
   eacute;cessaire face \& agrave; la crise climatique en cours, elle ne
   peut \& ecirc;tre produite par des formats de participation sans ignorer
   des principes d \& eacute;mocratiques fondamentaux. De plus, nous
   soulignons que l'acceptation sociale en tant qu'objectif principal est.
   hautement probl \& eacute;matique, car elle cr \& eacute;e le danger de
   manipulation et de participation factice.
   Questo documento contribuisce al dibattito sul valore normativo dei
   mini-pubblici deliberativi (DMP) nella formulazione delle politiche
   climatiche. Discutiamo diversi approcci agli obiettivi dei DMP, come
   l'aumento della legittimit \& agrave; democratica, dell'efficacia e
   dell'accettazione sociale. Successivamente, offriamo una valutazione
   critica della plausibilit \& agrave; di ciascuna concezione e
   argomentiamo perch \& eacute; una partecipazione significativa e
   indipendente sia cruciale per aumentare la legittimit \& agrave;
   democratica. Dimostriamo anche che, sebbene la prospettiva strumentale
   dell'efficacia delle politiche climatiche sembri necessaria alla luce
   della crisi climatica in atto, essa non pu \& ograve; essere raggiunta
   attraverso formati deliberativi senza compromettere i principi
   democratici fondamentali. Inoltre, evidenziamo che considerare
   l'accettazione sociale come obiettivo primario \& egrave; altamente
   problematico, poich \& eacute; rischia di portare a manipolazione e
   partecipazione fittizia.},
