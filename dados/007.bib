@article{ WOS:001374817200001,
Author = {Katsourides, Yiannos and Ioannidis, Nikandros},
Title = {Intra-Party Leadership Contests and Effect on Levels of Satisfaction
   with Democracy on Party Voters},
Journal = {GOVERNMENT AND OPPOSITION},
Year = {2025},
Volume = {60},
Number = {3},
Pages = {872-893},
Month = {JUL},
Abstract = {This article investigates the relationship between intra-party
   leadership contestations on levels of satisfaction with democracy among
   party voters, trying to identify the impact of the former on the latter.
   The article draws on empirical data for a cross-sectional analysis from
   three different data sets that cover 11 countries, including a more
   case-specific analysis that utilizes panel data from Germany. Overall,
   the study aims to capture the dynamics of intra-party politics and the
   magnitude of its effect on perceptions of democracy among parties'
   voters. We find that intra-party politics at its probably most
   competitive version, that is elections for the head of the party, does
   not seem to exercise any significant influence on voters' satisfaction
   with democracy.},
Publisher = {CAMBRIDGE UNIV PRESS},
Address = {EDINBURGH BLDG, SHAFTESBURY RD, CB2 8RU CAMBRIDGE, ENGLAND},
