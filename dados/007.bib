@article{ WOS:001415168900001,
Author = {Mcdonnell, Duncan and Ammassari, Sofia and Werner, Annika and Bolin,
   Niklas and Valbruzzi, Marco and Lopes, Hugo ferrinho and Heinisch,
   Reinhard and Jungar, Ann-cathrine and Wegscheider, Carsten},
Title = {Young radicals, moderates and aligned: Ideological congruence and
   incongruence in party youth wings},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2025},
Volume = {64},
Number = {4},
Pages = {1759-1782},
Month = {NOV},
Abstract = {The ideological fit between party grassroots and leaderships has long
   been a concern for political science, with members in general, and young
   members in particular, thought to be more radical. However, we do not
   know, first, whether this is still the case and, if it is, what drives
   members in different ideological directions. To investigate, we propose
   a new typology of members as radicals, moderates and aligned, and
   develop a theoretical framework that accounts for how political
   socialization and party contexts drive congruence and incongruence. We
   test this using YOUMEM survey data from over 4,000 members of 12 youth
   wings in six countries. Our results show that while radicals are the
   largest group in most youth wings, they are more common on the
   centre-left than the centre-right. They tend to have been in the youth
   wing for longer than aligned members, but are under-represented among
   politically ambitious members. Our findings thus shed light on opinion
   structures within political parties and provide a typology for future
   research on intra-party cohesion.},
