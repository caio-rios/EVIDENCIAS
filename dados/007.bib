@article{ WOS:001361899600001,
Author = {Ortega, Carmen and Onate, Pablo},
Title = {Impact of information shortcuts on preferential voting: Gender and
   ballot position effects in Luxembourg and Switzerland},
Journal = {SWISS POLITICAL SCIENCE REVIEW},
Year = {2024},
Volume = {30},
Number = {4},
Pages = {446-471},
Month = {DEC},
Abstract = {Free party lists provide voters with greater freedom of choice than
   other electoral systems, allowing them to select candidates within and
   between parties. Given that free party lists are cognitively highly
   demanding, voters have incentives to use shortcuts to discriminate
   between candidates. This study uses multilevel linear regression models
   to analyze the effect of candidates' gender and ballot position on
   preference voting in Luxembourg and Switzerland. Our results show that
   both candidates' gender and ballot position have a significant effect on
   their preference voting share and provide evidence on how they interact
   in intraparty competition. Candidates' ballot position has an inverse
   J-shaped effect on their preference vote share. This effect varies with
   candidates' gender in both countries but works in different directions.
   Our findings have important implications for electoral system design,
   outlining the potential consequences of alphabetical and party-ordered
   lists for candidates' chances and for electoral gender quotas'
   effectiveness under intraparty preference voting procedures.
   Freie Parteilisten bieten den W \& auml;hlern mehr Wahlfreiheit als
   andere Wahlsysteme, da sie ihnen erlauben, KandidatInnen innerhalb und
   zwischen Parteien auszuw \& auml;hlen. Da freie Parteilisten kognitiv
   sehr anspruchsvoll sind, haben W \& auml;hler Anreize, kognitive
   shortcuts zu verwenden, um zwischen KandidatInnen zu unterscheiden.
   Diese Studie analysiert die Auswirkungen von Geschlecht und
   Listenposition der KandidatInnen auf die Pr \& auml;ferenzwahl in
   Luxemburg und der Schweiz mithilfe mehrstufiger linearer
   Regressionsmodelle. Wir zeigen, dass Geschlecht und Listenposition den
   Anteil an der Pr \& auml;ferenzwahl signifikant beeinflussen und liefern
   Hinweise darauf, wie beide Variablen im innerparteilichen Wettbewerb
   interagieren. Die Listenposition der KandidatInnen hat einen umgekehrten
   J-f \& ouml;rmigen Effekt auf ihren Stimmenanteil. Dieser Effekt
   variiert in beiden L \& auml;ndern je nach Geschlecht der KandidatInnen,
   wirkt jedoch in unterschiedliche Richtungen. Unsere Ergebnisse wirken
   sich auf die Gestaltung von Wahlsystemen aus und zeigen potenzielle
   Folgen von alphabetischen und parteiorientierten Listen f \& uuml;r die
   Chancen der KandidatInnen und die Wirksamkeit von Geschlechterquoten bei
   parteiinternen Pr \& auml;ferenzwahlverfahren auf.
   Les listes de partis libres offrent aux \& eacute;lecteurs une plus
   grande libert \& eacute; de choix que les autres syst \& egrave;mes \&
   eacute;lectoraux, en leur permettant de s \& eacute;lectionner des
   candidats au sein d'un m \& ecirc;me parti ou entre plusieurs partis. \&
   Eacute;tant donn \& eacute; que les listes de partis libres sont
   cognitivement tr \& egrave;s exigeantes, les \& eacute;lecteurs sont
   incit \& eacute;s \& agrave; utiliser des raccourcis pour faire la
   distinction entre les candidats. Cette \& eacute;tude utilise des mod \&
   egrave;les de r \& eacute;gression lin \& eacute;aire multiniveaux pour
   analyser l'effet du sexe et de la position de liste des candidats sur le
   vote pr \& eacute;f \& eacute;rentiel au Luxembourg et en Suisse. Nos r
   \& eacute;sultats montrent que le sexe des candidats et leur position
   sur le bulletin de vote ont un effet significatif sur leur part de vote
   pr \& eacute;f \& eacute;rentiel et fournissent des preuves sur la fa \&
   ccedil;on dont ils interagissent dans la concurrence intra-parti. La
   position des candidats sur le bulletin de vote a un effet inverse en
   forme de J sur leur part de vote pr \& eacute;f \& eacute;rentiel. Cet
   effet varie en fonction du sexe des candidats dans les deux pays, mais
   dans des directions diff \& eacute;rentes. Nos r \& eacute;sultats ont
   des implications importantes pour la conception des syst \& egrave;mes
   \& eacute;lectoraux, soulignant les cons \& eacute;quences potentielles
   des listes alphab \& eacute;tiques et des listes ordonn \& eacute;es par
   les partis sur les chances des candidats et sur l'efficacit \& eacute;
   des quotas \& eacute;lectoraux par sexe dans le cadre des proc \&
   eacute;dures de vote pr \& eacute;f \& eacute;rentiel intra-parti.
   Le cosiddette ``liste libere{''} nelle elezioni offrono agli elettori
   una maggiore libert \& agrave; di scelta rispetto ad altri sistemi
   elettorali, consentendo loro di selezionare i candidati all'interno dei
   partiti e tra di essi. Poich \& eacute; le liste libere sono altamente
   impegnative dal punto di vista cognitivo, gli elettori sono incentivati
   a utilizzare gli shortcuts per discriminare tra i candidati. Questo
   studio utilizza modelli di regressione lineare multilivello per
   analizzare l'effetto del genere dei candidati e della posizione nella
   scheda elettorale sul voto di preferenza in Lussemburgo e in Svizzera. I
   risultati mostrano che sia il genere dei candidati che la loro posizione
   elettorale hanno un effetto significativo sulla loro quota di voti di
   preferenza e forniscono prove su come interagiscono nella competizione
   intrapartitica. La posizione elettorale dei candidati ha un effetto a
   forma di J inversa sulla quota di voti di preferenza. Questo effetto
   varia con il genere dei candidati in entrambi i Paesi, ma in direzioni
   diverse. I nostri risultati hanno importanti implicazioni per la
   progettazione dei sistemi elettorali, in quanto delineano le potenziali
   conseguenze delle liste alfabetiche e di quelle ordinate per partito
   sulle possibilit \& agrave; dei candidati e sull'efficacia delle quote
   elettorali di genere nelle procedure di voto di preferenza all'interno
   dei partiti.},
