@article{ WOS:000650007100001,
Author = {Finseraas, Henning and Strom, Marte},
Title = {Voter responses to refugee arrivals: Effects of settlement policy},
Journal = {EUROPEAN JOURNAL OF POLITICAL RESEARCH},
Year = {2022},
Volume = {61},
Number = {2},
Pages = {524-543},
Month = {MAY},
Abstract = {In this paper we leverage a sudden shift in refugee settlement policy to
   study the electoral consequences of refugee settlements. After the 2013
   Norwegian parliamentary election, the newly elected right-wing
   government made a concerted effort to spread newly arrived immigrants
   across the country, with the consequence that some municipalities with
   limited experience in settling refugees accepted to do so. We propose
   that such policy changes have political consequences, increasing the
   salience of immigration issues and shifting voters' preferences to the
   right. We further propose that successful refugee integration can move
   (parts of) the electorate to the left, with stronger political
   polarization as a possible effect of the policy change. Applying
   difference-in-differences techniques, we find no evidence of
   unidirectional shifts in voter sentiments, but support for the
   hypothesis of stronger political polarization.},
Publisher = {WILEY},
Address = {111 RIVER ST, HOBOKEN 07030-5774, NJ USA},
Type = {Article},
Language = {English},
Affiliation = {Finseraas, H (Corresponding Author), Norwegian Univ Sci \& Technol, Dept Sociol \& Polit Sci, Trondheim, Norway.
   Finseraas, Henning, Norwegian Univ Sci \& Technol, Dept Sociol \& Polit Sci, Trondheim, Norway.
   Strom, Marte, Inst Social Res, Oslo, Norway.},
DOI = {10.1111/1475-6765.12461},
EarlyAccessDate = {MAY 2021},
ISSN = {0304-4130},
EISSN = {1475-6765},
Keywords = {Elections; immigration; local politics; political polarization; public
   policy},
Keywords-Plus = {PERSONAL CONTACT; PUBLIC-ATTITUDES; ANTI-IMMIGRANT; COMPETITION},
Research-Areas = {Government \& Law},
Web-of-Science-Categories  = {Political Science},
