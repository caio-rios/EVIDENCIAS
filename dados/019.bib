@article{ WOS:000649493500001,
Author = {Castro, Laia and Stromback, Jesper and Esser, Frank and Van Aelst, Peter
   and de Vreese, Claes and Aalberg, Toril and Cardenal, Ana S. and Corbu,
   Nicoleta and Hopmann, David Nicolas and Koc-Michalska, Karolina and
   Matthes, Jorg and Schemer, Christian and Sheafer, Tamir and Splendore,
   Sergio and Stanyer, James and Stepinska, Agnieszka and Stetka, Vaclav
