@article{ WOS:000656968300001,
Author = {Erisen, Cengiz and Guidi, Mattia and Martini, Sergio and Toprakkiran,
   Selin and Isernia, Pierangelo and Littvay, Levente},
Title = {Psychological Correlates of Populist Attitudes},
